/// Minimal physical regression for the 12 MHz to 250 MHz EHXPLLL binding.
module PllSmoke (
    clk       : input  'refclk clock    ,
    clk_250   : input  'fast   clock    ,
    pll_locked: input  'fast   logic    ,
    led       : output 'fast   logic<2>,
) {
    var counter   : 'fast logic<28>;
    var fast_rst_n: 'fast reset_async_low;

    unsafe (cdc) {
        assign fast_rst_n = pll_locked;
    }

    always_ff (clk_250, fast_rst_n) {
        if_reset {
            counter = 28'd0;
        } else {
            counter = counter + 28'd1;
        }
    }

    always_comb {
        led = {counter[27], !pll_locked};
    }
}
