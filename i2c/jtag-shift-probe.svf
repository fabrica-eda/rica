! Verify the ER1 fabric shift register without involving Update-DR.
TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
STATE RESET;
STATE IDLE;
SIR 8 TDI (32);

! Load 2'b11 through the two-bit ER1 scan.
SDR 2 TDI (3);
RUNTEST 32 TCK;

! The value just loaded must shift out LSB first.
SDR 2 TDI (0) TDO (3) MASK (3);
RUNTEST 32 TCK;
STATE IDLE;
