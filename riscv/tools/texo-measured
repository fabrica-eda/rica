#!/usr/bin/env python3
"""Current Texo with Rica's hash-checked measured models and STA guard.

--historical-toolchain explicitly selects the archived, qualified executable.
Updating the tool does not qualify a new implementation or bitstream.
"""
import hashlib
import json
import os
from pathlib import Path
import sys

root=Path(__file__).resolve().parents[2]
profile=json.loads((root/'riscv/qualified-measured-sta.json').read_text())
def checked(key):
    path=root/profile[key]
    if not path.exists() and key in ('timing_library', 'placement_model'):
        path = Path(str(path) + '.zst')
    if path.suffix == '.zst':
        try:
            import zstandard
        except ImportError:
            os.execvp('nix', ['nix', 'develop', str(root), '--command', 'python3',
                             str(Path(__file__).resolve()), *sys.argv[1:]])
        with path.open('rb') as raw, zstandard.ZstdDecompressor().stream_reader(raw) as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    else:
        with path.open('rb') as stream:
            digest = hashlib.file_digest(stream, 'sha256').hexdigest()
    if digest != profile[key+'_sha256']:
        raise SystemExit('Qualified '+key+' changed; requalify the profile explicitly.')
    return path
args=sys.argv[1:]
historical = '--historical-toolchain' in args
args = [arg for arg in args if arg != '--historical-toolchain']
binary = checked('binary') if historical else root/'riscv/tools/texo'
def supplied(flag):return any(a==flag or a.startswith(flag+'=') for a in args)
if args and args[0]=='pnr':
    for flag,key in [('--measured-placement-model','placement_model'),('--measured-timing-library','timing_library')]:
        if not supplied(flag):args += [flag,str(checked(key))]
    for flag in ['--setup-uncertainty-ps','--hold-uncertainty-ps']:
        if not supplied(flag):args += [flag,str(profile['setup_hold_guard_ps'])]
os.execv(binary,[str(binary),*args])
