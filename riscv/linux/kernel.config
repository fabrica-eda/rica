# Merge after ARCH=riscv tinyconfig. Single-hart RV64IMAC, Sv39, SBI console.
CONFIG_NONPORTABLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_RISCV_ISA_FALLBACK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_EXPERT=y
CONFIG_RISCV_EMULATED_UNALIGNED_ACCESS=y
# CONFIG_RISCV_PROBE_UNALIGNED_ACCESS is not set
# CONFIG_SMP is not set
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FTRACE is not set
# CONFIG_KALLSYMS is not set
# CONFIG_MODULES is not set
# CONFIG_NET is not set
# CONFIG_BLOCK is not set
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_UNIX98_PTYS is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set

# Avoid repeating the long BLAKE2 startup KAT in every RTL boot.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
