#[test(test_performance_counter)]
module test_performance_counter {
    inst clk: $tb::clock_gen;
    var rst_n: reset;
    var write_enable: logic;
    var write_value: logic<64>;
    var increment: logic;
    var freeze: logic;
    var value: logic<64>;
    inst dut: PerformanceCounter64 (clk, rst_n, write_enable, write_value, increment, freeze, value);
    initial {
        rst_n = 0;
        write_enable = 0;
        write_value = 0;
        increment = 0;
        freeze = 0;
        clk.next();
        rst_n = 1;
        write_enable = 1;
        write_value = 64'h0000_0001_ffff_fffe;
        increment = 1;
        clk.next();
        write_enable = 0;
        $assert(value == 64'h0000_0001_ffff_fffe);
        clk.next();
        $assert(value == 64'h0000_0001_ffff_ffff);
        clk.next();
        $assert(value == 64'h0000_0002_0000_0000);
        // Freeze must preserve the exact value immediately after a low-half wrap.
        freeze = 1;
        clk.next();
        $assert(value == 64'h0000_0002_0000_0000);
        freeze = 0;
        clk.next();
        $assert(value == 64'h0000_0002_0000_0001);
        write_enable = 1;
        write_value = 64'hffff_ffff_ffff_ffff;
        clk.next();
        write_enable = 0;
        $assert(value == 64'hffff_ffff_ffff_ffff);
        clk.next();
        $assert(value == 0);
        // A write has priority over the event at the 64-bit wrap boundary.
        write_enable = 1;
        write_value = 7;
        clk.next();
        write_enable = 0;
        increment = 0;
        $assert(value == 7);
        clk.next();
        $assert(value == 7);
        $finish();
    }
}
