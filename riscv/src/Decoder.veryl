/// RV64 integer decoder with optional M and Zba extensions.
module Decoder #(
    param ENABLE_M  : bit = 0,
    param ENABLE_ZBA: bit = 0,
) (
    decode: modport DecodeBus::decoder,
) {
    var opcode              : logic<7> ;
    var funct3              : logic<3> ;
    var funct7              : logic<7> ;
    var imm_i               : logic<64>;
    var imm_s               : logic<64>;
    var imm_b               : logic<64>;
    var imm_u               : logic<64>;
    var imm_j               : logic<64>;
    var encoding_legal      : logic    ;
    var legal_u_jump        : logic    ;
    var legal_control       : logic    ;
    var legal_memory        : logic    ;
    var legal_integer       : logic    ;
    var zba_add             : logic    ;
    var zba_shift_add       : logic    ;
    var zba_shift_immediate : logic    ;
    var legal_zba           : logic    ;
    var legal_system        : logic    ;
    var csr_address_known   : logic    ;
    var csr_address_writable: logic    ;
    var csr_write_requested : logic    ;
    var csr_known_group0    : logic    ;
    var csr_known_group1    : logic    ;
    var csr_known_group2    : logic    ;
    var csr_known_group3    : logic    ;
    var csr_writable_group0 : logic    ;
    var csr_writable_group1 : logic    ;
    var csr_writable_group2 : logic    ;
    var use_rs1_group0      : logic    ;
    var use_rs1_group1      : logic    ;
    var use_rs1_group2      : logic    ;
    var use_rs1_csr         : logic    ;

    always_comb {
        opcode = decode.instr[6:0];
        funct3 = decode.instr[14:12];
        funct7 = decode.instr[31:25];

        decode.rs1 = decode.instr[19:15];
        decode.rs2 = decode.instr[24:20];
        decode.rd  = decode.instr[11:7];

        imm_i = {decode.instr[31] repeat 53, decode.instr[30:20]};
        imm_s = {decode.instr[31] repeat 53, decode.instr[30:25], decode.instr[11:7]};
        imm_b = {decode.instr[31] repeat 52, decode.instr[7], decode.instr[30:25], decode.instr[11:8], 1'b0};
        // RV64 LUI/AUIPC sign-extend the 32-bit U-immediate.
        imm_u = {decode.instr[31] repeat 33, decode.instr[30:12], 12'h000};
        imm_j = {decode.instr[31] repeat 44, decode.instr[19:12], decode.instr[20], decode.instr[30:21], 1'b0};

        decode.immediate     = imm_i;
        decode.alu_op        = 4'd0;
        decode.use_pc        = 1'b0;
        decode.use_immediate = 1'b0;
        decode.use_rs1       = 1'b0;
        decode.use_rs2       = 1'b0;
        decode.write_enable  = 1'b0;
        decode.is_load       = 1'b0;
        decode.is_muldiv     = 1'b0;
        decode.load_size     = 2'b11;
        decode.load_unsigned = 1'b0;
        decode.is_store      = 1'b0;
        decode.store_size    = 2'b11;
        decode.word_op       = 1'b0;
        decode.is_branch     = 1'b0;
        decode.branch_op     = 3'b000;
        decode.is_jal        = 1'b0;
        decode.is_jalr       = 1'b0;
        decode.is_csr        = 1'b0;
        decode.csr_op        = 2'b00;
        decode.csr_use_imm   = 1'b0;
        decode.csr_write     = 1'b0;
        // Predecode CSR addresses before the RX/EX registers. The compact
        // index keeps architectural CSR reads and writes off a 12-bit address
        // comparator in the EX critical path. Zero denotes an unknown CSR.
        // Each address has one index. Encode its bits in parallel instead
        // of cascading the mutually exclusive address matches.
        decode.csr_index[0]  = (decode.instr[31:20] == 12'h300) || (decode.instr[31:20] == 12'h305)
            || (decode.instr[31:20] == 12'h341) || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hf12)
            || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'hb02) || (decode.instr[31:20] == 12'hc02)
            || (decode.instr[31:20] == 12'h7c1);
        decode.csr_index[1]  = (decode.instr[31:20] == 12'h301) || (decode.instr[31:20] == 12'h305)
            || (decode.instr[31:20] == 12'h342) || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hf13)
            || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        decode.csr_index[2]  = (decode.instr[31:20] == 12'h340) || (decode.instr[31:20] == 12'h341)
            || (decode.instr[31:20] == 12'h342) || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hb00)
            || (decode.instr[31:20] == 12'hc00) || (decode.instr[31:20] == 12'hb02) || (decode.instr[31:20] == 12'hc02)
            || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        decode.csr_index[3]  = (decode.instr[31:20] == 12'hf11) || (decode.instr[31:20] == 12'hf12)
            || (decode.instr[31:20] == 12'hf13) || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'hb00)
            || (decode.instr[31:20] == 12'hc00) || (decode.instr[31:20] == 12'hb02) || (decode.instr[31:20] == 12'hc02)
            || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        csr_known_group0     = (decode.instr[31:20] == 12'h300) || (decode.instr[31:20] == 12'h301)
            || (decode.instr[31:20] == 12'h305) || (decode.instr[31:20] == 12'h340);
        csr_known_group1     = (decode.instr[31:20] == 12'h341) || (decode.instr[31:20] == 12'h342)
            || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hf11);
        csr_known_group2     = (decode.instr[31:20] == 12'hf12) || (decode.instr[31:20] == 12'hf13)
            || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'hb00);
        csr_known_group3     = (decode.instr[31:20] == 12'hc00) || (decode.instr[31:20] == 12'hb02)
            || (decode.instr[31:20] == 12'hc02) || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        csr_address_known    = (csr_known_group0 || csr_known_group1) || (csr_known_group2 || csr_known_group3);
        csr_writable_group0  = (decode.instr[31:20] == 12'h300) || (decode.instr[31:20] == 12'h305)
            || (decode.instr[31:20] == 12'h340) || (decode.instr[31:20] == 12'h341);
        csr_writable_group1  = (decode.instr[31:20] == 12'h342) || (decode.instr[31:20] == 12'h343)
            || (decode.instr[31:20] == 12'hb00) || (decode.instr[31:20] == 12'hb02);
        csr_writable_group2  = (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        csr_address_writable = (csr_writable_group0 || csr_writable_group1) || csr_writable_group2;
        csr_write_requested  = (funct3[1:0] == 2'b01) || ((funct3[1:0] != 2'b00) && (decode.rs1 != 5'd0));
        decode.is_ecall      = 1'b0;
        decode.is_ebreak     = 1'b0;
        decode.is_mret       = 1'b0;
        decode.is_fence_i    = 1'b0;
        // Every unsupported or reserved encoding raises an illegal-instruction
        // exception instead of silently retiring or stopping the core.
        decode.illegal = 1'b1;

        case opcode {
            7'b0110111: { // LUI
                decode.immediate     = imm_u;
                decode.alu_op        = 4'd5;
                decode.use_immediate = 1'b1;
                decode.write_enable  = 1'b1;
                decode.illegal       = 1'b0;
            }
            7'b0010111: { // AUIPC
                decode.immediate     = imm_u;
                decode.use_pc        = 1'b1;
                decode.use_immediate = 1'b1;
                decode.write_enable  = 1'b1;
                decode.illegal       = 1'b0;
            }
            7'b1101111: { // JAL
                decode.immediate    = imm_j;
                decode.write_enable = 1'b1;
                decode.is_jal       = 1'b1;
                decode.illegal      = 1'b0;
            }
            7'b1100111: { // JALR
                if funct3 == 3'b000 {
                    decode.immediate    = imm_i;
                    decode.use_rs1      = 1'b1;
                    decode.write_enable = 1'b1;
                    decode.is_jalr      = 1'b1;
                    decode.illegal      = 1'b0;
                }
            }
            7'b1100011: { // BEQ/BNE/BLT/BGE/BLTU/BGEU
                decode.immediate = imm_b;
                if (funct3 == 3'b000) || (funct3 == 3'b001) || (funct3 == 3'b100) || (funct3 == 3'b101)
                    || (funct3 == 3'b110) || (funct3 == 3'b111) {
                    decode.is_branch = 1'b1;
                    decode.branch_op = funct3;
                    decode.use_rs1   = 1'b1;
                    decode.use_rs2   = 1'b1;
                    decode.illegal   = 1'b0;
                    if (funct3 == 3'b100) || (funct3 == 3'b101) {
                        decode.alu_op = 4'd9;
                    } else if (funct3 == 3'b110) || (funct3 == 3'b111) {
                        decode.alu_op = 4'd11;
                    }
                }
            }
            7'b0000011: { // LB/LH/LW/LD/LBU/LHU/LWU
                if funct3 != 3'b111 {
                    decode.immediate     = imm_i;
                    decode.use_immediate = 1'b1;
                    decode.use_rs1       = 1'b1;
                    decode.write_enable  = 1'b1;
                    decode.is_load       = 1'b1;
                    decode.load_size     = funct3[1:0];
                    decode.load_unsigned = funct3[2];
                    decode.illegal       = 1'b0;
                }
            }
            7'b0100011: { // SB/SH/SW/SD
                if !funct3[2] {
                    decode.immediate     = imm_s;
                    decode.use_immediate = 1'b1;
                    decode.use_rs1       = 1'b1;
                    decode.use_rs2       = 1'b1;
                    decode.is_store      = 1'b1;
                    decode.store_size    = funct3[1:0];
                    decode.illegal       = 1'b0;
                }
            }
            7'b0001111: { // FENCE/FENCE.I
                // Data requests complete in order. FENCE.I also serializes the
                // fetch pipeline and invalidates instruction storage at CM.
                if funct3 == 3'b000 {
                    decode.illegal = 1'b0;
                } else if funct3 == 3'b001 {
                    // Zifencei requires ignoring the reserved operand fields.
                    decode.is_fence_i = 1'b1;
                    decode.illegal    = 1'b0;
                }
            }
            7'b1110011: { // SYSTEM / Zicsr
                case funct3 {
                    3'b000: {
                        case decode.instr {
                            32'h0000_0073: {
                                decode.is_ecall = 1'b1;
                                decode.illegal  = 1'b0;
                            }
                            32'h0010_0073: {
                                decode.is_ebreak = 1'b1;
                                decode.illegal   = 1'b0;
                            }
                            32'h3020_0073: {
                                decode.is_mret = 1'b1;
                                decode.illegal = 1'b0;
                            }
                            default: {}
                        }
                    }
                    3'b001: { // CSRRW
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd0;
                        decode.csr_write    = 1'b1;
                        decode.use_rs1      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b010: { // CSRRS
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd1;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.use_rs1      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b011: { // CSRRC
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd2;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.use_rs1      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b101: { // CSRRWI
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd0;
                        decode.csr_use_imm  = 1'b1;
                        decode.csr_write    = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b110: { // CSRRSI
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd1;
                        decode.csr_use_imm  = 1'b1;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b111: { // CSRRCI
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd2;
                        decode.csr_use_imm  = 1'b1;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    default: {}
                }
            }
            7'b0010011: { // OP-IMM
                case funct3 {
                    3'b000: {
                        decode.alu_op        = 4'd0;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b001: { // SLLI
                        if decode.instr[31:26] == 6'b000000 {
                            decode.alu_op        = 4'd6;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    3'b010: { // SLTI
                        decode.alu_op        = 4'd9;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b011: { // SLTIU
                        decode.alu_op        = 4'd11;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b100: {
                        decode.alu_op        = 4'd2;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b101: { // SRLI/SRAI
                        if decode.instr[31:26] == 6'b000000 {
                            decode.alu_op        = 4'd7;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.illegal       = 1'b0;
                        } else if decode.instr[31:26] == 6'b010000 {
                            decode.alu_op        = 4'd8;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    3'b110: {
                        decode.alu_op        = 4'd3;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b111: {
                        decode.alu_op        = 4'd4;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    default: {}
                }
            }
            7'b0110011: { // OP
                case funct3 {
                    3'b000: {
                        if funct7 == 7'b0000000 {
                            decode.alu_op       = 4'd0;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        } else if funct7 == 7'b0100000 {
                            decode.alu_op       = 4'd1;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b001: { // SLL
                        if funct7 == 7'b0000000 {
                            decode.alu_op       = 4'd6;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b010: { // SLT
                        if funct7 == 7'b0000000 {
                            decode.alu_op       = 4'd9;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b011: { // SLTU
                        if funct7 == 7'b0000000 {
                            decode.alu_op       = 4'd11;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b100: {
                        decode.alu_op       = 4'd2;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b101: { // SRL/SRA
                        if funct7 == 7'b0000000 {
                            decode.alu_op       = 4'd7;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        } else if funct7 == 7'b0100000 {
                            decode.alu_op       = 4'd8;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b110: {
                        decode.alu_op       = 4'd3;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b111: {
                        decode.alu_op       = 4'd4;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    default: {}
                }
            }
            7'b0011011: { // OP-IMM-32: ADDIW
                case funct3 {
                    3'b000: {
                        decode.alu_op        = 4'd0;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.word_op       = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b001: { // SLLIW
                        if funct7 == 7'b0000000 {
                            decode.alu_op        = 4'd6;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.word_op       = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    3'b101: { // SRLIW/SRAIW
                        if funct7 == 7'b0000000 {
                            decode.alu_op        = 4'd7;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.word_op       = 1'b1;
                            decode.illegal       = 1'b0;
                        } else if funct7 == 7'b0100000 {
                            decode.alu_op        = 4'd8;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.word_op       = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    default: {}
                }
            }
            7'b0111011: { // OP-32: ADDW/SUBW
                if funct3 == 3'b000 {
                    if funct7 == 7'b0000000 {
                        decode.alu_op       = 4'd0;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    } else if funct7 == 7'b0100000 {
                        decode.alu_op       = 4'd1;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                } else if funct3 == 3'b001 { // SLLW
                    if funct7 == 7'b0000000 {
                        decode.alu_op       = 4'd6;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                } else if funct3 == 3'b101 { // SRLW/SRAW
                    if funct7 == 7'b0000000 {
                        decode.alu_op       = 4'd7;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    } else if funct7 == 7'b0100000 {
                        decode.alu_op       = 4'd8;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                }
            }
            default: {}
        }

        // Operand-use bits feed the RX register enables and hazard detector;
        // do not synthesize them from the large result-selection case above.
        // Unsupported encodings may conservatively claim an operand because
        // `illegal` prevents them from changing architectural state.
        use_rs1_group0       = (opcode == 7'b1100111) // JALR
            || (opcode == 7'b1100011) // branch
            || (opcode == 7'b0000011) // load
             || (opcode == 7'b0100011); // store
        use_rs1_group1       = (opcode == 7'b0010011) // OP-IMM
            || (opcode == 7'b0110011) // OP
            || (opcode == 7'b0011011) // OP-IMM-32
             || (opcode == 7'b0111011); // OP-32
        use_rs1_csr          = (opcode == 7'b1110011) && !funct3[2] && (funct3[1:0] != 2'b00);
        use_rs1_group2       = use_rs1_csr;
        decode.use_rs1       = (use_rs1_group0 || use_rs1_group1) || use_rs1_group2;
        decode.use_rs2       = (opcode == 7'b1100011) // branch
            || (opcode == 7'b0100011) // store
            || (opcode == 7'b0110011) // OP
             || (opcode == 7'b0111011); // OP-32
        decode.use_immediate = (opcode == 7'b0110111) // LUI
            || (opcode == 7'b0010111) // AUIPC
            || (opcode == 7'b0000011) // load
            || (opcode == 7'b0100011) // store
            || (opcode == 7'b0010011) // OP-IMM
             || (opcode == 7'b0011011); // OP-IMM-32
        // Generate legality once, independently of the control payload case.
        // This maps as parallel opcode/funct matching rather than a chain of
        // priority updates to one `illegal` bit.
        legal_u_jump   = (opcode == 7'b0110111) || (opcode == 7'b0010111) || (opcode == 7'b1101111);
        legal_control  = ((opcode == 7'b1100111) && (funct3 == 3'b000))
            || ((opcode == 7'b1100011) && (funct3[2] || !funct3[1]));
        legal_memory   = ((opcode == 7'b0000011) && (funct3 != 3'b111)) || ((opcode == 7'b0100011) && !funct3[2]);
        legal_integer  = ((opcode == 7'b0010011)
                && (((funct3 != 3'b001) && (funct3 != 3'b101))
                    || ((funct3 == 3'b001) && (decode.instr[31:26] == 6'b000000))
                    || ((funct3 == 3'b101)
                        && ((decode.instr[31:26] == 6'b000000) || (decode.instr[31:26] == 6'b010000)))))
            || ((opcode == 7'b0110011)
                && ((funct7 == 7'b0000000) || ((funct7 == 7'b0100000) && ((funct3 == 3'b000) || (funct3 == 3'b101)))))
            || ((opcode == 7'b0011011)
                && ((funct3 == 3'b000) || ((funct3 == 3'b001) && (funct7 == 7'b0000000))
                    || ((funct3 == 3'b101) && ((funct7 == 7'b0000000) || (funct7 == 7'b0100000)))))
            || ((opcode == 7'b0111011)
                && (((funct7 == 7'b0000000) && ((funct3 == 3'b000) || (funct3 == 3'b001) || (funct3 == 3'b101)))
                    || ((funct7 == 7'b0100000) && ((funct3 == 3'b000) || (funct3 == 3'b101)))));
        legal_system   = ((opcode == 7'b0001111) && ((funct3 == 3'b000) || (funct3 == 3'b001)))
            || ((opcode == 7'b1110011)
                && (((funct3 == 3'b000)
                        && ((decode.instr == 32'h0000_0073) || (decode.instr == 32'h0010_0073)
                            || (decode.instr == 32'h3020_0073)))
                    || ((funct3[1:0] != 2'b00) && csr_address_known
                        && (!csr_write_requested || csr_address_writable))));
        encoding_legal = ((legal_u_jump || legal_control) || (legal_memory || legal_integer)) || legal_system;
        decode.illegal = !encoding_legal;
        // Generate register/control flags independently from the ALU payload
        // priority case. These expressions retain its legal instruction flags.
        decode.is_csr       = (opcode == 7'b1110011) && (funct3[1:0] != 2'b00);
        decode.csr_op[0]    = decode.is_csr && (funct3[1:0] == 2'b10);
        decode.csr_op[1]    = decode.is_csr && (funct3[1:0] == 2'b11);
        decode.csr_use_imm  = decode.is_csr && funct3[2];
        decode.csr_write    = decode.is_csr && csr_write_requested;
        decode.is_ecall     = decode.instr == 32'h0000_0073;
        decode.is_ebreak    = decode.instr == 32'h0010_0073;
        decode.is_mret      = decode.instr == 32'h3020_0073;
        decode.is_fence_i   = (opcode == 7'b0001111) && (funct3 == 3'b001);
        decode.write_enable = legal_u_jump || legal_integer || decode.is_csr
            || ((opcode == 7'b1100111) && (funct3 == 3'b000)) || ((opcode == 7'b0000011) && (funct3 != 3'b111));
        decode.word_op      = legal_integer && ((opcode == 7'b0011011) || (opcode == 7'b0111011));
        zba_add             = ENABLE_ZBA && (opcode == 7'b0111011) && (funct7 == 7'b0000100) && (funct3 == 3'b000);
        zba_shift_add       = ENABLE_ZBA && ((opcode == 7'b0110011) || (opcode == 7'b0111011)) && (funct7 == 7'b0010000)
            && ((funct3 == 3'b010) || (funct3 == 3'b100) || (funct3 == 3'b110));
        zba_shift_immediate = ENABLE_ZBA && (opcode == 7'b0011011) && (decode.instr[31:26] == 6'b000010)
            && (funct3 == 3'b001);
        legal_zba           = zba_add || zba_shift_add || zba_shift_immediate;
        // 16 = SLLI.UW, 17..19 = SHnADD, 20 = ADD.UW, 21..23 = SHnADD.UW.
        // All Zba results are XLEN-wide, including the OP-32 encodings.
        if legal_zba {
            decode.alu_op = 6'd16;
            if zba_add {
                decode.alu_op = 6'd20;
            } else if zba_shift_add {
                decode.alu_op = {3'b010, opcode[3], funct3[2:1]};
            }
            decode.write_enable = 1'b1;
            decode.word_op      = 1'b0;
            decode.illegal      = 1'b0;
        }
        if ENABLE_M && (funct7 == 7'b0000001)
            && ((opcode == 7'b0110011) || ((opcode == 7'b0111011) && ((funct3 == 3'd0) || funct3[2]))) {
            decode.is_muldiv    = 1'b1;
            decode.use_rs1      = 1'b1;
            decode.use_rs2      = 1'b1;
            decode.write_enable = 1'b1;
            decode.word_op      = opcode[3];
            decode.alu_op       = 4'd0;
            decode.illegal      = 1'b0;
        }
    }
}
