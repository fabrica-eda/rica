/// RV64 decoder with combinational CSR address classification.
module Decoder #(
    param ENABLE_M         : bit = 0,
    param ENABLE_U: bit = 0,
    param ENABLE_S: bit = 0,
    param ENABLE_A         : bit = 0,
    param ENABLE_ZBA       : bit = 0,
    param ENABLE_ZBB       : bit = 0,
    param ENABLE_ZBS       : bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
) (
    decode: modport DecodeBus::decoder,
) {
    inst unit: DecoderWithCsrClass #(
        ENABLE_M: ENABLE_M, ENABLE_U: ENABLE_U, ENABLE_S: ENABLE_S, ENABLE_A: ENABLE_A,
        ENABLE_ZBA: ENABLE_ZBA, ENABLE_ZBB: ENABLE_ZBB, ENABLE_ZBS: ENABLE_ZBS,
        ENABLE_INTERRUPTS: ENABLE_INTERRUPTS,
    ) (
        decode, csr_known: 1'b0, csr_writable: 1'b0,
    );
}

/// RV64 integer decoder with optional M, Zba, Zbb and Zbs extensions.
module DecoderWithCsrClass #(
    param USE_CSR_CLASS: bit = 0,
    param ENABLE_M         : bit = 0,
    param ENABLE_U: bit = 0,
    param ENABLE_S: bit = 0,
    param ENABLE_A         : bit = 0,
    param ENABLE_ZBA       : bit = 0,
    param ENABLE_ZBB       : bit = 0,
    param ENABLE_ZBS       : bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
) (
    decode: modport DecodeBus::decoder,
    csr_known: input logic,
    csr_writable: input logic,
) {
    var opcode              : logic<7> ;
    var base_alu_op         : logic<6> ;
    var zba_op              : logic<6> ;
    var zbs_op              : logic<6> ;
    var use_base_op         : logic    ;
    var legal_muldiv        : logic    ;
    var funct3              : logic<3> ;
    var funct7              : logic<7> ;
    var imm_i               : logic<64>;
    var imm_s               : logic<64>;
    var imm_b               : logic<64>;
    var imm_u               : logic<64>;
    var imm_j               : logic<64>;
    var encoding_legal      : logic    ;
    var legal_u_jump        : logic    ;
    var legal_control       : logic    ;
    var legal_memory        : logic    ;
    var legal_integer       : logic    ;
    var zba_add             : logic    ;
    var zba_shift_add       : logic    ;
    var zba_shift_immediate : logic    ;
    var legal_zba           : logic    ;
    var zbb_logic           : logic    ;
    var zbb_minmax          : logic    ;
    var zbb_rotate_reg      : logic    ;
    var zbb_rotate_imm      : logic    ;
    var zbb_count           : logic    ;
    var zbb_sext            : logic    ;
    var zbb_zext            : logic    ;
    var zbb_orc             : logic    ;
    var zbb_rev             : logic    ;
    var legal_zbb           : logic    ;
    var zbb_op              : logic<5> ;
    var legal_zbs           : logic    ;
    var zbs_opcode          : logic    ;
    var zbs_function        : logic    ;
    var legal_system        : logic    ;
    var csr_address_known   : logic    ;
    var csr_address_writable: logic    ;
    var csr_write_requested : logic    ;
    var csr_user_address: logic;
    var csr_supervisor_address: logic;
    var legal_supervisor_system: logic;
    var csr_known_group0    : logic    ;
    var csr_known_group1    : logic    ;
    var csr_known_group2    : logic    ;
    var csr_known_group3    : logic    ;
    var csr_writable_group0 : logic    ;
    var csr_writable_group1 : logic    ;
    var csr_writable_group2 : logic    ;
    var use_rs1_group0      : logic    ;
    var use_rs1_group1      : logic    ;
    var use_rs1_group2      : logic    ;
    var use_rs1_csr         : logic    ;

    always_comb {
        opcode = decode.instr[6:0];
        funct3 = decode.instr[14:12];
        funct7 = decode.instr[31:25];

        decode.rs1 = decode.instr[19:15];
        decode.rs2 = decode.instr[24:20];
        decode.rd  = decode.instr[11:7];

        imm_i = {decode.instr[31] repeat 53, decode.instr[30:20]};
        imm_s = {decode.instr[31] repeat 53, decode.instr[30:25], decode.instr[11:7]};
        imm_b = {decode.instr[31] repeat 52, decode.instr[7], decode.instr[30:25], decode.instr[11:8], 1'b0};
        // RV64 LUI/AUIPC sign-extend the 32-bit U-immediate.
        imm_u = {decode.instr[31] repeat 33, decode.instr[30:12], 12'h000};
        imm_j = {decode.instr[31] repeat 44, decode.instr[19:12], decode.instr[20], decode.instr[30:21], 1'b0};

        decode.immediate     = imm_i;
        base_alu_op          = 4'd0;
        decode.use_pc        = 1'b0;
        decode.use_immediate = 1'b0;
        decode.use_rs1       = 1'b0;
        decode.use_rs2       = 1'b0;
        decode.write_enable  = 1'b0;
        decode.is_load       = 1'b0;
        decode.is_muldiv     = 1'b0;
        decode.load_size     = 2'b11;
        decode.load_unsigned = 1'b0;
        decode.is_store      = 1'b0;
        decode.store_size    = 2'b11;
        decode.word_op       = 1'b0;
        decode.is_branch     = 1'b0;
        decode.branch_op     = 3'b000;
        decode.is_jal        = 1'b0;
        decode.is_jalr       = 1'b0;
        decode.is_csr        = 1'b0;
        decode.csr_op        = 2'b00;
        decode.csr_use_imm   = 1'b0;
        decode.csr_write     = 1'b0;
        // Predecode CSR addresses before the RX/EX registers. The compact
        // index keeps architectural CSR reads and writes off a 12-bit address
        // comparator in the EX critical path. Zero denotes an unknown CSR.
        // Each address has one index. Encode its bits in parallel instead
        // of cascading the mutually exclusive address matches.
        decode.csr_index[0] = (decode.instr[31:20] == 12'h300) || (decode.instr[31:20] == 12'h305)
            || (decode.instr[31:20] == 12'h341) || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hf12)
            || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'hb02) || (decode.instr[31:20] == 12'hc02)
            || (decode.instr[31:20] == 12'h7c1) || (ENABLE_INTERRUPTS && (decode.instr[31:20] == 12'h344));
        decode.csr_index[1] = (decode.instr[31:20] == 12'h301) || (decode.instr[31:20] == 12'h305)
            || (decode.instr[31:20] == 12'h342) || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hf13)
            || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        decode.csr_index[2] = (decode.instr[31:20] == 12'h340) || (decode.instr[31:20] == 12'h341)
            || (decode.instr[31:20] == 12'h342) || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hb00)
            || (decode.instr[31:20] == 12'hc00) || (decode.instr[31:20] == 12'hb02) || (decode.instr[31:20] == 12'hc02)
            || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        decode.csr_index[3] = (decode.instr[31:20] == 12'hf11) || (decode.instr[31:20] == 12'hf12)
            || (decode.instr[31:20] == 12'hf13) || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'hb00)
            || (decode.instr[31:20] == 12'hc00) || (decode.instr[31:20] == 12'hb02) || (decode.instr[31:20] == 12'hc02)
            || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        decode.csr_index[4] = ENABLE_INTERRUPTS
            && ((decode.instr[31:20] == 12'h304) || (decode.instr[31:20] == 12'h344));
        decode.csr_index[5] = 1'b0;
        csr_known_group0    = (decode.instr[31:20] == 12'h300) || (decode.instr[31:20] == 12'h301)
            || (decode.instr[31:20] == 12'h305) || (decode.instr[31:20] == 12'h340);
        csr_known_group1    = (decode.instr[31:20] == 12'h341) || (decode.instr[31:20] == 12'h342)
            || (decode.instr[31:20] == 12'h343) || (decode.instr[31:20] == 12'hf11);
        csr_known_group2    = (decode.instr[31:20] == 12'hf12) || (decode.instr[31:20] == 12'hf13)
            || (decode.instr[31:20] == 12'hf14) || (decode.instr[31:20] == 12'hb00);
        csr_known_group3    = (decode.instr[31:20] == 12'hc00) || (decode.instr[31:20] == 12'hb02)
            || (decode.instr[31:20] == 12'hc02) || (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1);
        csr_address_known   = (csr_known_group0 || csr_known_group1) || (csr_known_group2 || csr_known_group3)
            || decode.csr_index[4];
        csr_writable_group0 = (decode.instr[31:20] == 12'h300) || (decode.instr[31:20] == 12'h305)
            || (decode.instr[31:20] == 12'h340) || (decode.instr[31:20] == 12'h341);
        csr_writable_group1 = (decode.instr[31:20] == 12'h342) || (decode.instr[31:20] == 12'h343)
            || (decode.instr[31:20] == 12'hb00) || (decode.instr[31:20] == 12'hb02);
        // MISA has a fixed WARL value. Writes are legal and ignored by the
        // CSR bank; unlike the 0xcxx/0xfxx CSRs, its address is not read-only.
        csr_writable_group2 = (decode.instr[31:20] == 12'h7c0) || (decode.instr[31:20] == 12'h7c1)
            || (decode.instr[31:20] == 12'h301);
        // MIP has a writable CSR address, but its implemented pending bits
        // are read-only levels owned by the platform. Writes are legal NOPs.
        csr_address_writable = (csr_writable_group0 || csr_writable_group1) || csr_writable_group2
            || decode.csr_index[4];
        // Recognize the U/PMP CSR address set directly. Feeding legality
        // through the encoded index adds a priority mux and magnitude compare.
        csr_user_address = ENABLE_U && ((decode.instr[31:20] == 12'h3a0)
            || (decode.instr[31:20] == 12'h3a2) || (decode.instr[31:24] == 8'h3b)
            || (decode.instr[31:20] == 12'h306) || (decode.instr[31:20] == 12'h30a));
        if ENABLE_U {
            if decode.instr[31:20] == 12'h3a0 { decode.csr_index = 5'd18; }
            else if decode.instr[31:20] == 12'h3a2 { decode.csr_index = 5'd19; }
            else if decode.instr[31:22] == 10'h0ec {
                decode.csr_index = {3'b101, decode.instr[21:20]};
            } else if (decode.instr[31:24] == 8'h3b) && (decode.instr[23:22] != 2'd0) {
                decode.csr_index = 5'd24;
            } else if decode.instr[31:20] == 12'h306 { decode.csr_index = 5'd25; }
            else if decode.instr[31:20] == 12'h30a { decode.csr_index = 5'd26; }
            csr_address_known = csr_address_known || csr_user_address;
            csr_address_writable = csr_address_writable || csr_user_address;
        }
        // Supervisor CSRs and the delegation registers use indices 32..44.
        // SIE/SIP/MIDELEG exist only with interrupts. Privilege checks for
        // these addresses remain in the core, as for every CSR below M.
        csr_supervisor_address = 1'b0;
        if ENABLE_S {
            csr_supervisor_address = 1'b1;
            case decode.instr[31:20] {
                12'h100: decode.csr_index = 6'd32;
                12'h105: decode.csr_index = 6'd34;
                12'h106: decode.csr_index = 6'd35;
                12'h10a: decode.csr_index = 6'd36;
                12'h140: decode.csr_index = 6'd37;
                12'h141: decode.csr_index = 6'd38;
                12'h142: decode.csr_index = 6'd39;
                12'h143: decode.csr_index = 6'd40;
                12'h180: decode.csr_index = 6'd42;
                12'h302: decode.csr_index = 6'd43;
                default: csr_supervisor_address = 1'b0;
            }
            if ENABLE_INTERRUPTS {
                if decode.instr[31:20] == 12'h104 {
                    decode.csr_index = 6'd33;
                    csr_supervisor_address = 1'b1;
                } else if decode.instr[31:20] == 12'h144 {
                    decode.csr_index = 6'd41;
                    csr_supervisor_address = 1'b1;
                } else if decode.instr[31:20] == 12'h303 {
                    decode.csr_index = 6'd44;
                    csr_supervisor_address = 1'b1;
                }
            }
            csr_address_known = csr_address_known || csr_supervisor_address;
            csr_address_writable = csr_address_writable || csr_supervisor_address;
        }
        // Core may supply stable address properties registered with fd_q.
        // Operand-dependent write intent remains in this decode stage.
        if USE_CSR_CLASS {
            csr_address_known = csr_known;
            csr_address_writable = csr_writable;
        }
        csr_write_requested  = (funct3[1:0] == 2'b01) || ((funct3[1:0] != 2'b00) && (decode.rs1 != 5'd0));
        decode.is_ecall      = 1'b0;
        decode.is_ebreak     = 1'b0;
        decode.is_mret       = 1'b0;
        decode.is_sret       = 1'b0;
        decode.is_fence_i    = 1'b0;
        // Every unsupported or reserved encoding raises an illegal-instruction
        // exception instead of silently retiring or stopping the core.
        decode.illegal = 1'b1;

        case opcode {
            7'b0110111: { // LUI
                decode.immediate     = imm_u;
                base_alu_op          = 4'd5;
                decode.use_immediate = 1'b1;
                decode.write_enable  = 1'b1;
                decode.illegal       = 1'b0;
            }
            7'b0010111: { // AUIPC
                decode.immediate     = imm_u;
                decode.use_pc        = 1'b1;
                decode.use_immediate = 1'b1;
                decode.write_enable  = 1'b1;
                decode.illegal       = 1'b0;
            }
            7'b1101111: { // JAL
                decode.immediate    = imm_j;
                decode.write_enable = 1'b1;
                decode.is_jal       = 1'b1;
                decode.illegal      = 1'b0;
            }
            7'b1100111: { // JALR
                if funct3 == 3'b000 {
                    decode.immediate    = imm_i;
                    decode.use_rs1      = 1'b1;
                    decode.write_enable = 1'b1;
                    decode.is_jalr      = 1'b1;
                    decode.illegal      = 1'b0;
                }
            }
            7'b1100011: { // BEQ/BNE/BLT/BGE/BLTU/BGEU
                decode.immediate = imm_b;
                if (funct3 == 3'b000) || (funct3 == 3'b001) || (funct3 == 3'b100) || (funct3 == 3'b101)
                    || (funct3 == 3'b110) || (funct3 == 3'b111) {
                    decode.is_branch = 1'b1;
                    decode.branch_op = funct3;
                    decode.use_rs1   = 1'b1;
                    decode.use_rs2   = 1'b1;
                    decode.illegal   = 1'b0;
                    if (funct3 == 3'b100) || (funct3 == 3'b101) {
                        base_alu_op = 4'd9;
                    } else if (funct3 == 3'b110) || (funct3 == 3'b111) {
                        base_alu_op = 4'd11;
                    }
                }
            }
            7'b0000011: { // LB/LH/LW/LD/LBU/LHU/LWU
                if funct3 != 3'b111 {
                    decode.immediate     = imm_i;
                    decode.use_immediate = 1'b1;
                    decode.use_rs1       = 1'b1;
                    decode.write_enable  = 1'b1;
                    decode.is_load       = 1'b1;
                    decode.load_size     = funct3[1:0];
                    decode.load_unsigned = funct3[2];
                    decode.illegal       = 1'b0;
                }
            }
            7'b0100011: { // SB/SH/SW/SD
                if !funct3[2] {
                    decode.immediate     = imm_s;
                    decode.use_immediate = 1'b1;
                    decode.use_rs1       = 1'b1;
                    decode.use_rs2       = 1'b1;
                    decode.is_store      = 1'b1;
                    decode.store_size    = funct3[1:0];
                    decode.illegal       = 1'b0;
                }
            }
            7'b0001111: { // FENCE/FENCE.I
                // Data requests complete in order. FENCE.I also serializes the
                // fetch pipeline and invalidates instruction storage at CM.
                if funct3 == 3'b000 {
                    decode.illegal = 1'b0;
                } else if funct3 == 3'b001 {
                    // Zifencei requires ignoring the reserved operand fields.
                    decode.is_fence_i = 1'b1;
                    decode.illegal    = 1'b0;
                }
            }
            7'b1110011: { // SYSTEM / Zicsr
                case funct3 {
                    3'b000: {
                        case decode.instr {
                            32'h0000_0073: {
                                decode.is_ecall = 1'b1;
                                decode.illegal  = 1'b0;
                            }
                            32'h0010_0073: {
                                decode.is_ebreak = 1'b1;
                                decode.illegal   = 1'b0;
                            }
                            32'h3020_0073: {
                                decode.is_mret = 1'b1;
                                decode.illegal = 1'b0;
                            }
                            32'h1050_0073: {
                                // Privileged ISA permits WFI to execute as a
                                // NOP. This M-only core does not gate clocks.
                                decode.illegal = 1'b0;
                            }
                            default: {}
                        }
                    }
                    3'b001: { // CSRRW
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd0;
                        decode.csr_write    = 1'b1;
                        decode.use_rs1      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b010: { // CSRRS
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd1;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.use_rs1      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b011: { // CSRRC
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd2;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.use_rs1      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b101: { // CSRRWI
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd0;
                        decode.csr_use_imm  = 1'b1;
                        decode.csr_write    = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b110: { // CSRRSI
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd1;
                        decode.csr_use_imm  = 1'b1;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b111: { // CSRRCI
                        decode.is_csr       = 1'b1;
                        decode.csr_op       = 2'd2;
                        decode.csr_use_imm  = 1'b1;
                        decode.csr_write    = decode.rs1 != 5'd0;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    default: {}
                }
            }
            7'b0010011: { // OP-IMM
                case funct3 {
                    3'b000: {
                        base_alu_op          = 4'd0;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b001: { // SLLI
                        if decode.instr[31:26] == 6'b000000 {
                            base_alu_op          = 4'd6;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    3'b010: { // SLTI
                        base_alu_op          = 4'd9;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b011: { // SLTIU
                        base_alu_op          = 4'd11;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b100: {
                        base_alu_op          = 4'd2;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b101: { // SRLI/SRAI
                        if decode.instr[31:26] == 6'b000000 {
                            base_alu_op          = 4'd7;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.illegal       = 1'b0;
                        } else if decode.instr[31:26] == 6'b010000 {
                            base_alu_op          = 4'd8;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    3'b110: {
                        base_alu_op          = 4'd3;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b111: {
                        base_alu_op          = 4'd4;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    default: {}
                }
            }
            7'b0110011: { // OP
                case funct3 {
                    3'b000: {
                        if funct7 == 7'b0000000 {
                            base_alu_op         = 4'd0;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        } else if funct7 == 7'b0100000 {
                            base_alu_op         = 4'd1;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b001: { // SLL
                        if funct7 == 7'b0000000 {
                            base_alu_op         = 4'd6;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b010: { // SLT
                        if funct7 == 7'b0000000 {
                            base_alu_op         = 4'd9;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b011: { // SLTU
                        if funct7 == 7'b0000000 {
                            base_alu_op         = 4'd11;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b100: {
                        base_alu_op         = 4'd2;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b101: { // SRL/SRA
                        if funct7 == 7'b0000000 {
                            base_alu_op         = 4'd7;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        } else if funct7 == 7'b0100000 {
                            base_alu_op         = 4'd8;
                            decode.use_rs1      = 1'b1;
                            decode.use_rs2      = 1'b1;
                            decode.write_enable = 1'b1;
                            decode.illegal      = 1'b0;
                        }
                    }
                    3'b110: {
                        base_alu_op         = 4'd3;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    3'b111: {
                        base_alu_op         = 4'd4;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                    default: {}
                }
            }
            7'b0011011: { // OP-IMM-32: ADDIW
                case funct3 {
                    3'b000: {
                        base_alu_op          = 4'd0;
                        decode.use_immediate = 1'b1;
                        decode.use_rs1       = 1'b1;
                        decode.write_enable  = 1'b1;
                        decode.word_op       = 1'b1;
                        decode.illegal       = 1'b0;
                    }
                    3'b001: { // SLLIW
                        if funct7 == 7'b0000000 {
                            base_alu_op          = 4'd6;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.word_op       = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    3'b101: { // SRLIW/SRAIW
                        if funct7 == 7'b0000000 {
                            base_alu_op          = 4'd7;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.word_op       = 1'b1;
                            decode.illegal       = 1'b0;
                        } else if funct7 == 7'b0100000 {
                            base_alu_op          = 4'd8;
                            decode.use_immediate = 1'b1;
                            decode.use_rs1       = 1'b1;
                            decode.write_enable  = 1'b1;
                            decode.word_op       = 1'b1;
                            decode.illegal       = 1'b0;
                        }
                    }
                    default: {}
                }
            }
            7'b0111011: { // OP-32: ADDW/SUBW
                if funct3 == 3'b000 {
                    if funct7 == 7'b0000000 {
                        base_alu_op         = 4'd0;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    } else if funct7 == 7'b0100000 {
                        base_alu_op         = 4'd1;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                } else if funct3 == 3'b001 { // SLLW
                    if funct7 == 7'b0000000 {
                        base_alu_op         = 4'd6;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                } else if funct3 == 3'b101 { // SRLW/SRAW
                    if funct7 == 7'b0000000 {
                        base_alu_op         = 4'd7;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    } else if funct7 == 7'b0100000 {
                        base_alu_op         = 4'd8;
                        decode.use_rs1      = 1'b1;
                        decode.use_rs2      = 1'b1;
                        decode.write_enable = 1'b1;
                        decode.word_op      = 1'b1;
                        decode.illegal      = 1'b0;
                    }
                }
            }
            default: {}
        }

        // Operand-use bits feed the RX register enables and hazard detector;
        // do not synthesize them from the large result-selection case above.
        // Unsupported encodings may conservatively claim an operand because
        // `illegal` prevents them from changing architectural state.
        use_rs1_group0       = (opcode == 7'b1100111) // JALR
            || (opcode == 7'b1100011) // branch
            || (opcode == 7'b0000011) // load
             || (opcode == 7'b0100011); // store
        use_rs1_group1       = (opcode == 7'b0010011) // OP-IMM
            || (opcode == 7'b0110011) // OP
            || (opcode == 7'b0011011) // OP-IMM-32
             || (opcode == 7'b0111011); // OP-32
        use_rs1_csr          = (opcode == 7'b1110011) && !funct3[2] && (funct3[1:0] != 2'b00);
        use_rs1_group2       = use_rs1_csr;
        decode.use_rs1       = (use_rs1_group0 || use_rs1_group1) || use_rs1_group2;
        decode.use_rs2       = (opcode == 7'b1100011) // branch
            || (opcode == 7'b0100011) // store
            || (opcode == 7'b0110011) // OP
             || (opcode == 7'b0111011); // OP-32
        decode.use_immediate = (opcode == 7'b0110111) // LUI
            || (opcode == 7'b0010111) // AUIPC
            || (opcode == 7'b0000011) // load
            || (opcode == 7'b0100011) // store
            || (opcode == 7'b0010011) // OP-IMM
             || (opcode == 7'b0011011); // OP-IMM-32
        // Generate legality once, independently of the control payload case.
        // This maps as parallel opcode/funct matching rather than a chain of
        // priority updates to one `illegal` bit.
        legal_u_jump  = (opcode == 7'b0110111) || (opcode == 7'b0010111) || (opcode == 7'b1101111);
        legal_control = ((opcode == 7'b1100111) && (funct3 == 3'b000))
            || ((opcode == 7'b1100011) && (funct3[2] || !funct3[1]));
        legal_memory  = ((opcode == 7'b0000011) && (funct3 != 3'b111)) || ((opcode == 7'b0100011) && !funct3[2]);
        legal_integer = ((opcode == 7'b0010011)
                && (((funct3 != 3'b001) && (funct3 != 3'b101))
                    || ((funct3 == 3'b001) && (decode.instr[31:26] == 6'b000000))
                    || ((funct3 == 3'b101)
                        && ((decode.instr[31:26] == 6'b000000) || (decode.instr[31:26] == 6'b010000)))))
            || ((opcode == 7'b0110011)
                && ((funct7 == 7'b0000000) || ((funct7 == 7'b0100000) && ((funct3 == 3'b000) || (funct3 == 3'b101)))))
            || ((opcode == 7'b0011011)
                && ((funct3 == 3'b000) || ((funct3 == 3'b001) && (funct7 == 7'b0000000))
                    || ((funct3 == 3'b101) && ((funct7 == 7'b0000000) || (funct7 == 7'b0100000)))))
            || ((opcode == 7'b0111011)
                && (((funct7 == 7'b0000000) && ((funct3 == 3'b000) || (funct3 == 3'b001) || (funct3 == 3'b101)))
                    || ((funct7 == 7'b0100000) && ((funct3 == 3'b000) || (funct3 == 3'b101)))));
        // Exact privileged encodings already prove opcode and funct3.
        // Keep their recognition parallel to the CSR access checks.
        // SRET and SFENCE.VMA. With Bare translation SFENCE.VMA has no
        // cached translation to order, so it retires as a NOP.
        legal_supervisor_system = ENABLE_S && ((decode.instr == 32'h1020_0073)
            || ((decode.instr[31:25] == 7'b0001001) && (decode.instr[14:0] == 15'h0073)));
        legal_system   = ((opcode == 7'b0001111) && ((funct3 == 3'b000) || (funct3 == 3'b001)))
            || (decode.instr == 32'h0000_0073) || (decode.instr == 32'h0010_0073) || (decode.instr == 32'h3020_0073)
            || (decode.instr == 32'h1050_0073) || legal_supervisor_system
            || ((opcode == 7'b1110011) && (funct3[1:0] != 2'b00) && csr_address_known
                && (!csr_write_requested || csr_address_writable));
        encoding_legal = ((legal_u_jump || legal_control) || (legal_memory || legal_integer)) || legal_system;
        decode.illegal = !encoding_legal;
        // Generate register/control flags independently from the ALU payload
        // priority case. These expressions retain its legal instruction flags.
        decode.is_csr       = (opcode == 7'b1110011) && (funct3[1:0] != 2'b00);
        decode.csr_op[0]    = decode.is_csr && (funct3[1:0] == 2'b10);
        decode.csr_op[1]    = decode.is_csr && (funct3[1:0] == 2'b11);
        decode.csr_use_imm  = decode.is_csr && funct3[2];
        decode.csr_write    = decode.is_csr && csr_write_requested;
        decode.is_ecall     = decode.instr == 32'h0000_0073;
        decode.is_ebreak    = decode.instr == 32'h0010_0073;
        decode.is_mret      = decode.instr == 32'h3020_0073;
        decode.is_sret      = ENABLE_S && (decode.instr == 32'h1020_0073);
        decode.is_fence_i   = (opcode == 7'b0001111) && (funct3 == 3'b001);
        decode.write_enable = legal_u_jump || legal_integer || decode.is_csr
            || ((opcode == 7'b1100111) && (funct3 == 3'b000)) || ((opcode == 7'b0000011) && (funct3 != 3'b111));
        decode.word_op      = legal_integer && ((opcode == 7'b0011011) || (opcode == 7'b0111011));
        zba_add             = ENABLE_ZBA && (opcode == 7'b0111011) && (funct7 == 7'b0000100) && (funct3 == 3'b000);
        zba_shift_add       = ENABLE_ZBA && ((opcode == 7'b0110011) || (opcode == 7'b0111011)) && (funct7 == 7'b0010000)
            && ((funct3 == 3'b010) || (funct3 == 3'b100) || (funct3 == 3'b110));
        zba_shift_immediate = ENABLE_ZBA && (opcode == 7'b0011011) && (decode.instr[31:26] == 6'b000010)
            && (funct3 == 3'b001);
        legal_zba           = zba_add || zba_shift_add || zba_shift_immediate;
        // 16 = SLLI.UW, 17..19 = SHnADD, 20 = ADD.UW, 21..23 = SHnADD.UW.
        // All Zba results are XLEN-wide, including the OP-32 encodings.
        zba_op = {
            1'b0, legal_zba, 1'b0, zba_add || (zba_shift_add && opcode[3]), zba_shift_add && funct3[2],
            zba_shift_add && funct3[1]
        };
        if legal_zba {
            decode.write_enable = 1'b1;
            decode.word_op      = 1'b0;
            decode.illegal      = 1'b0;
        }
        // Zbb 1.0: exact RV64 encodings, including the reserved roriw bit 5.
        zbb_logic      = (opcode == 7'h33) && (funct7 == 7'h20)
            && ((funct3 == 3'd4) || (funct3 == 3'd6) || (funct3 == 3'd7));
        zbb_minmax     = (opcode == 7'h33) && (funct7 == 7'h05) && funct3[2];
        zbb_rotate_reg = ((opcode == 7'h33) || (opcode == 7'h3b)) && (funct7 == 7'h30)
            && ((funct3 == 3'd1) || (funct3 == 3'd5));
        zbb_rotate_imm = (funct3 == 3'd5)
            && (((opcode == 7'h13) && (decode.instr[31:26] == 6'h18)) || ((opcode == 7'h1b) && (funct7 == 7'h30)));
        zbb_count      = ((opcode == 7'h13) || (opcode == 7'h1b)) && (funct3 == 3'd1) && (funct7 == 7'h30)
            && (decode.instr[24:20] <= 5'd2);
        zbb_sext       = (opcode == 7'h13) && (funct3 == 3'd1) && (funct7 == 7'h30)
            && ((decode.instr[24:20] == 5'd4) || (decode.instr[24:20] == 5'd5));
        zbb_zext       = (opcode == 7'h3b) && (funct3 == 3'd4) && (funct7 == 7'h04) && (decode.instr[24:20] == 5'd0);
        zbb_orc        = (opcode == 7'h13) && (funct3 == 3'd5) && (decode.instr[31:20] == 12'h287);
        zbb_rev        = (opcode == 7'h13) && (funct3 == 3'd5) && (decode.instr[31:20] == 12'h6b8);
        legal_zbb      = ENABLE_ZBB
            && (zbb_logic || zbb_minmax || zbb_rotate_reg || zbb_rotate_imm || zbb_count || zbb_sext || zbb_zext
                || zbb_orc || zbb_rev);
        // 32..39 logic/extension/byte ops; 40..43 min/max; 44/45 rotate;
        // 46/47 leading/trailing zero count; 48 population count.
        // Instruction groups are disjoint. Encode each control bit directly
        // so the tag does not pass through a priority chain of whole words.
        zbb_op[0] = (zbb_logic && (funct3 == 3'd6)) || (zbb_sext && !decode.instr[20]) || zbb_zext || zbb_rev
            || (zbb_minmax && funct3[0]) || ((zbb_rotate_reg || zbb_rotate_imm) && funct3[2])
            || (zbb_count && decode.instr[20]);
        zbb_op[1] = (zbb_logic && (funct3 == 3'd4)) || (zbb_sext && !decode.instr[20]) || zbb_orc || zbb_rev
            || (zbb_minmax && funct3[1]) || (zbb_count && !decode.instr[21]);
        zbb_op[2] = (zbb_sext && decode.instr[20]) || zbb_zext || zbb_orc || zbb_rev || zbb_rotate_reg || zbb_rotate_imm
            || (zbb_count && !decode.instr[21]);
        zbb_op[3] = zbb_minmax || zbb_rotate_reg || zbb_rotate_imm || (zbb_count && !decode.instr[21]);
        zbb_op[4] = zbb_count && decode.instr[21];
        if legal_zbb {
            decode.word_op      = opcode[3] && !zbb_zext;
            decode.write_enable = 1'b1;
            decode.illegal      = 1'b0;
        }
        // Zbs 1.0: OP has a seven-bit funct7, OP-IMM a six-bit funct6.
        // RV64 admits every six-bit immediate; no OP-32 / OP-IMM-32 forms.
        zbs_opcode   = ((opcode == 7'h33) && !decode.instr[25]) || (opcode == 7'h13);
        zbs_function = ((funct3 == 3'd1)
                && ((decode.instr[31:26] == 6'h0a) || (decode.instr[31:26] == 6'h12) || (decode.instr[31:26] == 6'h1a)))
            || ((funct3 == 3'd5) && (decode.instr[31:26] == 6'h12));
        legal_zbs    = ENABLE_ZBS && zbs_opcode && zbs_function;
        if legal_zbs {
            // 52 BCLR, 53 BEXT, 54 BINV, 55 BSET (register and immediate).
            decode.word_op      = 1'b0;
            decode.write_enable = 1'b1;
            decode.illegal      = 1'b0;
        }
        legal_muldiv = ENABLE_M && (funct7 == 7'b0000001)
            && ((opcode == 7'b0110011) || ((opcode == 7'b0111011) && ((funct3 == 3'd0) || funct3[2])));
        if legal_muldiv {
            decode.is_muldiv    = 1'b1;
            decode.use_rs1      = 1'b1;
            decode.use_rs2      = 1'b1;
            decode.write_enable = 1'b1;
            decode.word_op      = opcode[3];
            decode.illegal      = 1'b0;
        }
        // A operations use the LSU address base with a zero offset. Mark all
        // as loads for dependency interlocks, and non-LR as stores for rs2.
        // Select the zero offset by major opcode, independently of funct5/rs2
        // legality. Invalid A encodings still trap; their immediate is unused.
        // Keep that legality reduction off the ordinary sign-extension path.
        if ENABLE_A && (opcode == 7'h2f) {
            decode.immediate = 64'd0;
        }
        // Eight AMOs have funct5[1:0]=00. The remaining operations are SWAP,
        // LR and SC (funct5=1,2,3); only LR requires rs2=x0.
        decode.is_atomic = ENABLE_A && (opcode == 7'h2f)
            && ((funct3 == 3'd2) || (funct3 == 3'd3))
            && ((decode.instr[28:27] == 2'd0)
                || ((decode.instr[31:29] == 3'd0)
                    && ((decode.instr[28:27] != 2'd2) || (decode.rs2 == 5'd0))));
        if decode.is_atomic {
            decode.use_immediate = 1'b1;
            decode.use_rs1 = 1'b1;
            decode.use_rs2 = decode.instr[31:27] != 5'd2;
            decode.is_load = 1'b1;
            decode.is_store = decode.instr[31:27] != 5'd2;
            decode.load_size = funct3[1:0];
            decode.store_size = funct3[1:0];
            decode.load_unsigned = 1'b0;
            decode.write_enable = 1'b1;
            decode.illegal = 1'b0;
        }
        // ISA groups are disjoint. In particular each asserted Zbb low tag
        // bit already proves that a Zbb encoding matched; a second legal_zbb
        // mux would add redundant selection to the instruction-to-RX path.
        use_base_op   = !(legal_zba || legal_zbb || legal_zbs || legal_muldiv);
        zbs_op        = {4'b1101, decode.instr[29], funct3[2] || !decode.instr[30]} & {legal_zbs repeat 6};
        decode.alu_op = (base_alu_op & {use_base_op repeat 6}) | zba_op
            | {legal_zbb, (zbb_op & {(ENABLE_ZBB != 1'b0) repeat 5})} | zbs_op;
    }
}

/// Stable CSR address properties, independent of operands and privilege state.
module CsrAddressClass #(
    param ENABLE_U: bit = 0,
    param ENABLE_S: bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
) (
    address: input logic<12>,
    known: output logic,
    writable: output logic,
) {
    var extended: logic;
    always_comb {
        extended = (ENABLE_INTERRUPTS && ((address == 12'h304) || (address == 12'h344)))
            || (ENABLE_U && ((address == 12'h3a0) || (address == 12'h3a2)
                || (address[11:4] == 8'h3b) || (address == 12'h306) || (address == 12'h30a)))
            || (ENABLE_S && ((address == 12'h100) || (address == 12'h105) || (address == 12'h106)
                || (address == 12'h10a) || (address == 12'h140) || (address == 12'h141) || (address == 12'h142)
                || (address == 12'h143) || (address == 12'h180) || (address == 12'h302)
                || (ENABLE_INTERRUPTS && ((address == 12'h104) || (address == 12'h144) || (address == 12'h303)))));
        known = (address == 12'h300) || (address == 12'h301) || (address == 12'h305) || (address == 12'h340)
            || (address == 12'h341) || (address == 12'h342) || (address == 12'h343)
            || (address == 12'hf11) || (address == 12'hf12) || (address == 12'hf13) || (address == 12'hf14)
            || (address == 12'hb00) || (address == 12'hc00) || (address == 12'hb02) || (address == 12'hc02)
            || (address == 12'h7c0) || (address == 12'h7c1) || extended;
        writable = (address == 12'h300) || (address == 12'h301) || (address == 12'h305) || (address == 12'h340)
            || (address == 12'h341) || (address == 12'h342) || (address == 12'h343)
            || (address == 12'hb00) || (address == 12'hb02)
            || (address == 12'h7c0) || (address == 12'h7c1) || extended;
    }
}
