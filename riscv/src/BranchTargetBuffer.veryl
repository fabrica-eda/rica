/// Synchronous 256-entry, two-way branch target buffer.
///
/// The lookup port has one clock of latency.  Each way is an independent
/// 128x64 memory so an implementation can map both ways onto FPGA block RAM.
/// The write port explicitly forwards a same-set update, invalidation, or scrub
/// into the read result; behavior therefore does not depend on the target RAM's
/// read-during-write mode.
/// The one-entry response is held until `response_accept`; accepting a response
/// and launching its replacement may occur on the same edge.
///
/// `SCRUB_ON_RESET=1` invalidates one set per clock after reset.  `ready` stays
/// low and lookup hits are suppressed until all 128 sets have been visited.
/// With the default value zero the memories are deliberately left untouched by
/// reset; the enclosing frontend is responsible for establishing their state.
module BranchTargetBuffer #(
    param SCRUB_ON_RESET: bit = 0,
) (
    clk             : input  clock    ,
    rst_n           : input  reset    ,
    ready           : output logic    ,
    lookup_valid    : input  logic    ,
    lookup_token    : input  logic<3> ,
    lookup_pc       : input  logic<32>,
    response_accept : input  logic    ,
    response_cancel : input  logic    ,
    rollback_valid  : input  logic    ,
    rollback_set    : input  logic<7> ,
    rollback_data   : input  logic    ,
    response_valid  : output logic    ,
    response_token  : output logic<3> ,
    response_hit    : output logic    ,
    response_kind   : output logic<3> ,
    response_target : output logic<32>,
    response_way    : output logic    ,
    response_plru   : output logic    ,
    update_valid    : input  logic    ,
    update_pc       : input  logic<32>,
    update_kind     : input  logic<3> ,
    update_target   : input  logic<32>,
    update_way      : input  logic    ,
    invalidate_valid: input  logic    ,
    invalidate_pc   : input  logic<32>,
    invalidate_way  : input  logic    ,
) {
    // Entry layout: valid, kind, target, tag, four padding bits.
    // The padding keeps both inferred memories at a natural 64-bit width.
    #[sv("struo_memory = \"required\"")]
    var way_0_memory: logic<64> [128];
    #[sv("struo_memory = \"required\"")]
    var way_1_memory: logic<64> [128];

    var way_0_read_q  : logic<64>;
    var way_1_read_q  : logic<64>;
    var way_0_bypass_q: logic    ;
    var way_1_bypass_q: logic    ;
    var bypass_data_q : logic<64>;
    var way_0_entry   : logic<64>;
    var way_1_entry   : logic<64>;

    var lookup_valid_q: logic    ;
    var lookup_token_q: logic<3> ;
    var lookup_set_q  : logic<7> ;
    var lookup_tag_q  : logic<24>;
    var lookup_accept : logic    ;

    // One pseudo-LRU bit per set selects the next victim.  Keep this as a
    // canonical simple-dual-port memory as well: spelling it as a packed
    // 128-bit register creates a large constant-index mux in Struo.
    #[sv("struo_memory = \"required\"")]
    var replacement_memory       : logic    [128];
    var replacement_read_raw_q   : logic         ;
    var replacement_read_bypass_q: logic         ;
    var replacement_bypass_data_q: logic         ;
    var replacement_read_q       : logic         ;
    var replacement_write        : logic         ;
    var replacement_address      : logic<7>      ;
    var replacement_data         : logic         ;
    var way_0_hit                : logic         ;
    var way_1_hit                : logic         ;

    var scrub_active_q: logic   ;
    var scrub_set_q   : logic<7>;

    var write_set  : logic<7> ;
    var write_entry: logic<64>;
    var write_way_0: logic    ;
    var write_way_1: logic    ;

    always_comb {
        ready = !scrub_active_q;
        // `lookup_valid_q` is the response-storage valid bit itself.  Using it
        // directly keeps the local capacity gate acyclic while retaining the
        // accept-and-replace case.
        lookup_accept = lookup_valid && ready && (!lookup_valid_q || response_accept);

        way_0_entry = way_0_read_q;
        way_1_entry = way_1_read_q;
        if way_0_bypass_q {
            way_0_entry = bypass_data_q;
        }
        if way_1_bypass_q {
            way_1_entry = bypass_data_q;
        }

        replacement_read_q = replacement_read_raw_q;
        if replacement_read_bypass_q {
            replacement_read_q = replacement_bypass_data_q;
        }

        way_0_hit = lookup_valid_q && ready && way_0_entry[63] && (way_0_entry[27:4] == lookup_tag_q);
        way_1_hit = lookup_valid_q && ready && way_1_entry[63] && (way_1_entry[27:4] == lookup_tag_q);

        response_valid  = lookup_valid_q;
        response_token  = lookup_token_q;
        response_hit    = way_0_hit || way_1_hit;
        response_kind   = 3'd0;
        response_target = 32'd0;
        // On a miss use the sole invalid physical way before consulting PLRU.
        // This lets invalidation leave replacement state untouched, so an
        // unrelated retire cannot steal the response-accept write port.
        // Duplicate hits are not a legal steady state, but way zero wins
        // deterministically if one is observed while an entry is replaced.
        response_way  = replacement_read_q;
        response_plru = replacement_read_q;
        if !way_0_entry[63] && way_1_entry[63] {
            response_way = 1'b0;
        } else if way_0_entry[63] && !way_1_entry[63] {
            response_way = 1'b1;
        }
        if way_0_hit {
            response_kind   = way_0_entry[62:60];
            response_target = way_0_entry[59:28];
            response_way    = 1'b0;
        } else if way_1_hit {
            response_kind   = way_1_entry[62:60];
            response_target = way_1_entry[59:28];
            response_way    = 1'b1;
        }

        write_set   = update_pc[7:1];
        write_entry = {1'b1, update_kind, update_target, update_pc[31:8], 4'b0000};
        write_way_0 = update_valid && !update_way && !scrub_active_q;
        write_way_1 = update_valid && update_way && !scrub_active_q;

        // Scrubbing owns both write ports.  Outside scrub, explicit
        // invalidation has priority over update because both commands share
        // the single logical port-B operation.
        if invalidate_valid && !scrub_active_q {
            write_set   = invalidate_pc[7:1];
            write_entry = 64'd0;
            write_way_0 = !invalidate_way;
            write_way_1 = invalidate_way;
        }

        // Popping a hit marks the other way as the next victim.  A miss
        // provisionally reserves its selected victim before retirement:
        // otherwise two outstanding cold misses to one set can both retain
        // the same way and overwrite each other when they retire.  A shadow
        // discovered only after the classifier register restores the PLRU bit
        // observed before its provisional claim.
        replacement_write   = response_accept && response_valid && !response_cancel && !scrub_active_q;
        replacement_address = lookup_set_q;
        replacement_data    = !response_way;
        if rollback_valid && !scrub_active_q {
            replacement_write   = 1'b1;
            replacement_address = rollback_set;
            replacement_data    = rollback_data;
        }

    }

    // Port A is the synchronous lookup read. Port B serializes reset scrub,
    // invalidation, and update into one write per way. This is the canonical
    // simple-dual-port shape expected by Struo and ECP5 DP16KD inference.
    always_ff (clk) {
        if lookup_accept {
            way_0_read_q = way_0_memory[lookup_pc[7:1]];
        }
    }

    always_ff (clk) {
        if lookup_accept {
            way_1_read_q = way_1_memory[lookup_pc[7:1]];
        }
    }

    always_ff (clk) {
        if scrub_active_q {
            way_0_memory[scrub_set_q] = 64'd0;
        } else if write_way_0 {
            way_0_memory[write_set] = write_entry;
        }
    }

    always_ff (clk) {
        if scrub_active_q {
            way_1_memory[scrub_set_q] = 64'd0;
        } else if write_way_1 {
            way_1_memory[write_set] = write_entry;
        }
    }

    // Explicit same-address forwarding makes simulation and silicon agree
    // regardless of the block RAM's configured read-during-write mode.
    always_ff (clk, rst_n) {
        if_reset {
            way_0_bypass_q = 1'b0;
            way_1_bypass_q = 1'b0;
            bypass_data_q  = 64'd0;
        } else if lookup_accept {
            way_0_bypass_q = write_way_0 && (write_set == lookup_pc[7:1]);
            way_1_bypass_q = write_way_1 && (write_set == lookup_pc[7:1]);
            bypass_data_q  = write_entry;
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            lookup_valid_q = 1'b0;
            lookup_token_q = 3'd0;
            lookup_set_q   = 7'd0;
            lookup_tag_q   = 24'd0;
        } else {
            if lookup_accept {
                // A new lookup may replace an accepted response on this same
                // edge.  Without a new lookup, all response metadata remains
                // stable until the consumer acknowledges it.
                lookup_valid_q = 1'b1;
                lookup_token_q = lookup_token;
                lookup_set_q   = lookup_pc[7:1];
                lookup_tag_q   = lookup_pc[31:8];
            } else if response_accept {
                lookup_valid_q = 1'b0;
            }
        }
    }

    always_ff (clk) {
        if lookup_accept {
            replacement_read_raw_q = replacement_memory[lookup_pc[7:1]];
        }
    }

    always_ff (clk) {
        if scrub_active_q {
            replacement_memory[scrub_set_q] = 1'b0;
        } else if replacement_write {
            replacement_memory[replacement_address] = replacement_data;
        }
    }

    // The PLRU RAM has the same explicit read-during-write forwarding as the
    // two entry RAMs.  Scrub is included so a lookup presented during the last
    // scrub cycle cannot observe device-specific old data once `ready` rises.
    always_ff (clk, rst_n) {
        if_reset {
            replacement_read_bypass_q = 1'b0;
            replacement_bypass_data_q = 1'b0;
        } else if lookup_accept {
            replacement_read_bypass_q = (scrub_active_q && (scrub_set_q == lookup_pc[7:1]))
                || (replacement_write && (replacement_address == lookup_pc[7:1]));
            replacement_bypass_data_q = replacement_data;
            if scrub_active_q {
                replacement_bypass_data_q = 1'b0;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            scrub_active_q = 1'b0;
            scrub_set_q    = 7'd0;
            if SCRUB_ON_RESET {
                scrub_active_q = 1'b1;
            }
        } else {
            if scrub_active_q {
                if scrub_set_q == 7'd127 {
                    scrub_active_q = 1'b0;
                } else {
                    scrub_set_q = scrub_set_q + 7'd1;
                }
            }
        }
    }
}
