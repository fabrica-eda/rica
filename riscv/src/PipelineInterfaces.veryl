/// Decoded instruction controls transferred from the decoder to the pipeline.
interface DecodeBus {
    var instr        : logic<32>;
    var rs1          : logic<5> ;
    var rs2          : logic<5> ;
    var rd           : logic<5> ;
    var immediate    : logic<64>;
    var alu_op       : logic<6> ;
    var use_pc       : logic    ;
    var use_immediate: logic    ;
    var use_rs1      : logic    ;
    var use_rs2      : logic    ;
    var write_enable : logic    ;
    var is_muldiv    : logic    ;
    var is_load      : logic    ;
    var load_size    : logic<2> ;
    var load_unsigned: logic    ;
    var is_store     : logic    ;
    var store_size   : logic<2> ;
    var word_op      : logic    ;
    var is_branch    : logic    ;
    var branch_op    : logic<3> ;
    var is_jal       : logic    ;
    var is_jalr      : logic    ;
    var is_csr       : logic    ;
    var csr_op       : logic<2> ;
    var csr_use_imm  : logic    ;
    var csr_write    : logic    ;
    var csr_index    : logic<5> ;
    var is_ecall     : logic    ;
    var is_ebreak    : logic    ;
    var is_mret      : logic    ;
    var is_fence_i   : logic    ;
    var illegal      : logic    ;

    modport core {
        instr: output,
        ..input
    }

    modport decoder {
        instr: input,
        ..output
    }
}

/// Machine-mode CSR storage and the precise trap/return control surface.
///
/// CSR instructions read combinationally in EX. Writes, trap entry, and MRET
/// update architectural state at the completion boundary, after older redirects.
/// Machine interrupt levels are synchronous to the core clock. Bit order is
/// {external, timer, software}; the platform owns acknowledgment of each level.
interface CsrBus {
    var index                         : logic<5> ;
    var write_index                   : logic<5> ;
    var read_data                     : logic<64>;
    var write_enable                  : logic    ;
    var write_op                      : logic<2> ;
    var write_source                  : logic<64>;
    var retire                        : logic    ;
    var stall_dependency              : logic    ;
    var stall_memory_wait             : logic    ;
    var stall_redirect                : logic    ;
    var stall_frontend_empty          : logic    ;
    var predictor_conditional_resolved: logic    ;
    var predictor_direction_wrong     : logic    ;
    var predictor_btb_miss            : logic    ;
    var predictor_ras_fallback        : logic    ;
    var predictor_repair              : logic    ;
    var counter_freeze                : logic    ;
    var debug_counter_index           : logic<4> ;
    var debug_counter_data            : logic<64>;
    var trap_enter                    : logic    ;
    var trap_pc                       : logic<64>;
    var trap_cause                    : logic<64>;
    var trap_value                    : logic<64>;
    var mret                          : logic    ;
    var trap_vector                   : logic<64>;
    var return_pc                     : logic<64>;
    var machine_interrupts            : logic<3> ;
    var interrupt_pending             : logic    ;
    var interrupt_cause               : logic<4> ;

    modport core {
        index                         : output,
        write_index                   : output,
        write_enable                  : output,
        write_op                      : output,
        write_source                  : output,
        retire                        : output,
        stall_dependency              : output,
        stall_memory_wait             : output,
        stall_redirect                : output,
        stall_frontend_empty          : output,
        predictor_conditional_resolved: output,
        predictor_direction_wrong     : output,
        predictor_btb_miss            : output,
        predictor_ras_fallback        : output,
        predictor_repair              : output,
        counter_freeze                : output,
        debug_counter_index           : output,
        trap_enter                    : output,
        trap_pc                       : output,
        trap_cause                    : output,
        trap_value                    : output,
        mret                          : output,
        machine_interrupts            : output,
        read_data                     : input ,
        debug_counter_data            : input ,
        trap_vector                   : input ,
        return_pc                     : input ,
        interrupt_pending             : input ,
        interrupt_cause               : input ,
    }

    modport file {
        index                         : input ,
        write_index                   : input ,
        write_enable                  : input ,
        write_op                      : input ,
        write_source                  : input ,
        retire                        : input ,
        stall_dependency              : input ,
        stall_memory_wait             : input ,
        stall_redirect                : input ,
        stall_frontend_empty          : input ,
        predictor_conditional_resolved: input ,
        predictor_direction_wrong     : input ,
        predictor_btb_miss            : input ,
        predictor_ras_fallback        : input ,
        predictor_repair              : input ,
        counter_freeze                : input ,
        debug_counter_index           : input ,
        trap_enter                    : input ,
        trap_pc                       : input ,
        trap_cause                    : input ,
        trap_value                    : input ,
        mret                          : input ,
        machine_interrupts            : input ,
        read_data                     : output,
        debug_counter_data            : output,
        trap_vector                   : output,
        return_pc                     : output,
        interrupt_pending             : output,
        interrupt_cause               : output,
    }
}

/// Registered operands enter the execution unit; arithmetic and logical
/// candidates leave separately so the pipeline can preserve a short bypass.
interface ExecuteBus {
    var alu_op            : logic<6> ;
    var subtract          : logic    ;
    var link              : logic    ;
    var word_op           : logic    ;
    var operand_a         : logic<64>;
    var operand_b         : logic<64>;
    var arithmetic        : logic<64>;
    var logic_result      : logic<64>;
    var shift_result      : logic<64>;
    var compare_equal     : logic<4> ;
    var compare_less      : logic<4> ;
    var compare_sign_a    : logic    ;
    var compare_sign_b    : logic    ;
    var result_use_logic  : logic    ;
    var result_use_shift  : logic    ;
    var result_use_compare: logic    ;

    modport pipeline {
        alu_op   : output,
        subtract : output,
        link     : output,
        word_op  : output,
        operand_a: output,
        operand_b: output,
        ..input
    }

    modport execute {
        alu_op   : input,
        subtract : input,
        link     : input,
        word_op  : input,
        operand_a: input,
        operand_b: input,
        ..output
    }
}

/// Low half of the pipelined RV64 funnel shifter.
interface ShiftBus {
    var alu_op : logic<4> ;
    var word_op: logic    ;
    var operand: logic<64>;
    var amount : logic<6> ;
    var result : logic<64>;

    modport pipeline {
        alu_op : output,
        word_op: output,
        operand: output,
        amount : output,
        result : input ,
    }

    modport shifter {
        alu_op : input ,
        word_op: input ,
        operand: input ,
        amount : input ,
        result : output,
    }
}

/// High half of the pipelined RV64 funnel shifter.
interface ShiftHighBus {
    var arithmetic: logic    ;
    var operand   : logic<64>;
    var amount    : logic<3> ;
    var result    : logic<64>;

    modport pipeline {
        arithmetic: output,
        operand   : output,
        amount    : output,
        result    : input ,
    }

    modport shifter {
        arithmetic: input ,
        operand   : input ,
        amount    : input ,
        result    : output,
    }
}

/// Registered EX1 candidates enter the common EX2 completion stage. The stage
/// finishes pipelined integer units and normalizes LSU read data before WB.
/// Future pipelined units add a candidate and selection tag here rather than
/// borrowing an LSU-specific pipeline stage.
interface CompletionBus {
    var arithmetic      : logic<64>;
    var logic_result    : logic<64>;
    var use_logic       : logic    ;
    var shift_low       : logic<64>;
    var shift_amount    : logic<3> ;
    var shift_arithmetic: logic    ;
    var shift_left      : logic    ;
    var shift_word      : logic    ;
    var use_shift       : logic    ;
    var compare_equal   : logic<4> ;
    var compare_less    : logic<4> ;
    var compare_sign_a  : logic    ;
    var compare_sign_b  : logic    ;
    var compare_signed  : logic    ;
    var use_compare     : logic    ;
    var load_data       : logic<64>;
    var load_size       : logic<2> ;
    var load_unsigned   : logic    ;
    var use_load        : logic    ;
    var store_size      : logic<2> ;
    var result          : logic<64>;
    var compare_result  : logic    ;
    var store_mask      : logic<8> ;

    modport pipeline {
        arithmetic      : output,
        logic_result    : output,
        use_logic       : output,
        shift_low       : output,
        shift_amount    : output,
        shift_arithmetic: output,
        shift_left      : output,
        shift_word      : output,
        use_shift       : output,
        compare_equal   : output,
        compare_less    : output,
        compare_sign_a  : output,
        compare_sign_b  : output,
        compare_signed  : output,
        use_compare     : output,
        load_data       : output,
        load_size       : output,
        load_unsigned   : output,
        use_load        : output,
        store_size      : output,
        result          : input ,
        compare_result  : input ,
        store_mask      : input ,
    }

    modport completion {
        arithmetic      : input ,
        logic_result    : input ,
        use_logic       : input ,
        shift_low       : input ,
        shift_amount    : input ,
        shift_arithmetic: input ,
        shift_left      : input ,
        shift_word      : input ,
        use_shift       : input ,
        compare_equal   : input ,
        compare_less    : input ,
        compare_sign_a  : input ,
        compare_sign_b  : input ,
        compare_signed  : input ,
        use_compare     : input ,
        load_data       : input ,
        load_size       : input ,
        load_unsigned   : input ,
        use_load        : input ,
        store_size      : input ,
        result          : output,
        compare_result  : output,
        store_mask      : output,
    }
}
