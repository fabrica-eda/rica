/// One-request-per-clock RV64C-aware branch prediction frontend.
///
/// The fetch-side request first enters a one-entry ingress register.  The BTB
/// and all five TAGE memories perform their synchronous read at the following
/// issue edge.  The next edge captures only compact TAGE match/weak/prediction
/// metadata plus the aligned BTB/RAS/request packet.  Provider and next-PC
/// selection are then derived from those registers.
/// Conditional history is applied once on the next edge; registered NT
/// previews let a new sequential lookup launch every clock while that effect
/// is pending, and a registered taken result cancels the launched shadow.
///
/// Tokens keep the large training metadata inside the predictor.  The current
/// in-order pipeline resolves every older control transfer no later than the
/// cycle in which a younger transfer can recover, so recovery can copy the
/// committed GHR/RAS frontier and apply the actual younger action.  A future
/// out-of-order frontend can replace that boundary with ROB checkpoints
/// without widening the fetch/decode packets.
module BranchPredictor #(
    param SCRUB_ON_RESET: bit = 0,
) (
    clk                       : input  clock    ,
    rst_n                     : input  reset    ,
    ready                     : output logic    ,
    request_ready             : output logic    ,
    request_valid             : input  logic    ,
    request_accept            : output logic    ,
    request_pc                : input  logic<32>,
    request_fallthrough       : input  logic<32>,
    request_is_conditional    : input  logic    ,
    response_accept           : input  logic    ,
    response_valid            : output logic    ,
    response_token            : output logic<3> ,
    response_kind             : output logic<3> ,
    response_taken            : output logic    ,
    response_next_pc          : output logic<32>,
    response_btb_hit          : output logic    ,
    response_tage_hit         : output logic    ,
    response_ras_fallback     : output logic    ,
    retire_valid              : input  logic    ,
    retire_token              : input  logic<3> ,
    retire_pc                 : input  logic<32>,
    retire_kind               : input  logic<3> ,
    retire_taken              : input  logic    ,
    retire_target             : input  logic<32>,
    retire_fallthrough        : input  logic<32>,
    recover_valid             : input  logic    ,
    recover_token             : input  logic<3> ,
    recover_kind              : input  logic<3> ,
    recover_taken             : input  logic    ,
    recover_fallthrough       : input  logic<32>,
    discard_all               : input  logic    ,
    conditional_resolved_event: output logic    ,
    direction_wrong_event     : output logic    ,
    btb_miss_event            : output logic    ,
    ras_fallback_event        : output logic    ,
) {
    const KIND_NONE       : u32 = 0;
    const KIND_CONDITIONAL: u32 = 1;
    const KIND_DIRECT     : u32 = 2;
    const KIND_INDIRECT   : u32 = 3;
    const KIND_CALL       : u32 = 4;
    const KIND_RETURN     : u32 = 5;
    const KIND_COROUTINE  : u32 = 6;
    const TOKEN_COUNT     : u32 = 8;
    const RAS_DEPTH       : u32 = 16;

    // Physical lookup sequencing is independent from the architectural token
    // claimed by a visible prediction.  In particular, a canceled sequential
    // shadow still needs a unique table correlation tag, but must not consume
    // one of the eight prediction/training snapshots.
    var lookup_sequence_q : logic<3>;
    var allocation_token_q: logic<3>;

    var slot_valid_q                  : logic<TOKEN_COUNT>              ;
    var slot_taken_q                  : logic<TOKEN_COUNT>              ;
    var slot_btb_hit_q                : logic<TOKEN_COUNT>              ;
    var slot_btb_way_q                : logic<TOKEN_COUNT>              ;
    var slot_btb_set_q                : logic<7>           [TOKEN_COUNT];
    var slot_btb_identity_stale_q     : logic<TOKEN_COUNT>              ;
    var slot_ras_fallback_q           : logic<TOKEN_COUNT>              ;
    var retire_slot_valid             : logic                           ;
    var retire_slot_taken             : logic                           ;
    var retire_slot_btb_hit           : logic                           ;
    var retire_slot_btb_way           : logic                           ;
    var retire_slot_btb_identity_stale: logic                           ;
    var retire_slot_ras_fallback      : logic                           ;

    var response_fallthrough_q        : logic<32>;
    var response_conditional_q        : logic    ;
    var response_btb_set_q            : logic<7> ;
    var response_btb_identity_stale_q : logic    ;
    var table_response_accept         : logic    ;
    var table_response_cancel         : logic    ;
    var tables_response_valid         : logic    ;
    var cancelled_response            : logic    ;
    var raw_response_capture          : logic    ;
    var decision_ready                : logic    ;
    var decision_promote              : logic    ;
    var decision_squash               : logic    ;
    var decision_replacement_rollback : logic    ;
    var decision_fast_miss            : logic    ;
    var fast_miss_accept              : logic    ;
    var output_ready                  : logic    ;
    var issue_ready                   : logic    ;
    var ingress_ready                 : logic    ;
    var ingress_accept                : logic    ;
    var request_fire                  : logic    ;
    var selected_response_valid       : logic    ;
    var selected_response_token       : logic<3> ;
    var selected_response_kind        : logic<3> ;
    var selected_response_target      : logic<32>;
    var selected_response_btb_hit     : logic    ;
    var selected_response_ras_fallback: logic    ;
    var decision_valid_q              : logic    ;
    var decision_token_q              : logic<3> ;
    var decision_kind_q               : logic<3> ;
    var decision_target_q             : logic<32>;
    var decision_fallthrough_q        : logic<32>;
    var decision_btb_hit_q            : logic    ;
    var decision_btb_way_q            : logic    ;
    var decision_btb_set_q            : logic<7> ;
    var decision_btb_plru_q           : logic    ;
    var decision_ras_fallback_q       : logic    ;
    var decision_conditional_q        : logic    ;
    var decision_match_q              : logic<4> ;
    var decision_weak_q               : logic<4> ;
    var decision_pred_q               : logic<5> ;
    var apply_decision_effect         : logic    ;
    var decision_effect_taken         : logic    ;
    var output_valid_q                : logic    ;
    var output_token_q                : logic<3> ;
    var output_kind_q                 : logic<3> ;
    var output_taken_q                : logic    ;
    var output_next_pc_q              : logic<32>;
    var output_fallthrough_q          : logic<32>;
    var output_btb_hit_q              : logic    ;
    var output_tage_hit_q             : logic    ;
    var output_ras_fallback_q         : logic    ;

    // The external fetch request is decoupled from the synchronous table
    // issue edge by one elastic entry.  In addition to the architectural
    // packet, retain the folded-history snapshot and its not-taken successor
    // in the same transaction.  The speculative frontier may advance while
    // this entry waits behind a table response; recomputing these folds at
    // issue time would therefore associate a request with the wrong history.

    // Use independent provider cones for scalar control, the 32-bit next-PC
    // mux, and history feedback.  This prevents one selected-direction net
    // from becoming the shared high-fanout bridge between those consumers.
    var decision_control_provider_oh: logic<5>;
    var decision_control_alt_oh     : logic<5>;
    var decision_control_lm_pred    : logic   ;
    var decision_control_alt_pred   : logic   ;
    var decision_control_weak       : logic   ;
    var decision_control_tage_pred  : logic   ;
    var decision_control_taken      : logic   ;
    var decision_control_tage_hit   : logic   ;
    var decision_pc_provider_oh     : logic<5>;
    var decision_pc_alt_oh          : logic<5>;
    var decision_pc_lm_pred         : logic   ;
    var decision_pc_alt_pred        : logic   ;
    var decision_pc_weak            : logic   ;
    var decision_pc_tage_pred       : logic   ;
    var decision_pc_taken           : logic   ;
    var decision_history_provider_oh: logic<5>;
    var decision_history_alt_oh     : logic<5>;
    var decision_history_lm_pred    : logic   ;
    var decision_history_alt_pred   : logic   ;
    var decision_history_weak       : logic   ;
    var decision_history_tage_pred  : logic   ;
    var decision_history_taken      : logic   ;

    var btb_ready                    : logic    ;
    var btb_response_valid           : logic    ;
    var btb_response_token           : logic<3> ;
    var btb_response_hit             : logic    ;
    var btb_response_kind            : logic<3> ;
    var btb_response_target          : logic<32>;
    var btb_response_way             : logic    ;
    var btb_response_plru            : logic    ;
    var btb_update_valid             : logic    ;
    var btb_update_way               : logic    ;
    var btb_invalidate_candidate     : logic    ;
    var btb_invalidate_valid         : logic    ;
    var btb_identity_mutation_valid  : logic    ;
    var btb_response_identity_mutated: logic    ;

    var tage_ready                  : logic   ;
    var tage_response_valid         : logic   ;
    var tage_response_token         : logic<3>;
    var tage_response_taken         : logic   ;
    var tage_response_hit           : logic   ;
    var tage_response_match_metadata: logic<4>;
    var tage_response_weak_metadata : logic<4>;
    var tage_response_pred_metadata : logic<5>;
    var tage_lookup_index_0         : logic<9>;
    var tage_lookup_index_1         : logic<9>;
    var tage_lookup_index_2         : logic<9>;
    var tage_lookup_index_3         : logic<9>;
    var tage_lookup_tag_0           : logic<8>;
    var tage_lookup_tag_1           : logic<8>;
    var tage_lookup_tag_2           : logic<9>;
    var tage_lookup_tag_3           : logic<9>;
    var request_pc_fold_8           : logic<8>;
    var request_pc_fold_9           : logic<9>;
    var tage_update_valid           : logic   ;
    var tage_flush_slots            : logic   ;

    // Bit zero is the newest conditional outcome.  Index folds are nine bits;
    // tag A/B folds use widths (8,7), (8,7), (9,8), and (9,8).
    struct Fold9x4 {
        bank0: logic<9>,
        bank1: logic<9>,
        bank2: logic<9>,
        bank3: logic<9>,
    }
    struct Fold8x4 {
        bank0: logic<8>,
        bank1: logic<8>,
        bank2: logic<8>,
        bank3: logic<8>,
    }
    struct LookupRequest {
        pc            : logic  <32>,
        fallthrough   : logic  <32>,
        is_conditional: logic      ,
        token         : logic  <3> ,
        index_fold    : Fold9x4    ,
        tag_a_fold    : Fold9x4    ,
        tag_b_fold    : Fold8x4    ,
        index_nt      : Fold9x4    ,
        tag_a_nt      : Fold9x4    ,
        tag_b_nt      : Fold8x4    ,
    }
    var ingress_valid_q      : logic             ;
    var ingress_q            : LookupRequest     ;
    var issue_pc             : logic        <32> ;
    var issue_fallthrough    : logic        <32> ;
    var issue_is_conditional : logic             ;
    var issue_token          : logic        <3>  ;
    var issue_index_fold     : Fold9x4           ;
    var issue_tag_a_fold     : Fold9x4           ;
    var issue_tag_b_fold     : Fold8x4           ;
    var issue_index_nt       : Fold9x4           ;
    var issue_tag_a_nt       : Fold9x4           ;
    var issue_tag_b_nt       : Fold8x4           ;
    var speculative_history_q: logic        <108>;
    var committed_history_q  : logic        <108>;
    var speculative_index_q  : Fold9x4           ;
    var committed_index_q    : Fold9x4           ;
    var speculative_tag_a_q  : Fold9x4           ;
    var committed_tag_a_q    : Fold9x4           ;
    var speculative_tag_b_q  : Fold8x4           ;
    var committed_tag_b_q    : Fold8x4           ;

    var speculative_history_next : logic  <108>;
    var committed_history_next   : logic  <108>;
    var speculative_index_next   : Fold9x4     ;
    var committed_index_next     : Fold9x4     ;
    var speculative_tag_a_next   : Fold9x4     ;
    var committed_tag_a_next     : Fold9x4     ;
    var speculative_tag_b_next   : Fold8x4     ;
    var committed_tag_b_next     : Fold8x4     ;
    var prediction_history_next  : logic  <108>;
    var prediction_index_next    : Fold9x4     ;
    var prediction_tag_a_next    : Fold9x4     ;
    var prediction_tag_b_next    : Fold8x4     ;
    var response_index_nt_q      : Fold9x4     ;
    var response_tag_a_nt_q      : Fold9x4     ;
    var response_tag_b_nt_q      : Fold8x4     ;
    var decision_index_nt_q      : Fold9x4     ;
    var decision_tag_a_nt_q      : Fold9x4     ;
    var decision_tag_b_nt_q      : Fold8x4     ;
    var request_index_nt         : Fold9x4     ;
    var request_tag_a_nt         : Fold9x4     ;
    var request_tag_b_nt         : Fold8x4     ;
    var lookup_index_fold        : Fold9x4     ;
    var lookup_tag_a_fold        : Fold9x4     ;
    var lookup_tag_b_fold        : Fold8x4     ;
    var append_prediction        : logic       ;
    var launch_conditional_shadow: logic       ;
    var append_commit            : logic       ;
    var recover_is_retire        : logic       ;

    var committed_ras_q       : logic<32> [RAS_DEPTH];
    var speculative_ras_data_q: logic<32> [RAS_DEPTH];
    // Keep validity as sixteen independent state bits.  Recovery and selected
    // word updates below drive each bit directly, avoiding both the old wide
    // packed-mask cone and a token-to-address reverse lookup on the read path.
    var speculative_ras_valid_q: logic    [RAS_DEPTH];
    var speculative_ras_owner_q: logic<3> [RAS_DEPTH];
    // Recovery first discards every ordinary speculative word, then may
    // recreate the resolved control transfer's single RAS write here.  Keep
    // that write out of the sixteen-entry valid bank so the combined
    // retire/recover stack arithmetic does not feed a 4-to-16 decoder.
    var recovery_ras_overlay_valid_q  : logic                ;
    var recovery_ras_overlay_address_q: logic<4>             ;
    var recovery_ras_overlay_top_sp_q : logic<4>             ;
    var recovery_ras_overlay_data_q   : logic<32>            ;
    var recovery_ras_overlay_owner_q  : logic<3>             ;
    var speculative_sp_q              : logic<4>             ;
    var committed_sp_q                : logic<4>             ;
    var speculative_count_q           : logic<5>             ;
    var committed_count_q             : logic<5>             ;
    var speculative_sp_next           : logic<4>             ;
    var committed_sp_next             : logic<4>             ;
    var speculative_count_next        : logic<5>             ;
    var committed_count_next          : logic<5>             ;
    var ras_entry_value               : logic<32> [RAS_DEPTH];
    var ras_top_candidate             : logic<32> [RAS_DEPTH];
    var ras_mux_level0                : logic<32> [8]        ;
    var ras_mux_level1                : logic<32> [4]        ;
    var ras_mux_level2                : logic<32> [2]        ;
    var ras_base_prediction           : logic<32>            ;
    var ras_prediction                : logic<32>            ;
    var committed_ras_write_valid     : logic                ;
    var committed_ras_write_address   : logic<4>             ;
    var speculative_ras_write_valid   : logic                ;
    var speculative_ras_write_address : logic<4>             ;
    var recovery_ras_write_valid      : logic                ;
    var recovery_ras_write_address    : logic<4>             ;

    inst btb: BranchTargetBuffer #(
        SCRUB_ON_RESET: SCRUB_ON_RESET,
    ) (
        clk             : clk                          ,
        rst_n           : rst_n                        ,
        ready           : btb_ready                    ,
        lookup_valid    : request_fire                 ,
        lookup_token    : issue_token                  ,
        lookup_pc       : issue_pc                     ,
        response_accept : table_response_accept        ,
        response_cancel : table_response_cancel        ,
        rollback_valid  : decision_replacement_rollback,
        rollback_set    : decision_btb_set_q           ,
        rollback_data   : decision_btb_plru_q          ,
        response_valid  : btb_response_valid           ,
        response_token  : btb_response_token           ,
        response_hit    : btb_response_hit             ,
        response_kind   : btb_response_kind            ,
        response_target : btb_response_target          ,
        response_way    : btb_response_way             ,
        response_plru   : btb_response_plru            ,
        update_valid    : btb_update_valid             ,
        update_pc       : retire_pc                    ,
        update_kind     : retire_kind                  ,
        update_target   : retire_target                ,
        update_way      : btb_update_way               ,
        invalidate_valid: btb_invalidate_valid         ,
        invalidate_pc   : retire_pc                    ,
        invalidate_way  : retire_slot_btb_way          ,
    );

    // The exact port list is intentionally flat: this keeps every BRAM address
    // and token visible to Struo's memory recognizer.
    inst tage: TageDirectionPredictor #(
        SCRUB_ON_RESET: SCRUB_ON_RESET,
    ) (
        clk                    : clk                         ,
        rst_n                  : rst_n                       ,
        ready                  : tage_ready                  ,
        lookup_valid           : request_fire                ,
        lookup_token           : issue_token                 ,
        snapshot_token         : allocation_token_q          ,
        lookup_pc              : issue_pc                    ,
        lookup_index_0         : tage_lookup_index_0         ,
        lookup_index_1         : tage_lookup_index_1         ,
        lookup_index_2         : tage_lookup_index_2         ,
        lookup_index_3         : tage_lookup_index_3         ,
        lookup_tag_0           : tage_lookup_tag_0           ,
        lookup_tag_1           : tage_lookup_tag_1           ,
        lookup_tag_2           : tage_lookup_tag_2           ,
        lookup_tag_3           : tage_lookup_tag_3           ,
        response_accept        : table_response_accept       ,
        response_cancel        : table_response_cancel       ,
        response_valid         : tage_response_valid         ,
        response_token         : tage_response_token         ,
        response_taken         : tage_response_taken         ,
        response_hit           : tage_response_hit           ,
        response_match_metadata: tage_response_match_metadata,
        response_weak_metadata : tage_response_weak_metadata ,
        response_pred_metadata : tage_response_pred_metadata ,
        update_valid           : tage_update_valid           ,
        update_token           : retire_token                ,
        update_taken           : retire_taken                ,
        release_valid          : retire_valid                ,
        release_token          : retire_token                ,
        squash_valid           : decision_squash             ,
        squash_token           : decision_token_q            ,
        flush_slots            : tage_flush_slots            ,
    );

    always_comb {
        // Classification for scalar control/cancellation.
        decision_control_provider_oh[4] = decision_match_q[3];
        decision_control_provider_oh[3] = !decision_match_q[3] && decision_match_q[2];
        decision_control_provider_oh[2] = !decision_match_q[3] && !decision_match_q[2] && decision_match_q[1];
        decision_control_provider_oh[1] = !decision_match_q[3] && !decision_match_q[2] && !decision_match_q[1]
            && decision_match_q[0];
        decision_control_provider_oh[0] = !(decision_match_q[0] || decision_match_q[1] || decision_match_q[2]
            || decision_match_q[3]);
        decision_control_alt_oh[4]      = 1'b0;
        decision_control_alt_oh[3]      = decision_match_q[3] && decision_match_q[2];
        decision_control_alt_oh[2]      = decision_match_q[1] && (decision_match_q[3] ^ decision_match_q[2]);
        decision_control_alt_oh[1]      = decision_match_q[0]
            && ((decision_match_q[1] && !decision_match_q[2] && !decision_match_q[3])
                || (!decision_match_q[1] && decision_match_q[2] && !decision_match_q[3])
                || (!decision_match_q[1] && !decision_match_q[2] && decision_match_q[3]));
        decision_control_alt_oh[0]      = !(decision_control_alt_oh[1] || decision_control_alt_oh[2]
            || decision_control_alt_oh[3]);
        decision_control_lm_pred        = (decision_control_provider_oh[0] && decision_pred_q[0])
            || (decision_control_provider_oh[1] && decision_pred_q[1])
            || (decision_control_provider_oh[2] && decision_pred_q[2])
            || (decision_control_provider_oh[3] && decision_pred_q[3])
            || (decision_control_provider_oh[4] && decision_pred_q[4]);
        decision_control_alt_pred       = (decision_control_alt_oh[0] && decision_pred_q[0])
            || (decision_control_alt_oh[1] && decision_pred_q[1]) || (decision_control_alt_oh[2] && decision_pred_q[2])
            || (decision_control_alt_oh[3] && decision_pred_q[3]) || (decision_control_alt_oh[4] && decision_pred_q[4]);
        decision_control_weak           = (decision_control_provider_oh[1] && decision_weak_q[0])
            || (decision_control_provider_oh[2] && decision_weak_q[1])
            || (decision_control_provider_oh[3] && decision_weak_q[2])
            || (decision_control_provider_oh[4] && decision_weak_q[3]);
        decision_control_tage_pred      = decision_control_lm_pred;
        if !decision_control_provider_oh[0] && decision_control_weak {
            decision_control_tage_pred = decision_control_alt_pred;
        }
        decision_control_taken = decision_btb_hit_q;
        if decision_kind_q == 3'd1 {
            decision_control_taken = decision_btb_hit_q && decision_control_tage_pred;
        }
        decision_control_tage_hit = decision_btb_hit_q && (decision_kind_q == 3'd1)
            && (decision_match_q[0] || decision_match_q[1] || decision_match_q[2] || decision_match_q[3]);

        // A deliberately separate copy drives only the wide next-PC mux.
        decision_pc_provider_oh[4] = decision_match_q[3];
        decision_pc_provider_oh[3] = !decision_match_q[3] && decision_match_q[2];
        decision_pc_provider_oh[2] = !decision_match_q[3] && !decision_match_q[2] && decision_match_q[1];
        decision_pc_provider_oh[1] = !decision_match_q[3] && !decision_match_q[2] && !decision_match_q[1]
            && decision_match_q[0];
        decision_pc_provider_oh[0] = !(decision_match_q[0] || decision_match_q[1] || decision_match_q[2]
            || decision_match_q[3]);
        decision_pc_alt_oh[4]      = 1'b0;
        decision_pc_alt_oh[3]      = decision_match_q[3] && decision_match_q[2];
        decision_pc_alt_oh[2]      = decision_match_q[1] && (decision_match_q[3] ^ decision_match_q[2]);
        decision_pc_alt_oh[1]      = decision_match_q[0]
            && ((decision_match_q[1] && !decision_match_q[2] && !decision_match_q[3])
                || (!decision_match_q[1] && decision_match_q[2] && !decision_match_q[3])
                || (!decision_match_q[1] && !decision_match_q[2] && decision_match_q[3]));
        decision_pc_alt_oh[0]      = !(decision_pc_alt_oh[1] || decision_pc_alt_oh[2] || decision_pc_alt_oh[3]);
        decision_pc_lm_pred        = (decision_pc_provider_oh[0] && decision_pred_q[0])
            || (decision_pc_provider_oh[1] && decision_pred_q[1]) || (decision_pc_provider_oh[2] && decision_pred_q[2])
            || (decision_pc_provider_oh[3] && decision_pred_q[3]) || (decision_pc_provider_oh[4] && decision_pred_q[4]);
        decision_pc_alt_pred       = (decision_pc_alt_oh[0] && decision_pred_q[0])
            || (decision_pc_alt_oh[1] && decision_pred_q[1]) || (decision_pc_alt_oh[2] && decision_pred_q[2])
            || (decision_pc_alt_oh[3] && decision_pred_q[3]) || (decision_pc_alt_oh[4] && decision_pred_q[4]);
        decision_pc_weak           = (decision_pc_provider_oh[1] && decision_weak_q[0])
            || (decision_pc_provider_oh[2] && decision_weak_q[1]) || (decision_pc_provider_oh[3] && decision_weak_q[2])
            || (decision_pc_provider_oh[4] && decision_weak_q[3]);
        decision_pc_tage_pred      = decision_pc_lm_pred;
        if !decision_pc_provider_oh[0] && decision_pc_weak {
            decision_pc_tage_pred = decision_pc_alt_pred;
        }
        decision_pc_taken = decision_btb_hit_q;
        if decision_kind_q == 3'd1 {
            decision_pc_taken = decision_btb_hit_q && decision_pc_tage_pred;
        }

        // History has its own small provider cone so it never returns from the
        // wide next-PC/control placement region to the folded-history FFs.
        decision_history_provider_oh[4] = decision_match_q[3];
        decision_history_provider_oh[3] = !decision_match_q[3] && decision_match_q[2];
        decision_history_provider_oh[2] = !decision_match_q[3] && !decision_match_q[2] && decision_match_q[1];
        decision_history_provider_oh[1] = !decision_match_q[3] && !decision_match_q[2] && !decision_match_q[1]
            && decision_match_q[0];
        decision_history_provider_oh[0] = !(decision_match_q[0] || decision_match_q[1] || decision_match_q[2]
            || decision_match_q[3]);
        decision_history_alt_oh[4]      = 1'b0;
        decision_history_alt_oh[3]      = decision_match_q[3] && decision_match_q[2];
        decision_history_alt_oh[2]      = decision_match_q[1] && (decision_match_q[3] ^ decision_match_q[2]);
        decision_history_alt_oh[1]      = decision_match_q[0]
            && ((decision_match_q[1] && !decision_match_q[2] && !decision_match_q[3])
                || (!decision_match_q[1] && decision_match_q[2] && !decision_match_q[3])
                || (!decision_match_q[1] && !decision_match_q[2] && decision_match_q[3]));
        decision_history_alt_oh[0]      = !(decision_history_alt_oh[1] || decision_history_alt_oh[2]
            || decision_history_alt_oh[3]);
        decision_history_lm_pred        = (decision_history_provider_oh[0] && decision_pred_q[0])
            || (decision_history_provider_oh[1] && decision_pred_q[1])
            || (decision_history_provider_oh[2] && decision_pred_q[2])
            || (decision_history_provider_oh[3] && decision_pred_q[3])
            || (decision_history_provider_oh[4] && decision_pred_q[4]);
        decision_history_alt_pred       = (decision_history_alt_oh[0] && decision_pred_q[0])
            || (decision_history_alt_oh[1] && decision_pred_q[1]) || (decision_history_alt_oh[2] && decision_pred_q[2])
            || (decision_history_alt_oh[3] && decision_pred_q[3]) || (decision_history_alt_oh[4] && decision_pred_q[4]);
        decision_history_weak           = (decision_history_provider_oh[1] && decision_weak_q[0])
            || (decision_history_provider_oh[2] && decision_weak_q[1])
            || (decision_history_provider_oh[3] && decision_weak_q[2])
            || (decision_history_provider_oh[4] && decision_weak_q[3]);
        decision_history_tage_pred      = decision_history_lm_pred;
        if !decision_history_provider_oh[0] && decision_history_weak {
            decision_history_tage_pred = decision_history_alt_pred;
        }
        decision_history_taken = decision_btb_hit_q;
        if decision_kind_q == 3'd1 {
            decision_history_taken = decision_btb_hit_q && decision_history_tage_pred;
        }

        ready = btb_ready && tage_ready;
        // Backend recovery discards the outstanding younger lookup even
        // though Core must not accept it as an architectural prediction.
        tables_response_valid = btb_response_valid && tage_response_valid
            && (btb_response_token == tage_response_token);
        // Only a direction that has crossed the classifier register may
        // control the raw table handshake.  By then one metadata packet can
        // be waiting in the elastic decision stage and one further table
        // lookup can be outstanding; both are wrong-path fall-through
        // shadows and are discarded together below.
        // Recovery/discard pops the outstanding raw response without admitting
        // it into the decision queue.  Mark that pop as cancellation as well,
        // so neither the BTB replacement state nor a TAGE training snapshot is
        // provisionally claimed by a lookup which the wrapper is flushing.
        table_response_cancel   = (output_valid_q && output_taken_q) || recover_valid || discard_all;
        cancelled_response      = tables_response_valid && table_response_cancel;
        selected_response_valid = tables_response_valid && !table_response_cancel;
        // Both one-entry pipeline stages support simultaneous pop/push.  The
        // metadata bits feed only the classified output/history registers;
        // readiness, raw table pop, and lookup launch depend on valid bits and
        // the already-registered output direction.
        output_ready    = !output_valid_q || response_accept;
        decision_squash = decision_valid_q && output_valid_q && output_taken_q;
        // A metadata packet has already advanced the BTB PLRU when it entered
        // the decision queue.  If recovery/discard removes that packet before
        // it becomes externally visible, restore the saved pre-claim bit.  This
        // deliberately covers only the latest internal reservation; accepted
        // predictions retain speculative replacement-state policy.
        decision_replacement_rollback = decision_squash || (decision_valid_q && (recover_valid || discard_all));
        // A registered BTB miss needs neither provider classification nor an
        // additional output register.  It may become the ordered response
        // only when no older output exists; the decision register itself then
        // supplies stable backpressure storage.
        decision_fast_miss   = decision_valid_q && !decision_btb_hit_q && !output_valid_q;
        fast_miss_accept     = decision_fast_miss && response_accept && !recover_valid && !discard_all;
        decision_promote     = decision_valid_q && decision_btb_hit_q && output_ready && !decision_squash
            && !recover_valid && !discard_all;
        decision_ready       = !decision_valid_q || decision_promote || fast_miss_accept || decision_squash;
        raw_response_capture = selected_response_valid && decision_ready && !recover_valid && !discard_all;
        // A shadow fall-through response is never exposed.  Its cancellation
        // consumes both table responses, but deliberately does not admit a
        // replacement request on that same edge; the target launches after
        // the cancellation has removed this control path from the table CEs.
        table_response_accept = raw_response_capture || cancelled_response || recover_valid || discard_all;
        // Both synchronous tables must accept exactly the same request.  A
        // held response may be replaced only when the consumer accepts it;
        // recovery/discard clears the old response without admitting a lookup
        // hashed from the pre-recovery speculative state on that same edge.
        //
        // `issue_ready` is deliberately separate from the public request
        // handshake.  The one-entry ingress can absorb a fetch request while
        // the table response is held, then issue it once the table pair is
        // available.  When an ingress entry issues on this edge, it is also
        // legal to enqueue the next request on the same edge.
        issue_ready   = btb_ready && tage_ready && !recover_valid && !discard_all && !(output_valid_q && output_taken_q)
            && ((!btb_response_valid && !tage_response_valid) || raw_response_capture);
        request_fire  = ingress_valid_q && issue_ready;
        ingress_ready = !ingress_valid_q || request_fire;
        // Keep reset-scrub behavior identical to the pre-ingress interface:
        // requests are not acknowledged until both table memories are ready.
        // The S0 entry hides normal response backpressure, not initialization.
        request_ready  = btb_ready && tage_ready && ingress_ready && !recover_valid && !discard_all
            && !(output_valid_q && output_taken_q);
        ingress_accept = request_valid && request_ready;
        request_accept = ingress_accept;
        // The table token only proves that the BTB and TAGE results belong to
        // the same physical lookup.  Claim the next architectural snapshot
        // only when that result becomes a visible decision.
        selected_response_token        = allocation_token_q;
        selected_response_kind         = 3'd0;
        selected_response_target       = btb_response_target;
        selected_response_btb_hit      = btb_response_hit;
        selected_response_ras_fallback = 1'b0;

        // speculative_sp_q points at the next push word, so rotate the
        // sixteen effective entries once and select the preceding word by the
        // pointer bits.  Keep this as an explicit four-level tree: Struo's
        // current lowering otherwise turns the loop of equalities into a
        // fifteen-deep priority mux on every RAS payload bit.
        for entry in 0..RAS_DEPTH {
            ras_entry_value[entry] = committed_ras_q[entry];
            if speculative_ras_valid_q[entry] {
                ras_entry_value[entry] = speculative_ras_data_q[entry];
            }
        }
        ras_top_candidate[0] = ras_entry_value[15];
        for entry in 1..RAS_DEPTH {
            ras_top_candidate[entry] = ras_entry_value[entry - 1];
        }
        for pair in 0..8 {
            if speculative_sp_q[0] {
                ras_mux_level0[pair] = ras_top_candidate[pair * 2 + 1];
            } else {
                ras_mux_level0[pair] = ras_top_candidate[pair * 2];
            }
        }
        for pair in 0..4 {
            if speculative_sp_q[1] {
                ras_mux_level1[pair] = ras_mux_level0[pair * 2 + 1];
            } else {
                ras_mux_level1[pair] = ras_mux_level0[pair * 2];
            }
        }
        for pair in 0..2 {
            if speculative_sp_q[2] {
                ras_mux_level2[pair] = ras_mux_level1[pair * 2 + 1];
            } else {
                ras_mux_level2[pair] = ras_mux_level1[pair * 2];
            }
        }
        if speculative_sp_q[3] {
            ras_base_prediction = ras_mux_level2[1];
        } else {
            ras_base_prediction = ras_mux_level2[0];
        }
        // The saved post-recovery SP identifies when the recovered word is
        // currently at the top.  This four-bit equality replaces both a
        // subtractor and sixteen address comparisons on the RAS read path.
        ras_prediction = ras_base_prediction;
        if recovery_ras_overlay_valid_q && (recovery_ras_overlay_top_sp_q == speculative_sp_q) {
            ras_prediction = recovery_ras_overlay_data_q;
        }
        if btb_response_hit {
            selected_response_kind = btb_response_kind;
            case btb_response_kind {
                3'd5, 3'd6: {
                    if speculative_count_q != 5'd0 {
                        selected_response_target = ras_prediction;
                    } else {
                        selected_response_ras_fallback = 1'b1;
                    }
                }
                default: {}
            }
        }

        // The fetch instruction, rather than mutable/aliased BTB metadata,
        // decides whether this dynamic instruction contributes to the GHR.
        // decision_effect_taken is the effective frontend direction: the fast
        // miss path is explicitly not-taken, while a stale taken-class entry
        // follows its predicted target and appends taken until recovery.
        apply_decision_effect = decision_promote || fast_miss_accept;
        decision_effect_taken = decision_history_taken;
        if fast_miss_accept {
            decision_effect_taken = 1'b0;
        }
        append_prediction         = apply_decision_effect && decision_conditional_q;
        launch_conditional_shadow = raw_response_capture && response_conditional_q;
        append_commit             = retire_valid && (retire_kind == 3'd1);
        recover_is_retire         = recover_valid && retire_valid && (recover_token == retire_token);

        retire_slot_valid              = 1'b0;
        retire_slot_taken              = 1'b0;
        retire_slot_btb_hit            = 1'b0;
        retire_slot_btb_way            = 1'b0;
        retire_slot_btb_identity_stale = 1'b0;
        retire_slot_ras_fallback       = 1'b0;
        for slot in 0..TOKEN_COUNT {
            if retire_token == slot as 3 {
                retire_slot_valid              = slot_valid_q[slot];
                retire_slot_taken              = slot_taken_q[slot];
                retire_slot_btb_hit            = slot_btb_hit_q[slot];
                retire_slot_btb_way            = slot_btb_way_q[slot];
                retire_slot_btb_identity_stale = slot_btb_identity_stale_q[slot];
                retire_slot_ras_fallback       = slot_ras_fallback_q[slot];
            }
        }

        conditional_resolved_event = append_commit;
        direction_wrong_event      = append_commit && retire_slot_valid && (retire_slot_taken != retire_taken);
        btb_miss_event             = retire_valid && (retire_kind != 3'd0) && retire_slot_valid && !retire_slot_btb_hit;
        ras_fallback_event         = retire_valid && retire_slot_valid
            && ((retire_kind == 3'd5) || (retire_kind == 3'd6)) && retire_slot_ras_fallback;

        btb_update_valid         = retire_valid && (retire_kind != 3'd0) && retire_slot_valid;
        btb_update_way           = retire_slot_btb_way;
        btb_invalidate_candidate = retire_valid && (retire_kind == 3'd0) && retire_slot_valid && retire_slot_btb_hit;
        // A younger stale-hit token may outlive an older control update that
        // replaces the same physical BTB word.  Preserve the hit/event
        // snapshot, but never let that token erase the replacement entry.
        btb_invalidate_valid          = btb_invalidate_candidate && !retire_slot_btb_identity_stale;
        btb_identity_mutation_valid   = btb_update_valid || btb_invalidate_valid;
        btb_response_identity_mutated = btb_identity_mutation_valid && btb_response_valid && btb_response_hit
            && (retire_pc[7:1] == response_btb_set_q) && (retire_slot_btb_way == btb_response_way);
        tage_update_valid             = append_commit && retire_slot_valid;
        // Current early recovery is non-conditional JAL/JALR, whose TAGE
        // snapshot is never trained; flush it together with all wrong-path
        // slots. A future early conditional resolver must retain its token
        // until retirement and therefore needs selective flush-except-token
        // support rather than changing this predicate to every recovery.
        tage_flush_slots = discard_all || (recover_valid && (recover_is_retire || (recover_kind != 3'd1)));

        // Hash the request from the speculative state *after* accepting the
        // preceding conditional response.  This is the feedback edge that a
        // naive two-cycle TAGE pipeline loses.
        tage_lookup_index_0 = issue_pc[9:1] ^ issue_index_fold.bank0;
        tage_lookup_index_1 = issue_pc[9:1] ^ issue_index_fold.bank1;
        tage_lookup_index_2 = issue_pc[9:1] ^ issue_index_fold.bank2;
        tage_lookup_index_3 = issue_pc[9:1] ^ issue_index_fold.bank3;
        // Fold all 31 halfword-PC bits into the table tag.  Using only the
        // low tag-width bits makes branches separated by a small power of two
        // indistinguishable whenever their histories match.
        request_pc_fold_8 = issue_pc[8:1] ^ issue_pc[16:9] ^ issue_pc[24:17] ^ {1'b0, issue_pc[31:25]};
        request_pc_fold_9 = issue_pc[9:1] ^ issue_pc[18:10] ^ issue_pc[27:19] ^ {5'd0, issue_pc[31:28]};
        tage_lookup_tag_0 = request_pc_fold_8 ^ issue_tag_a_fold.bank0[7:0] ^ {issue_tag_b_fold.bank0[6:0], 1'b0};
        tage_lookup_tag_1 = request_pc_fold_8 ^ issue_tag_a_fold.bank1[7:0] ^ {issue_tag_b_fold.bank1[6:0], 1'b0};
        tage_lookup_tag_2 = request_pc_fold_9 ^ issue_tag_a_fold.bank2 ^ {issue_tag_b_fold.bank2, 1'b0};
        tage_lookup_tag_3 = request_pc_fold_9 ^ issue_tag_a_fold.bank3 ^ {issue_tag_b_fold.bank3, 1'b0};

        // Output ports are leaves of the wrapper logic.  Internal state and
        // feedback consume the selected signals above, never the port nets.
        response_valid        = output_valid_q;
        response_token        = output_token_q;
        response_kind         = output_kind_q;
        response_taken        = output_taken_q;
        response_next_pc      = output_next_pc_q;
        response_btb_hit      = output_btb_hit_q;
        response_tage_hit     = output_tage_hit_q;
        response_ras_fallback = output_ras_fallback_q;
        if decision_fast_miss {
            response_valid        = 1'b1;
            response_token        = decision_token_q;
            response_kind         = 3'd0;
            response_taken        = 1'b0;
            response_next_pc      = decision_fallthrough_q;
            response_btb_hit      = 1'b0;
            response_tage_hit     = 1'b0;
            response_ras_fallback = 1'b0;
        }
    }

    // Only an accepted prediction can feed a same-edge lookup. At request time
    // we precompute and register that request's not-taken successor folds. A
    // taken successor differs only in bit zero of every fold, so the response
    // feedback path is one parallel XOR rather than BRAM -> provider -> full
    // rotate/fold -> next BRAM address. This preserves one lookup per clock.
    always_comb {
        prediction_history_next     = speculative_history_q;
        prediction_index_next.bank0 = speculative_index_q.bank0;
        prediction_index_next.bank1 = speculative_index_q.bank1;
        prediction_index_next.bank2 = speculative_index_q.bank2;
        prediction_index_next.bank3 = speculative_index_q.bank3;
        prediction_tag_a_next.bank0 = speculative_tag_a_q.bank0;
        prediction_tag_a_next.bank1 = speculative_tag_a_q.bank1;
        prediction_tag_a_next.bank2 = speculative_tag_a_q.bank2;
        prediction_tag_a_next.bank3 = speculative_tag_a_q.bank3;
        prediction_tag_b_next.bank0 = speculative_tag_b_q.bank0;
        prediction_tag_b_next.bank1 = speculative_tag_b_q.bank1;
        prediction_tag_b_next.bank2 = speculative_tag_b_q.bank2;
        prediction_tag_b_next.bank3 = speculative_tag_b_q.bank3;

        if append_prediction {
            prediction_history_next     = {speculative_history_q[106:0], decision_effect_taken};
            prediction_index_next.bank0 = decision_index_nt_q.bank0 ^ {8'd0, decision_effect_taken};
            prediction_index_next.bank1 = decision_index_nt_q.bank1 ^ {8'd0, decision_effect_taken};
            prediction_index_next.bank2 = decision_index_nt_q.bank2 ^ {8'd0, decision_effect_taken};
            prediction_index_next.bank3 = decision_index_nt_q.bank3 ^ {8'd0, decision_effect_taken};
            prediction_tag_a_next.bank0 = decision_tag_a_nt_q.bank0 ^ {8'd0, decision_effect_taken};
            prediction_tag_a_next.bank1 = decision_tag_a_nt_q.bank1 ^ {8'd0, decision_effect_taken};
            prediction_tag_a_next.bank2 = decision_tag_a_nt_q.bank2 ^ {8'd0, decision_effect_taken};
            prediction_tag_a_next.bank3 = decision_tag_a_nt_q.bank3 ^ {8'd0, decision_effect_taken};
            prediction_tag_b_next.bank0 = decision_tag_b_nt_q.bank0 ^ {7'd0, decision_effect_taken};
            prediction_tag_b_next.bank1 = decision_tag_b_nt_q.bank1 ^ {7'd0, decision_effect_taken};
            prediction_tag_b_next.bank2 = decision_tag_b_nt_q.bank2 ^ {7'd0, decision_effect_taken};
            prediction_tag_b_next.bank3 = decision_tag_b_nt_q.bank3 ^ {7'd0, decision_effect_taken};
        }

        // A same-edge replacement always names the sequential fall-through.
        // Hash it with the registered not-taken successor, independent of the
        // accepted branch's prediction.  The architectural speculative state
        // above still advances with the actual prediction for a later target
        // request after a canceled shadow response.
        lookup_index_fold.bank0 = prediction_index_next.bank0;
        lookup_index_fold.bank1 = prediction_index_next.bank1;
        lookup_index_fold.bank2 = prediction_index_next.bank2;
        lookup_index_fold.bank3 = prediction_index_next.bank3;
        lookup_tag_a_fold.bank0 = prediction_tag_a_next.bank0;
        lookup_tag_a_fold.bank1 = prediction_tag_a_next.bank1;
        lookup_tag_a_fold.bank2 = prediction_tag_a_next.bank2;
        lookup_tag_a_fold.bank3 = prediction_tag_a_next.bank3;
        lookup_tag_b_fold.bank0 = prediction_tag_b_next.bank0;
        lookup_tag_b_fold.bank1 = prediction_tag_b_next.bank1;
        lookup_tag_b_fold.bank2 = prediction_tag_b_next.bank2;
        lookup_tag_b_fold.bank3 = prediction_tag_b_next.bank3;
        if launch_conditional_shadow {
            lookup_index_fold.bank0 = response_index_nt_q.bank0;
            lookup_index_fold.bank1 = response_index_nt_q.bank1;
            lookup_index_fold.bank2 = response_index_nt_q.bank2;
            lookup_index_fold.bank3 = response_index_nt_q.bank3;
            lookup_tag_a_fold.bank0 = response_tag_a_nt_q.bank0;
            lookup_tag_a_fold.bank1 = response_tag_a_nt_q.bank1;
            lookup_tag_a_fold.bank2 = response_tag_a_nt_q.bank2;
            lookup_tag_a_fold.bank3 = response_tag_a_nt_q.bank3;
            lookup_tag_b_fold.bank0 = response_tag_b_nt_q.bank0;
            lookup_tag_b_fold.bank1 = response_tag_b_nt_q.bank1;
            lookup_tag_b_fold.bank2 = response_tag_b_nt_q.bank2;
            lookup_tag_b_fold.bank3 = response_tag_b_nt_q.bank3;
        }

        // The accepted request carries a not-taken preview of its successor
        // folds. For a continuous conditional stream, derive that preview
        // from the preceding request's registered preview: the preceding
        // outcome is now bit one and the outgoing bit is L-2.
        request_index_nt.bank0 = {prediction_index_next.bank0[7:0], prediction_index_next.bank0[8]}
            ^ {4'd0, prediction_history_next[3], 4'd0};
        request_index_nt.bank1 = {prediction_index_next.bank1[7:0], prediction_index_next.bank1[8]}
            ^ {5'd0, prediction_history_next[11], 3'd0};
        request_index_nt.bank2 = {prediction_index_next.bank2[7:0], prediction_index_next.bank2[8]}
            ^ {8'd0, prediction_history_next[35]};
        request_index_nt.bank3 = {prediction_index_next.bank3[7:0], prediction_index_next.bank3[8]}
            ^ {8'd0, prediction_history_next[107]};
        request_tag_a_nt.bank0 = {1'b0, prediction_tag_a_next.bank0[6:0], prediction_tag_a_next.bank0[7]}
            ^ {4'd0, prediction_history_next[3], 4'd0};
        request_tag_a_nt.bank1 = {1'b0, prediction_tag_a_next.bank1[6:0], prediction_tag_a_next.bank1[7]}
            ^ {4'd0, prediction_history_next[11], 4'd0};
        request_tag_a_nt.bank2 = {prediction_tag_a_next.bank2[7:0], prediction_tag_a_next.bank2[8]}
            ^ {8'd0, prediction_history_next[35]};
        request_tag_a_nt.bank3 = {prediction_tag_a_next.bank3[7:0], prediction_tag_a_next.bank3[8]}
            ^ {8'd0, prediction_history_next[107]};
        request_tag_b_nt.bank0 = {1'b0, prediction_tag_b_next.bank0[5:0], prediction_tag_b_next.bank0[6]}
            ^ {3'd0, prediction_history_next[3], 4'd0};
        request_tag_b_nt.bank1 = {1'b0, prediction_tag_b_next.bank1[5:0], prediction_tag_b_next.bank1[6]}
            ^ {2'd0, prediction_history_next[11], 5'd0};
        request_tag_b_nt.bank2 = {prediction_tag_b_next.bank2[6:0], prediction_tag_b_next.bank2[7]}
            ^ {3'd0, prediction_history_next[35], 4'd0};
        request_tag_b_nt.bank3 = {prediction_tag_b_next.bank3[6:0], prediction_tag_b_next.bank3[7]}
            ^ {3'd0, prediction_history_next[107], 4'd0};

        if launch_conditional_shadow {
            request_index_nt.bank0 = {response_index_nt_q.bank0[7:0], response_index_nt_q.bank0[8]}
                ^ {4'd0, prediction_history_next[2], 4'd0};
            request_index_nt.bank1 = {response_index_nt_q.bank1[7:0], response_index_nt_q.bank1[8]}
                ^ {5'd0, prediction_history_next[10], 3'd0};
            request_index_nt.bank2 = {response_index_nt_q.bank2[7:0], response_index_nt_q.bank2[8]}
                ^ {8'd0, prediction_history_next[34]};
            request_index_nt.bank3 = {response_index_nt_q.bank3[7:0], response_index_nt_q.bank3[8]}
                ^ {8'd0, prediction_history_next[106]};
            request_tag_a_nt.bank0 = {1'b0, response_tag_a_nt_q.bank0[6:0], response_tag_a_nt_q.bank0[7]}
                ^ {4'd0, prediction_history_next[2], 4'd0};
            request_tag_a_nt.bank1 = {1'b0, response_tag_a_nt_q.bank1[6:0], response_tag_a_nt_q.bank1[7]}
                ^ {4'd0, prediction_history_next[10], 4'd0};
            request_tag_a_nt.bank2 = {response_tag_a_nt_q.bank2[7:0], response_tag_a_nt_q.bank2[8]}
                ^ {8'd0, prediction_history_next[34]};
            request_tag_a_nt.bank3 = {response_tag_a_nt_q.bank3[7:0], response_tag_a_nt_q.bank3[8]}
                ^ {8'd0, prediction_history_next[106]};
            request_tag_b_nt.bank0 = {1'b0, response_tag_b_nt_q.bank0[5:0], response_tag_b_nt_q.bank0[6]}
                ^ {3'd0, prediction_history_next[2], 4'd0};
            request_tag_b_nt.bank1 = {1'b0, response_tag_b_nt_q.bank1[5:0], response_tag_b_nt_q.bank1[6]}
                ^ {2'd0, prediction_history_next[10], 5'd0};
            request_tag_b_nt.bank2 = {response_tag_b_nt_q.bank2[6:0], response_tag_b_nt_q.bank2[7]}
                ^ {3'd0, prediction_history_next[34], 4'd0};
            request_tag_b_nt.bank3 = {response_tag_b_nt_q.bank3[6:0], response_tag_b_nt_q.bank3[7]}
                ^ {3'd0, prediction_history_next[106], 4'd0};
        }

    }

    // S0 captures the history frontier that was visible when the fetch side
    // accepted the request.  If an older response is applied while the packet
    // waits, its speculative history becomes newer before this packet can
    // issue.  Rebase only the folded-history fields in that case; the packet,
    // physical token, and its PC remain the registered S0 transaction.  This
    // preserves the old one-request-per-clock lookup semantics across the new
    // enqueue/issue boundary without rewriting the wide S0 payload on every
    // cycle.
    always_comb {
        issue_pc               = ingress_q.pc;
        issue_fallthrough      = ingress_q.fallthrough;
        issue_is_conditional   = ingress_q.is_conditional;
        issue_token            = ingress_q.token;
        issue_index_fold.bank0 = ingress_q.index_fold.bank0;
        issue_index_fold.bank1 = ingress_q.index_fold.bank1;
        issue_index_fold.bank2 = ingress_q.index_fold.bank2;
        issue_index_fold.bank3 = ingress_q.index_fold.bank3;
        issue_tag_a_fold.bank0 = ingress_q.tag_a_fold.bank0;
        issue_tag_a_fold.bank1 = ingress_q.tag_a_fold.bank1;
        issue_tag_a_fold.bank2 = ingress_q.tag_a_fold.bank2;
        issue_tag_a_fold.bank3 = ingress_q.tag_a_fold.bank3;
        issue_tag_b_fold.bank0 = ingress_q.tag_b_fold.bank0;
        issue_tag_b_fold.bank1 = ingress_q.tag_b_fold.bank1;
        issue_tag_b_fold.bank2 = ingress_q.tag_b_fold.bank2;
        issue_tag_b_fold.bank3 = ingress_q.tag_b_fold.bank3;
        issue_index_nt.bank0   = ingress_q.index_nt.bank0;
        issue_index_nt.bank1   = ingress_q.index_nt.bank1;
        issue_index_nt.bank2   = ingress_q.index_nt.bank2;
        issue_index_nt.bank3   = ingress_q.index_nt.bank3;
        issue_tag_a_nt.bank0   = ingress_q.tag_a_nt.bank0;
        issue_tag_a_nt.bank1   = ingress_q.tag_a_nt.bank1;
        issue_tag_a_nt.bank2   = ingress_q.tag_a_nt.bank2;
        issue_tag_a_nt.bank3   = ingress_q.tag_a_nt.bank3;
        issue_tag_b_nt.bank0   = ingress_q.tag_b_nt.bank0;
        issue_tag_b_nt.bank1   = ingress_q.tag_b_nt.bank1;
        issue_tag_b_nt.bank2   = ingress_q.tag_b_nt.bank2;
        issue_tag_b_nt.bank3   = ingress_q.tag_b_nt.bank3;
        if append_prediction || launch_conditional_shadow {
            issue_index_fold.bank0 = lookup_index_fold.bank0;
            issue_index_fold.bank1 = lookup_index_fold.bank1;
            issue_index_fold.bank2 = lookup_index_fold.bank2;
            issue_index_fold.bank3 = lookup_index_fold.bank3;
            issue_tag_a_fold.bank0 = lookup_tag_a_fold.bank0;
            issue_tag_a_fold.bank1 = lookup_tag_a_fold.bank1;
            issue_tag_a_fold.bank2 = lookup_tag_a_fold.bank2;
            issue_tag_a_fold.bank3 = lookup_tag_a_fold.bank3;
            issue_tag_b_fold.bank0 = lookup_tag_b_fold.bank0;
            issue_tag_b_fold.bank1 = lookup_tag_b_fold.bank1;
            issue_tag_b_fold.bank2 = lookup_tag_b_fold.bank2;
            issue_tag_b_fold.bank3 = lookup_tag_b_fold.bank3;
            issue_index_nt.bank0   = request_index_nt.bank0;
            issue_index_nt.bank1   = request_index_nt.bank1;
            issue_index_nt.bank2   = request_index_nt.bank2;
            issue_index_nt.bank3   = request_index_nt.bank3;
            issue_tag_a_nt.bank0   = request_tag_a_nt.bank0;
            issue_tag_a_nt.bank1   = request_tag_a_nt.bank1;
            issue_tag_a_nt.bank2   = request_tag_a_nt.bank2;
            issue_tag_a_nt.bank3   = request_tag_a_nt.bank3;
            issue_tag_b_nt.bank0   = request_tag_b_nt.bank0;
            issue_tag_b_nt.bank1   = request_tag_b_nt.bank1;
            issue_tag_b_nt.bank2   = request_tag_b_nt.bank2;
            issue_tag_b_nt.bank3   = request_tag_b_nt.bank3;
        }
    }

    // GHR and all folded histories share one explicit architectural
    // next-state block.  The constants are L modulo fold width for
    // L={4,12,36,108}.
    always_comb {
        speculative_history_next = prediction_history_next;
        committed_history_next   = committed_history_q;
        speculative_index_next   = prediction_index_next;
        committed_index_next     = committed_index_q;
        speculative_tag_a_next   = prediction_tag_a_next;
        committed_tag_a_next     = committed_tag_a_q;
        speculative_tag_b_next   = prediction_tag_b_next;
        committed_tag_b_next     = committed_tag_b_q;

        if append_commit {
            committed_history_next     = {committed_history_q[106:0], retire_taken};
            committed_index_next.bank0 = {committed_index_q.bank0[7:0], committed_index_q.bank0[8]}
                ^ {8'd0, retire_taken} ^ {4'd0, committed_history_q[3], 4'd0};
            committed_index_next.bank1 = {committed_index_q.bank1[7:0], committed_index_q.bank1[8]}
                ^ {8'd0, retire_taken} ^ {5'd0, committed_history_q[11], 3'd0};
            committed_index_next.bank2 = {committed_index_q.bank2[7:0], committed_index_q.bank2[8]}
                ^ {8'd0, retire_taken} ^ {8'd0, committed_history_q[35]};
            committed_index_next.bank3 = {committed_index_q.bank3[7:0], committed_index_q.bank3[8]}
                ^ {8'd0, retire_taken} ^ {8'd0, committed_history_q[107]};

            committed_tag_a_next.bank0 = {1'b0, committed_tag_a_q.bank0[6:0], committed_tag_a_q.bank0[7]}
                ^ {8'd0, retire_taken} ^ {4'd0, committed_history_q[3], 4'd0};
            committed_tag_a_next.bank1 = {1'b0, committed_tag_a_q.bank1[6:0], committed_tag_a_q.bank1[7]}
                ^ {8'd0, retire_taken} ^ {4'd0, committed_history_q[11], 4'd0};
            committed_tag_a_next.bank2 = {committed_tag_a_q.bank2[7:0], committed_tag_a_q.bank2[8]}
                ^ {8'd0, retire_taken} ^ {8'd0, committed_history_q[35]};
            committed_tag_a_next.bank3 = {committed_tag_a_q.bank3[7:0], committed_tag_a_q.bank3[8]}
                ^ {8'd0, retire_taken} ^ {8'd0, committed_history_q[107]};

            committed_tag_b_next.bank0 = {1'b0, committed_tag_b_q.bank0[5:0], committed_tag_b_q.bank0[6]}
                ^ {7'd0, retire_taken} ^ {3'd0, committed_history_q[3], 4'd0};
            committed_tag_b_next.bank1 = {1'b0, committed_tag_b_q.bank1[5:0], committed_tag_b_q.bank1[6]}
                ^ {7'd0, retire_taken} ^ {2'd0, committed_history_q[11], 5'd0};
            committed_tag_b_next.bank2 = {committed_tag_b_q.bank2[6:0], committed_tag_b_q.bank2[7]}
                ^ {7'd0, retire_taken} ^ {3'd0, committed_history_q[35], 4'd0};
            committed_tag_b_next.bank3 = {committed_tag_b_q.bank3[6:0], committed_tag_b_q.bank3[7]}
                ^ {7'd0, retire_taken} ^ {3'd0, committed_history_q[107], 4'd0};
        }

        if recover_valid || discard_all {
            speculative_history_next = committed_history_next;
            speculative_index_next   = committed_index_next;
            speculative_tag_a_next   = committed_tag_a_next;
            speculative_tag_b_next   = committed_tag_b_next;
            // A conditional resolved in CM is already present in the
            // committed-next state.  This clause covers a future earlier
            // conditional resolver without appending the same outcome twice.
            if recover_valid && !recover_is_retire && (recover_kind == 3'd1) {
                speculative_history_next     = {committed_history_next[106:0], recover_taken};
                speculative_index_next.bank0 = {committed_index_next.bank0[7:0], committed_index_next.bank0[8]}
                    ^ {8'd0, recover_taken} ^ {4'd0, committed_history_next[3], 4'd0};
                speculative_index_next.bank1 = {committed_index_next.bank1[7:0], committed_index_next.bank1[8]}
                    ^ {8'd0, recover_taken} ^ {5'd0, committed_history_next[11], 3'd0};
                speculative_index_next.bank2 = {committed_index_next.bank2[7:0], committed_index_next.bank2[8]}
                    ^ {8'd0, recover_taken} ^ {8'd0, committed_history_next[35]};
                speculative_index_next.bank3 = {committed_index_next.bank3[7:0], committed_index_next.bank3[8]}
                    ^ {8'd0, recover_taken} ^ {8'd0, committed_history_next[107]};

                speculative_tag_a_next.bank0 = {1'b0, committed_tag_a_next.bank0[6:0], committed_tag_a_next.bank0[7]}
                    ^ {8'd0, recover_taken} ^ {4'd0, committed_history_next[3], 4'd0};
                speculative_tag_a_next.bank1 = {1'b0, committed_tag_a_next.bank1[6:0], committed_tag_a_next.bank1[7]}
                    ^ {8'd0, recover_taken} ^ {4'd0, committed_history_next[11], 4'd0};
                speculative_tag_a_next.bank2 = {committed_tag_a_next.bank2[7:0], committed_tag_a_next.bank2[8]}
                    ^ {8'd0, recover_taken} ^ {8'd0, committed_history_next[35]};
                speculative_tag_a_next.bank3 = {committed_tag_a_next.bank3[7:0], committed_tag_a_next.bank3[8]}
                    ^ {8'd0, recover_taken} ^ {8'd0, committed_history_next[107]};

                speculative_tag_b_next.bank0 = {1'b0, committed_tag_b_next.bank0[5:0], committed_tag_b_next.bank0[6]}
                    ^ {7'd0, recover_taken} ^ {3'd0, committed_history_next[3], 4'd0};
                speculative_tag_b_next.bank1 = {1'b0, committed_tag_b_next.bank1[5:0], committed_tag_b_next.bank1[6]}
                    ^ {7'd0, recover_taken} ^ {2'd0, committed_history_next[11], 5'd0};
                speculative_tag_b_next.bank2 = {committed_tag_b_next.bank2[6:0], committed_tag_b_next.bank2[7]}
                    ^ {7'd0, recover_taken} ^ {3'd0, committed_history_next[35], 4'd0};
                speculative_tag_b_next.bank3 = {committed_tag_b_next.bank3[6:0], committed_tag_b_next.bank3[7]}
                    ^ {7'd0, recover_taken} ^ {3'd0, committed_history_next[107], 4'd0};
            }
        }
    }

    // The committed circular stack owns the architectural data.  Speculation
    // overlays only words actually written by an in-flight call/coroutine;
    // pop changes just the pointer.  Recovery therefore clears sixteen valid
    // bits instead of copying a 512-bit array.  Owner tokens prevent an older
    // retirement from clearing a younger overwrite of the same stack word.
    always_comb {
        committed_sp_next             = committed_sp_q;
        committed_count_next          = committed_count_q;
        speculative_sp_next           = speculative_sp_q;
        speculative_count_next        = speculative_count_q;
        committed_ras_write_valid     = 1'b0;
        committed_ras_write_address   = 4'd0;
        speculative_ras_write_valid   = 1'b0;
        speculative_ras_write_address = 4'd0;
        recovery_ras_write_valid      = 1'b0;
        recovery_ras_write_address    = 4'd0;

        if retire_valid {
            case retire_kind {
                3'd4: {
                    committed_ras_write_valid   = 1'b1;
                    committed_ras_write_address = committed_sp_q;
                    committed_sp_next           = committed_sp_q + 4'd1;
                    if committed_count_q != 5'd16 {
                        committed_count_next = committed_count_q + 5'd1;
                    }
                }
                3'd5: {
                    if committed_count_q != 5'd0 {
                        committed_sp_next    = committed_sp_q - 4'd1;
                        committed_count_next = committed_count_q - 5'd1;
                    }
                }
                3'd6: {
                    committed_ras_write_valid = 1'b1;
                    if committed_count_q != 5'd0 {
                        committed_ras_write_address = committed_sp_q - 4'd1;
                    } else {
                        committed_ras_write_address = committed_sp_q;
                        committed_sp_next           = committed_sp_q + 4'd1;
                        committed_count_next        = 5'd1;
                    }
                }
                default: {}
            }
        }

        if response_accept && output_valid_q {
            case output_kind_q {
                3'd4: {
                    speculative_ras_write_valid   = 1'b1;
                    speculative_ras_write_address = speculative_sp_q;
                    speculative_sp_next           = speculative_sp_q + 4'd1;
                    if speculative_count_q != 5'd16 {
                        speculative_count_next = speculative_count_q + 5'd1;
                    }
                }
                3'd5: {
                    if speculative_count_q != 5'd0 {
                        speculative_sp_next    = speculative_sp_q - 4'd1;
                        speculative_count_next = speculative_count_q - 5'd1;
                    }
                }
                3'd6: {
                    speculative_ras_write_valid = 1'b1;
                    if speculative_count_q != 5'd0 {
                        speculative_ras_write_address = speculative_sp_q - 4'd1;
                    } else {
                        speculative_ras_write_address = speculative_sp_q;
                        speculative_sp_next           = speculative_sp_q + 4'd1;
                        speculative_count_next        = 5'd1;
                    }
                }
                default: {}
            }
        }

        if recover_valid || discard_all {
            speculative_sp_next    = committed_sp_next;
            speculative_count_next = committed_count_next;
            if recover_valid && !recover_is_retire {
                case recover_kind {
                    3'd4: {
                        recovery_ras_write_valid   = 1'b1;
                        recovery_ras_write_address = committed_sp_next;
                        speculative_sp_next        = committed_sp_next + 4'd1;
                        if committed_count_next != 5'd16 {
                            speculative_count_next = committed_count_next + 5'd1;
                        }
                    }
                    3'd5: {
                        if committed_count_next != 5'd0 {
                            speculative_sp_next    = committed_sp_next - 4'd1;
                            speculative_count_next = committed_count_next - 5'd1;
                        }
                    }
                    3'd6: {
                        recovery_ras_write_valid = 1'b1;
                        if committed_count_next != 5'd0 {
                            recovery_ras_write_address = committed_sp_next - 4'd1;
                        } else {
                            recovery_ras_write_address = committed_sp_next;
                            speculative_sp_next        = committed_sp_next + 4'd1;
                            speculative_count_next     = 5'd1;
                        }
                    }
                    default: {}
                }
            }
        }
    }

    // The independent bits avoid a packed-vector next-state expression.
    // Recovery only clears this bank; its optional replacement write lives in
    // the single overlay below, eliminating the late recovery-address decode.
    // A younger same-word write has final priority, so retirement of the older
    // owner cannot expose the newly committed base in its place.
    always_ff (clk, rst_n) {
        if_reset {
            for entry in 0..RAS_DEPTH {
                speculative_ras_valid_q[entry] = 1'b0;
            }
        } else {
            for entry in 0..RAS_DEPTH {
                if recover_valid || discard_all {
                    speculative_ras_valid_q[entry] = 1'b0;
                } else {
                    if committed_ras_write_valid && (committed_ras_write_address == entry as 4)
                        && speculative_ras_valid_q[entry] && (speculative_ras_owner_q[entry] == retire_token) {
                        speculative_ras_valid_q[entry] = 1'b0;
                    }
                    if speculative_ras_write_valid && (speculative_ras_write_address == entry as 4) {
                        speculative_ras_valid_q[entry] = 1'b1;
                    }
                }
            }
        }
    }

    // A recovery can retain at most the resolved instruction's one RAS
    // payload.  A later same-word prediction supersedes it; retirement clears
    // it only when the committing token is its owner.  Recovery/discard has
    // priority over any simultaneously accepted younger prediction, matching
    // the ordinary valid-bank ordering above.
    always_ff (clk, rst_n) {
        if_reset {
            recovery_ras_overlay_valid_q = 1'b0;
        } else {
            if recover_valid || discard_all {
                recovery_ras_overlay_valid_q = recovery_ras_write_valid;
            } else {
                if committed_ras_write_valid && recovery_ras_overlay_valid_q
                    && (committed_ras_write_address == recovery_ras_overlay_address_q)
                    && (recovery_ras_overlay_owner_q == retire_token) {
                    recovery_ras_overlay_valid_q = 1'b0;
                }
                if speculative_ras_write_valid && (speculative_ras_write_address == recovery_ras_overlay_address_q) {
                    recovery_ras_overlay_valid_q = 1'b0;
                }
            }
        }
    }

    // RAS payload and owner bits are intentionally not reset: count/valid
    // state masks every word until it has been written.  Keeping them in a
    // clock-only block avoids reset muxes and high-fanout reset routing.
    always_ff (clk) {
        for entry in 0..RAS_DEPTH {
            if committed_ras_write_valid && (committed_ras_write_address == entry as 4) {
                committed_ras_q[entry] = retire_fallthrough;
            }
            if !(recover_valid || discard_all) && speculative_ras_write_valid
                && (speculative_ras_write_address == entry as 4) {
                speculative_ras_data_q[entry]  = output_fallthrough_q;
                speculative_ras_owner_q[entry] = output_token_q;
            }
        }
        if recover_valid && recovery_ras_write_valid {
            recovery_ras_overlay_address_q = recovery_ras_write_address;
            recovery_ras_overlay_top_sp_q  = speculative_sp_next;
            recovery_ras_overlay_data_q    = recover_fallthrough;
            recovery_ras_overlay_owner_q   = recover_token;
        }
    }

    // Register compact table metadata before deriving provider and direction.
    // The queue supports simultaneous pop/push and can also discard the one
    // younger packet exposed when an older registered output redirects.
    always_ff (clk, rst_n) {
        if_reset {
            decision_valid_q = 1'b0;
        } else {
            if recover_valid || discard_all {
                decision_valid_q = 1'b0;
            } else if decision_squash {
                decision_valid_q = 1'b0;
            } else if raw_response_capture {
                decision_valid_q = 1'b1;
            } else if decision_promote || fast_miss_accept {
                decision_valid_q = 1'b0;
            }
        }
    }

    // Classification terminates in a second elastic register.  No compact
    // match/weak/prediction metadata crosses this boundary, so downstream
    // table CE/WEA control can depend only on output_valid_q/output_taken_q.
    always_ff (clk, rst_n) {
        if_reset {
            output_valid_q = 1'b0;
        } else {
            if recover_valid || discard_all {
                output_valid_q = 1'b0;
            } else if decision_promote {
                output_valid_q = 1'b1;
            } else if response_accept {
                output_valid_q = 1'b0;
            }
        }
    }

    // Output payload is masked by output_valid_q and intentionally reset-free.
    always_ff (clk) {
        if decision_promote {
            output_token_q   = decision_token_q;
            output_kind_q    = decision_kind_q;
            output_taken_q   = decision_control_taken;
            output_next_pc_q = decision_fallthrough_q;
            if decision_pc_taken {
                output_next_pc_q = decision_target_q;
            }
            output_fallthrough_q  = decision_fallthrough_q;
            output_btb_hit_q      = decision_btb_hit_q;
            output_tage_hit_q     = decision_control_tage_hit;
            output_ras_fallback_q = decision_ras_fallback_q;
        }
    }

    // The response packet and its request-time metadata share one clocked
    // process.  Capturing the older response before replacing the scalar
    // request metadata makes simultaneous pop/push ordering explicit to both
    // native simulation and synthesis.
    // Every field below is payload masked by a reset-bearing valid bit or by a
    // table response that can only follow request_fire.  Leaving the bank
    // reset-free avoids both reset fanout and a mixed-reset aggregate that the
    // ECP5 mapper cannot represent.
    always_ff (clk) {
        if raw_response_capture {
            decision_token_q          = selected_response_token;
            decision_kind_q           = selected_response_kind;
            decision_target_q         = selected_response_target;
            decision_fallthrough_q    = response_fallthrough_q;
            decision_btb_hit_q        = selected_response_btb_hit;
            decision_btb_way_q        = btb_response_way;
            decision_btb_set_q        = response_btb_set_q;
            decision_btb_plru_q       = btb_response_plru;
            decision_ras_fallback_q   = selected_response_ras_fallback;
            decision_conditional_q    = response_conditional_q;
            decision_match_q          = tage_response_match_metadata;
            decision_weak_q           = tage_response_weak_metadata;
            decision_pred_q           = tage_response_pred_metadata;
            decision_index_nt_q.bank0 = response_index_nt_q.bank0;
            decision_index_nt_q.bank1 = response_index_nt_q.bank1;
            decision_index_nt_q.bank2 = response_index_nt_q.bank2;
            decision_index_nt_q.bank3 = response_index_nt_q.bank3;
            decision_tag_a_nt_q.bank0 = response_tag_a_nt_q.bank0;
            decision_tag_a_nt_q.bank1 = response_tag_a_nt_q.bank1;
            decision_tag_a_nt_q.bank2 = response_tag_a_nt_q.bank2;
            decision_tag_a_nt_q.bank3 = response_tag_a_nt_q.bank3;
            decision_tag_b_nt_q.bank0 = response_tag_b_nt_q.bank0;
            decision_tag_b_nt_q.bank1 = response_tag_b_nt_q.bank1;
            decision_tag_b_nt_q.bank2 = response_tag_b_nt_q.bank2;
            decision_tag_b_nt_q.bank3 = response_tag_b_nt_q.bank3;
        }
        for slot in 0..TOKEN_COUNT {
            // Propagate a physical-word overwrite into every older live
            // identity snapshot.  Set/way comparison is exact, so writes
            // to unrelated BTB words do not suppress useful invalidation.
            if slot_valid_q[slot] && slot_btb_hit_q[slot] && btb_identity_mutation_valid
                && (slot_btb_set_q[slot] == retire_pc[7:1]) && (slot_btb_way_q[slot] == retire_slot_btb_way) {
                slot_btb_identity_stale_q[slot] = 1'b1;
            }
        }
        if raw_response_capture {
            for slot in 0..TOKEN_COUNT {
                if selected_response_token == slot as 3 {
                    slot_btb_hit_q[slot]            = selected_response_btb_hit;
                    slot_btb_way_q[slot]            = btb_response_way;
                    slot_btb_set_q[slot]            = response_btb_set_q;
                    slot_btb_identity_stale_q[slot] = response_btb_identity_stale_q || btb_response_identity_mutated;
                    slot_ras_fallback_q[slot]       = selected_response_ras_fallback;
                }
            }
        }
        if apply_decision_effect {
            for slot in 0..TOKEN_COUNT {
                if decision_token_q == slot as 3 {
                    slot_taken_q[slot] = decision_effect_taken;
                }
            }
        }
        // The outstanding table response names the lookup's physical BTB
        // word.  Remember any later overwrite while it waits behind the
        // registered decision queue; a write on the original lookup edge
        // is already covered by the BTB's read-during-write forwarding and
        // therefore starts a fresh identity below.  These request writes
        // stay after every old-response capture in this process.
        if request_fire || table_response_accept {
            response_btb_identity_stale_q = 1'b0;
        } else if btb_response_identity_mutated {
            response_btb_identity_stale_q = 1'b1;
        }
        if request_fire {
            response_fallthrough_q    = issue_fallthrough;
            response_conditional_q    = issue_is_conditional;
            response_btb_set_q        = issue_pc[7:1];
            response_index_nt_q.bank0 = issue_index_nt.bank0;
            response_index_nt_q.bank1 = issue_index_nt.bank1;
            response_index_nt_q.bank2 = issue_index_nt.bank2;
            response_index_nt_q.bank3 = issue_index_nt.bank3;
            response_tag_a_nt_q.bank0 = issue_tag_a_nt.bank0;
            response_tag_a_nt_q.bank1 = issue_tag_a_nt.bank1;
            response_tag_a_nt_q.bank2 = issue_tag_a_nt.bank2;
            response_tag_a_nt_q.bank3 = issue_tag_a_nt.bank3;
            response_tag_b_nt_q.bank0 = issue_tag_b_nt.bank0;
            response_tag_b_nt_q.bank1 = issue_tag_b_nt.bank1;
            response_tag_b_nt_q.bank2 = issue_tag_b_nt.bank2;
            response_tag_b_nt_q.bank3 = issue_tag_b_nt.bank3;
        }
    }

    // S0: enqueue the external request and its history snapshot.  The
    // registered packet is the only source for the table issue edge, so the
    // cache-hit/request-ready cone in Core terminates at this entry.  A full
    // entry may be replaced when its old packet issues on the same edge.
    #[allow(missing_reset_statement)]
    always_ff (clk, rst_n) {
        if_reset {
            // The wide packet is masked by ingress_valid_q.  Leaving it
            // reset-free removes an asynchronous reset mux from every
            // payload bit; enqueue writes all fields before the entry may
            // issue on a later edge.
            ingress_valid_q   = 1'b0;
            lookup_sequence_q = 3'd0;
        } else if recover_valid || discard_all {
            // No younger request may issue after a recovery/discard edge.
            // Payload is intentionally retained; valid is the transaction
            // boundary and prevents stale fields from reaching either table.
            ingress_valid_q = 1'b0;
        } else if ingress_accept {
            ingress_valid_q            = 1'b1;
            ingress_q.pc               = request_pc;
            ingress_q.fallthrough      = request_fallthrough;
            ingress_q.is_conditional   = request_is_conditional;
            ingress_q.token            = lookup_sequence_q;
            ingress_q.index_fold.bank0 = lookup_index_fold.bank0;
            ingress_q.index_fold.bank1 = lookup_index_fold.bank1;
            ingress_q.index_fold.bank2 = lookup_index_fold.bank2;
            ingress_q.index_fold.bank3 = lookup_index_fold.bank3;
            ingress_q.tag_a_fold.bank0 = lookup_tag_a_fold.bank0;
            ingress_q.tag_a_fold.bank1 = lookup_tag_a_fold.bank1;
            ingress_q.tag_a_fold.bank2 = lookup_tag_a_fold.bank2;
            ingress_q.tag_a_fold.bank3 = lookup_tag_a_fold.bank3;
            ingress_q.tag_b_fold.bank0 = lookup_tag_b_fold.bank0;
            ingress_q.tag_b_fold.bank1 = lookup_tag_b_fold.bank1;
            ingress_q.tag_b_fold.bank2 = lookup_tag_b_fold.bank2;
            ingress_q.tag_b_fold.bank3 = lookup_tag_b_fold.bank3;
            ingress_q.index_nt.bank0   = request_index_nt.bank0;
            ingress_q.index_nt.bank1   = request_index_nt.bank1;
            ingress_q.index_nt.bank2   = request_index_nt.bank2;
            ingress_q.index_nt.bank3   = request_index_nt.bank3;
            ingress_q.tag_a_nt.bank0   = request_tag_a_nt.bank0;
            ingress_q.tag_a_nt.bank1   = request_tag_a_nt.bank1;
            ingress_q.tag_a_nt.bank2   = request_tag_a_nt.bank2;
            ingress_q.tag_a_nt.bank3   = request_tag_a_nt.bank3;
            ingress_q.tag_b_nt.bank0   = request_tag_b_nt.bank0;
            ingress_q.tag_b_nt.bank1   = request_tag_b_nt.bank1;
            ingress_q.tag_b_nt.bank2   = request_tag_b_nt.bank2;
            ingress_q.tag_b_nt.bank3   = request_tag_b_nt.bank3;
            lookup_sequence_q          = lookup_sequence_q + 3'd1;
        } else if request_fire {
            ingress_valid_q = 1'b0;
        }
    }

    #[allow(missing_reset_statement)]
    always_ff (clk, rst_n) {
        if_reset {
            allocation_token_q = 3'd0;
            for history_bit in 0..108 {
                speculative_history_q[history_bit] = 1'b0;
                committed_history_q[history_bit]   = 1'b0;
            }
            speculative_sp_q          = 4'd0;
            committed_sp_q            = 4'd0;
            speculative_count_q       = 5'd0;
            committed_count_q         = 5'd0;
            speculative_index_q.bank0 = 9'd0;
            speculative_index_q.bank1 = 9'd0;
            speculative_index_q.bank2 = 9'd0;
            speculative_index_q.bank3 = 9'd0;
            committed_index_q.bank0   = 9'd0;
            committed_index_q.bank1   = 9'd0;
            committed_index_q.bank2   = 9'd0;
            committed_index_q.bank3   = 9'd0;
            speculative_tag_a_q.bank0 = 9'd0;
            speculative_tag_a_q.bank1 = 9'd0;
            speculative_tag_a_q.bank2 = 9'd0;
            speculative_tag_a_q.bank3 = 9'd0;
            committed_tag_a_q.bank0   = 9'd0;
            committed_tag_a_q.bank1   = 9'd0;
            committed_tag_a_q.bank2   = 9'd0;
            committed_tag_a_q.bank3   = 9'd0;
            speculative_tag_b_q.bank0 = 8'd0;
            speculative_tag_b_q.bank1 = 8'd0;
            speculative_tag_b_q.bank2 = 8'd0;
            speculative_tag_b_q.bank3 = 8'd0;
            committed_tag_b_q.bank0   = 8'd0;
            committed_tag_b_q.bank1   = 8'd0;
            committed_tag_b_q.bank2   = 8'd0;
            committed_tag_b_q.bank3   = 8'd0;
            // Payload bits are masked by slot_valid_q and intentionally do
            // not reset, avoiding unnecessary reset muxes and fanout.
            slot_valid_q = 8'd0;
        } else {
            speculative_history_q = speculative_history_next;
            committed_history_q   = committed_history_next;
            speculative_sp_q      = speculative_sp_next;
            committed_sp_q        = committed_sp_next;
            speculative_count_q   = speculative_count_next;
            committed_count_q     = committed_count_next;
            speculative_index_q   = speculative_index_next;
            committed_index_q     = committed_index_next;
            speculative_tag_a_q   = speculative_tag_a_next;
            committed_tag_a_q     = committed_tag_a_next;
            speculative_tag_b_q   = speculative_tag_b_next;
            committed_tag_b_q     = committed_tag_b_next;
            if raw_response_capture {
                // Provisionally claim the current architectural token.  A
                // later registered taken output may prove this metadata
                // packet to be a fall-through shadow; decision_squash then
                // rolls the allocation frontier back to this exact token.
                allocation_token_q = allocation_token_q + 3'd1;
                for slot in 0..TOKEN_COUNT {
                    if selected_response_token == slot as 3 {
                        slot_valid_q[slot] = 1'b1;
                    }
                }
            }

            if decision_squash {
                allocation_token_q = decision_token_q;
                for slot in 0..TOKEN_COUNT {
                    if decision_token_q == slot as 3 {
                        slot_valid_q[slot] = 1'b0;
                    }
                }
            }

            if retire_valid {
                for slot in 0..TOKEN_COUNT {
                    if retire_token == slot as 3 {
                        slot_valid_q[slot] = 1'b0;
                    }
                }
            }
            if recover_valid {
                allocation_token_q = recover_token + 3'd1;
                slot_valid_q       = 8'd0;
                for slot in 0..TOKEN_COUNT {
                    if !recover_is_retire && (recover_token == slot as 3) {
                        slot_valid_q[slot] = 1'b1;
                    }
                }
            }
            if discard_all {
                allocation_token_q = 3'd0;
                slot_valid_q       = 8'd0;
            }
        }
    }
}
