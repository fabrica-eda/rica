/// Direct-JTAG loadable RV64 hardware-test system.
///
/// ER1 carries one 128-bit command frame per update. The CPU remains reset
/// while the host fills memory, then reports its self-check result through the
/// programmed `tohost` address. ER1 returns the selected response bit while
/// each command frame is scanned; ER2 independently reports PLL lock.
module HardwareTestTop #(
    param PREDICTOR_MODE   : u32 = 0,
    param ICACHE_INDEX_BITS: u32 = 0,
    param FAST_LSU         : u32 = 0,
    param ENABLE_ZBA       : bit = 0,
    param ENABLE_ZBB       : bit = 0,
    param ENABLE_ZBS       : bit = 0,
    param EARLY_BITMANIP   : bit = 0,
    param EARLY_TAKEN_FETCH: bit = 0,
    param ENABLE_U: bit = 0,
    param ENABLE_S: bit = 0,
    param ENABLE_SV39: bit = 0,
    param PMP_DATA_STAGES: u32 = 3,
    param EARLY_ALU: bit = 0,
    // Related clocks at the same frequency can return the held BRAM result
    // directly to CM; no request can retire before its response token.
    param DIRECT_LOAD_RETURN: bit = 0,
    param MEMORY_HZ: u64 = 62_400_000,
    param ENABLE_A: bit = 0,
    param ENABLE_M         : bit = 0,
    param M_USE_DSP        : bit = 0,
    param EARLY_DIVIDE     : bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
    param ENABLE_CONSOLE   : bit = 0,
    param STRICT_MEMORY    : bit = 0,
) (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
    jtag_tck   : input  'tap       clock             ,
    jtag_rti1  : input  'tap       logic             ,
    jtag_rti2  : input  'tap       logic             ,
    jtag_shift : input  'tap       logic             ,
    jtag_update: input  'tap       clock             ,
    jtag_rst_n : input  'tap       reset_async_low   ,
    jtag_ce1   : input  'tap       logic             ,
    jtag_ce2   : input  'tap       logic             ,
    jtag_tdo1  : output 'tap       logic             ,
    jtag_tdo2  : output 'tap       logic             ,
) {
    var debug_reset_async_n: 'cpu reset_async_low   ;
    var debug_reset_sync_q : 'cpu logic          <2>;
    var debug_rst_n        : 'cpu reset_async_low   ;

    var command_valid      : 'cpu logic    ;
    var command_frame_low  : 'cpu logic<64>;
    var command_frame_high : 'cpu logic<64>;
    var response_selector_q: 'cpu logic<8> ;
    var counter_selector_q : 'cpu logic<4> ;
    var response_bank      : 'cpu logic<32>;
    var response_mux_16    : 'cpu logic<16>;
    var response_mux_8     : 'cpu logic<8> ;
    var response_mux_4     : 'cpu logic<4> ;
    var response_mux_2     : 'cpu logic<2> ;
    var response_bit       : 'cpu logic    ;

    var run_q               : 'cpu logic              ;
    var tohost_address_q    : 'cpu logic          <32>;
    var result_q            : 'cpu logic          <64>;
    var result_valid_q      : 'cpu logic              ;
    var result_clear        : 'cpu logic              ;
    var result_capture      : 'cpu logic              ;
    var result_enable       : 'cpu logic              ;
    var command_error_q     : 'cpu logic              ;
    var last_sequence_q     : 'cpu logic          <8> ;
    var activity_q          : 'cpu logic          <24>;
    var cpu_rst_n           : 'cpu reset_async_low    ;
    var memory_debug_write_q: 'cpu logic          <2> ;
    var memory_debug_addr_q : 'cpu logic          <32>;
    var memory_debug_data_q : 'cpu logic          <8> ;
    var write_busy_q        : 'cpu logic              ;
    var write_address_q     : 'cpu logic          <32>;
    var write_data_q        : 'cpu logic          <64>;
    var write_mask_q        : 'cpu logic          <8> ;
    var write_index_q       : 'cpu logic          <3> ;
    var write_sequence_q    : 'cpu logic          <8> ;

    var instruction                  : 'cpu    logic<32>;
    var instruction_compressed       : 'cpu    logic    ;
    var instruction_valid            : 'cpu    logic    ;
    var memory_instr_address         : 'memory logic<32>;
    var memory_instr_line            : 'memory logic<64>;
    var memory_instr_response_address: 'memory logic<32>;
    var memory_instr_response_valid  : 'memory logic    ;
    var cpu_pc                       : 'cpu    logic<64>;
    var data_addr                    : 'cpu    logic<64>;
    var data_memory_addr             : 'cpu    logic<64>;
    var data_rdata                   : 'cpu    logic<64>;
    var data_wdata                   : 'cpu    logic<64>;
    var data_wmask                   : 'cpu    logic<8> ;
    var data_we                      : 'cpu    logic    ;
    var data_request_sequence        : 'cpu    logic    ;
    var data_response_sequence       : 'cpu    logic    ;
    var halted                       : 'cpu    logic    ;
    var commit_valid                 : 'cpu    logic    ;
    var debug_x31                    : 'cpu    logic<64>;
    var debug_counter_data           : 'cpu    logic<64>;
    var unused_commit_pc             : 'cpu    logic<64>;
    var unused_commit_instr          : 'cpu    logic<32>;
    var unused_commit_rd             : 'cpu    logic<5> ;
    var unused_commit_data           : 'cpu    logic<64>;
    var unused_commit_mem_we         : 'cpu    logic    ;
    var unused_commit_mem_addr       : 'cpu    logic<64>;
    var unused_commit_mem_wdata      : 'cpu    logic<64>;
    var unused_commit_mem_wmask      : 'cpu    logic<8> ;

    inst jtag_debug_transport: JtagDebugTransport (
        clk               : clk_cpu           ,
        rst_n             : debug_rst_n       ,
        jtag_tdi          : jtag_tdi          ,
        jtag_tck          : jtag_tck          ,
        jtag_rti1         : jtag_rti1         ,
        jtag_rti2         : jtag_rti2         ,
        jtag_shift        : jtag_shift        ,
        jtag_update       : jtag_update       ,
        jtag_rst_n        : jtag_rst_n        ,
        jtag_ce1          : jtag_ce1          ,
        jtag_ce2          : jtag_ce2          ,
        jtag_tdo1         : jtag_tdo1         ,
        jtag_tdo2         : jtag_tdo2         ,
        command_valid     : command_valid     ,
        command_frame_low : command_frame_low ,
        command_frame_high: command_frame_high,
        response_bit      : response_bit      ,
        status_bit        : pll_locked        ,
    );

    var instruction_flush             : 'cpu    logic;
    var fetch_translate               : 'cpu    logic;
    var fetch_next_page               : 'cpu    logic<20>;
    var memory_instr_request_sequence : 'memory logic;
    var memory_instr_response_sequence: 'memory logic;
    if ICACHE_INDEX_BITS == 0 :g_buffer {
        inst instruction_buffer: InstructionBuffer (
            clk: clk_cpu,
            // Loading a new ELF resets the CPU without reconfiguring the FPGA.
            // Flush cached lines with that same reset so a previous test cannot
            // execute stale instructions at identical virtual addresses.
            rst_n                  : cpu_rst_n                    ,
            invalidate             : instruction_flush            ,
            pc                     : cpu_pc[31:0]                 ,
            instruction            : instruction                  ,
            instruction_compressed : instruction_compressed       ,
            instruction_valid      : instruction_valid            ,
            memory_request_address : memory_instr_address         ,
            memory_response_address: memory_instr_response_address,
            memory_response_line   : memory_instr_line            ,
            memory_response_valid  : memory_instr_response_valid  ,
        );
        assign memory_instr_request_sequence = 1'b0;
    } else :g_cache {
        inst instruction_cache: InstructionCache #(
            INDEX_BITS: ICACHE_INDEX_BITS,
        ) (
            clk                     : clk_cpu                       ,
            rst_n                   : cpu_rst_n                     ,
            invalidate              : instruction_flush             ,
            pc                      : cpu_pc[31:0]                  ,
            translate               : fetch_translate               ,
            next_page               : fetch_next_page               ,
            instruction             : instruction                   ,
            instruction_compressed  : instruction_compressed        ,
            instruction_valid       : instruction_valid             ,
            memory_request_address  : memory_instr_address          ,
            memory_request_sequence : memory_instr_request_sequence ,
            memory_response_address : memory_instr_response_address ,
            memory_response_line    : memory_instr_line             ,
            memory_response_valid   : memory_instr_response_valid   ,
            memory_response_sequence: memory_instr_response_sequence,
        );
    }

    var memory_machine_interrupts    : 'memory logic<3> ;
    var core_machine_interrupts      : 'cpu    logic<3> ;
    var console_request_q            : 'cpu    logic    ;
    var console_pop_q                : 'cpu    logic    ;
    var console_push_q               : 'cpu    logic    ;
    var console_data_q               : 'cpu    logic<8> ;
    var console_busy_q               : 'cpu    logic    ;
    var console_sequence_q           : 'cpu    logic<8> ;
    var console_completed_sequence_q : 'cpu    logic<8> ;
    var console_response_q           : 'cpu    logic<16>;
    var console_response_sequence    : 'memory logic    ;
    var console_response             : 'memory logic<16>;
    var console_response_sequence_cpu: 'cpu    logic    ;
    var console_response_cpu         : 'cpu    logic<16>;
    unsafe (cdc) {
        assign console_response_sequence_cpu = console_response_sequence;
        assign console_response_cpu          = console_response;
    }
    unsafe (cdc) {
        inst hardware_memory: HardwareMemory #(
            MEMORY_HZ     : MEMORY_HZ,
            STRICT_MEMORY : STRICT_MEMORY    ,
            ENABLE_TIMER  : ENABLE_INTERRUPTS,
            ENABLE_CONSOLE: ENABLE_CONSOLE   ,
            FAST_LSU      : FAST_LSU         ,
        ) (
            clk                           : clk_mem                       ,
            rst_n                         : debug_rst_n                   ,
            timer_rst_n                   : cpu_rst_n                     ,
            timer_freeze                  : result_valid_q                ,
            machine_interrupts            : memory_machine_interrupts     ,
            console_host_request_sequence : console_request_q             ,
            console_host_pop              : console_pop_q                 ,
            console_host_push             : console_push_q                ,
            console_host_data             : console_data_q                ,
            console_host_response_sequence: console_response_sequence     ,
            console_host_response         : console_response              ,
            cpu_instr_address             : memory_instr_address          ,
            cpu_instr_request_sequence    : memory_instr_request_sequence ,
            cpu_instr_response_sequence   : memory_instr_response_sequence,
            cpu_instr_line                : memory_instr_line             ,
            cpu_instr_response_address    : memory_instr_response_address ,
            cpu_instr_response_valid      : memory_instr_response_valid   ,
            cpu_data_address              : data_memory_addr[31:0]        ,
            cpu_data_read                 : data_rdata                    ,
            cpu_data_write                : data_wdata                    ,
            cpu_data_mask                 : data_wmask                    ,
            cpu_data_we                   : data_we                       ,
            cpu_data_request_sequence     : data_request_sequence         ,
            cpu_data_response_sequence    : data_response_sequence        ,
            debug_write                   : memory_debug_write_q != 2'd0,
            debug_address                 : memory_debug_addr_q           ,
            debug_data                    : memory_debug_data_q           ,
        );
    }

    unsafe (cdc) {
        always_ff (clk_cpu, cpu_rst_n) {
            if_reset {
                core_machine_interrupts = 3'd0;
            } else {
                core_machine_interrupts = memory_machine_interrupts;
            }
        }
    }

    var data_load_size             : 'cpu logic<2> ;
    var data_load_unsigned         : 'cpu logic    ;
    var core_data_rdata            : 'cpu logic<64>;
    var data_store_retire_ready: 'cpu logic;
    var core_data_response_sequence: 'cpu logic    ;
    var core_load_response_sequence: 'cpu logic;
    if !DIRECT_LOAD_RETURN && ((FAST_LSU == 4) || (FAST_LSU == 6)) :g_load_return {
        // CM holds the load descriptor until its response sequence matches.
        // Format before this existing response register: load extension no
        // longer precedes Core's forwarding mux, without another wait cycle.
        var formatted_load: 'cpu logic<64>;
        inst load_format: LoadFormat (
            value        : data_rdata        ,
            size         : data_load_size    ,
            unsigned_load: data_load_unsigned,
            formatted    : formatted_load    ,
        );
        var load_sequence_q: 'cpu logic;
        assign core_data_response_sequence = if data_we ? data_response_sequence : load_sequence_q;
        assign core_load_response_sequence = load_sequence_q;
        always_ff (clk_cpu, cpu_rst_n) {
            if_reset {
                core_data_rdata = 64'd0;
                load_sequence_q = 1'b0;
            } else {
                core_data_rdata = formatted_load;
                load_sequence_q = data_response_sequence;
            }
        }
    } else {
        assign core_data_rdata             = data_rdata;
        assign core_data_response_sequence = data_response_sequence;
        assign core_load_response_sequence = data_response_sequence;
    }

    inst core: Core #(
        PMP_DATA_STAGES: PMP_DATA_STAGES,
        EARLY_ALU: EARLY_ALU,
        FORMATTED_LOAD_DATA    : !DIRECT_LOAD_RETURN && ((FAST_LSU == 4) || (FAST_LSU == 6)),
        STRICT_MEMORY          : STRICT_MEMORY                     ,
        ENABLE_INTERRUPTS      : ENABLE_INTERRUPTS                 ,
        ENABLE_ZBA             : ENABLE_ZBA                        ,
        ENABLE_ZBB             : ENABLE_ZBB                        ,
        ENABLE_ZBS             : ENABLE_ZBS                        ,
        EARLY_BITMANIP         : EARLY_BITMANIP                    ,
        EARLY_TAKEN_FETCH      : EARLY_TAKEN_FETCH                 ,
        ENABLE_M               : ENABLE_M                          ,
        M_USE_DSP              : M_USE_DSP                         ,
        EARLY_DIVIDE           : EARLY_DIVIDE                      ,
        COMMIT_PAYLOAD         : 0                                 ,
        SYNC_DATA_MEMORY       : 1                                 ,
        RELOCATE_LOW_DATA      : 1                                 ,
        BRANCH_PREDICTOR_CONFIG: 1 + 2 * PREDICTOR_MODE,
        ENABLE_U: ENABLE_U,
        ENABLE_S: ENABLE_S,
        ENABLE_SV39: ENABLE_SV39,
        ENABLE_A: ENABLE_A,
        SPLIT_MEMORY_RESPONSES: ENABLE_A,
    ) (
        clk                   : clk_cpu                    ,
        rst_n                 : cpu_rst_n                  ,
        instr                 : instruction                ,
        instr_is_compressed   : instruction_compressed     ,
        instr_valid           : instruction_valid          ,
        data_rdata            : core_data_rdata            ,
        data_response_sequence: core_data_response_sequence,
        data_load_response_sequence: core_load_response_sequence,
        data_store_response_sequence: data_response_sequence,
        machine_interrupts    : core_machine_interrupts    ,
        counter_freeze        : result_valid_q             ,
        debug_counter_index   : counter_selector_q         ,
        debug_counter_data    : debug_counter_data         ,
        pc                    : cpu_pc                     ,
        data_addr             : data_addr                  ,
        data_memory_addr      : data_memory_addr           ,
        data_wdata            : data_wdata                 ,
        data_wmask            : data_wmask                 ,
        data_we               : data_we                    ,
        data_store_retire_ready: data_store_retire_ready,
        data_request_sequence : data_request_sequence      ,
        data_load_size        : data_load_size             ,
        data_load_unsigned    : data_load_unsigned         ,
        halted                : halted                     ,
        commit_valid          : commit_valid               ,
        commit_pc             : unused_commit_pc           ,
        commit_instr          : unused_commit_instr        ,
        commit_rd             : unused_commit_rd           ,
        commit_data           : unused_commit_data         ,
        commit_mem_we         : unused_commit_mem_we       ,
        commit_mem_addr       : unused_commit_mem_addr     ,
        commit_mem_wdata      : unused_commit_mem_wdata    ,
        commit_mem_wmask      : unused_commit_mem_wmask    ,
        debug_x31             : debug_x31                  ,
        instruction_flush     : instruction_flush          ,
        fetch_translate       : fetch_translate            ,
        fetch_next_page       : fetch_next_page            ,
    );

    // PLL lock and TAP reset may assert reset without a running CPU clock.
    // Release is synchronized so the CPU-side command mailbox and test system
    // cannot leave reset on a placement-dependent recovery edge.
    always_ff (clk_cpu, debug_reset_async_n) {
        if_reset {
            debug_reset_sync_q = 2'b00;
        } else {
            debug_reset_sync_q = {debug_reset_sync_q[0], 1'b1};
        }
    }

    unsafe (cdc) {
        assign debug_reset_async_n = jtag_rst_n && pll_locked;
        assign debug_rst_n         = debug_reset_sync_q[1];
    }

    always_comb {
        cpu_rst_n      = debug_rst_n && run_q;
        result_clear   = command_valid && (command_frame_low[7:0] == 8'hd5) && (command_frame_low[11:8] == 4'd1)
            && (command_frame_low[15:12] == 4'd3) && !write_busy_q && command_frame_low[57];
        result_capture = run_q && data_we && data_store_retire_ready && (data_addr[31:0] == tohost_address_q)
            && (data_response_sequence == data_request_sequence);
        result_enable  = result_clear || result_capture;
        response_bank  = 32'd0;
        case response_selector_q[7:5] {
            3'd0   : response_bank = {
                last_sequence_q, 2'b00, command_error_q, write_busy_q || (memory_debug_write_q != 2'd0), halted,
                result_valid_q, run_q, pll_locked, 8'h05, 8'h52
            };
            3'd1   : response_bank = result_q[31:0];
            3'd2   : response_bank = result_q[63:32];
            3'd3   : response_bank = debug_x31[31:0];
            3'd4   : response_bank = debug_x31[63:32];
            3'd5   : response_bank = debug_counter_data[31:0];
            3'd6   : response_bank = debug_counter_data[63:32];
            3'd7   : response_bank = {7'd0, console_busy_q, console_completed_sequence_q, console_response_q};
            default: {}
        }
        // A static five-level tree avoids the unsupported dynamic packed
        // select without exploding into one equality decoder per response bit.
        for index in 0..16 {
            if response_selector_q[0] {
                response_mux_16[index] = response_bank[index * 2 + 1];
            } else {
                response_mux_16[index] = response_bank[index * 2];
            }
        }
        for index in 0..8 {
            if response_selector_q[1] {
                response_mux_8[index] = response_mux_16[index * 2 + 1];
            } else {
                response_mux_8[index] = response_mux_16[index * 2];
            }
        }
        for index in 0..4 {
            if response_selector_q[2] {
                response_mux_4[index] = response_mux_8[index * 2 + 1];
            } else {
                response_mux_4[index] = response_mux_8[index * 2];
            }
        }
        for index in 0..2 {
            if response_selector_q[3] {
                response_mux_2[index] = response_mux_4[index * 2 + 1];
            } else {
                response_mux_2[index] = response_mux_4[index * 2];
            }
        }
        if response_selector_q[4] {
            response_bit = response_mux_2[1];
        } else {
            response_bit = response_mux_2[0];
        }

        if result_valid_q {
            led[5:0] = ~result_q[5:0];
        } else {
            led[5:0] = ~debug_x31[5:0];
        }
        led[6] = !activity_q[23];
        led[7] = !pll_locked;
    }

    // An explicit enable lets the result bank use local register CEs instead
    // of routing command decode through each feedback mux. Acknowledged stores
    // take precedence over a simultaneous CONTROL clear, as before.
    always_ff (clk_cpu, debug_rst_n) {
        if_reset {
            result_q       = 64'd0;
            result_valid_q = 1'b0;
        } else if result_enable {
            result_q = data_wdata;
            if !result_capture {
                result_q = 64'd0;
            }
            result_valid_q = result_capture && (data_wdata != 64'd0);
        }
    }

    always_ff (clk_cpu, debug_rst_n) {
        if_reset {
            run_q                        = 1'b0;
            tohost_address_q             = 32'h0000_0000;
            command_error_q              = 1'b0;
            last_sequence_q              = 8'h00;
            response_selector_q          = 8'd0;
            counter_selector_q           = 4'd0;
            activity_q                   = 24'h000000;
            memory_debug_write_q         = 2'd0;
            memory_debug_addr_q          = 32'h0000_0000;
            memory_debug_data_q          = 8'h00;
            write_busy_q                 = 1'b0;
            write_address_q              = 32'h0000_0000;
            write_data_q                 = 64'h0000_0000_0000_0000;
            write_mask_q                 = 8'h00;
            write_index_q                = 3'd0;
            write_sequence_q             = 8'h00;
            console_request_q            = 1'b0;
            console_pop_q                = 1'b0;
            console_push_q               = 1'b0;
            console_data_q               = 8'd0;
            console_busy_q               = 1'b0;
            console_sequence_q           = 8'd0;
            console_completed_sequence_q = 8'd0;
            console_response_q           = 16'd0;
        } else {
            activity_q = activity_q + 24'd1;
            if !run_q {
                console_request_q            = 1'b0;
                console_busy_q               = 1'b0;
                console_completed_sequence_q = 8'd0;
                console_response_q           = 16'd0;
            } else if console_busy_q && (console_response_sequence_cpu == console_request_q) {
                console_response_q           = console_response_cpu;
                console_completed_sequence_q = console_sequence_q;
                console_busy_q               = 1'b0;
                last_sequence_q              = console_sequence_q;
            }

            // HardwareMemory is in the divided memory clock domain. Keep each
            // byte's write enable, address, and data stable for three CPU
            // clocks, matching the established CDC stretch contract.
            if memory_debug_write_q != 2'd0 {
                memory_debug_write_q = memory_debug_write_q - 2'd1;
            } else if write_busy_q {
                if write_mask_q[0] {
                    memory_debug_write_q = 2'd3;
                    memory_debug_addr_q  = write_address_q;
                    memory_debug_data_q  = write_data_q[7:0];
                    write_mask_q[0]      = 1'b0;
                }

                if write_index_q != 3'd7 {
                    write_index_q   = write_index_q + 3'd1;
                    write_address_q = write_address_q + 32'd1;
                    write_data_q    = {8'd0, write_data_q[63:8]};
                    write_mask_q    = {1'b0, write_mask_q[7:1]};
                } else if !write_mask_q[0] {
                    write_busy_q    = 1'b0;
                    last_sequence_q = write_sequence_q;
                }
            }

            if command_valid {
                if (command_frame_low[7:0] != 8'hd5) || (command_frame_low[11:8] != 4'd1) {
                    command_error_q = 1'b1;
                } else {
                    case command_frame_low[15:12] {
                        // NOP preserves the completed side-effect sequence.
                        4'd0: {}
                        // WRITE64 is accepted only while the CPU is stopped
                        // and no previous write is still being serialized.
                        4'd1: {
                            if write_busy_q || run_q {
                                command_error_q = 1'b1;
                                if !write_busy_q {
                                    last_sequence_q = command_frame_low[23:16];
                                }
                            } else {
                                write_busy_q     = 1'b1;
                                write_address_q  = command_frame_low[55:24];
                                write_data_q     = {command_frame_high[55:0], command_frame_low[63:56]};
                                write_mask_q     = command_frame_high[63:56];
                                write_index_q    = 3'd0;
                                write_sequence_q = command_frame_low[23:16];
                            }
                        }
                        // SET_TOHOST
                        4'd2: {
                            if write_busy_q {
                                command_error_q = 1'b1;
                            } else {
                                tohost_address_q = command_frame_low[55:24];
                                last_sequence_q  = command_frame_low[23:16];
                            }
                        }
                        // CONTROL: data[0] controls run; data[1] clears the
                        // prior result and sticky command error.
                        4'd3: {
                            if write_busy_q {
                                command_error_q = 1'b1;
                            } else {
                                run_q           = command_frame_low[56];
                                last_sequence_q = command_frame_low[23:16];
                                if command_frame_low[57] {
                                    command_error_q = 1'b0;
                                }
                            }
                        }
                        // SELECT changes the stable ER1 response bit without
                        // disturbing the completed transaction sequence.
                        // Address[11:8] selects one of eleven frozen counters.
                        4'd4: {
                            response_selector_q = command_frame_low[31:24];
                            counter_selector_q  = command_frame_low[35:32];
                        }
                        // EXCHANGE: address[0] pops output, address[1] pushes input.
                        // The memory-domain device snapshots both results once.
                        4'd5: {
                            if ENABLE_CONSOLE && ENABLE_INTERRUPTS && run_q && !console_busy_q && !write_busy_q {
                                console_request_q  = !console_request_q;
                                console_pop_q      = command_frame_low[24];
                                console_push_q     = command_frame_low[25];
                                console_data_q     = command_frame_low[63:56];
                                console_sequence_q = command_frame_low[23:16];
                                console_busy_q     = 1'b1;
                            } else {
                                command_error_q = 1'b1;
                            }
                        }
                        default: command_error_q = 1'b1;
                    }
                }
            }

        }
    }
}
