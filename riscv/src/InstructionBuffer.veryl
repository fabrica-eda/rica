/// Two-entry instruction-line buffer between the related 62.4 MHz memory
/// clock and 124.8 MHz CPU clock.
///
/// A registered request address removes cache-hit logic from the related-clock
/// boundary. HardwareMemory returns a tagged 64-bit line on every memory edge;
/// a CPU-domain response register gives that bundle a complete CPU cycle to
/// settle before cache state consumes it. The output is a 32-bit little-endian
/// instruction window starting at any halfword-aligned PC. A 32-bit instruction
/// beginning in the final parcel of a line is assembled from the current and
/// successor lines; a 16-bit instruction in that parcel can proceed without
/// waiting for the successor.
module InstructionBuffer (
    clk                    : input  'cpu    clock              ,
    rst_n                  : input  'cpu    reset_async_low    ,
    pc                     : input  'cpu    logic          <32>,
    instruction            : output 'cpu    logic          <32>,
    instruction_compressed : output 'cpu    logic              ,
    instruction_valid      : output 'cpu    logic              ,
    memory_request_address : output 'memory logic          <32>,
    memory_response_address: input  'memory logic          <32>,
    memory_response_line   : input  'memory logic          <64>,
    memory_response_valid  : input  'memory logic              ,
) {
    var response_address_async: 'cpu logic<32>;
    var response_line_async   : 'cpu logic<64>;
    var response_valid_async  : 'cpu logic    ;
    var response_address_q    : 'cpu logic<32>;
    var response_line_q       : 'cpu logic<64>;
    var response_valid_q      : 'cpu logic    ;
    var request_address_q     : 'cpu logic<32>;
    var desired_address       : 'cpu logic<32>;

    var cache_address_0_q   : 'cpu logic<32>;
    var cache_address_1_q   : 'cpu logic<32>;
    var cache_successor_0_q : 'cpu logic<29>;
    var cache_successor_1_q : 'cpu logic<29>;
    var cache_line_0_q      : 'cpu logic<64>;
    var cache_line_1_q      : 'cpu logic<64>;
    var cache_compressed_0_q: 'cpu logic<4> ;
    var cache_compressed_1_q: 'cpu logic<4> ;
    var cache_valid_0_q     : 'cpu logic    ;
    var cache_valid_1_q     : 'cpu logic    ;
    var current_hit         : 'cpu logic    ;
    var next_hit            : 'cpu logic    ;
    var pc_line             : 'cpu logic<32>;
    var next_line           : 'cpu logic<32>;
    var current_data        : 'cpu logic<64>;
    var next_data           : 'cpu logic<64>;
    var current_compressed  : 'cpu logic<4> ;

    unsafe (cdc) {
        assign response_address_async = memory_response_address;
        assign response_line_async    = memory_response_line;
        assign response_valid_async   = memory_response_valid;
        assign memory_request_address = request_address_q;
    }

    always_comb {
        pc_line   = {pc[31:3], 3'b000};
        next_line = pc_line + 32'd8;

        // Consecutive eight-byte lines differ in address bit 3, so two
        // direct-mapped slots always hold a current/successor pair. The tag
        // comparison now qualifies validity only; it no longer drives a
        // 64-bit associative data mux on every fetched instruction.
        if pc_line[3] {
            current_hit        = cache_valid_1_q && (cache_address_1_q[31:4] == pc_line[31:4]);
            next_hit           = cache_valid_0_q && (cache_address_0_q[31:3] == cache_successor_1_q);
            current_data       = cache_line_1_q;
            next_data          = cache_line_0_q;
            current_compressed = cache_compressed_1_q;
        } else {
            current_hit        = cache_valid_0_q && (cache_address_0_q[31:4] == pc_line[31:4]);
            next_hit           = cache_valid_1_q && (cache_address_1_q[31:3] == cache_successor_0_q);
            current_data       = cache_line_0_q;
            next_data          = cache_line_1_q;
            current_compressed = cache_compressed_0_q;
        }

        instruction_compressed = current_compressed[pc[2:1]];
        instruction_valid      = current_hit;
        case pc[2:1] {
            2'd0   : instruction = current_data[31:0];
            2'd1   : instruction = current_data[47:16];
            2'd2   : instruction = current_data[63:32];
            default: {
                // Only a 32-bit instruction in the final parcel consumes the
                // following line. Its low two bits are available locally.
                if current_data[49:48] == 2'b11 {
                    instruction       = {next_data[15:0], current_data[63:48]};
                    instruction_valid = current_hit && next_hit;
                } else {
                    instruction = {16'd0, current_data[63:48]};
                }
            }
        }

        // A hit means the current line is already local, so spend the next
        // memory cycle fetching its successor. A redirect miss requests the
        // redirect target instead.
        desired_address = pc_line;
        if current_hit {
            desired_address = next_line;
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            cache_address_0_q    = 32'h0000_0000;
            cache_address_1_q    = 32'h0000_0000;
            cache_successor_0_q  = 29'd1;
            cache_successor_1_q  = 29'd1;
            cache_line_0_q       = 64'h0000_0000_0000_0013;
            cache_line_1_q       = 64'h0000_0000_0000_0013;
            cache_compressed_0_q = 4'b0000;
            cache_compressed_1_q = 4'b0000;
            cache_valid_0_q      = 1'b0;
            cache_valid_1_q      = 1'b0;
            response_address_q   = 32'h0000_0000;
            response_line_q      = 64'h0000_0013_0000_0013;
            response_valid_q     = 1'b0;
            request_address_q    = 32'h0000_0000;
        } else {
            // Cache state consumes the preceding sample, giving the related-
            // clock payload one complete CPU period to settle.
            response_address_q = response_address_async;
            response_line_q    = response_line_async;
            response_valid_q   = response_valid_async;

            // On the fill edge, advance directly from the returned tag. This
            // removes the otherwise empty cycle in which cache-hit state has
            // not yet observed the new line. A redirect keeps priority by
            // failing the tag-to-current-PC comparison.
            request_address_q = desired_address;
            if response_valid_q && (response_address_q == pc_line) {
                request_address_q = response_address_q + 32'd8;
            }

            if response_valid_q {
                if response_address_q[3] {
                    cache_address_1_q    = response_address_q;
                    cache_successor_1_q  = response_address_q[31:3] + 29'd1;
                    cache_line_1_q       = response_line_q;
                    cache_compressed_1_q = {
                        response_line_q[49:48] != 2'b11, response_line_q[33:32] != 2'b11,
                        response_line_q[17:16] != 2'b11, response_line_q[1:0] != 2'b11
                    };
                    cache_valid_1_q      = 1'b1;
                } else {
                    cache_address_0_q    = response_address_q;
                    cache_successor_0_q  = response_address_q[31:3] + 29'd1;
                    cache_line_0_q       = response_line_q;
                    cache_compressed_0_q = {
                        response_line_q[49:48] != 2'b11, response_line_q[33:32] != 2'b11,
                        response_line_q[17:16] != 2'b11, response_line_q[1:0] != 2'b11
                    };
                    cache_valid_0_q      = 1'b1;
                }
            }
        }
    }
}
