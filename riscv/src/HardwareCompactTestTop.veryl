/// Full-address physical access checks with the qualified integer/interrupt configuration.
module HardwareCompactAccessFaultTestTop (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
    jtag_tck   : input  'tap       clock             ,
    jtag_rti1  : input  'tap       logic             ,
    jtag_rti2  : input  'tap       logic             ,
    jtag_shift : input  'tap       logic             ,
    jtag_update: input  'tap       clock             ,
    jtag_rst_n : input  'tap       reset_async_low   ,
    jtag_ce1   : input  'tap       logic             ,
    jtag_ce2   : input  'tap       logic             ,
    jtag_tdo1  : output 'tap       logic             ,
    jtag_tdo2  : output 'tap       logic             ,
) {
    inst board: HardwareTestTop #(
        ENABLE_INTERRUPTS: 1,
        STRICT_MEMORY    : 1,
        PREDICTOR_MODE   : 4,
        ICACHE_INDEX_BITS: 8,
        FAST_LSU         : 6,
        ENABLE_ZBA       : 1,
        ENABLE_ZBB       : 1,
        ENABLE_ZBS       : 1,
        EARLY_BITMANIP   : 1,
        EARLY_TAKEN_FETCH: 1,
        ENABLE_M         : 1,
        M_USE_DSP        : 1,
        EARLY_DIVIDE     : 1,
    ) (
        clk          ,
        clk_cpu      ,
        clk_mem      ,
        pll_locked   ,
        led          ,
        jtag_tdi     ,
        jtag_tck     ,
        jtag_rti1    ,
        jtag_rti2    ,
        jtag_shift   ,
        jtag_update  ,
        jtag_rst_n   ,
        jtag_ce1     ,
        jtag_ce2     ,
        jtag_tdo1    ,
        jtag_tdo2    ,
    );
}

/// Live USB/JTAG console with receive interrupts on the strict physical platform.
module HardwareCompactConsoleTestTop (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
