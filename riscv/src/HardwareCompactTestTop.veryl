/// Compact predictor (64 BTB entries, eight RAS entries) with 4 KiB L1I.
module HardwareCompact4KTestTop (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
    jtag_tck   : input  'tap       clock             ,
    jtag_rti1  : input  'tap       logic             ,
    jtag_rti2  : input  'tap       logic             ,
    jtag_shift : input  'tap       logic             ,
    jtag_update: input  'tap       clock             ,
    jtag_rst_n : input  'tap       reset_async_low   ,
    jtag_ce1   : input  'tap       logic             ,
    jtag_ce2   : input  'tap       logic             ,
    jtag_tdo1  : output 'tap       logic             ,
    jtag_tdo2  : output 'tap       logic             ,
) {
    inst board: HardwareTestTop #(
        PREDICTOR_MODE   : 4,
        ICACHE_INDEX_BITS: 8,
    ) (
        clk          ,
        clk_cpu      ,
        clk_mem      ,
        pll_locked   ,
        led          ,
        jtag_tdi     ,
        jtag_tck     ,
        jtag_rti1    ,
        jtag_rti2    ,
        jtag_shift   ,
        jtag_update  ,
        jtag_rst_n   ,
        jtag_ce1     ,
        jtag_ce2     ,
        jtag_tdo1    ,
        jtag_tdo2    ,
    );
}

/// Compact 32-entry BTB comparison at the same PLL and memory settings.
module HardwareCompact32Cached4KTestTop (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
    jtag_tck   : input  'tap       clock             ,
    jtag_rti1  : input  'tap       logic             ,
    jtag_rti2  : input  'tap       logic             ,
    jtag_shift : input  'tap       logic             ,
    jtag_update: input  'tap       clock             ,
    jtag_rst_n : input  'tap       reset_async_low   ,
    jtag_ce1   : input  'tap       logic             ,
    jtag_ce2   : input  'tap       logic             ,
    jtag_tdo1  : output 'tap       logic             ,
    jtag_tdo2  : output 'tap       logic             ,
) {
    inst board: HardwareTestTop #(
        PREDICTOR_MODE   : 12,
        ICACHE_INDEX_BITS: 8 ,
    ) (
        clk          ,
        clk_cpu      ,
        clk_mem      ,
        pll_locked   ,
        led          ,
        jtag_tdi     ,
        jtag_tck     ,
        jtag_rti1    ,
        jtag_rti2    ,
        jtag_shift   ,
        jtag_update  ,
        jtag_rst_n   ,
        jtag_ce1     ,
        jtag_ce2     ,
        jtag_tdo1    ,
        jtag_tdo2    ,
    );
}

/// Compact 64-entry BTB and direction predictor without RAS, for timing comparison.
module HardwareCompactNoRas4KTestTop (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
    jtag_tck   : input  'tap       clock             ,
    jtag_rti1  : input  'tap       logic             ,
    jtag_rti2  : input  'tap       logic             ,
    jtag_shift : input  'tap       logic             ,
    jtag_update: input  'tap       clock             ,
    jtag_rst_n : input  'tap       reset_async_low   ,
    jtag_ce1   : input  'tap       logic             ,
    jtag_ce2   : input  'tap       logic             ,
    jtag_tdo1  : output 'tap       logic             ,
    jtag_tdo2  : output 'tap       logic             ,
) {
    inst board: HardwareTestTop #(
        PREDICTOR_MODE   : 20,
        ICACHE_INDEX_BITS: 8 ,
    ) (
        clk          ,
        clk_cpu      ,
        clk_mem      ,
        pll_locked   ,
        led          ,
        jtag_tdi     ,
        jtag_tck     ,
        jtag_rti1    ,
        jtag_rti2    ,
        jtag_shift   ,
        jtag_update  ,
        jtag_rst_n   ,
        jtag_ce1     ,
        jtag_ce2     ,
        jtag_tdo1    ,
        jtag_tdo2    ,
    );
}

/// LSU response/forwarding comparison at the same compact predictor and 4 KiB L1I.
module HardwareCompactLsu4KTestTop (
    clk        : input  'reference clock             ,
    clk_cpu    : input  'cpu       clock             ,
    clk_mem    : input  'memory    clock             ,
    pll_locked : input  'cpu       logic             ,
    led        : output 'cpu       logic          <8>,
    jtag_tdi   : input  'tap       logic             ,
    jtag_tck   : input  'tap       clock             ,
    jtag_rti1  : input  'tap       logic             ,
    jtag_rti2  : input  'tap       logic             ,
    jtag_shift : input  'tap       logic             ,
    jtag_update: input  'tap       clock             ,
    jtag_rst_n : input  'tap       reset_async_low   ,
    jtag_ce1   : input  'tap       logic             ,
    jtag_ce2   : input  'tap       logic             ,
    jtag_tdo1  : output 'tap       logic             ,
    jtag_tdo2  : output 'tap       logic             ,
) {
    inst board: HardwareTestTop #(
        PREDICTOR_MODE   : 4,
        ICACHE_INDEX_BITS: 8,
        FAST_LSU         : 1,
    ) (
        clk          ,
        clk_cpu      ,
        clk_mem      ,
        pll_locked   ,
        led          ,
        jtag_tdi     ,
        jtag_tck     ,
        jtag_rti1    ,
        jtag_rti2    ,
        jtag_shift   ,
        jtag_update  ,
        jtag_rst_n   ,
        jtag_ce1     ,
        jtag_ce2     ,
        jtag_tdo1    ,
        jtag_tdo2    ,
    );
}

