/// 256 KiB unified hardware-test memory with a byte-wide debug loader.
///
/// Port A fetches instruction lines on the rising memory edge and becomes the
/// debug write port while the CPU is held in reset. Port B performs synchronous
/// LSU reads and writes on that same memory edge. Eight byte banks preserve
/// arbitrary RV64 load/store alignment without requiring a third memory port.
///
/// Addresses at 0x8000_0000 map directly to the first 252 KiB of BRAM. The
/// reset trampoline at address zero is relocated to the final 4 KiB. The Core
/// holds each LSU request until its response. This module captures instruction,
/// LSU, and stopped-CPU debug request bundles once in the memory domain before
/// address translation and BRAM selection, so related-clock crossings end at
/// simple registers instead of high-fanout BRAM address logic.
/// FAST_LSU=5 presents the CPU's held LSU address directly to port B one edge
/// earlier. The request token and store data/mask remain registered, stores
/// execute once, and the load response still passes through data_output_q.
/// FAST_LSU=6 accepts loads on that prefetched read edge. The matching read
/// data and token return together. The wrapper normally registers that return;
/// the same-rate platform can hold it directly through Core's completion stage.
/// Stores retain the registered request bundle and physical-write response edge.
module HardwareMemory #(
    // 0: original; 1: early store/forwarding; 2: early stores; 3/4: direct load return; 5: read port prefetch.
    param FAST_LSU      : u32 = 0,
    param ENABLE_TIMER  : bit = 0,
    param ENABLE_CONSOLE: bit = 0,
    param STRICT_MEMORY : bit = 0,
    param MEMORY_HZ     : u64 = 62_400_000,
) (
    clk                           : input  'memory clock              ,
    rst_n                         : input  'memory reset_async_low    ,
    timer_rst_n                   : input  'memory reset_async_low    ,
    timer_freeze                  : input  'memory logic              ,
    machine_interrupts            : output 'memory logic          <3> ,
    console_host_request_sequence : input  'memory logic              ,
    console_host_pop              : input  'memory logic              ,
    console_host_push             : input  'memory logic              ,
    console_host_data             : input  'memory logic          <8> ,
    console_host_response_sequence: output 'memory logic              ,
    console_host_response         : output 'memory logic          <16>,
    cpu_instr_address             : input  'memory logic          <32>,
    cpu_instr_line                : output 'memory logic          <64>,
    cpu_instr_request_sequence    : input  'memory logic              ,
    cpu_instr_response_sequence   : output 'memory logic              ,
    cpu_instr_response_address    : output 'memory logic          <32>,
    cpu_instr_response_valid      : output 'memory logic              ,
    cpu_data_address              : input  'memory logic          <32>,
    cpu_data_read                 : output 'memory logic          <64>,
    cpu_data_write                : input  'memory logic          <64>,
    cpu_data_mask                 : input  'memory logic          <8> ,
    cpu_data_we                   : input  'memory logic              ,
    cpu_data_request_sequence     : input  'memory logic              ,
    cpu_data_response_sequence    : output 'memory logic              ,
    debug_write                   : input  'memory logic              ,
    debug_address                 : input  'memory logic          <32>,
    debug_data                    : input  'memory logic          <8> ,
) {
    const BANK_COUNT: u32 = 8;

    var instr_physical     : 'memory logic<18>;
    var instr_port_physical: 'memory logic<18>;
    var debug_physical     : 'memory logic<18>;
    var data_physical      : 'memory logic<18>;

    var instr_read    : 'memory logic<8> [BANK_COUNT];
    var data_bank_read: 'memory logic<8> [BANK_COUNT];

    var data_read_row             : 'memory logic<15> [BANK_COUNT];
    var data_row_base             : 'memory logic<15>             ;
    var data_row_next             : 'memory logic<15>             ;
    var data_row_advance          : 'memory logic<8>              ;
    var store_bank_data           : 'memory logic<8>  [BANK_COUNT];
    var store_bank_mask           : 'memory logic     [BANK_COUNT];
    var store_data_request_rotated: 'memory logic<64>             ;
    var store_mask_request_rotated: 'memory logic<8>              ;
    var data_read_mux             : 'memory logic<64>             ;
    var instr_port_row            : 'memory logic<14>             ;
    var instr_port_high           : 'memory logic                 ;
    var instr_response_bank_q     : 'memory logic<2>              ;
    var instr_request_address_q   : 'memory logic<32>             ;
    var instr_request_sequence_q  : 'memory logic                 ;
    var instr_response_sequence_q : 'memory logic                 ;
    var instr_response_address_q  : 'memory logic<32>             ;
    var instr_response_valid_q    : 'memory logic                 ;
    var debug_write_q             : 'memory logic                 ;
    var debug_address_q           : 'memory logic<32>             ;
    var debug_data_q              : 'memory logic<8>              ;
    var data_port_row             : 'memory logic<14> [BANK_COUNT];
    var data_port_high            : 'memory logic     [BANK_COUNT];
    var data_response_high_q      : 'memory logic     [BANK_COUNT];
    var data_response_select_q    : 'memory logic<4>              ;
    var data_response_rotate4_q   : 'memory logic                 ;
    var data_read_low_rotation    : 'memory logic<64>             ;
    var data_address_q            : 'memory logic<32>             ;
    var data_write_q              : 'memory logic<64>             ;
    var data_mask_q               : 'memory logic<8>              ;
    var data_we_q                 : 'memory logic                 ;
    var data_request_sequence_q   : 'memory logic                 ;
    var data_request_handled_q    : 'memory logic                 ;
    var data_response_sequence_q  : 'memory logic                 ;
    var data_output_q             : 'memory logic<64>             ;
    var data_request_new          : 'memory logic                 ;
    var recent_store_valid_q      : 'memory logic                 ;
    var recent_store_address_q    : 'memory logic<18>             ;
    var recent_store_data_q       : 'memory logic<64>             ;
    var recent_store_hit          : 'memory logic                 ;

    var timer_software_irq    : 'memory logic    ;
    var timer_pending_irq     : 'memory logic    ;
    var timer_read            : 'memory logic<64>;
    var timer_response_q      : 'memory logic<64>;
    var timer_response_valid_q: 'memory logic    ;
    var timer_request         : 'memory logic    ;
    var timer_live_address    : 'memory logic    ;
    var ram_store_request     : 'memory logic    ;
    var console_read          : 'memory logic<64>;
    var console_request       : 'memory logic    ;
    var console_interrupt     : 'memory logic    ;
    assign machine_interrupts = {console_interrupt, timer_pending_irq, timer_software_irq};
    assign timer_request      = ENABLE_TIMER && (data_address_q[31:16] == 16'h0200);
    assign timer_live_address = ENABLE_TIMER && (cpu_data_address[31:16] == 16'h0200);
    assign ram_store_request  = data_request_new && data_we_q && !timer_request;
    assign console_request    = ENABLE_CONSOLE && timer_request && (data_address_q[15:6] == 10'h040);
    if ENABLE_CONSOLE && ENABLE_TIMER :g_console {
        inst console: MachineConsole (
            clk                                                        ,
            rst_n                 : timer_rst_n                        ,
            address               : data_address_q[5:0]                ,
            request               : data_request_new && console_request,
            write_enable          : data_we_q                          ,
            write_data            : data_write_q                       ,
            write_mask            : data_mask_q                        ,
            read_data             : console_read                       ,
            interrupt             : console_interrupt                  ,
            host_request_sequence : console_host_request_sequence      ,
            host_pop              : console_host_pop                   ,
            host_push             : console_host_push                  ,
            host_data             : console_host_data                  ,
            host_response_sequence: console_host_response_sequence     ,
            host_response         : console_host_response              ,
        );
    } else {
        assign console_read                   = 64'd0;
        assign console_interrupt              = 1'b0;
        assign console_host_response_sequence = 1'b0;
        assign console_host_response          = 16'd0;
    }
    if ENABLE_TIMER :g_timer {
        inst timer: MachineTimer #(TIMEBASE_HZ: MEMORY_HZ) (
            clk               : clk                                           ,
            rst_n             : timer_rst_n                                   ,
            freeze            : timer_freeze                                  ,
            address           : data_address_q[15:0]                          ,
            write_enable      : data_request_new && data_we_q && timer_request,
            write_data        : data_write_q                                  ,
            write_mask        : data_mask_q                                   ,
            read_data         : timer_read                                    ,
            software_interrupt: timer_software_irq                            ,
            timer_interrupt   : timer_pending_irq                             ,
        );
        always_ff (clk, rst_n) {
            if_reset {
                timer_response_q       = 64'd0;
                timer_response_valid_q = 1'b0;
            } else {
                if data_request_new {
                    timer_response_q       = if console_request ? console_read : timer_read;
                    timer_response_valid_q = timer_request;
                }
                if (FAST_LSU == 6) && !cpu_data_we && !timer_live_address
                    && (cpu_data_request_sequence != data_request_handled_q) {
                    timer_response_valid_q = 1'b0;
                }
            }
        }
    } else {
        assign timer_read             = 64'd0;
        assign timer_response_q       = 64'd0;
        assign timer_response_valid_q = 1'b0;
        assign timer_software_irq     = 1'b0;
        assign timer_pending_irq      = 1'b0;
    }

    always_comb {
        instr_physical = instr_request_address_q[17:0];
        if !instr_request_address_q[31] {
            instr_physical = {6'h3f, instr_request_address_q[11:0]};
        }
        debug_physical = debug_address_q[17:0];
        if !debug_address_q[31] {
            debug_physical = {6'h3f, debug_address_q[11:0]};
        }
        data_physical = data_address_q[17:0];
        if (FAST_LSU == 5) || (FAST_LSU == 6) {
            // Core holds the address until acknowledgment. Read the held
            // request one edge ahead of its registered token; stores still
            // use the registered data/mask and are performed only once.
            data_physical = cpu_data_address[17:0];
        }
        if debug_write_q {
            instr_port_physical = debug_physical;
        } else {
            instr_port_physical = instr_physical;
        }
        instr_port_row  = instr_port_physical[16:3];
        instr_port_high = instr_port_physical[17];

        data_row_base = data_physical[17:3];
        data_row_next = data_physical[17:3] + 15'd1;
        case data_physical[2:0] {
            3'd0   : data_row_advance = 8'h00;
            3'd1   : data_row_advance = 8'h01;
            3'd2   : data_row_advance = 8'h03;
            3'd3   : data_row_advance = 8'h07;
            3'd4   : data_row_advance = 8'h0f;
            3'd5   : data_row_advance = 8'h1f;
            3'd6   : data_row_advance = 8'h3f;
            default: data_row_advance = 8'h7f;
        }
        for bank in 0..BANK_COUNT {
            data_read_row[bank] = data_row_base;
            if data_row_advance[bank] {
                data_read_row[bank] = data_row_next;
            }
        }

        case data_address_q[2:0] {
            3'd0: {
                store_data_request_rotated = {
                    data_write_q[63:56], data_write_q[55:48], data_write_q[47:40], data_write_q[39:32],
                    data_write_q[31:24], data_write_q[23:16], data_write_q[15:8], data_write_q[7:0]
                };
                store_mask_request_rotated = data_mask_q;
            }
            3'd1: {
                store_data_request_rotated = {
                    data_write_q[55:48], data_write_q[47:40], data_write_q[39:32], data_write_q[31:24],
                    data_write_q[23:16], data_write_q[15:8], data_write_q[7:0], data_write_q[63:56]
                };
                store_mask_request_rotated = {data_mask_q[6:0], data_mask_q[7]};
            }
            3'd2: {
                store_data_request_rotated = {
                    data_write_q[47:40], data_write_q[39:32], data_write_q[31:24], data_write_q[23:16],
                    data_write_q[15:8], data_write_q[7:0], data_write_q[63:56], data_write_q[55:48]
                };
                store_mask_request_rotated = {data_mask_q[5:0], data_mask_q[7:6]};
            }
            3'd3: {
                store_data_request_rotated = {
                    data_write_q[39:32], data_write_q[31:24], data_write_q[23:16], data_write_q[15:8],
                    data_write_q[7:0], data_write_q[63:56], data_write_q[55:48], data_write_q[47:40]
                };
                store_mask_request_rotated = {data_mask_q[4:0], data_mask_q[7:5]};
            }
            3'd4: {
                store_data_request_rotated = {
                    data_write_q[31:24], data_write_q[23:16], data_write_q[15:8], data_write_q[7:0],
                    data_write_q[63:56], data_write_q[55:48], data_write_q[47:40], data_write_q[39:32]
                };
                store_mask_request_rotated = {data_mask_q[3:0], data_mask_q[7:4]};
            }
            3'd5: {
                store_data_request_rotated = {
                    data_write_q[23:16], data_write_q[15:8], data_write_q[7:0], data_write_q[63:56],
                    data_write_q[55:48], data_write_q[47:40], data_write_q[39:32], data_write_q[31:24]
                };
                store_mask_request_rotated = {data_mask_q[2:0], data_mask_q[7:3]};
            }
            3'd6: {
                store_data_request_rotated = {
                    data_write_q[15:8], data_write_q[7:0], data_write_q[63:56], data_write_q[55:48],
                    data_write_q[47:40], data_write_q[39:32], data_write_q[31:24], data_write_q[23:16]
                };
                store_mask_request_rotated = {data_mask_q[1:0], data_mask_q[7:2]};
            }
            default: {
                store_data_request_rotated = {
                    data_write_q[7:0], data_write_q[63:56], data_write_q[55:48], data_write_q[47:40],
                    data_write_q[39:32], data_write_q[31:24], data_write_q[23:16], data_write_q[15:8]
                };
                store_mask_request_rotated = {data_mask_q[0], data_mask_q[7:1]};
            }
        }

        data_request_new = data_request_sequence_q != data_request_handled_q;
        // One full-width, physically completed store. Partial or intervening
        // stores invalidate the entry; other/overlapping loads use the RAM.
        // Compare the actual BRAM address, including its 256 KiB aliasing.
        recent_store_hit = (FAST_LSU == 1) && recent_store_valid_q && !data_we_q && !timer_request
            && (data_physical == recent_store_address_q);

        for bank in 0..BANK_COUNT {
            store_bank_data[bank] = store_data_request_rotated[bank step 8];
            store_bank_mask[bank] = store_mask_request_rotated[bank];

            data_port_row[bank]  = data_read_row[bank][13:0];
            data_port_high[bank] = data_read_row[bank][14];
        }

        // Decode the low rotation bits on the existing RAM read edge.
        // Four parallel terms followed by a 32-bit half swap keep the data
        // path shallow without the fanout of a full eight-way crossbar.
        // Request and response edges are unchanged.
        for byte in 0..BANK_COUNT {
            data_read_low_rotation[byte step 8] =
                (data_bank_read[(byte + 0) % BANK_COUNT] & {data_response_select_q[0] repeat 8})
                | (data_bank_read[(byte + 1) % BANK_COUNT] & {data_response_select_q[1] repeat 8})
                | (data_bank_read[(byte + 2) % BANK_COUNT] & {data_response_select_q[2] repeat 8})
                | (data_bank_read[(byte + 3) % BANK_COUNT] & {data_response_select_q[3] repeat 8});
        }
        data_read_mux = if data_response_rotate4_q ?
            {data_read_low_rotation[31:0], data_read_low_rotation[63:32]} : data_read_low_rotation;

        cpu_instr_line              = {
            instr_read[7], instr_read[6], instr_read[5], instr_read[4], instr_read[3], instr_read[2], instr_read[1],
            instr_read[0]
        };
        cpu_instr_response_address  = instr_response_address_q;
        cpu_instr_response_valid    = instr_response_valid_q;
        cpu_instr_response_sequence = instr_response_sequence_q;
        cpu_data_read               = data_output_q;
        if (FAST_LSU == 3) || (FAST_LSU == 4) || (FAST_LSU == 6) {
            // BRAM outputs and their bank/byte selectors update together.
            // The related CPU clock captures this bundle after the RAM edge.
            cpu_data_read = data_read_mux;
        }
        if timer_response_valid_q {
            cpu_data_read = timer_response_q;
        }
        cpu_data_response_sequence = data_response_sequence_q;
    }

    // Keep every synchronous RAM read destination scalar inside its generated
    // lane. This preserves the canonical true-dual-port inference shape while
    // removing all hand-unrolled byte-bank control.
    for bank in 0..BANK_COUNT :g_bank {
        #[sv("struo_memory = \"required\"")]
        var mem_low: 'memory logic<8> [16384];
        #[sv("struo_memory = \"required\"")]
        var mem_high: 'memory logic<8> [16384];

        var instr_read_low : 'memory logic<8>;
        var instr_read_high: 'memory logic<8>;
        var data_read_low  : 'memory logic<8>;
        var data_read_high : 'memory logic<8>;

        always_comb {
            instr_read[bank]     = (instr_read_low & {instr_response_bank_q[0] repeat 8})
                | (instr_read_high & {instr_response_bank_q[1] repeat 8});
            data_bank_read[bank] = data_read_low;
            if data_response_high_q[bank] {
                data_bank_read[bank] = data_read_high;
            }
        }

        always_ff (clk) {
            if debug_write_q && (debug_physical[2:0] == bank as 3) && !instr_port_high {
                mem_low[instr_port_row] = debug_data_q;
            } else {
                instr_read_low = mem_low[instr_port_row];
            }
        }
        always_ff (clk) {
            if debug_write_q && (debug_physical[2:0] == bank as 3) && instr_port_high {
                mem_high[instr_port_row] = debug_data_q;
            } else {
                instr_read_high = mem_high[instr_port_row];
            }
        }
        always_ff (clk) {
            if ram_store_request && store_bank_mask[bank] && !data_port_high[bank] {
                mem_low[data_port_row[bank]] = store_bank_data[bank];
            } else {
                data_read_low = mem_low[data_port_row[bank]];
            }
        }
        always_ff (clk) {
            if ram_store_request && store_bank_mask[bank] && data_port_high[bank] {
                mem_high[data_port_row[bank]] = store_bank_data[bank];
            } else {
                data_read_high = mem_high[data_port_row[bank]];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            instr_request_address_q   = 32'h0000_0000;
            instr_response_address_q  = 32'h0000_0000;
            instr_response_valid_q    = 1'b0;
            instr_request_sequence_q  = 1'b0;
            instr_response_sequence_q = 1'b0;
            debug_write_q             = 1'b0;
            debug_address_q           = 32'h0000_0000;
            debug_data_q              = 8'h00;
            data_address_q            = 32'h0000_0000;
            data_write_q              = 64'h0000_0000_0000_0000;
            data_mask_q               = 8'h00;
            data_we_q                 = 1'b0;
            data_request_sequence_q   = 1'b0;
            data_request_handled_q    = 1'b0;
            data_response_sequence_q  = 1'b0;
            data_output_q             = 64'h0000_0000_0000_0000;
        } else {
            // Capture every request interface before address translation or
            // byte-bank selection. The instruction response tag follows its
            // request register, matching the address sampled by the BRAM one
            // edge later; InstructionBuffer accepts variable tagged latency.
            instr_request_address_q  = cpu_instr_address;
            instr_request_sequence_q = cpu_instr_request_sequence;
            debug_write_q            = debug_write;
            debug_address_q          = debug_address;
            debug_data_q             = debug_data;
            data_address_q           = cpu_data_address;
            data_write_q             = cpu_data_write;
            data_mask_q              = cpu_data_mask;
            data_we_q                = cpu_data_we;
            data_request_sequence_q  = cpu_data_request_sequence;
            // The bank/high/byte selection cone is registered in the slow
            // domain. Publish its token on the same edge, then let Core's
            // CPU-domain stage capture the stable bundle.
            data_output_q             = data_read_mux;
            data_response_sequence_q  = data_request_handled_q;
            instr_response_address_q  = {instr_request_address_q[31:3], 3'b000};
            instr_response_sequence_q = instr_request_sequence_q;
            instr_response_valid_q    = !debug_write_q;
            if data_request_new {
                data_request_handled_q = data_request_sequence_q;
                if FAST_LSU != 0 {
                    // A store is acknowledged on the same edge that writes
                    // every enabled byte bank. No uncompleted store retires,
                    // so FENCE/FENCE.I and terminal tohost keep their ordering.
                    if data_we_q || recent_store_hit || (FAST_LSU >= 3) {
                        data_response_sequence_q = data_request_sequence_q;
                    }
                    if recent_store_hit {
                        data_output_q = recent_store_data_q;
                    }

                }
            }

            // Core holds a single outstanding request until acknowledgment.
            // Port B and its byte/high selectors sample this same held address
            // on this edge. The wrapper registers their post-edge result and
            // this token together before Core can observe a completed load.
            if (FAST_LSU == 6) && !cpu_data_we && !timer_live_address
                && (cpu_data_request_sequence != data_request_handled_q) {
                data_request_handled_q   = cpu_data_request_sequence;
                data_response_sequence_q = cpu_data_request_sequence;
            }

        }
    }

    // Omit the entire entry when disabled; reset-only payload FFs otherwise
    // survive synthesis even though FAST_LSU masks their outputs.
    if FAST_LSU == 1 :g_recent_store {
        always_ff (clk, rst_n) {
            if_reset {
                recent_store_valid_q   = 1'b0;
                recent_store_address_q = 18'd0;
                recent_store_data_q    = 64'd0;
            } else {
                if data_request_new && data_we_q {
                    recent_store_valid_q   = (data_mask_q == 8'hff) && !timer_request;
                    recent_store_address_q = data_physical;
                    recent_store_data_q    = data_write_q;
                }
                // Debug writes occur with the CPU stopped. Never reuse the
                // saved word after any byte has been changed by the loader.
                if debug_write_q {
                    recent_store_valid_q = 1'b0;
                }
            }
        }
    } else {
        assign recent_store_valid_q   = 1'b0;
        assign recent_store_address_q = 18'd0;
        assign recent_store_data_q    = 64'd0;
    }

    always_ff (clk) {
        // Decode permission and bank together before the response edge.
        // Each returned bit then needs only a four-input AND/OR selection;
        // no address decoder follows the BRAM output or its bank selector.
        // Speculative invalid fills remain inert; Core faults only demanded PCs.
        instr_response_bank_q = {instr_port_physical[17], !instr_port_physical[17]};
        if STRICT_MEMORY
            && !((instr_request_address_q[31:12] == 20'd0)
                || ((instr_request_address_q[31:18] == 14'h2000) && (instr_request_address_q[17:12] != 6'h3f))) {
            instr_response_bank_q = 2'b00;
        }
        data_response_select_q = 4'd1 << data_physical[1:0];
        data_response_rotate4_q = data_physical[2];
        for bank in 0..BANK_COUNT {
            data_response_high_q[bank] = data_read_row[bank][14];
        }
    }
}

/// Console queues and registers in one memory-clock domain. Host request
/// bundles remain held until the matching response sequence is observed.
module MachineConsole (
    clk                   : input  clock              ,
    rst_n                 : input  reset_async_low    ,
    address               : input  logic          <6> ,
    request               : input  logic              ,
    write_enable          : input  logic              ,
    write_data            : input  logic          <64>,
    write_mask            : input  logic          <8> ,
    read_data             : output logic          <64>,
    interrupt             : output logic              ,
    host_request_sequence : input  logic              ,
    host_pop              : input  logic              ,
    host_push             : input  logic              ,
    host_data             : input  logic          <8> ,
    host_response_sequence: output logic              ,
    host_response         : output logic          <16>,
) {
    var tx_bytes       : logic<8>  [16];
    var rx_bytes       : logic<8>  [16];
    var tx_head        : logic<4>      ;
    var tx_tail        : logic<4>      ;
    var rx_head        : logic<4>      ;
    var rx_tail        : logic<4>      ;
    var tx_count       : logic<5>      ;
    var rx_count       : logic<5>      ;
    var rx_irq_enable  : logic         ;
    var errors         : logic<2>      ;
    var host_sequence_q: logic         ;
    var host_pop_q     : logic         ;
    var host_push_q    : logic         ;
    var host_data_q    : logic<8>      ;
    var host_new       : logic         ;
    var tx_front       : logic<8>      ;
    var rx_front       : logic<8>      ;
    var tx_push_request: logic         ;
    var tx_push        : logic         ;
    var tx_pop         : logic         ;
    var rx_push        : logic         ;
    var rx_pop         : logic         ;
    var low_byte_write : logic         ;
    var read_word      : logic<64>     ;

    // Select by one index bit per level. A dynamic unpacked-array read was
    // lowered into a long priority chain on the console response path.
    inst tx_read: ConsoleQueueRead (bytes: tx_bytes, head: tx_head, front: tx_front);
    inst rx_read: ConsoleQueueRead (bytes: rx_bytes, head: rx_head, front: rx_front);

    always_comb {
        host_new        = host_sequence_q != host_response_sequence;
        low_byte_write  = request && write_enable && (address[2:0] == 3'd0) && write_mask[0];
        tx_push_request = low_byte_write && (address[5:3] == 3'd0);
        rx_pop          = request && !write_enable && (address == 6'h08) && (rx_count != 5'd0);
        tx_pop          = host_new && host_pop_q && (tx_count != 5'd0);
        tx_push         = tx_push_request && ((tx_count != 5'd16) || tx_pop);
        rx_push         = host_new && host_push_q && ((rx_count != 5'd16) || rx_pop);
        interrupt       = rx_irq_enable && (rx_count != 5'd0);
        read_word       = 64'd0;
        case address[5:3] {
            3'd1   : if rx_count != 5'd0 {
                read_word = {55'd0, 1'b1, rx_front};
            }
            3'd2   : read_word = {60'd0, rx_count != 5'd16, tx_count != 5'd0, rx_count != 5'd0, tx_count != 5'd16};
            3'd3   : read_word = {63'd0, rx_irq_enable};
            3'd4   : read_word = 64'h0000_0000_434f_4e01;
            3'd5   : read_word = {51'd0, rx_count, 3'd0, tx_count};
            3'd6   : read_word = {62'd0, errors};
            default: {}
        }
        read_data = read_word >> {address[2:0], 3'b000};
    }

    always_ff (clk, rst_n) {
        if_reset {
            tx_head                = 4'd0;
            tx_tail                = 4'd0;
            rx_head                = 4'd0;
            rx_tail                = 4'd0;
            tx_count               = 5'd0;
            rx_count               = 5'd0;
            rx_irq_enable          = 1'b0;
            errors                 = 2'd0;
            host_sequence_q        = 1'b0;
            host_pop_q             = 1'b0;
            host_push_q            = 1'b0;
            host_data_q            = 8'd0;
            host_response_sequence = 1'b0;
            host_response          = 16'd0;
            for index in 0..16 {
                tx_bytes[index] = 8'd0;
                rx_bytes[index] = 8'd0;
            }
        } else {
            host_sequence_q = host_request_sequence;
            host_pop_q      = host_pop;
            host_push_q     = host_push;
            host_data_q     = host_data;
            if host_new {
                host_response_sequence = host_sequence_q;
                host_response          = {4'd0, (rx_count != 5'd16) || rx_pop, tx_count != 5'd0, rx_push, tx_pop, 8'd0};
                if tx_pop {
                    host_response[7:0]     = tx_front;
                }
            }
            if tx_push {
                tx_bytes[tx_tail] = write_data[7:0];
                tx_tail           = tx_tail + 4'd1;
            }
            if tx_pop {
                tx_head           = tx_head + 4'd1;
            }
            if tx_push && !tx_pop {
                tx_count          = tx_count + 5'd1;
            }
            if tx_pop && !tx_push {
                tx_count          = tx_count - 5'd1;
            }
            if rx_push {
                rx_bytes[rx_tail] = host_data_q;
                rx_tail           = rx_tail + 4'd1;
            }
            if rx_pop {
                rx_head           = rx_head + 4'd1;
            }
            if rx_push && !rx_pop {
                rx_count          = rx_count + 5'd1;
            }
            if rx_pop && !rx_push {
                rx_count          = rx_count - 5'd1;
            }
            if low_byte_write && (address[5:3] == 3'd3) {
                rx_irq_enable     = write_data[0];
            }
            if low_byte_write && (address[5:3] == 3'd6) {
                errors            = errors & ~write_data[1:0];
            }
            if tx_push_request && !tx_push {
                errors[0]         = 1'b1;
            }
            if host_new && host_push_q && !rx_push {
                errors[1]         = 1'b1;
            }
        }
    }
}

/// Balanced read of a 16-byte queue; no extra state or response latency.
module ConsoleQueueRead (
    bytes: input logic<8> [16],
    head : input logic<4>,
    front: output logic<8>,
) {
    var pairs : logic<8> [8];
    var quads : logic<8> [4];
    var halves: logic<8> [2];
    always_comb {
        for i in 0..8 {
            pairs[i] = if head[0] ? bytes[i * 2 + 1] : bytes[i * 2];
        }
        for i in 0..4 {
            quads[i] = if head[1] ? pairs[i * 2 + 1] : pairs[i * 2];
        }
        for i in 0..2 {
            halves[i] = if head[2] ? quads[i * 2 + 1] : quads[i * 2];
        }
        front = if head[3] ? halves[1] : halves[0];
    }
}

/// Single-hart machine timer in the platform's memory clock domain.
/// The platform maps this 64 KiB window at 0x0200_0000. Each register exposes
/// little-endian byte lanes; a transfer crossing an 8-byte register boundary
/// reads zero / ignores writes beyond that register. Reserved addresses are
/// side-effect free and never select BRAM. Reset stops time at zero, clears
/// MSIP, and sets MTIMECMP to all ones. An mtime write wins over increment.
module MachineTimer #(param TIMEBASE_HZ: u64 = 62_400_000) (
    clk               : input  clock    ,
    rst_n             : input  reset    ,
    freeze            : input  logic    ,
    address           : input  logic<16>,
    write_enable      : input  logic    ,
    write_data        : input  logic<64>,
    write_mask        : input  logic<8> ,
    read_data         : output logic<64>,
    software_interrupt: output logic    ,
    timer_interrupt   : output logic    ,
) {
    var time_low_q      : logic<32>;
    var time_high_q     : logic<32>;
    var compare_q       : logic<64>;
    var software_q      : logic    ;
    var timer_q         : logic    ;
    var time_value      : logic<64>;
    var low_plus_one    : logic<33>;
    var high_plus_one   : logic<32>;
    var register_read   : logic<64>;
    var shifted_data    : logic<64>;
    var shifted_mask    : logic<8> ;
    var time_write_value: logic<64>;
    var time_write      : logic    ;
    var compare_write   : logic    ;
    var software_write  : logic    ;

    always_comb {
        time_value       = {time_high_q, time_low_q};
        low_plus_one     = {1'b0, time_low_q} + 33'd1;
        high_plus_one    = time_high_q + 32'd1;
        shifted_data     = write_data << {address[2:0], 3'b000};
        shifted_mask     = write_mask << address[2:0];
        time_write       = write_enable && (address[15:3] == 13'h17ff) && (shifted_mask != 8'd0);
        compare_write    = write_enable && (address[15:3] == 13'h0800);
        software_write   = write_enable && (address[15:3] == 13'h0000) && shifted_mask[0];
        time_write_value = time_value;
        for byte in 0..8 {
            if shifted_mask[byte] {
                time_write_value[byte step 8] = shifted_data[byte step 8];
            }
        }
        register_read = 64'd0;
        case address[15:3] {
            13'h0000: register_read = {63'd0, software_q};
            13'h0800: register_read = compare_q;
            13'h17fe: register_read = TIMEBASE_HZ; // Platform timebase Hz, read-only.
            13'h17ff: register_read = time_value;
            default : register_read = 64'd0;
        }
        read_data          = register_read >> {address[2:0], 3'b000};
        software_interrupt = software_q;
        timer_interrupt    = timer_q;
    }

    always_ff (clk, rst_n) {
        if_reset {
            time_low_q = 32'd0;
        } else if time_write || !freeze {
            if time_write {
                time_low_q = time_write_value[31:0];
            } else {
                time_low_q = low_plus_one[31:0];
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            time_high_q = 32'd0;
        } else if time_write || (!freeze && low_plus_one[32]) {
            if time_write {
                time_high_q = time_write_value[63:32];
            } else {
                time_high_q = high_plus_one;
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            compare_q = 64'hffff_ffff_ffff_ffff;
        } else if compare_write {
            for byte in 0..8 {
                if shifted_mask[byte] {
                    compare_q[byte step 8] = shifted_data[byte step 8];
                }
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            software_q = 1'b0;
            timer_q    = 1'b0;
        } else {
            if software_write {
                software_q = shifted_data[0];
            }
            // A registered comparison deliberately allows the specification's
            // eventual MTIP update. Clearing MTIMECMP can leave a short tail;
            // handlers must tolerate a repeated timer interrupt after MRET.
            timer_q = time_value >= compare_q;
        }
    }
}
