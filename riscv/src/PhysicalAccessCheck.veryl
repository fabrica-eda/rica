/// Bounds for the single-hart BRAM/timer platform, before address truncation.
/// RAM permits unaligned transfers, but every requested byte must fit in one
/// mapped region. Timer accesses must be naturally aligned; emulating a split
/// peripheral transfer is not supported. Instruction fetch never selects MMIO.
module PhysicalAccessCheck #(
    param ENABLE_TIMER: bit = 0,
) (
    address      : input  logic<64>,
    size         : input  logic<2> ,
    instruction  : input  logic    ,
    allowed      : output logic    ,
    crosses_bound: output logic    ,
    fault_address: output logic<64>,
) {
    var boot_region : logic   ;
    var ram_region  : logic   ;
    var timer_region: logic   ;
    var aligned     : logic   ;
    var lane_cross  : logic   ;
    var boot_cross  : logic   ;
    var ram_cross   : logic   ;

    always_comb {
        boot_region  = address[63:12] == 52'd0;
        ram_region   = (address[63:18] == 46'h0000_0000_2000) && (address[17:12] != 6'h3f);
        timer_region = ENABLE_TIMER && !instruction && (address[63:16] == 48'h0000_0000_0200);
        lane_cross   = 1'b0;
        aligned      = 1'b1;
        case size {
            2'd1: {
                lane_cross = address[2:0] == 3'd7;
                aligned   = address[0] == 1'b0;
            }
            2'd2: {
                lane_cross = address[2] && (address[1] || address[0]);
                aligned   = address[1:0] == 2'd0;
            }
            2'd3: {
                lane_cross = address[2:0] != 3'd0;
                aligned   = address[2:0] == 3'd0;
            }
            default: {}
        }
        // Region ends are eight-byte aligned. Compare the starting lane with
        // the last legal lane for each width, avoiding an instruction-length
        // decoder followed by a carry chain on the fetch-valid path.
        boot_cross    = boot_region && (address[11:3] == 9'h1ff) && lane_cross;
        ram_cross     = ram_region && (address[17:3] == 15'h7dff) && lane_cross;
        crosses_bound = boot_cross || ram_cross;
        allowed       = ((boot_region || ram_region) && !crosses_bound) || (timer_region && aligned);
        fault_address = address;
        if boot_cross {
            fault_address = 64'h0000_0000_0000_1000;
        } else if ram_cross {
            fault_address = 64'h0000_0000_8003_f000;
        }
    }
}
