/// Privileged CSR bank for precise traps and optional interrupts.
///
/// Rica has one hart; ENABLE_U adds user privilege and PMP, and ENABLE_S
/// (which requires ENABLE_U) adds supervisor privilege with trap delegation.
/// The implemented state is nevertheless architectural: trap entry records
/// xEPC/xCAUSE/xTVAL in the mode selected by MEDELEG/MIDELEG and updates the
/// status stack, while MRET and SRET restore it and return to xEPC.
/// Supervisor address translation is Bare only: SATP reads zero and ignores
/// writes, which the privileged ISA permits for an unsupported MODE.
module CsrFile #(
    param ENABLE_M         : bit = 0,
    param ENABLE_U: bit = 0,
    param ENABLE_S: bit = 0,
    param ENABLE_A         : bit = 0,
    param ENABLE_B         : bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
    param FULL_ADDRESS     : bit = 0,
) (
    clk  : input   clock       ,
    rst_n: input   reset       ,
    csr  : modport CsrBus::file,
) {
    const ADDRESS_BITS: u32 = 32 + 32 * (FULL_ADDRESS as u32);
    // Physical execution remains bounded; full-width state retains bad addresses.
    // Keep only implemented WARL/WLRL fields in flops; CSR reads expand them
    // to XLEN. This avoids routing 64-bit write muxes to mostly constant state.
    // {MPP[1:0], MPIE, MIE}
    var user_q: logic;
    var supervisor_q: logic;
    var mprv_q: logic;
    var counter_enable_q: logic<3>;
    // Supervisor state. Status bits are the SSTATUS view of MSTATUS:
    // {TSR, TW, TVM, MXR, SPP, SPIE, SIE}.
    var supervisor_status_q: logic<7>;
    var supervisor_status_write: logic<7>;
    var supervisor_counter_enable_q: logic<3>;
    var stvec_q: logic<ADDRESS_BITS - 2>;
    var sscratch_q: logic<64>;
    var sepc_q: logic<ADDRESS_BITS - 1>;
    var scause_q: logic<4>;
    var scause_interrupt_q: logic;
    var stval_q: logic<ADDRESS_BITS>;
    // Synchronous exceptions 0..15 except ECALL from M (11) and the reserved
    // codes 10 and 14. Interrupt delegation and the supervisor enable and
    // software-pending bits use the order {external, timer, software}.
    var medeleg_q: logic<16>;
    var mideleg_q: logic<3>;
    var supervisor_interrupt_enable_q: logic<3>;
    var supervisor_interrupt_pending_q: logic<3>;
    var supervisor_interrupts_enabled: logic<3>;
    var machine_interrupt_candidates: logic<6>;
    var supervisor_interrupt_candidates: logic<3>;
    var machine_interrupt_taken: logic;
    var trap_to_supervisor: logic;
    var supervisor_write: logic;
    var sstatus_read_value: logic<64>;
    var sie_read: logic<64>;
    var sip_read: logic<64>;
    var csr_supervisor_level0: logic<64> [8];
    var csr_supervisor_level1: logic<64> [4];
    var csr_supervisor_level2: logic<64> [2];
    var mstatus_write: logic<64>;
    var mstatus_q         : logic<4>               ;
    var mtvec_q           : logic<ADDRESS_BITS - 2>;
    var mscratch_q        : logic<64>              ;
    var mepc_q            : logic<ADDRESS_BITS - 1>;
    var mcause_q          : logic<4>               ;
    var mcause_interrupt_q: logic                  ;
    var mie_q             : logic<3>               ;
    var interrupt_enabled : logic<3>               ;
    var mie_read          : logic<64>              ;
    var mip_read          : logic<64>              ;
    var mtval_q           : logic<ADDRESS_BITS>    ;
    var mcycle_value      : logic<64>              ;
    var minstret_value    : logic<64>              ;

    // The two custom machine CSRs at 0x7c0/0x7c1 select and access one of nine
    // implementation-defined event counters without consuming nine entries
    // in the compact CSR index. Selectors 0..3 are mutually exclusive
    // pipeline-cycle classes; selectors 4..8 are independent predictor events.
    var stall_selector_q       : logic<4>     ;
    var event_counter_value    : logic<64> [4];
    var predictor_counter_value: logic<64> [5];
    var selected_stall_counter : logic<64>    ;
    var selected_counter_value : logic<64>    ;
    var counter_write_value    : logic<64>    ;
    // Struo currently lowers a many-arm case as a priority mux chain.  Spell
    // both read muxes as explicit binary trees so their physical depth grows
    // with the selector width rather than the number of CSR values.
    var stall_mux_level0                   : logic<64> [8];
    var stall_mux_level1                   : logic<64> [4];
    var stall_mux_level2                   : logic<64> [2];
    var csr_mux_level0                     : logic<64> [8];
    var csr_mux_level1                     : logic<64> [4];
    var csr_mux_level2                     : logic<64> [2];
    var csr_upper_level0: logic<64> [8];
    var csr_upper_level1: logic<64> [4];
    var csr_upper_level2: logic<64> [2];
    var mstatus_read_value                 : logic<64>    ;
    var event_dependency_q                 : logic        ;
    var event_memory_wait_q                : logic        ;
    var event_redirect_q                   : logic        ;
    var event_frontend_empty_q             : logic        ;
    var predictor_conditional_q            : logic        ;
    var predictor_direction_wrong_q        : logic        ;
    var predictor_btb_miss_q               : logic        ;
    var predictor_ras_fallback_q           : logic        ;
    var predictor_repair_q                 : logic        ;
    var event_freeze_q                     : logic        ;
    var event_write_q                      : logic        ;
    var event_write_index_q                : logic<4>     ;
    var event_increment_valid              : logic        ;
    var event_increment_index              : logic<2>     ;
    var predictor_conditional_increment    : logic        ;
    var predictor_direction_wrong_increment: logic        ;
    var predictor_btb_miss_increment       : logic        ;
    var predictor_ras_fallback_increment   : logic        ;
    var predictor_repair_increment         : logic        ;

    inst mcycle_counter: PerformanceCounter64 (
        clk         : clk                                                                     ,
        rst_n       : rst_n                                                                   ,
        write_enable: csr.write_enable && (csr.write_index == 6'd12) && (csr.write_op != 2'd3),
        write_value : counter_write_value                                                     ,
        increment   : 1'b1                                                                    ,
        freeze      : csr.counter_freeze                                                      ,
        value       : mcycle_value                                                            ,
    );

    inst minstret_counter: PerformanceCounter64 (
        clk         : clk                                                                     ,
        rst_n       : rst_n                                                                   ,
        write_enable: csr.write_enable && (csr.write_index == 6'd13) && (csr.write_op != 2'd3),
        write_value : counter_write_value                                                     ,
        increment   : csr.retire                                                              ,
        freeze      : csr.counter_freeze                                                      ,
        value       : minstret_value                                                          ,
    );

    inst event_counters: PerformanceEventCounters4 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q <: 4'd4),
        write_index    : stall_selector_q[1:0],
        write_value    : counter_write_value  ,
        increment_valid: event_increment_valid,
        increment_index: event_increment_index,
        freeze         : event_freeze_q       ,
        value          : event_counter_value  ,
    );

    inst predictor_conditional_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd4),
        write_value: counter_write_value            ,
        increment  : predictor_conditional_increment,
        freeze     : event_freeze_q                 ,
        value      : predictor_counter_value[0]     ,
    );

    inst predictor_direction_wrong_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd5),
        write_value: counter_write_value                ,
        increment  : predictor_direction_wrong_increment,
        freeze     : event_freeze_q                     ,
        value      : predictor_counter_value[1]         ,
    );

    inst predictor_btb_miss_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd6),
        write_value: counter_write_value         ,
        increment  : predictor_btb_miss_increment,
        freeze     : event_freeze_q              ,
        value      : predictor_counter_value[2]  ,
    );

    inst predictor_ras_fallback_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd7),
        write_value: counter_write_value             ,
        increment  : predictor_ras_fallback_increment,
        freeze     : event_freeze_q                  ,
        value      : predictor_counter_value[3]      ,
    );

    inst predictor_repair_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd8),
        write_value: counter_write_value       ,
        increment  : predictor_repair_increment,
        freeze     : event_freeze_q            ,
        value      : predictor_counter_value[4],
    );

    always_comb {
        // The inputs were sampled together before this boundary. Apply the
        // pipeline controller's priority here exactly once; a lower-priority
        // event must neither select nor increment its counter when predicates
        // overlap in the original cycle.
        event_increment_valid = 1'b0;
        event_increment_index = 2'd0;
        if event_memory_wait_q {
            event_increment_index = 2'd1;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd1));
        } else if event_redirect_q {
            event_increment_index = 2'd2;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd2));
        } else if event_dependency_q {
            event_increment_index = 2'd0;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd0));
        } else if event_frontend_empty_q {
            event_increment_index = 2'd3;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd3));
        }
        predictor_conditional_increment     = predictor_conditional_q
            && !(event_write_q && (event_write_index_q == 4'd4));
        predictor_direction_wrong_increment = predictor_direction_wrong_q
            && !(event_write_q && (event_write_index_q == 4'd5));
        predictor_btb_miss_increment        = predictor_btb_miss_q && !(event_write_q && (event_write_index_q == 4'd6));
        predictor_ras_fallback_increment    = predictor_ras_fallback_q
            && !(event_write_q && (event_write_index_q == 4'd7));
        predictor_repair_increment          = predictor_repair_q && !(event_write_q && (event_write_index_q == 4'd8));

        if stall_selector_q[0] {
            stall_mux_level0[0] = event_counter_value[1];
            stall_mux_level0[1] = event_counter_value[3];
            stall_mux_level0[2] = predictor_counter_value[1];
            stall_mux_level0[3] = predictor_counter_value[3];
            stall_mux_level0[4] = 64'd0;
        } else {
            stall_mux_level0[0] = event_counter_value[0];
            stall_mux_level0[1] = event_counter_value[2];
            stall_mux_level0[2] = predictor_counter_value[0];
            stall_mux_level0[3] = predictor_counter_value[2];
            stall_mux_level0[4] = predictor_counter_value[4];
        }
        stall_mux_level0[5] = 64'd0;
        stall_mux_level0[6] = 64'd0;
        stall_mux_level0[7] = 64'd0;
        if stall_selector_q[1] {
            stall_mux_level1[0] = stall_mux_level0[1];
            stall_mux_level1[1] = stall_mux_level0[3];
            stall_mux_level1[2] = stall_mux_level0[5];
            stall_mux_level1[3] = stall_mux_level0[7];
        } else {
            stall_mux_level1[0] = stall_mux_level0[0];
            stall_mux_level1[1] = stall_mux_level0[2];
            stall_mux_level1[2] = stall_mux_level0[4];
            stall_mux_level1[3] = stall_mux_level0[6];
        }
        if stall_selector_q[2] {
            stall_mux_level2[0] = stall_mux_level1[1];
            stall_mux_level2[1] = stall_mux_level1[3];
        } else {
            stall_mux_level2[0] = stall_mux_level1[0];
            stall_mux_level2[1] = stall_mux_level1[2];
        }
        if stall_selector_q[3] {
            selected_stall_counter = stall_mux_level2[1];
        } else {
            selected_stall_counter = stall_mux_level2[0];
        }

        selected_counter_value = selected_stall_counter;
        if csr.write_index == 6'd12 {
            selected_counter_value = mcycle_value;
        } else if csr.write_index == 6'd13 {
            selected_counter_value = minstret_value;
        }
        if csr.write_op == 2'd1 {
            counter_write_value = selected_counter_value | csr.write_source;
        } else if csr.write_op == 2'd2 {
            counter_write_value = selected_counter_value & ~csr.write_source;
        } else {
            counter_write_value = csr.write_source;
        }

        mstatus_read_value        = 64'd0;
        mstatus_read_value[3]     = mstatus_q[0];
        mstatus_read_value[7]     = mstatus_q[1];
        mstatus_read_value[12:11] = mstatus_q[3:2];
        if ENABLE_U {
            mstatus_read_value[33:32] = 2'd2;
            mstatus_read_value[17] = mprv_q;
        }
        sstatus_read_value = 64'd0;
        if ENABLE_S {
            sstatus_read_value[1] = supervisor_status_q[0];
            sstatus_read_value[5] = supervisor_status_q[1];
            sstatus_read_value[8] = supervisor_status_q[2];
            sstatus_read_value[19] = supervisor_status_q[3];
            sstatus_read_value[33:32] = 2'd2;
            mstatus_read_value = mstatus_read_value | sstatus_read_value;
            mstatus_read_value[22:20] = supervisor_status_q[6:4];
            mstatus_read_value[35:34] = 2'd2;
        }
        mstatus_write = csr.write_source;
        if csr.write_op == 2'd1 { mstatus_write = mstatus_read_value | csr.write_source; }
        else if csr.write_op == 2'd2 { mstatus_write = mstatus_read_value & ~csr.write_source; }
        // SSTATUS writes are replace-only, like every supervisor-bank write:
        // the core presents completed read-modify-write values with op 0.
        supervisor_status_write = {
            mstatus_write[22:19], mstatus_write[8], mstatus_write[5], mstatus_write[1]
        };
        if csr.write_index == 6'd32 {
            supervisor_status_write = {
                supervisor_status_q[6:4], csr.write_source[19], csr.write_source[8],
                csr.write_source[5], csr.write_source[1]
            };
        }
        supervisor_write = ENABLE_S && csr.write_enable && (csr.write_op == 2'd0);
        csr.below_machine = ENABLE_U && (user_q || (ENABLE_S && supervisor_q));
        csr.supervisor_mode = ENABLE_S && supervisor_q;
        csr.data_below_machine = csr.below_machine || (ENABLE_U && mprv_q && (mstatus_q[3:2] != 2'd3));
        csr.trap_virtual_memory = ENABLE_S && supervisor_status_q[4];
        csr.timeout_wait = ENABLE_S && supervisor_status_q[5];
        csr.trap_sret = ENABLE_S && supervisor_status_q[6];
        csr.counter_enable = counter_enable_q;
        if ENABLE_S && user_q {
            csr.counter_enable = counter_enable_q & supervisor_counter_enable_q;
        }


        if csr.index[0] {
            csr_mux_level0[0] = mstatus_read_value;
            csr_mux_level0[1] = {mtvec_q, 2'b00};
            csr_mux_level0[2] = {mepc_q, 1'b0};
            csr_mux_level0[3] = mtval_q;
            csr_mux_level0[4] = 64'd0;
            csr_mux_level0[5] = 64'd0;
            csr_mux_level0[6] = minstret_value;
            csr_mux_level0[7] = selected_stall_counter;
        } else {
            csr_mux_level0[0] = 64'd0;
            // RV64 with fixed base-integer and compressed extensions.
            csr_mux_level0[1] = 64'h8000_0000_0000_0104;
            if ENABLE_U { csr_mux_level0[1][20] = 1'b1; }
            if ENABLE_S { csr_mux_level0[1][18] = 1'b1; }
            if ENABLE_A { csr_mux_level0[1][0] = 1'b1; }
            if ENABLE_M {
                csr_mux_level0[1][12] = 1'b1;
            }
            if ENABLE_B {
                csr_mux_level0[1][1] = 1'b1;
            }
            csr_mux_level0[2] = mscratch_q;
            csr_mux_level0[3] = {mcause_interrupt_q, 59'd0, mcause_q};
            // Standard read-only machine identity CSRs for hart zero.
            csr_mux_level0[4] = 64'd0;
            csr_mux_level0[5] = 64'd0;
            csr_mux_level0[6] = mcycle_value;
            csr_mux_level0[7] = {60'd0, stall_selector_q};
        }
        if csr.index[1] {
            csr_mux_level1[0] = csr_mux_level0[1];
            csr_mux_level1[1] = csr_mux_level0[3];
            csr_mux_level1[2] = csr_mux_level0[5];
            csr_mux_level1[3] = csr_mux_level0[7];
        } else {
            csr_mux_level1[0] = csr_mux_level0[0];
            csr_mux_level1[1] = csr_mux_level0[2];
            csr_mux_level1[2] = csr_mux_level0[4];
            csr_mux_level1[3] = csr_mux_level0[6];
        }
        if csr.index[2] {
            csr_mux_level2[0] = csr_mux_level1[1];
            csr_mux_level2[1] = csr_mux_level1[3];
        } else {
            csr_mux_level2[0] = csr_mux_level1[0];
            csr_mux_level2[1] = csr_mux_level1[2];
        }
        if csr.index[3] {
            csr.read_data = csr_mux_level2[1];
        } else {
            csr.read_data = csr_mux_level2[0];
        }

        mie_read          = 64'd0;
        mip_read          = 64'd0;
        sie_read          = 64'd0;
        sip_read          = 64'd0;
        interrupt_enabled = 3'd0;
        supervisor_interrupts_enabled = 3'd0;
        if ENABLE_INTERRUPTS {
            mie_read[11]      = mie_q[2];
            mie_read[7]       = mie_q[1];
            mie_read[3]       = mie_q[0];
            mip_read[11]      = csr.machine_interrupts[2];
            mip_read[7]       = csr.machine_interrupts[1];
            mip_read[3]       = csr.machine_interrupts[0];
            interrupt_enabled = mie_q & csr.machine_interrupts;
            if ENABLE_S {
                mie_read[9] = supervisor_interrupt_enable_q[2];
                mie_read[5] = supervisor_interrupt_enable_q[1];
                mie_read[1] = supervisor_interrupt_enable_q[0];
                mip_read[9] = supervisor_interrupt_pending_q[2];
                mip_read[5] = supervisor_interrupt_pending_q[1];
                mip_read[1] = supervisor_interrupt_pending_q[0];
                sie_read[9] = supervisor_interrupt_enable_q[2] && mideleg_q[2];
                sie_read[5] = supervisor_interrupt_enable_q[1] && mideleg_q[1];
                sie_read[1] = supervisor_interrupt_enable_q[0] && mideleg_q[0];
                sip_read[9] = supervisor_interrupt_pending_q[2] && mideleg_q[2];
                sip_read[5] = supervisor_interrupt_pending_q[1] && mideleg_q[1];
                sip_read[1] = supervisor_interrupt_pending_q[0] && mideleg_q[0];
                supervisor_interrupts_enabled = supervisor_interrupt_enable_q & supervisor_interrupt_pending_q;
            }
        }
        // Keep the U/PMP bank off the lower-bank read path. A binary tree
        // avoids a priority chain through every newly implemented CSR.
        for i in 0..8 { csr_upper_level0[i] = 64'd0; }
        if csr.index[0] {
            csr_upper_level0[0] = mip_read;
            csr_upper_level0[2] = {34'd0, csr.pmp_address[1]};
            csr_upper_level0[3] = {34'd0, csr.pmp_address[3]};
            csr_upper_level0[4] = {61'd0, counter_enable_q};
        } else {
            csr_upper_level0[0] = mie_read;
            csr_upper_level0[1] = {32'd0, csr.pmp_config[3], csr.pmp_config[2], csr.pmp_config[1], csr.pmp_config[0]};
            csr_upper_level0[2] = {34'd0, csr.pmp_address[0]};
            csr_upper_level0[3] = {34'd0, csr.pmp_address[2]};
        }
        for i in 0..4 {
            csr_upper_level1[i] = csr_upper_level0[2*i];
            if csr.index[1] { csr_upper_level1[i] = csr_upper_level0[2*i+1]; }
        }
        for i in 0..2 {
            csr_upper_level2[i] = csr_upper_level1[2*i];
            if csr.index[2] { csr_upper_level2[i] = csr_upper_level1[2*i+1]; }
        }
        if csr.index[4] {
            csr.read_data = 64'd0;
            if ENABLE_U {
                csr.read_data = csr_upper_level2[0];
                if csr.index[3] { csr.read_data = csr_upper_level2[1]; }
            } else if csr.index == 6'd16 {
                csr.read_data = mie_read;
            } else if csr.index == 6'd17 {
                csr.read_data = mip_read;
            }
        }
        // Supervisor bank, indices 32..47.
        for i in 0..8 { csr_supervisor_level0[i] = 64'd0; }
        if csr.index[0] {
            csr_supervisor_level0[0] = sie_read;
            csr_supervisor_level0[1] = {61'd0, supervisor_counter_enable_q};
            csr_supervisor_level0[2] = sscratch_q;
            csr_supervisor_level0[3] = {scause_interrupt_q, 59'd0, scause_q};
            csr_supervisor_level0[4] = sip_read;
            csr_supervisor_level0[5] = {48'd0, medeleg_q};
        } else {
            csr_supervisor_level0[0] = sstatus_read_value;
            csr_supervisor_level0[1] = {stvec_q, 2'b00};
            csr_supervisor_level0[3] = {sepc_q, 1'b0};
            csr_supervisor_level0[4] = stval_q;
            csr_supervisor_level0[6] = {54'd0, mideleg_q[2], 3'd0, mideleg_q[1], 3'd0, mideleg_q[0], 1'b0};
        }
        for i in 0..4 {
            csr_supervisor_level1[i] = csr_supervisor_level0[2*i];
            if csr.index[1] { csr_supervisor_level1[i] = csr_supervisor_level0[2*i+1]; }
        }
        for i in 0..2 {
            csr_supervisor_level2[i] = csr_supervisor_level1[2*i];
            if csr.index[2] { csr_supervisor_level2[i] = csr_supervisor_level1[2*i+1]; }
        }
        if ENABLE_S && csr.index[5] {
            csr.read_data = csr_supervisor_level2[0];
            if csr.index[3] { csr.read_data = csr_supervisor_level2[1]; }
        }

        // Interrupts destined for M precede those destined for S. Within
        // each destination the order is MEI, MSI, MTI, SEI, SSI, STI.
        // Candidate bits are {MEI, MTI, MSI, SEI, STI, SSI}.
        machine_interrupt_candidates = {
            interrupt_enabled, supervisor_interrupts_enabled & ~mideleg_q
        };
        supervisor_interrupt_candidates = supervisor_interrupts_enabled & mideleg_q;
        if !(ENABLE_S && (user_q || (supervisor_q && supervisor_status_q[0]))) {
            supervisor_interrupt_candidates = 3'd0;
        }
        machine_interrupt_taken = (mstatus_q[0] || csr.below_machine) && (machine_interrupt_candidates != 6'd0);
        csr.interrupt_pending = machine_interrupt_taken || (supervisor_interrupt_candidates != 3'd0);
        // The cause reports the highest enabled machine-destined level even
        // while MSTATUS.MIE masks it; a delegated cause applies only when it
        // is the interrupt actually taken.
        csr.interrupt_cause = 4'd7;
        if machine_interrupt_candidates[5] {
            csr.interrupt_cause = 4'd11;
        } else if machine_interrupt_candidates[3] {
            csr.interrupt_cause = 4'd3;
        } else if machine_interrupt_candidates[4] {
            csr.interrupt_cause = 4'd7;
        } else if machine_interrupt_candidates[2] {
            csr.interrupt_cause = 4'd9;
        } else if machine_interrupt_candidates[0] {
            csr.interrupt_cause = 4'd1;
        } else if machine_interrupt_candidates[1] {
            csr.interrupt_cause = 4'd5;
        }
        if !machine_interrupt_taken && (supervisor_interrupt_candidates != 3'd0) {
            csr.interrupt_cause = 4'd5;
            if supervisor_interrupt_candidates[2] {
                csr.interrupt_cause = 4'd9;
            } else if supervisor_interrupt_candidates[0] {
                csr.interrupt_cause = 4'd1;
            }
        }

        // Traps never move to a less privileged mode: both delegation masks
        // are zero in M. The core registers the decision for its trap cause
        // (exceptions in EX, interrupts at acceptance) and presents it with
        // the trap, so no cause lookup reaches the trap-state enables.
        csr.exception_delegated = 16'd0;
        csr.interrupt_delegated = 3'd0;
        if ENABLE_S && csr.below_machine {
            csr.exception_delegated = medeleg_q;
            csr.interrupt_delegated = mideleg_q;
        }
        csr.interrupt_to_supervisor = ENABLE_S && !machine_interrupt_taken
            && (supervisor_interrupt_candidates != 3'd0);
        trap_to_supervisor = ENABLE_S && csr.trap_supervisor;

        // MTVEC/STVEC implement direct mode only. C makes IALIGN 16 bits,
        // while each vector retains its required 4-byte direct-mode alignment.
        csr.trap_vector = {mtvec_q, 2'b00};
        if trap_to_supervisor { csr.trap_vector = {stvec_q, 2'b00}; }
        csr.return_pc   = {mepc_q, 1'b0};
        csr.supervisor_return_pc = {sepc_q, 1'b0};

        // The board debug transport can sample all performance counters
        // without injecting CSR instructions into the running program.
        case csr.debug_counter_index {
            4'd0   : csr.debug_counter_data = mcycle_value;
            4'd1   : csr.debug_counter_data = minstret_value;
            4'd2   : csr.debug_counter_data = event_counter_value[0];
            4'd3   : csr.debug_counter_data = event_counter_value[1];
            4'd4   : csr.debug_counter_data = event_counter_value[2];
            4'd5   : csr.debug_counter_data = event_counter_value[3];
            4'd6   : csr.debug_counter_data = predictor_counter_value[0];
            4'd7   : csr.debug_counter_data = predictor_counter_value[1];
            4'd8   : csr.debug_counter_data = predictor_counter_value[2];
            4'd9   : csr.debug_counter_data = predictor_counter_value[3];
            4'd10  : csr.debug_counter_data = predictor_counter_value[4];
            default: csr.debug_counter_data = 64'd0;
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            event_dependency_q          = 1'b0;
            event_memory_wait_q         = 1'b0;
            event_redirect_q            = 1'b0;
            event_frontend_empty_q      = 1'b0;
            predictor_conditional_q     = 1'b0;
            predictor_direction_wrong_q = 1'b0;
            predictor_btb_miss_q        = 1'b0;
            predictor_ras_fallback_q    = 1'b0;
            predictor_repair_q          = 1'b0;
            event_freeze_q              = 1'b0;
            event_write_q               = 1'b0;
            event_write_index_q         = 4'd0;
        } else {
            // Isolate the late pipeline-control predicates from the 32-way
            // counter CE cones. Events are counted one cycle later. When a
            // hardware result freezes the bank, delay the event-counter
            // freeze once so the terminal cycle's pending event is included.
            event_freeze_q      = csr.counter_freeze;
            event_write_q       = csr.write_enable && (csr.write_index == 6'd15) && (csr.write_op != 2'd3);
            event_write_index_q = stall_selector_q;
            if csr.counter_freeze {
                event_dependency_q          = 1'b0;
                event_memory_wait_q         = 1'b0;
                event_redirect_q            = 1'b0;
                event_frontend_empty_q      = 1'b0;
                predictor_conditional_q     = 1'b0;
                predictor_direction_wrong_q = 1'b0;
                predictor_btb_miss_q        = 1'b0;
                predictor_ras_fallback_q    = 1'b0;
                predictor_repair_q          = 1'b0;
            } else {
                // Capture late pipeline events directly.  The independent
                // write marker above delays the same-counter suppression by
                // the same cycle, preserving write priority without putting
                // CSR decode/select logic on every event FF's D path.
                event_dependency_q          = csr.stall_dependency;
                event_memory_wait_q         = csr.stall_memory_wait;
                event_redirect_q            = csr.stall_redirect;
                event_frontend_empty_q      = csr.stall_frontend_empty;
                predictor_conditional_q     = csr.predictor_conditional_resolved;
                predictor_direction_wrong_q = csr.predictor_direction_wrong;
                predictor_btb_miss_q        = csr.predictor_btb_miss;
                predictor_ras_fallback_q    = csr.predictor_ras_fallback;
                predictor_repair_q          = csr.predictor_repair;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset { mstatus_q = 4'b1100; }
        else if (csr.trap_enter && !trap_to_supervisor) || csr.mret
            || (csr.write_enable && (csr.write_index == 6'd1) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mstatus_q[1] = mstatus_q[0];
                mstatus_q[0] = 1'b0;
                mstatus_q[3:2] = 2'b11;
                if ENABLE_U && user_q { mstatus_q[3:2] = 2'b00; }
                if ENABLE_S && supervisor_q { mstatus_q[3:2] = 2'b01; }
            } else if csr.mret {
                mstatus_q[0] = mstatus_q[1];
                mstatus_q[1] = 1'b1;
                mstatus_q[3:2] = 2'b11;
                if ENABLE_U { mstatus_q[3:2] = 2'b00; }
            } else {
                // MPP is WARL over the implemented modes; 2 maps to U.
                mstatus_q = {2'b11, mstatus_write[7], mstatus_write[3]};
                if ENABLE_U && (mstatus_write[12:11] != 2'b11) { mstatus_q[3:2] = 2'b00; }
                if ENABLE_S && (mstatus_write[12:11] == 2'b01) { mstatus_q[3:2] = 2'b01; }
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            user_q = 1'b0;
            supervisor_q = 1'b0;
        } else if csr.trap_enter || csr.mret || (ENABLE_S && csr.sret) {
            if csr.trap_enter {
                user_q = 1'b0;
                supervisor_q = trap_to_supervisor;
            } else if csr.mret {
                user_q = ENABLE_U && (mstatus_q[3:2] == 2'b00);
                supervisor_q = ENABLE_S && (mstatus_q[3:2] == 2'b01);
            } else {
                user_q = !supervisor_status_q[2];
                supervisor_q = supervisor_status_q[2];
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset { mprv_q = 1'b0; }
        else if ENABLE_U && ((csr.mret && (mstatus_q[3:2] != 2'b11)) || (ENABLE_S && csr.sret)
            || (csr.write_enable && (csr.write_index == 6'd1) && (csr.write_op != 2'd3))) {
            if csr.mret || csr.sret { mprv_q = 1'b0; }
            else { mprv_q = mstatus_write[17]; }
        }
    }
    always_ff (clk, rst_n) {
        if_reset { supervisor_status_q = 7'd0; }
        else if ENABLE_S && ((csr.trap_enter && trap_to_supervisor) || csr.sret
            || (csr.write_enable && (csr.write_op != 2'd3)
                && ((csr.write_index == 6'd1) || ((csr.write_index == 6'd32) && (csr.write_op == 2'd0))))) {
            if csr.trap_enter {
                supervisor_status_q[2] = supervisor_q;
                supervisor_status_q[1] = supervisor_status_q[0];
                supervisor_status_q[0] = 1'b0;
            } else if csr.sret {
                supervisor_status_q[0] = supervisor_status_q[1];
                supervisor_status_q[1] = 1'b1;
                supervisor_status_q[2] = 1'b0;
            } else {
                supervisor_status_q = supervisor_status_write;
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            supervisor_counter_enable_q = 3'd0;
            stvec_q = 0;
            sscratch_q = 64'd0;
            medeleg_q = 16'd0;
            mideleg_q = 3'd0;
        } else if supervisor_write {
            if csr.write_index == 6'd35 { supervisor_counter_enable_q = csr.write_source[2:0] & 3'b101; }
            if csr.write_index == 6'd34 { stvec_q = csr.write_source[ADDRESS_BITS - 1:2]; }
            if csr.write_index == 6'd37 { sscratch_q = csr.write_source; }
            if csr.write_index == 6'd43 { medeleg_q = csr.write_source[15:0] & 16'hb3ff; }
            if ENABLE_INTERRUPTS && (csr.write_index == 6'd44) {
                mideleg_q = {csr.write_source[9], csr.write_source[5], csr.write_source[1]};
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset {
            sepc_q = 0;
            scause_q = 4'd0;
            scause_interrupt_q = 1'b0;
            stval_q = 0;
        } else if ENABLE_S && csr.trap_enter && trap_to_supervisor {
            sepc_q = csr.trap_pc[ADDRESS_BITS - 1:1];
            scause_q = csr.trap_cause[3:0];
            scause_interrupt_q = ENABLE_INTERRUPTS && csr.trap_cause[63];
            stval_q = csr.trap_value[ADDRESS_BITS - 1:0];
        } else if supervisor_write {
            if csr.write_index == 6'd38 { sepc_q = csr.write_source[ADDRESS_BITS - 1:1]; }
            if csr.write_index == 6'd39 {
                scause_q = csr.write_source[3:0];
                scause_interrupt_q = ENABLE_INTERRUPTS && csr.write_source[63];
            }
            if csr.write_index == 6'd40 { stval_q = csr.write_source[ADDRESS_BITS - 1:0]; }
        }
    }
    // Supervisor interrupt enables are written through MIE, or through SIE
    // for delegated bits. Pending bits are software-owned: MIP writes all
    // three, SIP only a delegated SSIP.
    always_ff (clk, rst_n) {
        if_reset {
            supervisor_interrupt_enable_q = 3'd0;
            supervisor_interrupt_pending_q = 3'd0;
        } else if ENABLE_S && ENABLE_INTERRUPTS && csr.write_enable && (csr.write_op != 2'd3) {
            if csr.write_index == 6'd16 {
                if csr.write_op == 2'd0 {
                    supervisor_interrupt_enable_q = {csr.write_source[9], csr.write_source[5], csr.write_source[1]};
                } else if csr.write_op == 2'd1 {
                    supervisor_interrupt_enable_q = supervisor_interrupt_enable_q
                        | {csr.write_source[9], csr.write_source[5], csr.write_source[1]};
                } else {
                    supervisor_interrupt_enable_q = supervisor_interrupt_enable_q
                        & ~{csr.write_source[9], csr.write_source[5], csr.write_source[1]};
                }
            } else if (csr.write_index == 6'd17) && (csr.write_op == 2'd0) {
                supervisor_interrupt_pending_q = {csr.write_source[9], csr.write_source[5], csr.write_source[1]};
            } else if (csr.write_index == 6'd33) && (csr.write_op == 2'd0) {
                supervisor_interrupt_enable_q = (supervisor_interrupt_enable_q & ~mideleg_q)
                    | ({csr.write_source[9], csr.write_source[5], csr.write_source[1]} & mideleg_q);
            } else if (csr.write_index == 6'd41) && (csr.write_op == 2'd0) && mideleg_q[0] {
                supervisor_interrupt_pending_q[0] = csr.write_source[1];
            }
        }
    }
    always_ff (clk, rst_n) {
        if_reset { counter_enable_q = 3'd0; }
        else if ENABLE_U && csr.write_enable && (csr.write_index == 6'd25) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 { counter_enable_q = csr.write_source[2:0] & 3'b101; }
            else if csr.write_op == 2'd1 { counter_enable_q = counter_enable_q | (csr.write_source[2:0] & 3'b101); }
            else { counter_enable_q = counter_enable_q & ~csr.write_source[2:0]; }
        }
    }

    // Sixteen architectural entries, four programmable; entries 4..15 are
    // read-only OFF/zero. Four-byte grain, 32-bit physical address space.
    for entry in 0..4 :g_pmp {
        var next_config: logic<8>;
        var next_address: logic<30>;
        var address_locked: logic;
        always_comb {
            next_config = csr.write_source[entry * 8 +: 8];
            next_address = csr.write_source[29:0];
            if csr.write_op == 2'd1 {
                next_config = csr.pmp_config[entry] | next_config;
                next_address = csr.pmp_address[entry] | next_address;
            } else if csr.write_op == 2'd2 {
                next_config = csr.pmp_config[entry] & ~next_config;
                next_address = csr.pmp_address[entry] & ~next_address;
            }
            next_config[6:5] = 2'd0;
            if !next_config[0] { next_config[1] = 1'b0; }
            address_locked = csr.pmp_config[entry][7];
            if entry <: 3 {
                address_locked = address_locked || (csr.pmp_config[(entry + 1) % 4][7]
                    && (csr.pmp_config[(entry + 1) % 4][4:3] == 2'd1));
            }
        }
        always_ff (clk, rst_n) {
            if_reset {
                csr.pmp_config[entry] = 8'd0;
                csr.pmp_address[entry] = 30'd0;
            } else if ENABLE_U && csr.write_enable && (csr.write_op != 2'd3) {
                if (csr.write_index == 6'd18) && !csr.pmp_config[entry][7] {
                    csr.pmp_config[entry] = next_config;
                }
                if (csr.write_index == (20 + entry)) && !address_locked {
                    csr.pmp_address[entry] = next_address;
                }
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mie_q = 3'd0;
        } else if ENABLE_INTERRUPTS && csr.write_enable && (csr.write_index == 6'd16) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                mie_q = {csr.write_source[11], csr.write_source[7], csr.write_source[3]};
            } else if csr.write_op == 2'd1 {
                mie_q = mie_q | {csr.write_source[11], csr.write_source[7], csr.write_source[3]};
            } else {
                mie_q = mie_q & ~{csr.write_source[11], csr.write_source[7], csr.write_source[3]};
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mcause_interrupt_q = 1'b0;
        } else if ENABLE_INTERRUPTS
            && ((csr.trap_enter && !trap_to_supervisor)
                || (csr.write_enable && (csr.write_index == 6'd6) && (csr.write_op != 2'd3))) {
            if csr.trap_enter {
                mcause_interrupt_q = csr.trap_cause[63];
            } else if csr.write_op == 2'd0 {
                mcause_interrupt_q = csr.write_source[63];
            } else if csr.write_op == 2'd1 {
                mcause_interrupt_q = mcause_interrupt_q | csr.write_source[63];
            } else {
                mcause_interrupt_q = mcause_interrupt_q & ~csr.write_source[63];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mtvec_q = 30'd0;
        } else if csr.write_enable && (csr.write_index == 6'd3) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                mtvec_q = csr.write_source[ADDRESS_BITS - 1:2];
            } else if csr.write_op == 2'd1 {
                mtvec_q = mtvec_q | csr.write_source[ADDRESS_BITS - 1:2];
            } else {
                mtvec_q = mtvec_q & ~csr.write_source[ADDRESS_BITS - 1:2];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mscratch_q = 64'd0;
        } else if csr.write_enable && (csr.write_index == 6'd4) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                mscratch_q = csr.write_source;
            } else if csr.write_op == 2'd1 {
                mscratch_q = mscratch_q | csr.write_source;
            } else {
                mscratch_q = mscratch_q & ~csr.write_source;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mepc_q = 31'd0;
        } else if (csr.trap_enter && !trap_to_supervisor)
            || (csr.write_enable && (csr.write_index == 6'd5) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mepc_q = csr.trap_pc[ADDRESS_BITS - 1:1];
            } else if csr.write_op == 2'd0 {
                mepc_q = csr.write_source[ADDRESS_BITS - 1:1];
            } else if csr.write_op == 2'd1 {
                mepc_q = mepc_q | csr.write_source[ADDRESS_BITS - 1:1];
            } else {
                mepc_q = mepc_q & ~csr.write_source[ADDRESS_BITS - 1:1];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mcause_q = 4'd0;
        } else if (csr.trap_enter && !trap_to_supervisor)
            || (csr.write_enable && (csr.write_index == 6'd6) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mcause_q = csr.trap_cause[3:0];
            } else if csr.write_op == 2'd0 {
                mcause_q = csr.write_source[3:0];
            } else if csr.write_op == 2'd1 {
                mcause_q = mcause_q | csr.write_source[3:0];
            } else {
                mcause_q = mcause_q & ~csr.write_source[3:0];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mtval_q = 32'd0;
        } else if (csr.trap_enter && !trap_to_supervisor)
            || (csr.write_enable && (csr.write_index == 6'd7) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mtval_q = csr.trap_value[ADDRESS_BITS - 1:0];
            } else if csr.write_op == 2'd0 {
                mtval_q = csr.write_source[ADDRESS_BITS - 1:0];
            } else if csr.write_op == 2'd1 {
                mtval_q = mtval_q | csr.write_source[ADDRESS_BITS - 1:0];
            } else {
                mtval_q = mtval_q & ~csr.write_source[ADDRESS_BITS - 1:0];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            stall_selector_q = 4'd0;
        } else if csr.write_enable && (csr.write_index == 6'd14) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                stall_selector_q = csr.write_source[3:0];
            } else if csr.write_op == 2'd1 {
                stall_selector_q = stall_selector_q | csr.write_source[3:0];
            } else {
                stall_selector_q = stall_selector_q & ~csr.write_source[3:0];
            }
        }
    }

}
