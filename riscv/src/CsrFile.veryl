/// Machine-mode CSR bank for precise traps and optional machine interrupts.
///
/// Rica currently has one hart and no lower privilege modes.
/// The implemented state is nevertheless architectural: trap entry records
/// MEPC/MCAUSE/MTVAL and updates MSTATUS, while MRET restores the interrupt
/// enable stack and returns to the aligned MEPC value.
module CsrFile #(
    param ENABLE_M         : bit = 0,
    param ENABLE_B         : bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
    param FULL_ADDRESS     : bit = 0,
) (
    clk  : input   clock       ,
    rst_n: input   reset       ,
    csr  : modport CsrBus::file,
) {
    const ADDRESS_BITS: u32 = 32 + 32 * (FULL_ADDRESS as u32);
    // Physical execution remains bounded; full-width state retains bad addresses.
    // Keep only implemented WARL/WLRL fields in flops; CSR reads expand them
    // to XLEN. This avoids routing 64-bit write muxes to mostly constant state.
    // {MPP[1:0], MPIE, MIE}
    var mstatus_q         : logic<4>               ;
    var mtvec_q           : logic<ADDRESS_BITS - 2>;
    var mscratch_q        : logic<64>              ;
    var mepc_q            : logic<ADDRESS_BITS - 1>;
    var mcause_q          : logic<4>               ;
    var mcause_interrupt_q: logic                  ;
    var mie_q             : logic<3>               ;
    var interrupt_enabled : logic<3>               ;
    var mie_read          : logic<64>              ;
    var mip_read          : logic<64>              ;
    var mtval_q           : logic<ADDRESS_BITS>    ;
    var mcycle_value      : logic<64>              ;
    var minstret_value    : logic<64>              ;

    // The two custom machine CSRs at 0x7c0/0x7c1 select and access one of nine
    // implementation-defined event counters without consuming nine entries
    // in the compact CSR index. Selectors 0..3 are mutually exclusive
    // pipeline-cycle classes; selectors 4..8 are independent predictor events.
    var stall_selector_q       : logic<4>     ;
    var event_counter_value    : logic<64> [4];
    var predictor_counter_value: logic<64> [5];
    var selected_stall_counter : logic<64>    ;
    var selected_counter_value : logic<64>    ;
    var counter_write_value    : logic<64>    ;
    // Struo currently lowers a many-arm case as a priority mux chain.  Spell
    // both read muxes as explicit binary trees so their physical depth grows
    // with the selector width rather than the number of CSR values.
    var stall_mux_level0                   : logic<64> [8];
    var stall_mux_level1                   : logic<64> [4];
    var stall_mux_level2                   : logic<64> [2];
    var csr_mux_level0                     : logic<64> [8];
    var csr_mux_level1                     : logic<64> [4];
    var csr_mux_level2                     : logic<64> [2];
    var mstatus_read_value                 : logic<64>    ;
    var event_dependency_q                 : logic        ;
    var event_memory_wait_q                : logic        ;
    var event_redirect_q                   : logic        ;
    var event_frontend_empty_q             : logic        ;
    var predictor_conditional_q            : logic        ;
    var predictor_direction_wrong_q        : logic        ;
    var predictor_btb_miss_q               : logic        ;
    var predictor_ras_fallback_q           : logic        ;
    var predictor_repair_q                 : logic        ;
    var event_freeze_q                     : logic        ;
    var event_write_q                      : logic        ;
    var event_write_index_q                : logic<4>     ;
    var event_increment_valid              : logic        ;
    var event_increment_index              : logic<2>     ;
    var predictor_conditional_increment    : logic        ;
    var predictor_direction_wrong_increment: logic        ;
    var predictor_btb_miss_increment       : logic        ;
    var predictor_ras_fallback_increment   : logic        ;
    var predictor_repair_increment         : logic        ;

    inst mcycle_counter: PerformanceCounter64 (
        clk         : clk                                                                     ,
        rst_n       : rst_n                                                                   ,
        write_enable: csr.write_enable && (csr.write_index == 4'd12) && (csr.write_op != 2'd3),
        write_value : counter_write_value                                                     ,
        increment   : 1'b1                                                                    ,
        freeze      : csr.counter_freeze                                                      ,
        value       : mcycle_value                                                            ,
    );

    inst minstret_counter: PerformanceCounter64 (
        clk         : clk                                                                     ,
        rst_n       : rst_n                                                                   ,
        write_enable: csr.write_enable && (csr.write_index == 4'd13) && (csr.write_op != 2'd3),
        write_value : counter_write_value                                                     ,
        increment   : csr.retire                                                              ,
        freeze      : csr.counter_freeze                                                      ,
        value       : minstret_value                                                          ,
    );

    inst event_counters: PerformanceEventCounters4 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q <: 4'd4),
        write_index    : stall_selector_q[1:0],
        write_value    : counter_write_value  ,
        increment_valid: event_increment_valid,
        increment_index: event_increment_index,
        freeze         : event_freeze_q       ,
        value          : event_counter_value  ,
    );

    inst predictor_conditional_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd4),
        write_value: counter_write_value            ,
        increment  : predictor_conditional_increment,
        freeze     : event_freeze_q                 ,
        value      : predictor_counter_value[0]     ,
    );

    inst predictor_direction_wrong_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd5),
        write_value: counter_write_value                ,
        increment  : predictor_direction_wrong_increment,
        freeze     : event_freeze_q                     ,
        value      : predictor_counter_value[1]         ,
    );

    inst predictor_btb_miss_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd6),
        write_value: counter_write_value         ,
        increment  : predictor_btb_miss_increment,
        freeze     : event_freeze_q              ,
        value      : predictor_counter_value[2]  ,
    );

    inst predictor_ras_fallback_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd7),
        write_value: counter_write_value             ,
        increment  : predictor_ras_fallback_increment,
        freeze     : event_freeze_q                  ,
        value      : predictor_counter_value[3]      ,
    );

    inst predictor_repair_counter: PerformanceCounter64 (
        clk         : clk  ,
        rst_n       : rst_n,
        write_enable: csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3)
            && (stall_selector_q == 4'd8),
        write_value: counter_write_value       ,
        increment  : predictor_repair_increment,
        freeze     : event_freeze_q            ,
        value      : predictor_counter_value[4],
    );

    always_comb {
        // The inputs were sampled together before this boundary. Apply the
        // pipeline controller's priority here exactly once; a lower-priority
        // event must neither select nor increment its counter when predicates
        // overlap in the original cycle.
        event_increment_valid = 1'b0;
        event_increment_index = 2'd0;
        if event_memory_wait_q {
            event_increment_index = 2'd1;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd1));
        } else if event_redirect_q {
            event_increment_index = 2'd2;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd2));
        } else if event_dependency_q {
            event_increment_index = 2'd0;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd0));
        } else if event_frontend_empty_q {
            event_increment_index = 2'd3;
            event_increment_valid = !(event_write_q && (event_write_index_q == 4'd3));
        }
        predictor_conditional_increment     = predictor_conditional_q
            && !(event_write_q && (event_write_index_q == 4'd4));
        predictor_direction_wrong_increment = predictor_direction_wrong_q
            && !(event_write_q && (event_write_index_q == 4'd5));
        predictor_btb_miss_increment        = predictor_btb_miss_q && !(event_write_q && (event_write_index_q == 4'd6));
        predictor_ras_fallback_increment    = predictor_ras_fallback_q
            && !(event_write_q && (event_write_index_q == 4'd7));
        predictor_repair_increment          = predictor_repair_q && !(event_write_q && (event_write_index_q == 4'd8));

        if stall_selector_q[0] {
            stall_mux_level0[0] = event_counter_value[1];
            stall_mux_level0[1] = event_counter_value[3];
            stall_mux_level0[2] = predictor_counter_value[1];
            stall_mux_level0[3] = predictor_counter_value[3];
            stall_mux_level0[4] = 64'd0;
        } else {
            stall_mux_level0[0] = event_counter_value[0];
            stall_mux_level0[1] = event_counter_value[2];
            stall_mux_level0[2] = predictor_counter_value[0];
            stall_mux_level0[3] = predictor_counter_value[2];
            stall_mux_level0[4] = predictor_counter_value[4];
        }
        stall_mux_level0[5] = 64'd0;
        stall_mux_level0[6] = 64'd0;
        stall_mux_level0[7] = 64'd0;
        if stall_selector_q[1] {
            stall_mux_level1[0] = stall_mux_level0[1];
            stall_mux_level1[1] = stall_mux_level0[3];
            stall_mux_level1[2] = stall_mux_level0[5];
            stall_mux_level1[3] = stall_mux_level0[7];
        } else {
            stall_mux_level1[0] = stall_mux_level0[0];
            stall_mux_level1[1] = stall_mux_level0[2];
            stall_mux_level1[2] = stall_mux_level0[4];
            stall_mux_level1[3] = stall_mux_level0[6];
        }
        if stall_selector_q[2] {
            stall_mux_level2[0] = stall_mux_level1[1];
            stall_mux_level2[1] = stall_mux_level1[3];
        } else {
            stall_mux_level2[0] = stall_mux_level1[0];
            stall_mux_level2[1] = stall_mux_level1[2];
        }
        if stall_selector_q[3] {
            selected_stall_counter = stall_mux_level2[1];
        } else {
            selected_stall_counter = stall_mux_level2[0];
        }

        selected_counter_value = selected_stall_counter;
        if csr.write_index == 4'd12 {
            selected_counter_value = mcycle_value;
        } else if csr.write_index == 4'd13 {
            selected_counter_value = minstret_value;
        }
        if csr.write_op == 2'd1 {
            counter_write_value = selected_counter_value | csr.write_source;
        } else if csr.write_op == 2'd2 {
            counter_write_value = selected_counter_value & ~csr.write_source;
        } else {
            counter_write_value = csr.write_source;
        }

        mstatus_read_value        = 64'd0;
        mstatus_read_value[3]     = mstatus_q[0];
        mstatus_read_value[7]     = mstatus_q[1];
        mstatus_read_value[12:11] = mstatus_q[3:2];

        if csr.index[0] {
            csr_mux_level0[0] = mstatus_read_value;
            csr_mux_level0[1] = {mtvec_q, 2'b00};
            csr_mux_level0[2] = {mepc_q, 1'b0};
            csr_mux_level0[3] = mtval_q;
            csr_mux_level0[4] = 64'd0;
            csr_mux_level0[5] = 64'd0;
            csr_mux_level0[6] = minstret_value;
            csr_mux_level0[7] = selected_stall_counter;
        } else {
            csr_mux_level0[0] = 64'd0;
            // RV64 with fixed base-integer and compressed extensions.
            csr_mux_level0[1] = 64'h8000_0000_0000_0104;
            if ENABLE_M {
                csr_mux_level0[1][12] = 1'b1;
            }
            if ENABLE_B {
                csr_mux_level0[1][1] = 1'b1;
            }
            csr_mux_level0[2] = mscratch_q;
            csr_mux_level0[3] = {mcause_interrupt_q, 59'd0, mcause_q};
            // Standard read-only machine identity CSRs for hart zero.
            csr_mux_level0[4] = 64'd0;
            csr_mux_level0[5] = 64'd0;
            csr_mux_level0[6] = mcycle_value;
            csr_mux_level0[7] = {60'd0, stall_selector_q};
        }
        if csr.index[1] {
            csr_mux_level1[0] = csr_mux_level0[1];
            csr_mux_level1[1] = csr_mux_level0[3];
            csr_mux_level1[2] = csr_mux_level0[5];
            csr_mux_level1[3] = csr_mux_level0[7];
        } else {
            csr_mux_level1[0] = csr_mux_level0[0];
            csr_mux_level1[1] = csr_mux_level0[2];
            csr_mux_level1[2] = csr_mux_level0[4];
            csr_mux_level1[3] = csr_mux_level0[6];
        }
        if csr.index[2] {
            csr_mux_level2[0] = csr_mux_level1[1];
            csr_mux_level2[1] = csr_mux_level1[3];
        } else {
            csr_mux_level2[0] = csr_mux_level1[0];
            csr_mux_level2[1] = csr_mux_level1[2];
        }
        if csr.index[3] {
            csr.read_data = csr_mux_level2[1];
        } else {
            csr.read_data = csr_mux_level2[0];
        }

        mie_read          = 64'd0;
        mip_read          = 64'd0;
        interrupt_enabled = 3'd0;
        if ENABLE_INTERRUPTS {
            mie_read[11]      = mie_q[2];
            mie_read[7]       = mie_q[1];
            mie_read[3]       = mie_q[0];
            mip_read[11]      = csr.machine_interrupts[2];
            mip_read[7]       = csr.machine_interrupts[1];
            mip_read[3]       = csr.machine_interrupts[0];
            interrupt_enabled = mie_q & csr.machine_interrupts;
        }
        if csr.index[4] {
            csr.read_data = 64'd0;
            if csr.index == 5'd16 {
                csr.read_data = mie_read;
            } else if csr.index == 5'd17 {
                csr.read_data = mip_read;
            }
        }
        csr.interrupt_pending = mstatus_q[0] && (interrupt_enabled != 3'd0);
        // The architectural priority is external > software > timer.
        csr.interrupt_cause = 4'd7;
        if interrupt_enabled[2] {
            csr.interrupt_cause = 4'd11;
        } else if interrupt_enabled[0] {
            csr.interrupt_cause = 4'd3;
        }

        // MTVEC implements direct mode only. C makes IALIGN 16
        // bits, while mtvec retains its independently required 4-byte base
        // alignment in direct mode.
        csr.trap_vector = {mtvec_q, 2'b00};
        csr.return_pc   = {mepc_q, 1'b0};

        // The board debug transport can sample all performance counters
        // without injecting CSR instructions into the running program.
        case csr.debug_counter_index {
            4'd0   : csr.debug_counter_data = mcycle_value;
            4'd1   : csr.debug_counter_data = minstret_value;
            4'd2   : csr.debug_counter_data = event_counter_value[0];
            4'd3   : csr.debug_counter_data = event_counter_value[1];
            4'd4   : csr.debug_counter_data = event_counter_value[2];
            4'd5   : csr.debug_counter_data = event_counter_value[3];
            4'd6   : csr.debug_counter_data = predictor_counter_value[0];
            4'd7   : csr.debug_counter_data = predictor_counter_value[1];
            4'd8   : csr.debug_counter_data = predictor_counter_value[2];
            4'd9   : csr.debug_counter_data = predictor_counter_value[3];
            4'd10  : csr.debug_counter_data = predictor_counter_value[4];
            default: csr.debug_counter_data = 64'd0;
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            event_dependency_q          = 1'b0;
            event_memory_wait_q         = 1'b0;
            event_redirect_q            = 1'b0;
            event_frontend_empty_q      = 1'b0;
            predictor_conditional_q     = 1'b0;
            predictor_direction_wrong_q = 1'b0;
            predictor_btb_miss_q        = 1'b0;
            predictor_ras_fallback_q    = 1'b0;
            predictor_repair_q          = 1'b0;
            event_freeze_q              = 1'b0;
            event_write_q               = 1'b0;
            event_write_index_q         = 4'd0;
        } else {
            // Isolate the late pipeline-control predicates from the 32-way
            // counter CE cones. Events are counted one cycle later. When a
            // hardware result freezes the bank, delay the event-counter
            // freeze once so the terminal cycle's pending event is included.
            event_freeze_q      = csr.counter_freeze;
            event_write_q       = csr.write_enable && (csr.write_index == 4'd15) && (csr.write_op != 2'd3);
            event_write_index_q = stall_selector_q;
            if csr.counter_freeze {
                event_dependency_q          = 1'b0;
                event_memory_wait_q         = 1'b0;
                event_redirect_q            = 1'b0;
                event_frontend_empty_q      = 1'b0;
                predictor_conditional_q     = 1'b0;
                predictor_direction_wrong_q = 1'b0;
                predictor_btb_miss_q        = 1'b0;
                predictor_ras_fallback_q    = 1'b0;
                predictor_repair_q          = 1'b0;
            } else {
                // Capture late pipeline events directly.  The independent
                // write marker above delays the same-counter suppression by
                // the same cycle, preserving write priority without putting
                // CSR decode/select logic on every event FF's D path.
                event_dependency_q          = csr.stall_dependency;
                event_memory_wait_q         = csr.stall_memory_wait;
                event_redirect_q            = csr.stall_redirect;
                event_frontend_empty_q      = csr.stall_frontend_empty;
                predictor_conditional_q     = csr.predictor_conditional_resolved;
                predictor_direction_wrong_q = csr.predictor_direction_wrong;
                predictor_btb_miss_q        = csr.predictor_btb_miss;
                predictor_ras_fallback_q    = csr.predictor_ras_fallback;
                predictor_repair_q          = csr.predictor_repair;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            // This M-only hart implements M as the sole WARL value of MPP.
            mstatus_q = 4'b1100;
        } else if csr.trap_enter || csr.mret
            || (csr.write_enable && (csr.write_index == 4'd1) && (csr.write_op != 2'd3)) {
            // Express every real update below one self-hold boundary. Struo
            // can map that boundary to the ECP5 FF clock enable instead of
            // putting trap/CSR control through every bit's D-input mux.
            if csr.trap_enter {
                // MPIE <- MIE, MIE <- 0, MPP <- M-mode.
                mstatus_q[1]   = mstatus_q[0];
                mstatus_q[0]   = 1'b0;
                mstatus_q[3:2] = 2'b11;
            } else if csr.mret {
                // MIE <- MPIE, MPIE <- 1, MPP <- the least implemented mode (M).
                mstatus_q[0]   = mstatus_q[1];
                mstatus_q[1]   = 1'b1;
                mstatus_q[3:2] = 2'b11;
            } else if csr.write_op == 2'd0 {
                mstatus_q = {2'b11, csr.write_source[7], csr.write_source[3]};
            } else if csr.write_op == 2'd1 {
                mstatus_q = mstatus_q | {2'b00, csr.write_source[7], csr.write_source[3]};
            } else {
                mstatus_q = mstatus_q & ~{2'b00, csr.write_source[7], csr.write_source[3]};
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mie_q = 3'd0;
        } else if ENABLE_INTERRUPTS && csr.write_enable && (csr.write_index == 5'd16) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                mie_q = {csr.write_source[11], csr.write_source[7], csr.write_source[3]};
            } else if csr.write_op == 2'd1 {
                mie_q = mie_q | {csr.write_source[11], csr.write_source[7], csr.write_source[3]};
            } else {
                mie_q = mie_q & ~{csr.write_source[11], csr.write_source[7], csr.write_source[3]};
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mcause_interrupt_q = 1'b0;
        } else if ENABLE_INTERRUPTS
            && (csr.trap_enter || (csr.write_enable && (csr.write_index == 5'd6) && (csr.write_op != 2'd3))) {
            if csr.trap_enter {
                mcause_interrupt_q = csr.trap_cause[63];
            } else if csr.write_op == 2'd0 {
                mcause_interrupt_q = csr.write_source[63];
            } else if csr.write_op == 2'd1 {
                mcause_interrupt_q = mcause_interrupt_q | csr.write_source[63];
            } else {
                mcause_interrupt_q = mcause_interrupt_q & ~csr.write_source[63];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mtvec_q = 30'd0;
        } else if csr.write_enable && (csr.write_index == 4'd3) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                mtvec_q = csr.write_source[ADDRESS_BITS - 1:2];
            } else if csr.write_op == 2'd1 {
                mtvec_q = mtvec_q | csr.write_source[ADDRESS_BITS - 1:2];
            } else {
                mtvec_q = mtvec_q & ~csr.write_source[ADDRESS_BITS - 1:2];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mscratch_q = 64'd0;
        } else if csr.write_enable && (csr.write_index == 4'd4) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                mscratch_q = csr.write_source;
            } else if csr.write_op == 2'd1 {
                mscratch_q = mscratch_q | csr.write_source;
            } else {
                mscratch_q = mscratch_q & ~csr.write_source;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mepc_q = 31'd0;
        } else if csr.trap_enter || (csr.write_enable && (csr.write_index == 4'd5) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mepc_q = csr.trap_pc[ADDRESS_BITS - 1:1];
            } else if csr.write_op == 2'd0 {
                mepc_q = csr.write_source[ADDRESS_BITS - 1:1];
            } else if csr.write_op == 2'd1 {
                mepc_q = mepc_q | csr.write_source[ADDRESS_BITS - 1:1];
            } else {
                mepc_q = mepc_q & ~csr.write_source[ADDRESS_BITS - 1:1];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mcause_q = 4'd0;
        } else if csr.trap_enter || (csr.write_enable && (csr.write_index == 4'd6) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mcause_q = csr.trap_cause[3:0];
            } else if csr.write_op == 2'd0 {
                mcause_q = csr.write_source[3:0];
            } else if csr.write_op == 2'd1 {
                mcause_q = mcause_q | csr.write_source[3:0];
            } else {
                mcause_q = mcause_q & ~csr.write_source[3:0];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            mtval_q = 32'd0;
        } else if csr.trap_enter || (csr.write_enable && (csr.write_index == 4'd7) && (csr.write_op != 2'd3)) {
            if csr.trap_enter {
                mtval_q = csr.trap_value[ADDRESS_BITS - 1:0];
            } else if csr.write_op == 2'd0 {
                mtval_q = csr.write_source[ADDRESS_BITS - 1:0];
            } else if csr.write_op == 2'd1 {
                mtval_q = mtval_q | csr.write_source[ADDRESS_BITS - 1:0];
            } else {
                mtval_q = mtval_q & ~csr.write_source[ADDRESS_BITS - 1:0];
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            stall_selector_q = 4'd0;
        } else if csr.write_enable && (csr.write_index == 4'd14) && (csr.write_op != 2'd3) {
            if csr.write_op == 2'd0 {
                stall_selector_q = csr.write_source[3:0];
            } else if csr.write_op == 2'd1 {
                stall_selector_q = stall_selector_q | csr.write_source[3:0];
            } else {
                stall_selector_q = stall_selector_q & ~csr.write_source[3:0];
            }
        }
    }

}
