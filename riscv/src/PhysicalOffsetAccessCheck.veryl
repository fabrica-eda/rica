/// Data permissions from a base and signed start/end offsets.
/// end_offset must equal sign-extended offset + (1 << size) - 1. The caller
/// prepares it before EX, so both possible page carries are evaluated in parallel.
module PhysicalOffsetAccessCheck #(
    param ENABLE_TIMER: bit = 0,
) (
    base         : input  logic<64>,
    offset       : input  logic<12>,
    end_offset   : input  logic<13>,
    size         : input  logic<2> ,
    allowed      : output logic    ,
    boot_boundary: output logic    ,
    ram_boundary : output logic    ,
    boot_region  : output logic    ,
    timer_region : output logic    ,
) {
    var low_sum       : logic<13>;
    var end_sum       : logic<13>;
    var last_boot     : logic    ;
    var last_ram      : logic    ;
    var boot_current  : logic    ;
    var boot_next     : logic    ;
    var boot_previous : logic    ;
    var ram_current   : logic    ;
    var ram_next      : logic    ;
    var ram_previous  : logic    ;
    var timer_current : logic    ;
    var timer_next    : logic    ;
    var timer_previous: logic    ;
    var ram           : logic    ;
    var boot          : logic    ;
    var timer         : logic    ;
    var aligned       : logic    ;
    var upper_zero    : logic    ;
    var wrapped_boot  : logic    ;
    var boot_crossing : logic    ;
    var ram_crossing  : logic    ;

    always_comb {
        low_sum = {1'b0, base[11:0]} + {1'b0, offset};
        end_sum = {1'b0, base[11:0]} + {1'b0, end_offset[11:0]};
        // Keep the common upper-address check parallel to region selection.
        // No implemented region is near the 32-bit boundary. The only valid
        // nonzero-upper base is immediately below zero in XLEN arithmetic;
        // a positive 12-bit offset can wrap it into the first 2047 boot bytes.
        upper_zero     = base[63:32] == 32'd0;
        wrapped_boot   = (base[63:32] == 32'hffff_ffff) && (base[31:12] == 20'hfffff) && !offset[11] && low_sum[12];
        boot_current   = base[31:12] == 20'd0;
        boot_next      = 1'b0;
        boot_previous  = base[31:12] == 20'd1;
        ram_current    = (base[31:18] == 14'h2000) && (base[17:12] != 6'h3f);
        ram_next       = ((base[31:18] == 14'h2000) && (base[17:12] <= 6'h3d)) || (base[31:12] == 20'h7_ffff);
        ram_previous   = (base[31:18] == 14'h2000) && (base[17:12] != 6'd0);
        timer_current  = ENABLE_TIMER && (base[31:16] == 16'h0200);
        timer_next     = ENABLE_TIMER
            && (((base[31:16] == 16'h0200) && (base[15:12] != 4'hf)) || (base[31:12] == 20'h1fff));
        timer_previous = ENABLE_TIMER
            && (((base[31:16] == 16'h0200) && (base[15:12] != 4'd0)) || (base[31:12] == 20'h2010));

        boot  = boot_current;
        ram   = ram_current;
        timer = timer_current;
        if !offset[11] && low_sum[12] {
            boot  = boot_next;
            ram   = ram_next;
            timer = timer_next;
        } else if offset[11] && !low_sum[12] {
            boot  = boot_previous;
            ram   = ram_previous;
            timer = timer_previous;
        }
        // A 13-bit signed end offset also represents 2047 + 7. Its
        // carry selects the same three pages independently of low_sum.
        last_boot = boot_current;
        last_ram  = ram_current;
        if !end_offset[12] && end_sum[12] {
            last_boot = boot_next;
            last_ram  = ram_next;
        } else if end_offset[12] && !end_sum[12] {
            last_boot = boot_previous;
            last_ram  = ram_previous;
        }
        aligned = 1'b1;
        case size {
            2'd1   : aligned = low_sum[0] == 1'b0;
            2'd2   : aligned = low_sum[1:0] == 2'd0;
            2'd3   : aligned = low_sum[2:0] == 3'd0;
            default: {}
        }
        boot_crossing = boot && !last_boot;
        ram_crossing  = ram && !last_ram;
        boot_boundary = upper_zero && boot_crossing;
        ram_boundary  = upper_zero && ram_crossing;
        boot_region   = wrapped_boot || (upper_zero && boot);
        timer_region  = upper_zero && timer;
        allowed       = wrapped_boot
            || (upper_zero && (((boot || ram) && !(boot_crossing || ram_crossing)) || (timer && aligned)));
    }
}
