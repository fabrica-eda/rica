/// Direct JTAG debug transport using a 128-bit ER1 command mailbox.
///
/// Sample JTAGG on falling JTCK edges, away from its rising-edge launches.
/// JTDI is one TCK behind the TAP controls, so register the shift enable.
/// Sample UPDATE as data in the same domain and publish only after the final
/// shift has settled. The host sends exactly 128 bits, LSB first.
module JtagDebugTransport (
    clk               : input  'cpu clock              ,
    rst_n             : input  'cpu reset_async_low    ,
    command_valid     : output 'cpu logic              ,
    command_frame_low : output 'cpu logic          <64>,
    command_frame_high: output 'cpu logic          <64>,
    response_bit      : input  'cpu logic              ,
    status_bit        : input  'cpu logic              ,
    jtag_tdi          : input  'tap logic              ,
    jtag_tck          : input  'tap clock_negedge      ,
    jtag_rti1         : input  'tap logic              ,
    jtag_rti2         : input  'tap logic              ,
    jtag_shift        : input  'tap logic              ,
    jtag_update       : input  'tap logic              ,
    jtag_rst_n        : input  'tap reset_async_low    ,
    jtag_ce1          : input  'tap logic              ,
    jtag_ce2          : input  'tap logic              ,
    jtag_tdo1         : output 'tap logic              ,
    jtag_tdo2         : output 'tap logic              ,
) {
    var shift_low     : 'tap logic<64>;
    var shift_high    : 'tap logic<64>;
    var last_chain_er1: 'tap logic    ;
    var shift_enable_q: 'tap logic    ;
    var update_q      : 'tap logic    ;
    var update_seen_q : 'tap logic    ;
    var mailbox_low   : 'tap logic<64>;
    var mailbox_high  : 'tap logic<64>;
    var request_toggle: 'tap logic    ;

    var mailbox_low_async    : 'cpu logic<64>;
    var mailbox_high_async   : 'cpu logic<64>;
    var request_toggle_async : 'cpu logic    ;
    var request_toggle_meta_q: 'cpu logic    ;
    var request_toggle_sync_q: 'cpu logic    ;
    var request_toggle_seen_q: 'cpu logic    ;
    var request_sync_warmup_q: 'cpu logic<2> ;

    // JTAGG control/data launches have no complete hold model in the current
    // ECP5 flow. Falling-edge sampling gives them half a TCK to settle instead
    // of relying on placement-dependent same-edge races. Delaying CE/SHIFT
    // aligns these controls with JTAGG's one-cycle-delayed JTDI.
    always_ff (jtag_tck, jtag_rst_n) {
        if_reset {
            shift_low      = 64'd0;
            shift_high     = 64'd0;
            shift_enable_q = 1'b0;
            last_chain_er1 = 1'b0;
            update_q       = 1'b0;
            update_seen_q  = 1'b0;
            mailbox_low    = 64'd0;
            mailbox_high   = 64'd0;
            request_toggle = 1'b0;
        } else {
            shift_enable_q = jtag_ce1 && jtag_shift;
            update_q       = jtag_update;
            update_seen_q  = update_q;

            if jtag_ce1 {
                last_chain_er1 = 1'b1;
            } else if jtag_ce2 {
                last_chain_er1 = 1'b0;
            }
            if shift_enable_q {
                shift_low  = {shift_high[0], shift_low[63:1]};
                shift_high = {jtag_tdi, shift_high[63:1]};
            }

            // UPDATE is data, never a generated clock. Its registered rising
            // edge publishes the old, complete shifter on a later falling TCK.
            // Clearing the arm prevents ER2/non-user scans from replaying it.
            if update_q && !update_seen_q {
                if last_chain_er1 {
                    mailbox_low    = shift_low;
                    mailbox_high   = shift_high;
                    request_toggle = !request_toggle;
                }
                last_chain_er1 = 1'b0;
            }
        }
    }

    // The mailbox stays stable until the next ER1 update. Synchronizing its
    // toggle gives the bundled frame two CPU clocks to settle before capture.
    unsafe (cdc) {
        assign mailbox_low_async    = mailbox_low;
        assign mailbox_high_async   = mailbox_high;
        assign request_toggle_async = request_toggle;
        assign jtag_tdo1            = response_bit;
        assign jtag_tdo2            = status_bit;
    }

    always_ff (clk, rst_n) {
        if_reset {
            request_toggle_meta_q = 1'b0;
            request_toggle_sync_q = 1'b0;
            request_toggle_seen_q = 1'b0;
            request_sync_warmup_q = 2'd0;
            command_valid         = 1'b0;
            command_frame_low     = 64'd0;
            command_frame_high    = 64'd0;
        } else {
            request_toggle_meta_q = request_toggle_async;
            request_toggle_sync_q = request_toggle_meta_q;
            command_valid         = 1'b0;

            // rst_n can fall when the PLL loses lock without resetting the
            // JTAG producer. Align to its existing toggle for three clocks so
            // relock cannot replay the previous mailbox contents.
            if request_sync_warmup_q != 2'd3 {
                request_sync_warmup_q = request_sync_warmup_q + 2'd1;
                request_toggle_seen_q = request_toggle_sync_q;
            } else if request_toggle_sync_q != request_toggle_seen_q {
                request_toggle_seen_q = request_toggle_sync_q;
                command_frame_low     = mailbox_low_async;
                command_frame_high    = mailbox_high_async;
                command_valid         = 1'b1;
            }
        }
    }
}
