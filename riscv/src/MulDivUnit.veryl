/// RV64M execution outside the single-cycle ALU. Radix-four multiplication
/// consumes two multiplier bits per cycle; restoring division consumes one.
/// Result and done remain stable until consumed. Cancel discards speculative work.
module MulDivUnit (
    clk      : input  clock              ,
    rst_n    : input  reset_async_low    ,
    start    : input  logic              ,
    cancel   : input  logic              ,
    consume  : input  logic              ,
    operation: input  logic          <3> ,
    word_op  : input  logic              ,
    operand_a: input  logic          <64>,
    operand_b: input  logic          <64>,
    done     : output logic              ,
    result   : output logic          <64>,
) {
    const IDLE      : u32 = 0;
    const PREPARE   : u32 = 1;
    const MULTIPLY  : u32 = 2;
    const DIVIDE    : u32 = 3;
    const MUL_SIGN_A: u32 = 4;
    const MUL_SIGN_B: u32 = 5;
    const DIV_SIGN  : u32 = 6;
    const FORMAT    : u32 = 7;
    const DONE      : u32 = 8;

    var state_q          : logic<4> ;
    var operation_q      : logic<3> ;
    var word_q           : logic    ;
    var count_q          : logic<6> ;
    var a_q              : logic<64>;
    var b_q              : logic<64>;
    var high_q           : logic<64>;
    var low_q            : logic<64>;
    var triple_q         : logic<66>;
    var negative_a_q     : logic    ;
    var negative_b_q     : logic    ;
    var divisor_zero_q   : logic    ;
    var raw_result_q     : logic<64>;
    var result_q         : logic<64>;
    var normalized_a     : logic<64>;
    var normalized_b     : logic<64>;
    var magnitude_a      : logic<64>;
    var magnitude_b      : logic<64>;
    var multiple         : logic<66>;
    var product_step     : logic<66>;
    var division_step    : logic<65>;
    var division_result  : logic<64>;
    var division_negative: logic    ;

    always_comb {
        normalized_a = operand_a;
        normalized_b = operand_b;
        if word_op {
            normalized_a = {32'd0, operand_a[31:0]};
            normalized_b = {32'd0, operand_b[31:0]};
            if operation[2] && !operation[0] {
                normalized_a[63:32] = {operand_a[31] repeat 32};
                normalized_b[63:32] = {operand_b[31] repeat 32};
            }
        }
        magnitude_a = a_q;
        magnitude_b = b_q;
        if negative_a_q {
            magnitude_a = ~a_q + 64'd1;
        }
        if negative_b_q {
            magnitude_b = ~b_q + 64'd1;
        }
        case low_q[1:0] {
            2'd0   : multiple = 66'd0;
            2'd1   : multiple = {2'd0, b_q};
            2'd2   : multiple = {1'b0, b_q, 1'b0};
            default: multiple = triple_q;
        }
        product_step      = {2'd0, high_q} + multiple;
        division_step     = {high_q, low_q[63]} - {1'b0, b_q};
        division_result   = low_q;
        division_negative = (negative_a_q ^ negative_b_q) && !divisor_zero_q;
        if operation_q[1] {
            division_result   = high_q;
            division_negative = negative_a_q;
        }
        done   = state_q == DONE;
        result = result_q;
    }

    always_ff (clk, rst_n) {
        if_reset {
            state_q        = IDLE;
            operation_q    = 3'd0;
            word_q         = 1'b0;
            count_q        = 6'd0;
            a_q            = 64'd0;
            b_q            = 64'd0;
            high_q         = 64'd0;
            low_q          = 64'd0;
            triple_q       = 66'd0;
            negative_a_q   = 1'b0;
            negative_b_q   = 1'b0;
            divisor_zero_q = 1'b0;
            raw_result_q   = 64'd0;
            result_q       = 64'd0;
        } else {
            case state_q {
                IDLE: {
                    // Idle payload is unowned. Capture it without putting
                    // the late pipeline start/cancel decision on 128 bits.
                    a_q          = normalized_a;
                    b_q          = normalized_b;
                    operation_q  = operation;
                    word_q       = word_op;
                    negative_a_q = normalized_a[63]
                        && ((operation == 3'd1) || (operation == 3'd2) || (operation[2] && !operation[0]));
                    negative_b_q = normalized_b[63] && ((operation == 3'd1) || (operation[2] && !operation[0]));
                    if start {
                        state_q = PREPARE;
                    }
                }
                PREPARE: {
                    high_q = 64'd0;
                    if operation_q[2] {
                        low_q   = magnitude_a;
                        count_q = 6'd63;
                        if word_q {
                            low_q   = {magnitude_a[31:0], 32'd0};
                            count_q = 6'd31;
                        }
                        b_q            = magnitude_b;
                        divisor_zero_q = b_q == 64'd0;
                        state_q        = DIVIDE;
                    } else {
                        low_q    = a_q;
                        triple_q = {2'd0, b_q} + {1'b0, b_q, 1'b0};
                        count_q  = 6'd31;
                        state_q  = MULTIPLY;
                    }
                }
                MULTIPLY: {
                    high_q  = product_step[65:2];
                    low_q   = {product_step[1:0], low_q[63:2]};
                    count_q = count_q - 6'd1;
                    if count_q == 6'd0 {
                        state_q = MUL_SIGN_A;
                    }
                }
                MUL_SIGN_A: {
                    if operation_q == 3'd0 {
                        raw_result_q = low_q;
                        state_q      = FORMAT;
                    } else {
                        if negative_a_q {
                            high_q = high_q - b_q;
                        }
                        state_q = MUL_SIGN_B;
                    }
                }
                MUL_SIGN_B: {
                    raw_result_q = high_q;
                    if negative_b_q {
                        raw_result_q = high_q - a_q;
                    }
                    state_q = FORMAT;
                }
                DIVIDE: {
                    low_q  = {low_q[62:0], !division_step[64]};
                    high_q = {high_q[62:0], low_q[63]};
                    if !division_step[64] {
                        high_q = division_step[63:0];
                    }
                    count_q = count_q - 6'd1;
                    if count_q == 6'd0 {
                        state_q = DIV_SIGN;
                    }
                }
                DIV_SIGN: {
                    raw_result_q = division_result;
                    if division_negative {
                        raw_result_q = ~division_result + 64'd1;
                    }
                    state_q = FORMAT;
                }
                FORMAT: {
                    result_q = raw_result_q;
                    if word_q {
                        result_q = {raw_result_q[31] repeat 32, raw_result_q[31:0]};
                    }
                    state_q = DONE;
                }
                DONE: {
                    if consume {
                        state_q = IDLE;
                    }
                }
                default: state_q = IDLE;
            }
            // Cancel revokes ownership; payload updates on this edge are
            // irrelevant until a later start captures a complete new request.
            if cancel {
                state_q = IDLE;
            }
        }
    }
}
