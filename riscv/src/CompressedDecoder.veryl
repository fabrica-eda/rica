/// Combinational RV64C/Zca integer-instruction decompressor.
///
/// Every legal compressed instruction is expanded to the corresponding
/// canonical RV64I instruction before it reaches the existing Decoder.  RVC
/// HINT encodings remain legal and expand to their architecturally harmless
/// integer operation.  Reserved encodings, floating-point compressed opcodes,
/// and the non-compressed quadrant assert `illegal`.
///
/// The fetch pipeline must retain the original instruction length.  In
/// particular, a canonicalized C.JALR still links to the compressed
/// instruction's successor at PC + 2, rather than the canonical JALR's PC + 4.
module CompressedDecoder (
    compressed : input  logic<16>,
    instruction: output logic<32>,
    illegal    : output logic    ,
) {
    var quadrant    : logic<2> ;
    var funct3      : logic<3> ;
    var rd          : logic<5> ;
    var rs2         : logic<5> ;
    var rs1_prime   : logic<5> ;
    var rs2_prime   : logic<5> ;
    var ci_imm      : logic<12>;
    var shift_imm   : logic<12>;
    var addi4spn_imm: logic<12>;
    var word_imm    : logic<12>;
    var double_imm  : logic<12>;
    var addi16sp_imm: logic<12>;
    var lwsp_imm    : logic<12>;
    var ldsp_imm    : logic<12>;
    var swsp_imm    : logic<12>;
    var sdsp_imm    : logic<12>;
    var branch_imm  : logic<13>;
    var jump_imm    : logic<21>;

    // Disjoint instruction matches form a balanced OR tree. No instruction
    // field waits behind the priority chain of unrelated compressed opcodes.
    var selected  : logic<32>     ;
    var candidates: logic<32> [32];
    var masked    : logic<32> [32];
    var level0    : logic<32> [16];
    var level1    : logic<32> [8] ;
    var level2    : logic<32> [4] ;
    var level3    : logic<32> [2] ;

    always_comb {
        quadrant  = compressed[1:0];
        funct3    = compressed[15:13];
        rd        = compressed[11:7];
        rs2       = compressed[6:2];
        rs1_prime = {2'b01, compressed[9:7]};
        rs2_prime = {2'b01, compressed[4:2]};

        // CI-format sign-extended immediate and RV64 six-bit shift amount.
        ci_imm    = {compressed[12] repeat 7, compressed[6:2]};
        shift_imm = {6'b000000, compressed[12], compressed[6:2]};

        // Zero-extended scaled load/store and stack-adjust immediates.
        addi4spn_imm = {2'b00, compressed[10:7], compressed[12:11], compressed[5], compressed[6], 2'b00};
        word_imm     = {5'b00000, compressed[5], compressed[12:10], compressed[6], 2'b00};
        double_imm   = {4'b0000, compressed[6:5], compressed[12:10], 3'b000};
        addi16sp_imm = {compressed[12] repeat 3, compressed[4:3], compressed[5], compressed[2], compressed[6], 4'b0000};
        lwsp_imm     = {4'b0000, compressed[3:2], compressed[12], compressed[6:4], 2'b00};
        ldsp_imm     = {3'b000, compressed[4:2], compressed[12], compressed[6:5], 3'b000};
        swsp_imm     = {4'b0000, compressed[8:7], compressed[12:9], 2'b00};
        sdsp_imm     = {3'b000, compressed[9:7], compressed[12:10], 3'b000};

        // Sign-extended control-flow displacements in their natural order.
        branch_imm = {
            compressed[12] repeat 5, compressed[6:5], compressed[2], compressed[11:10], compressed[4:3], 1'b0
        };
        jump_imm   = {
            compressed[12] repeat 10, compressed[8], compressed[10:9], compressed[6], compressed[7], compressed[2],
            compressed[11], compressed[5:3], 1'b0
        };

        // Q0: C.ADDI4SPN, C.LW, C.LD, C.SW, C.SD.
        selected[0]   = (quadrant == 2'b00) && (funct3 == 3'b000) && (compressed[12:5] != 8'd0);
        candidates[0] = {addi4spn_imm, 5'd2, 3'b000, rs2_prime, 7'b0010011};
        selected[1]   = (quadrant == 2'b00) && (funct3 == 3'b010);
        candidates[1] = {word_imm, rs1_prime, 3'b010, rs2_prime, 7'b0000011};
        selected[2]   = (quadrant == 2'b00) && (funct3 == 3'b011);
        candidates[2] = {double_imm, rs1_prime, 3'b011, rs2_prime, 7'b0000011};
        selected[3]   = (quadrant == 2'b00) && (funct3 == 3'b110);
        candidates[3] = {word_imm[11:5], rs2_prime, rs1_prime, 3'b010, word_imm[4:0], 7'b0100011};
        selected[4]   = (quadrant == 2'b00) && (funct3 == 3'b111);
        candidates[4] = {double_imm[11:5], rs2_prime, rs1_prime, 3'b011, double_imm[4:0], 7'b0100011};

        // Q1 immediates. Preserve the C.NOP/C.ADDI, C.LI and C.LUI HINT spaces.
        selected[5]   = (quadrant == 2'b01) && (funct3 == 3'b000);
        candidates[5] = {ci_imm, rd, 3'b000, rd, 7'b0010011};
        selected[6]   = (quadrant == 2'b01) && (funct3 == 3'b001) && (rd != 5'd0);
        candidates[6] = {ci_imm, rd, 3'b000, rd, 7'b0011011};
        selected[7]   = (quadrant == 2'b01) && (funct3 == 3'b010);
        candidates[7] = {ci_imm, 5'd0, 3'b000, rd, 7'b0010011};
        selected[8]   = (quadrant == 2'b01) && (funct3 == 3'b011) && (rd == 5'd2)
            && ({compressed[12], compressed[6:2]} != 6'd0);
        candidates[8] = {addi16sp_imm, 5'd2, 3'b000, 5'd2, 7'b0010011};
        selected[9]   = (quadrant == 2'b01) && (funct3 == 3'b011) && (rd != 5'd2)
            && ({compressed[12], compressed[6:2]} != 6'd0);
        candidates[9] = {compressed[12] repeat 15, compressed[6:2], rd, 7'b0110111};

        // Q1 compact ALU: SRLI, SRAI, ANDI, SUB, XOR, OR, AND, SUBW, ADDW.
        selected[10]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[11:10] == 2'b00);
        candidates[10] = {shift_imm, rs1_prime, 3'b101, rs1_prime, 7'b0010011};
        selected[11]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[11:10] == 2'b01);
        candidates[11] = {6'b010000, compressed[12], compressed[6:2], rs1_prime, 3'b101, rs1_prime, 7'b0010011};
        selected[12]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[11:10] == 2'b10);
        candidates[12] = {ci_imm, rs1_prime, 3'b111, rs1_prime, 7'b0010011};
        selected[13]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[12:10] == 3'b011)
            && (compressed[6:5] == 2'b00);
        candidates[13] = {7'b0100000, rs2_prime, rs1_prime, 3'b000, rs1_prime, 7'b0110011};
        selected[14]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[12:10] == 3'b011)
            && (compressed[6:5] == 2'b01);
        candidates[14] = {7'b0000000, rs2_prime, rs1_prime, 3'b100, rs1_prime, 7'b0110011};
        selected[15]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[12:10] == 3'b011)
            && (compressed[6:5] == 2'b10);
        candidates[15] = {7'b0000000, rs2_prime, rs1_prime, 3'b110, rs1_prime, 7'b0110011};
        selected[16]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[12:10] == 3'b011)
            && (compressed[6:5] == 2'b11);
        candidates[16] = {7'b0000000, rs2_prime, rs1_prime, 3'b111, rs1_prime, 7'b0110011};
        selected[17]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[12:10] == 3'b111)
            && (compressed[6:5] == 2'b00);
        candidates[17] = {7'b0100000, rs2_prime, rs1_prime, 3'b000, rs1_prime, 7'b0111011};
        selected[18]   = (quadrant == 2'b01) && (funct3 == 3'b100) && (compressed[12:10] == 3'b111)
            && (compressed[6:5] == 2'b01);
        candidates[18] = {7'b0000000, rs2_prime, rs1_prime, 3'b000, rs1_prime, 7'b0111011};

        // Q1 control flow: C.J, C.BEQZ and C.BNEZ.
        selected[19]   = (quadrant == 2'b01) && (funct3 == 3'b101);
        candidates[19] = {jump_imm[20], jump_imm[10:1], jump_imm[11], jump_imm[19:12], 5'd0, 7'b1101111};
        selected[20]   = (quadrant == 2'b01) && (funct3 == 3'b110);
        candidates[20] = {
            branch_imm[12], branch_imm[10:5], 5'd0, rs1_prime, 3'b000, branch_imm[4:1], branch_imm[11], 7'b1100011
        };
        selected[21]   = (quadrant == 2'b01) && (funct3 == 3'b111);
        candidates[21] = {
            branch_imm[12], branch_imm[10:5], 5'd0, rs1_prime, 3'b001, branch_imm[4:1], branch_imm[11], 7'b1100011
        };

        // Q2: shifts, stack loads/stores and the disjoint CR instruction forms.
        selected[22]   = (quadrant == 2'b10) && (funct3 == 3'b000);
        candidates[22] = {shift_imm, rd, 3'b001, rd, 7'b0010011};
        selected[23]   = (quadrant == 2'b10) && (funct3 == 3'b010) && (rd != 5'd0);
        candidates[23] = {lwsp_imm, 5'd2, 3'b010, rd, 7'b0000011};
        selected[24]   = (quadrant == 2'b10) && (funct3 == 3'b011) && (rd != 5'd0);
        candidates[24] = {ldsp_imm, 5'd2, 3'b011, rd, 7'b0000011};
        selected[25]   = (quadrant == 2'b10) && (funct3 == 3'b100) && !compressed[12] && (rs2 == 5'd0) && (rd != 5'd0);
        candidates[25] = {12'd0, rd, 3'b000, 5'd0, 7'b1100111};
        selected[26]   = (quadrant == 2'b10) && (funct3 == 3'b100) && !compressed[12] && (rs2 != 5'd0);
        candidates[26] = {7'b0000000, rs2, 5'd0, 3'b000, rd, 7'b0110011};
        selected[27]   = (quadrant == 2'b10) && (funct3 == 3'b100) && compressed[12] && (rs2 == 5'd0) && (rd == 5'd0);
        candidates[27] = 32'h0010_0073;
        selected[28]   = (quadrant == 2'b10) && (funct3 == 3'b100) && compressed[12] && (rs2 == 5'd0) && (rd != 5'd0);
        candidates[28] = {12'd0, rd, 3'b000, 5'd1, 7'b1100111};
        selected[29]   = (quadrant == 2'b10) && (funct3 == 3'b100) && compressed[12] && (rs2 != 5'd0);
        candidates[29] = {7'b0000000, rs2, rd, 3'b000, rd, 7'b0110011};
        selected[30]   = (quadrant == 2'b10) && (funct3 == 3'b110);
        candidates[30] = {swsp_imm[11:5], rs2, 5'd2, 3'b010, swsp_imm[4:0], 7'b0100011};
        selected[31]   = (quadrant == 2'b10) && (funct3 == 3'b111);
        candidates[31] = {sdsp_imm[11:5], rs2, 5'd2, 3'b011, sdsp_imm[4:0], 7'b0100011};

        for i in 0..32 {
            masked[i] = candidates[i] & {selected[i] repeat 32};
        }
        for i in 0..16 {
            level0[i] = masked[i * 2] | masked[i * 2 + 1];
        }
        for i in 0..8 {
            level1[i] = level0[i * 2] | level0[i * 2 + 1];
        }
        for i in 0..4 {
            level2[i] = level1[i * 2] | level1[i * 2 + 1];
        }
        for i in 0..2 {
            level3[i] = level2[i * 2] | level2[i * 2 + 1];
        }
        illegal = selected == 32'd0;
        // Preserve the deterministic NOP for every illegal encoding, without
        // gating the other 29 output bits behind the legality reduction.
        instruction = level3[0] | level3[1] | ({illegal repeat 32} & 32'h0000_0013);
    }
}
