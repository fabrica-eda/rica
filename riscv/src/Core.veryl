/// Overlapped in-order RV64IC-subset core for the 125 MHz timing target.
///
/// Fetch/decode, synchronous register read, EX1, common completion/EX2, and
/// writeback overlap. The LSU is one completion source rather than the owner of
/// EX2. Consecutive dependent ALU instructions use a registered EX bypass;
/// load-use plus two-stage shift/compare dependencies stall once.
module Core #(
    param COMMIT_PAYLOAD   : bit = 1,
    param ENABLE_ZBA       : bit = 0,
    param ENABLE_ZBB       : bit = 0,
    param ENABLE_ZBS       : bit = 0,
    param EARLY_BITMANIP   : bit = 0,
    param EARLY_TAKEN_FETCH: bit = 0,
    param ENABLE_M         : bit = 0,
    param M_USE_DSP        : bit = 0,
    param EARLY_DIVIDE     : bit = 0,
    param ENABLE_INTERRUPTS: bit = 0,
    param STRICT_MEMORY    : bit = 0,
    // The board can format a load before its existing CPU response register.
    // Raw asynchronous/direct model ports keep formatting in CompletionUnit.
    param FORMATTED_LOAD_DATA: bit = 0,
    param SYNC_DATA_MEMORY   : bit = 0,
    param RELOCATE_LOW_DATA  : bit = 0,
    // Bits 0/1/2: scrub/bimodal/static. Bit 3 selects compact; bit 4 selects
    // its 32-entry variant, bit 5 disables RAS, bit 6 disables direction prediction.
    param BRANCH_PREDICTOR_CONFIG: u32 = 0,
) (
    clk                   : input  clock    ,
    rst_n                 : input  reset    ,
    instr                 : input  logic<32>,
    instr_is_compressed   : input  logic    ,
    instr_valid           : input  logic    ,
    data_rdata            : input  logic<64>,
    data_response_sequence: input  logic    ,
    machine_interrupts    : input  logic<3> ,
    pc                    : output logic<64>,
    data_addr             : output logic<64>,
    data_memory_addr      : output logic<64>,
    data_wdata            : output logic<64>,
    data_wmask            : output logic<8> ,
    data_we               : output logic    ,
    data_request_sequence : output logic    ,
    data_load_size        : output logic<2> ,
    data_load_unsigned    : output logic    ,
    halted                : output logic    ,
    commit_valid          : output logic    ,
    commit_pc             : output logic<64>,
    commit_instr          : output logic<32>,
    commit_rd             : output logic<5> ,
    commit_data           : output logic<64>,
    commit_mem_we         : output logic    ,
    commit_mem_addr       : output logic<64>,
    commit_mem_wdata      : output logic<64>,
    commit_mem_wmask      : output logic<8> ,
    counter_freeze        : input  logic    ,
    debug_counter_index   : input  logic<4> ,
    debug_counter_data    : output logic<64>,
    debug_x31             : output logic<64>,
    instruction_flush     : output logic    ,
) {
    // Strict physical memory retains full architectural PC/trap values while
    // admitting execution only in the platform RAM/reset regions. The predictor
    // still indexes physical PCs; invalid full-width targets become fetch faults.
    const ADDRESS_BITS       : u32 = 32 + 32 * (STRICT_MEMORY as u32);
    const TARGET_MATCH_SLICES: u32 = ADDRESS_BITS / 16;
    // FetchPayload is the registered boundary after instruction-line selection;
    // FetchPacket adds the separately registered occupancy bit to its view.
    // DecodePacket keeps the original encoding beside its canonical RV64I form:
    // the latter feeds the ordinary decoder while the former remains available
    // for architectural traces and illegal-instruction trap values.
    struct FetchPacket {
        pc             : logic<ADDRESS_BITS>,
        raw_instruction: logic<32>          ,
        is_compressed  : logic              ,
        valid          : logic              ,
        access_fault   : logic              ,
        fault_boundary : logic              ,
    }
    struct FetchPayload {
        pc             : logic<ADDRESS_BITS>,
        raw_instruction: logic<32>          ,
        is_compressed  : logic              ,
        access_fault   : logic              ,
        fault_boundary : logic              ,
    }
    struct DecodePacket {
        pc               : logic<ADDRESS_BITS>,
        instruction      : logic<32>          ,
        raw_instruction  : logic<32>          ,
        is_compressed    : logic              ,
        illegal          : logic              ,
        prediction_token : logic<3>           ,
        predicted_kind   : logic<3>           ,
        predicted_taken  : logic              ,
        predicted_next_pc: logic<32>          ,
        valid            : logic              ,
        access_fault     : logic              ,
        fault_boundary   : logic              ,
    }
    var fetch_line_q             : logic       <ADDRESS_BITS - 3>;
    var fetch_parcel_q           : logic       <2>               ;
    var fetch_address            : logic       <ADDRESS_BITS>    ;
    var taken_fetch_valid_q      : logic                         ;
    var taken_fetch_pc_q         : logic       <ADDRESS_BITS>    ;
    var fetch_line_plus_one      : logic       <ADDRESS_BITS - 3>;
    var fetch_next_parcel        : logic       <2>               ;
    var fetch_cross_line         : logic                         ;
    var fetch_fallthrough        : logic       <ADDRESS_BITS>    ;
    var fetch_is_conditional     : logic                         ;
    var debug_x31_q              : logic       <64>              ;
    var fetch_packet             : FetchPacket                   ;
    var fetch_payload_q          : FetchPayload                  ;
    var fetch_lookahead_payload_q: FetchPayload                  ;
    var fetch_tail_payload_q     : FetchPayload                  ;
    var fetch_valid_q            : logic                         ;
    var fetch_lookahead_valid_q  : logic                         ;
    var fetch_tail_valid_q       : logic                         ;
    var fetch_payload_write      : logic                         ;
    var fetch_lookahead_write    : logic                         ;
    var fetch_tail_write         : logic                         ;
    var fetch_q                  : FetchPacket                   ;
    var fetch_lookahead_q        : FetchPacket                   ;
    var decode_packet            : DecodePacket                  ;
    var fd_q                     : DecodePacket                  ;

    var rx_valid_q            : logic              ;
    var rx_pc_q               : logic<ADDRESS_BITS>;
    var rx_raw_instr_q        : logic<32>          ;
    var rx_is_compressed_q    : logic              ;
    var rx_rs1_q              : logic<5>           ;
    var rx_rs2_q              : logic<5>           ;
    var rx_rd_q               : logic<5>           ;
    var rx_immediate_q        : logic<64>          ;
    var rx_alu_op_q           : logic<6>           ;
    var rx_use_pc_q           : logic              ;
    var rx_use_immediate_q    : logic              ;
    var rx_use_rs1_q          : logic              ;
    var rx_use_rs2_q          : logic              ;
    var rx_write_enable_q     : logic              ;
    var rx_is_load_q          : logic              ;
    var rx_load_size_q        : logic<2>           ;
    var rx_load_unsigned_q    : logic              ;
    var rx_is_store_q         : logic              ;
    var rx_store_size_q       : logic<2>           ;
    var rx_word_op_q          : logic              ;
    var rx_is_branch_q        : logic              ;
    var rx_branch_op_q        : logic<3>           ;
    var rx_is_jal_q           : logic              ;
    var rx_is_jalr_q          : logic              ;
    var rx_is_csr_q           : logic              ;
    var rx_csr_op_q           : logic<2>           ;
    var rx_csr_use_imm_q      : logic              ;
    var rx_csr_write_q        : logic              ;
    var rx_csr_index_q        : logic<5>           ;
    var rx_is_ecall_q         : logic              ;
    var rx_is_ebreak_q        : logic              ;
    var rx_is_mret_q          : logic              ;
    var rx_is_fence_i_q       : logic              ;
    var rx_illegal_q          : logic              ;
    var rx_prediction_token_q : logic<3>           ;
    var rx_predicted_kind_q   : logic<3>           ;
    var rx_predicted_taken_q  : logic              ;
    var rx_predicted_next_pc_q: logic<32>          ;
    var rx_stalled_q          : logic              ;
    var rx_stall_data_a_q     : logic<64>          ;
    var rx_stall_data_b_q     : logic<64>          ;

    var ex_valid_q              : logic              ;
    var ex_pc_q                 : logic<ADDRESS_BITS>;
    var ex_raw_instr_q          : logic<32>          ;
    var ex_rd_q                 : logic<5>           ;
    var ex_alu_op_q             : logic<6>           ;
    var ex_zba_control_q        : logic<3>           ;
    var ex_subtract_q           : logic              ;
    var ex_write_enable_q       : logic              ;
    var ex_can_bypass_q         : logic              ;
    var ex_is_load_q            : logic              ;
    var ex_load_size_q          : logic<2>           ;
    var ex_load_unsigned_q      : logic              ;
    var ex_is_store_q           : logic              ;
    var ex_store_size_q         : logic<2>           ;
    var ex_word_op_q            : logic              ;
    var ex_is_branch_q          : logic              ;
    var ex_branch_op_q          : logic<3>           ;
    var ex_link_q               : logic              ;
    var ex_static_redirect_q    : logic              ;
    var ex_control_fallthrough_q: logic              ;
    var ex_is_csr_q             : logic              ;
    var ex_csr_op_q             : logic<2>           ;
    var ex_csr_use_imm_q        : logic              ;
    var ex_csr_immediate_q      : logic<5>           ;
    var ex_csr_write_q          : logic              ;
    var ex_csr_index_q          : logic<5>           ;
    var ex_is_ecall_q           : logic              ;
    var ex_is_ebreak_q          : logic              ;
    var ex_is_mret_q            : logic              ;
    var ex_is_fence_i_q         : logic              ;
    var ex_illegal_q            : logic              ;
    var ex_prediction_token_q   : logic<3>           ;
    var ex_predicted_kind_q     : logic<3>           ;
    var ex_predicted_taken_q    : logic              ;
    var ex_predicted_next_pc_q  : logic<32>          ;
    var ex_fallthrough_pc_q     : logic<ADDRESS_BITS>;
    var ex_operand_a_q          : logic<64>          ;
    var ex_operand_b_q          : logic<64>          ;
    var ex_store_data_q         : logic<64>          ;
    var ex_redirect_base_q      : logic<64>          ;
    var ex_redirect_offset_q    : logic<64>          ;
    var ex_redirect_clear_lsb_q : logic              ;
    struct BypassState {
        operand_a : logic,
        operand_b : logic,
        store_data: logic,
        redirect  : logic,
    }
    var ex_bypass_q: BypassState;

    var cm_valid_q              : logic                     ;
    var cm_pc_q                 : logic<ADDRESS_BITS>       ;
    var cm_raw_instr_q          : logic<32>                 ;
    var cm_rd_q                 : logic<5>                  ;
    var cm_write_enable_q       : logic                     ;
    var cm_is_load_q            : logic                     ;
    var cm_load_size_q          : logic<2>                  ;
    var cm_load_unsigned_q      : logic                     ;
    var cm_is_store_q           : logic                     ;
    var cm_store_size_q         : logic<2>                  ;
    var cm_is_branch_q          : logic                     ;
    var cm_branch_taken_q       : logic                     ;
    var cm_linear_match_q       : logic<TARGET_MATCH_SLICES>;
    var ex_kind_match_q         : logic                     ;
    var cm_taken_match_q        : logic<TARGET_MATCH_SLICES>;
    var cm_untaken_match_q      : logic                     ;
    var cm_branch_op_q          : logic<3>                  ;
    var cm_control_fallthrough_q: logic                     ;
    var cm_branch_equal_q       : logic<4>                  ;
    var cm_redirect_target_q    : logic<ADDRESS_BITS>       ;
    var cm_arithmetic_q         : logic<64>                 ;
    var cm_shift_low_q          : logic<64>                 ;
    var cm_shift_amount_q       : logic<3>                  ;
    var cm_shift_arithmetic_q   : logic                     ;
    var cm_logic_result_q       : logic<64>                 ;
    var cm_use_logic_q          : logic                     ;
    var cm_use_shift_q          : logic                     ;
    var cm_use_bitmanip_q       : logic                     ;
    var bitmanip_result         : logic<64>                 ;
    var early_bitmanip_result   : logic<64>                 ;
    var ex_early_bitmanip       : logic                     ;
    var rx_early_bitmanip       : logic                     ;
    var cm_compare_less_q       : logic<4>                  ;
    var cm_compare_sign_a_q     : logic                     ;
    var cm_compare_sign_b_q     : logic                     ;
    var cm_compare_signed_q     : logic                     ;
    var cm_use_compare_q        : logic                     ;
    var cm_shift_left_q         : logic                     ;
    var cm_shift_word_q         : logic                     ;
    var cm_lsu_address_q        : logic<ADDRESS_BITS>       ;
    var cm_lsu_memory_address_q : logic<32>                 ;
    var cm_lsu_wdata_q          : logic<64>                 ;
    var cm_is_csr_q             : logic                     ;
    var cm_csr_op_q             : logic<2>                  ;
    var cm_csr_write_q          : logic                     ;
    var cm_csr_index_q          : logic<5>                  ;
    var cm_csr_source_q         : logic<64>                 ;
    var cm_exception_q          : logic                     ;
    var cm_exception_cause_q    : logic<64>                 ;
    var cm_exception_value_q    : logic<64>                 ;
    var cm_is_mret_q            : logic                     ;
    var cm_is_fence_i_q         : logic                     ;
    var cm_prediction_token_q   : logic<3>                  ;
    var cm_predicted_kind_q     : logic<3>                  ;
    var cm_predicted_taken_q    : logic                     ;
    var cm_predicted_next_pc_q  : logic<32>                 ;
    var cm_fallthrough_pc_q     : logic<ADDRESS_BITS>       ;
    var cm_control_kind_q       : logic<3>                  ;

    var wb_valid_q       : logic              ;
    var wb_pc_q          : logic<ADDRESS_BITS>;
    var wb_raw_instr_q   : logic<32>          ;
    var wb_rd_q          : logic<5>           ;
    var wb_write_enable_q: logic              ;
    var wb_result_q      : logic<64>          ;
    var wb_mem_we_q      : logic              ;
    var wb_mem_addr_q    : logic<ADDRESS_BITS>;
    var wb_mem_wdata_q   : logic<64>          ;
    var wb_mem_wmask_q   : logic<8>           ;

    var rf_write_enable: logic    ;
    var rf_read_data_a : logic<64>;
    var rf_read_data_b : logic<64>;

    var cm_forward_data         : logic<64>              ;
    var forwarded_rs1           : logic<64>              ;
    var forwarded_rs2           : logic<64>              ;
    var rx_operand_a            : logic<64>              ;
    var rx_operand_b            : logic<64>              ;
    var alu_operand_a           : logic<64>              ;
    var alu_operand_b           : logic<64>              ;
    var lsu_address             : logic<ADDRESS_BITS>    ;
    var lsu_offset              : logic<64>              ;
    var lsu_sum_c0              : logic<17>           [4];
    var lsu_sum_c1              : logic<17>           [4];
    var lsu_carry               : logic<4>               ;
    var bypass_data             : logic<64>              ;
    var execute_store_data      : logic<64>              ;
    var ex_bypass_hit_rs1       : logic                  ;
    var ex_bypass_hit_rs2       : logic                  ;
    var redirect_addend_a       : logic<64>              ;
    var redirect_low            : logic<17>              ;
    var redirect_high_c0        : logic<17>              ;
    var redirect_high_c1        : logic<17>              ;
    var redirect_high           : logic<17>              ;
    var redirect_sum            : logic<64>              ;
    var ex_branch_equal         : logic                  ;
    var ex_compare_less_high    : logic                  ;
    var ex_compare_less_low     : logic                  ;
    var ex_compare_unsigned     : logic                  ;
    var ex_compare_result       : logic                  ;
    var ex_branch_taken         : logic                  ;
    var cm_branch_taken         : logic                  ;
    var cm_compare_unsigned     : logic                  ;
    var cm_compare_result       : logic                  ;
    var rx_control_fallthrough  : logic                  ;
    var ex_redirect_valid       : logic                  ;
    var branch_redirect_valid   : logic                  ;
    var redirect_valid          : logic                  ;
    var ex_redirect_target      : logic<ADDRESS_BITS>    ;
    var ex_predicted_address    : logic<ADDRESS_BITS>    ;
    var redirect_target         : logic<ADDRESS_BITS>    ;
    var redirect_pending_q      : logic                  ;
    var redirect_preserve_cm    : logic                  ;
    var redirect_preserve_cm_q  : logic                  ;
    var redirect_discards_cm    : logic                  ;
    var redirect_event_delay_q  : logic                  ;
    var redirect_flush_wb_q     : logic                  ;
    var redirect_target_q       : logic<ADDRESS_BITS>    ;
    var pending_redirect_target : logic<ADDRESS_BITS>    ;
    var execution_hazard        : logic                  ;
    var decode_operand_match_rx : logic                  ;
    var rx_result_can_bypass    : logic                  ;
    var decode_execution_hazard : logic                  ;
    var rx_execution_hazard_q   : logic                  ;
    var backend_wait            : logic                  ;
    var memory_wait             : logic                  ;
    var muldiv_wait             : logic                  ;
    var muldiv_start            : logic                  ;
    var muldiv_done             : logic                  ;
    var muldiv_result           : logic<64>              ;
    var cm_muldiv_pending_q     : logic                  ;
    var rx_is_muldiv_q          : logic                  ;
    var ex_is_muldiv_q          : logic                  ;
    var data_request_sequence_q : logic                  ;
    var csr_source              : logic<64>              ;
    var csr_write_value         : logic<64>              ;
    var fetch_access_allowed    : logic                  ;
    var fetch_access_boundary   : logic                  ;
    var fetch_fault_address     : logic<64>              ;
    var fetch_access_size       : logic<2>               ;
    var lsu_access_allowed      : logic                  ;
    var lsu_boot_boundary       : logic                  ;
    var lsu_ram_boundary        : logic                  ;
    var lsu_boot_region         : logic                  ;
    var lsu_timer_region        : logic                  ;
    var lsu_access_bases        : logic<64>           [3];
    var lsu_allowed_candidates  : logic               [3];
    var lsu_boot_candidates     : logic               [3];
    var lsu_ram_candidates      : logic               [3];
    var lsu_boot_regions        : logic               [3];
    var lsu_timer_regions       : logic               [3];
    var lsu_fault_address       : logic<64>              ;
    var lsu_access_size         : logic<2>               ;
    var rx_access_size          : logic<2>               ;
    var rx_access_last_byte     : logic<3>               ;
    var rx_access_end_offset    : logic<13>              ;
    var ex_access_end_offset_q  : logic<13>              ;
    var lsu_access_fault        : logic                  ;
    var rx_fetch_fault_q        : logic                  ;
    var rx_fault_boundary_q     : logic                  ;
    var ex_fetch_fault_q        : logic                  ;
    var ex_fault_boundary_q     : logic                  ;
    var redirect_upper_c0       : logic<32>              ;
    var redirect_upper_c1       : logic<32>              ;
    var redirect_upper          : logic<32>              ;
    var ex_exception            : logic                  ;
    var ex_exception_cause      : logic<64>              ;
    var ex_exception_value      : logic<64>              ;
    var cm_trap_event           : logic                  ;
    var cm_mret_event           : logic                  ;
    var cm_system_redirect      : logic                  ;
    var ex_irq_fence            : logic                  ;
    var ex_system_barrier       : logic                  ;
    var cm_irq_fence_event      : logic                  ;
    var interrupt_drain         : logic                  ;
    var interrupt_drain_q       : logic                  ;
    var interrupt_accept        : logic                  ;
    var interrupt_claimed_q     : logic                  ;
    var interrupt_cause_q       : logic<4>               ;
    var interrupt_event         : logic                  ;
    var interrupt_resume_pc_q   : logic<ADDRESS_BITS>    ;
    var frontend_hold           : logic                  ;
    var cm_fence_i_event        : logic                  ;
    var cm_retire_event         : logic                  ;
    var decompressed_instruction: logic<32>              ;
    var compressed_illegal      : logic                  ;
    var rx_control_kind         : logic<3>               ;
    var ex_control_kind_q       : logic<3>               ;
    var ex_actual_next_pc       : logic<ADDRESS_BITS>    ;
    var ex_prediction_mismatch  : logic                  ;
    var cm_actual_next_pc       : logic<ADDRESS_BITS>    ;
    var cm_prediction_mismatch  : logic                  ;

    var predictor_ready                : logic    ;
    var predictor_wait                 : logic    ;
    var predictor_request_ready        : logic    ;
    var predictor_request_valid        : logic    ;
    var predictor_request_accept       : logic    ;
    var fetch_candidate_offer          : logic    ;
    var fetch_payload_capture          : logic    ;
    var fetch_queue_push_valid         : logic    ;
    var fetch_queue_advance            : logic    ;
    var predictor_response_accept      : logic    ;
    var predictor_response_valid       : logic    ;
    var predictor_response_token       : logic<3> ;
    var predictor_response_kind        : logic<3> ;
    var predictor_response_taken       : logic    ;
    var predictor_response_next_pc     : logic<32>;
    var predictor_response_btb_hit     : logic    ;
    var predictor_response_tage_hit    : logic    ;
    var predictor_response_ras_fallback: logic    ;
    var predictor_frontend_redirect    : logic    ;
    var predictor_recover_valid        : logic    ;
    var predictor_recover_token        : logic<3> ;
    var predictor_recover_kind         : logic<3> ;
    var predictor_recover_taken        : logic    ;
    var predictor_recover_fallthrough  : logic<32>;
    var predictor_discard_all          : logic    ;
    var predictor_conditional_event    : logic    ;
    var predictor_direction_wrong_event: logic    ;
    var predictor_btb_miss_event       : logic    ;
    var predictor_ras_fallback_event   : logic    ;

    // Predictor maintenance is deliberately one stage behind architectural
    // resolution.  A redirect already blocks frontend requests while its
    // registered target is installed, so applying recovery in that window
    // cuts EX forwarding/redirect arithmetic away from TAGE and RAS state
    // without adding a normal-path bubble.
    struct PredictorRetirePayload {
        token      : logic<3> ,
        pc         : logic<32>,
        kind       : logic<3> ,
        taken      : logic    ,
        target     : logic<32>,
        fallthrough: logic<32>,
    }
    struct PredictorRecoverPayload {
        token      : logic<3> ,
        kind       : logic<3> ,
        taken      : logic    ,
        fallthrough: logic<32>,
    }
    var predictor_retire_valid_q  : logic                  ;
    var predictor_retire_q        : PredictorRetirePayload ;
    var predictor_recover_valid_q : logic                  ;
    var predictor_recover_branch_q: logic                  ;
    var predictor_recover_q       : PredictorRecoverPayload;
    var predictor_discard_all_q   : logic                  ;

    inst registers: RegisterFile (
        clk           : clk                    ,
        write_enable  : rf_write_enable        ,
        write_address : wb_rd_q                ,
        write_data    : wb_result_q            ,
        read_enable   : !backend_wait          ,
        read_address_a: fd_q.instruction[19:15],
        read_address_b: fd_q.instruction[24:20],
        read_data_a   : rf_read_data_a         ,
        read_data_b   : rf_read_data_b         ,
    );

    inst decode_bus: DecodeBus;
    if ENABLE_M :g_muldiv {
        inst unit: MulDivUnit #(
            USE_DSP     : M_USE_DSP   ,
            EARLY_DIVIDE: EARLY_DIVIDE,
        ) (
            clk      : clk                                             ,
            rst_n    : rst_n                                           ,
            start    : muldiv_start                                    ,
            cancel   : redirect_discards_cm                            ,
            consume  : muldiv_done && cm_valid_q && cm_muldiv_pending_q,
            operation: ex_raw_instr_q[14:12]                           ,
            word_op  : ex_word_op_q                                    ,
            operand_a: alu_operand_a                                   ,
            operand_b: alu_operand_b                                   ,
            done     : muldiv_done                                     ,
            result   : muldiv_result                                   ,
        );
    } else {
        assign muldiv_done   = 1'b0;
        assign muldiv_result = 64'd0;
    }

    inst decoder: Decoder #(
        ENABLE_INTERRUPTS: ENABLE_INTERRUPTS,
        ENABLE_ZBB       : ENABLE_ZBB       ,
        ENABLE_ZBS       : ENABLE_ZBS       ,
        ENABLE_ZBA       : ENABLE_ZBA       ,
        ENABLE_M         : ENABLE_M         ,
    ) (
        decode: decode_bus,
    );

    inst compressed_decoder: CompressedDecoder (
        compressed : fetch_q.raw_instruction[15:0],
        instruction: decompressed_instruction     ,
        illegal    : compressed_illegal           ,
    );

    inst csr_bus : CsrBus;
    inst csr_file: CsrFile #(
        FULL_ADDRESS     : STRICT_MEMORY                         ,
        ENABLE_INTERRUPTS: ENABLE_INTERRUPTS                     ,
        ENABLE_M         : ENABLE_M                              ,
        ENABLE_B         : ENABLE_ZBA && ENABLE_ZBB && ENABLE_ZBS,
    ) (
        clk  : clk    ,
        rst_n: rst_n  ,
        csr  : csr_bus,
    );

    inst execute_bus : ExecuteBus;
    inst execute_unit: ExecuteUnit #(
        ENABLE_ZBA    : ENABLE_ZBA,
        PREDECODED_ZBA: 1         ,
    ) (
        execute: execute_bus,
    );

    inst completion_bus : CompletionBus;
    inst completion_unit: CompletionUnit (
        completion: completion_bus,
    );

    if ENABLE_ZBB || ENABLE_ZBS :g_bitmanip {
        var partial    : logic<64>;
        var partial_q  : logic<64>;
        var operand_b_q: logic<64>;
        var operation_q: logic<5> ;
        inst low: BitManipUnit #(
            EARLY_SIMPLE: EARLY_BITMANIP,
        ) (
            operation: ex_alu_op_q[4:0],
            word_op  : ex_word_op_q    ,
            operand_a: alu_operand_a   ,
            operand_b: alu_operand_b   ,
            partial  : partial         ,
        );
        inst high: BitManipHighUnit #(
            EARLY_SIMPLE: EARLY_BITMANIP,
        ) (
            operation    : operation_q        ,
            word_op      : cm_shift_word_q    ,
            amount       : cm_shift_amount_q  ,
            partial      : partial_q          ,
            operand_b    : operand_b_q        ,
            compare_equal: cm_branch_equal_q  ,
            compare_less : cm_compare_less_q  ,
            sign_a       : cm_compare_sign_a_q,
            sign_b       : cm_compare_sign_b_q,
            result       : bitmanip_result    ,
        );
        // Payload refresh follows CM; validity and redirects are owned by Core.
        always_ff (clk) {
            if !backend_wait {
                partial_q   = partial;
                operand_b_q = alu_operand_b;
                operation_q = ex_alu_op_q[4:0];
            }
        }
    } else {
        assign bitmanip_result = 64'd0;
    }

    // Only shallow operations use the existing registered ALU forwarding path.
    // BEXT, min/max, rotates and counts still complete through CM and WB.
    // Decode the forwarding class before EX so opcode comparisons do not
    // precede its word-wide result select. It advances with ex_alu_op_q.
    always_ff (clk, rst_n) {
        if_reset {
            ex_early_bitmanip = 1'b0;
        } else if !backend_wait {
            ex_early_bitmanip = rx_early_bitmanip;
        }
    }
    assign rx_early_bitmanip = EARLY_BITMANIP
        && ((ENABLE_ZBB && (rx_alu_op_q[5:3] == 3'b100))
            || (ENABLE_ZBS && (rx_alu_op_q[5:2] == 4'b1101) && (rx_alu_op_q[1] || !rx_alu_op_q[0])));
    if EARLY_BITMANIP && (ENABLE_ZBB || ENABLE_ZBS) :g_early_bitmanip {
        inst unit: SimpleBitManipUnit #(
            ENABLE_ZBB: ENABLE_ZBB,
            ENABLE_ZBS: ENABLE_ZBS,
        ) (
            operation: ex_alu_op_q[4:0]     ,
            operand_a: alu_operand_a        ,
            operand_b: alu_operand_b        ,
            result   : early_bitmanip_result,
        );
    } else {
        assign early_bitmanip_result = 64'd0;
    }

    if (BRANCH_PREDICTOR_CONFIG & 8) != 0 :g_compact {
        inst compact_predictor: CompactBranchPredictor #(
            INDEX_BITS   : 6 - ((BRANCH_PREDICTOR_CONFIG >> 4) & 1),
            USE_RAS      : (BRANCH_PREDICTOR_CONFIG & 32) == 0,
            USE_DIRECTION: (BRANCH_PREDICTOR_CONFIG & 64) == 0,
        ) (
            clk                       : clk                            ,
            rst_n                     : rst_n                          ,
            ready                     : predictor_ready                ,
            request_ready             : predictor_request_ready        ,
            request_valid             : predictor_request_valid        ,
            request_accept            : predictor_request_accept       ,
            request_pc                : fetch_packet.pc                ,
            request_fallthrough       : fetch_fallthrough              ,
            response_accept           : predictor_response_accept      ,
            response_valid            : predictor_response_valid       ,
            response_token            : predictor_response_token       ,
            response_kind             : predictor_response_kind        ,
            response_taken            : predictor_response_taken       ,
            response_next_pc          : predictor_response_next_pc     ,
            response_btb_hit          : predictor_response_btb_hit     ,
            response_tage_hit         : predictor_response_tage_hit    ,
            response_ras_fallback     : predictor_response_ras_fallback,
            retire_valid              : predictor_retire_valid_q       ,
            retire_token              : predictor_retire_q.token       ,
            retire_pc                 : predictor_retire_q.pc          ,
            retire_kind               : predictor_retire_q.kind        ,
            retire_taken              : predictor_retire_q.taken       ,
            retire_target             : predictor_retire_q.target      ,
            retire_fallthrough        : predictor_retire_q.fallthrough ,
            recover_valid             : predictor_recover_valid_q      ,
            discard_all               : predictor_discard_all_q        ,
            conditional_resolved_event: predictor_conditional_event    ,
            direction_wrong_event     : predictor_direction_wrong_event,
            btb_miss_event            : predictor_btb_miss_event       ,
            ras_fallback_event        : predictor_ras_fallback_event   ,
        );
    } else if (BRANCH_PREDICTOR_CONFIG & 4) == 0 :g_dynamic {
        inst branch_predictor: BranchPredictor #(
            SCRUB_ON_RESET: (BRANCH_PREDICTOR_CONFIG & 1) != 0,
            USE_TAGE      : (BRANCH_PREDICTOR_CONFIG & 2) == 0,
        ) (
            clk                       : clk                            ,
            rst_n                     : rst_n                          ,
            ready                     : predictor_ready                ,
            request_ready             : predictor_request_ready        ,
            request_valid             : predictor_request_valid        ,
            request_accept            : predictor_request_accept       ,
            request_pc                : fetch_packet.pc                ,
            request_fallthrough       : fetch_fallthrough              ,
            request_is_conditional    : fetch_is_conditional           ,
            response_accept           : predictor_response_accept      ,
            response_valid            : predictor_response_valid       ,
            response_token            : predictor_response_token       ,
            response_kind             : predictor_response_kind        ,
            response_taken            : predictor_response_taken       ,
            response_next_pc          : predictor_response_next_pc     ,
            response_btb_hit          : predictor_response_btb_hit     ,
            response_tage_hit         : predictor_response_tage_hit    ,
            response_ras_fallback     : predictor_response_ras_fallback,
            retire_valid              : predictor_retire_valid_q       ,
            retire_token              : predictor_retire_q.token       ,
            retire_pc                 : predictor_retire_q.pc          ,
            retire_kind               : predictor_retire_q.kind        ,
            retire_taken              : predictor_retire_q.taken       ,
            retire_target             : predictor_retire_q.target      ,
            retire_fallthrough        : predictor_retire_q.fallthrough ,
            recover_valid             : predictor_recover_valid_q      ,
            recover_token             : predictor_recover_token        ,
            recover_kind              : predictor_recover_kind         ,
            recover_taken             : predictor_recover_taken        ,
            recover_fallthrough       : predictor_recover_fallthrough  ,
            discard_all               : predictor_discard_all_q        ,
            conditional_resolved_event: predictor_conditional_event    ,
            direction_wrong_event     : predictor_direction_wrong_event,
            btb_miss_event            : predictor_btb_miss_event       ,
            ras_fallback_event        : predictor_ras_fallback_event   ,
        );
    } else :g_static {
        // Static recovery uses predecoded control flow and the architectural
        // fallthrough in EX/CM, so no predicted-PC payload is needed here.
        inst static_predictor: StaticBranchPredictor (
            clk                       : clk                            ,
            rst_n                     : rst_n                          ,
            ready                     : predictor_ready                ,
            request_ready             : predictor_request_ready        ,
            request_valid             : predictor_request_valid        ,
            request_accept            : predictor_request_accept       ,
            request_fallthrough       : 32'd0                          ,
            response_accept           : predictor_response_accept      ,
            response_valid            : predictor_response_valid       ,
            response_token            : predictor_response_token       ,
            response_kind             : predictor_response_kind        ,
            response_taken            : predictor_response_taken       ,
            response_next_pc          : predictor_response_next_pc     ,
            response_btb_hit          : predictor_response_btb_hit     ,
            response_tage_hit         : predictor_response_tage_hit    ,
            response_ras_fallback     : predictor_response_ras_fallback,
            retire_valid              : predictor_retire_valid_q       ,
            retire_kind               : predictor_retire_q.kind        ,
            retire_taken              : predictor_retire_q.taken       ,
            recover_valid             : predictor_recover_valid_q      ,
            discard_all               : predictor_discard_all_q        ,
            conditional_resolved_event: predictor_conditional_event    ,
            direction_wrong_event     : predictor_direction_wrong_event,
            btb_miss_event            : predictor_btb_miss_event       ,
            ras_fallback_event        : predictor_ras_fallback_event   ,
        );
    }

    inst fetch_access: PhysicalAccessCheck (
        address      : fetch_address        ,
        size         : fetch_access_size    ,
        instruction  : 1'b1                 ,
        allowed      : fetch_access_allowed ,
        crosses_bound: fetch_access_boundary,
        fault_address: fetch_fault_address  ,
    );
    for source in 0..3 :g_lsu_access {
        inst check: PhysicalOffsetAccessCheck #(
            ENABLE_TIMER: ENABLE_INTERRUPTS,
        ) (
            base         : lsu_access_bases[source]      ,
            offset       : ex_redirect_offset_q[11:0]    ,
            end_offset   : ex_access_end_offset_q        ,
            size         : lsu_access_size               ,
            allowed      : lsu_allowed_candidates[source],
            boot_boundary: lsu_boot_candidates[source]   ,
            ram_boundary : lsu_ram_candidates[source]    ,
            boot_region  : lsu_boot_regions[source]      ,
            timer_region : lsu_timer_regions[source]     ,
        );
    }

    always_comb {
        rf_write_enable  = wb_valid_q && wb_write_enable_q && (wb_rd_q != 5'd0);
        decode_bus.instr = fd_q.instruction;

        fetch_address                            = {fetch_line_q, fetch_parcel_q, 1'b0};
        fetch_line_plus_one[7:0]                 = fetch_line_q[7:0] + 8'd1;
        fetch_line_plus_one[15:8]                = fetch_line_q[15:8] + ((fetch_line_q[7:0] == 8'hff) as 8);
        fetch_line_plus_one[23:16]               = fetch_line_q[23:16] + ((fetch_line_q[15:0] == 16'hffff) as 8);
        fetch_line_plus_one[ADDRESS_BITS - 4:24] = fetch_line_q[ADDRESS_BITS - 4:24]
            + ((fetch_line_q[23:0] == 24'hffffff) as 64);
        fetch_packet.pc                          = fetch_address;
        fetch_packet.raw_instruction             = instr;
        fetch_packet.is_compressed               = instr_is_compressed;
        fetch_access_size                        = 2'd2;
        if instr_is_compressed {
            fetch_access_size = 2'd1;
        }
        fetch_packet.access_fault   = STRICT_MEMORY && !fetch_access_allowed;
        fetch_packet.fault_boundary = fetch_access_boundary;
        // An unmapped starting PC needs no memory response. At a mapped final
        // halfword, wait for the instruction length before deciding whether its
        // second parcel lies outside RAM. The memory returns zero for that line.
        fetch_packet.valid = instr_valid || (STRICT_MEMORY && !fetch_access_allowed && !fetch_access_boundary);
        if fetch_packet.access_fault {
            fetch_packet.raw_instruction = 32'h0000_0013;
            fetch_packet.is_compressed   = 1'b0;
        }
        // Preserve the packed queue views used by decode and verification while
        // keeping their payload and occupancy in disjoint physical registers.
        fetch_q.pc                        = fetch_payload_q.pc;
        fetch_q.access_fault              = fetch_payload_q.access_fault;
        fetch_q.fault_boundary            = fetch_payload_q.fault_boundary;
        fetch_q.raw_instruction           = fetch_payload_q.raw_instruction;
        fetch_q.is_compressed             = fetch_payload_q.is_compressed;
        fetch_q.valid                     = fetch_valid_q;
        fetch_lookahead_q.pc              = fetch_lookahead_payload_q.pc;
        fetch_lookahead_q.access_fault    = fetch_lookahead_payload_q.access_fault;
        fetch_lookahead_q.fault_boundary  = fetch_lookahead_payload_q.fault_boundary;
        fetch_lookahead_q.raw_instruction = fetch_lookahead_payload_q.raw_instruction;
        fetch_lookahead_q.is_compressed   = fetch_lookahead_payload_q.is_compressed;
        fetch_lookahead_q.valid           = fetch_lookahead_valid_q;
        // Exact RV64I/RV64C conditional predecode. Reserved standard branch
        // funct3 values 010/011 are illegal and must not perturb history.
        // C.BEQZ/C.BNEZ are the only compressed conditional encodings; every
        // encoding in those two funct3 spaces is legal in RV64C/Zca.
        fetch_is_conditional = 1'b0;
        if fetch_packet.is_compressed {
            fetch_is_conditional = (fetch_packet.raw_instruction[1:0] == 2'b01)
                && ((fetch_packet.raw_instruction[15:13] == 3'b110) || (fetch_packet.raw_instruction[15:13] == 3'b111));
        } else if fetch_packet.raw_instruction[6:0] == 7'b1100011 {
            case fetch_packet.raw_instruction[14:12] {
                3'b000, 3'b001, 3'b100, 3'b101, 3'b110, 3'b111: {
                    fetch_is_conditional = 1'b1;
                }
                default: {}
            }
        }
        fetch_fallthrough = fetch_packet.pc + 32'd4;
        if fetch_packet.is_compressed {
            fetch_fallthrough = fetch_packet.pc + 32'd2;
            fetch_next_parcel = fetch_parcel_q + 2'd1;
            fetch_cross_line  = fetch_parcel_q == 2'd3;
        } else {
            fetch_next_parcel = fetch_parcel_q + 2'd2;
            fetch_cross_line  = fetch_parcel_q[1];
        }

        decode_packet.pc = fetch_q.pc;

        decode_packet.access_fault = fetch_q.access_fault;

        decode_packet.fault_boundary    = fetch_q.fault_boundary;
        decode_packet.instruction       = fetch_q.raw_instruction;
        decode_packet.raw_instruction   = fetch_q.raw_instruction;
        decode_packet.is_compressed     = fetch_q.is_compressed;
        decode_packet.illegal           = 1'b0;
        decode_packet.prediction_token  = predictor_response_token;
        decode_packet.predicted_kind    = predictor_response_kind;
        decode_packet.predicted_taken   = predictor_response_taken;
        decode_packet.predicted_next_pc = predictor_response_next_pc;
        decode_packet.valid             = fetch_q.valid;
        if !predictor_response_valid {
            decode_packet.prediction_token  = 3'd0;
            decode_packet.predicted_kind    = 3'd0;
            decode_packet.predicted_taken   = 1'b0;
            decode_packet.predicted_next_pc = fetch_q.pc + 32'd4;
        }
        if fetch_q.is_compressed {
            decode_packet.instruction     = decompressed_instruction;
            decode_packet.raw_instruction = {16'd0, fetch_q.raw_instruction[15:0]};
            decode_packet.illegal         = compressed_illegal;
            if !predictor_response_valid {
                decode_packet.predicted_next_pc = fetch_q.pc + 32'd2;
            }
        }
        if (BRANCH_PREDICTOR_CONFIG & 4) != 0 {
            decode_packet.predicted_next_pc = 32'd0;
        }

        // The preceding EX result is already registered in the common
        // completion stage. Reuse that copy for the fast EX bypass instead of
        // duplicating two 64-bit result banks in a second bypass register.
        if cm_use_logic_q {
            bypass_data = cm_logic_result_q;
        } else {
            bypass_data = cm_arithmetic_q;
        }
        completion_bus.arithmetic       = cm_arithmetic_q;
        completion_bus.logic_result     = cm_logic_result_q;
        completion_bus.use_logic        = cm_use_logic_q;
        completion_bus.shift_low        = cm_shift_low_q;
        completion_bus.shift_amount     = cm_shift_amount_q;
        completion_bus.shift_arithmetic = cm_shift_arithmetic_q;
        completion_bus.shift_left       = cm_shift_left_q;
        completion_bus.shift_word       = cm_shift_word_q;
        completion_bus.use_shift        = cm_use_shift_q;
        completion_bus.compare_equal    = cm_branch_equal_q;
        completion_bus.compare_less     = cm_compare_less_q;
        completion_bus.compare_sign_a   = cm_compare_sign_a_q;
        completion_bus.compare_sign_b   = cm_compare_sign_b_q;
        completion_bus.compare_signed   = cm_compare_signed_q;
        completion_bus.use_compare      = cm_use_compare_q;
        completion_bus.load_data        = data_rdata;
        completion_bus.load_size        = cm_load_size_q;
        completion_bus.load_unsigned    = cm_load_unsigned_q;
        if FORMATTED_LOAD_DATA {
            completion_bus.load_size     = 2'b11;
            completion_bus.load_unsigned = 1'b0;
        }
        completion_bus.use_load   = cm_is_load_q;
        completion_bus.store_size = cm_store_size_q;
        cm_forward_data           = completion_bus.result;
        if rx_stalled_q {
            forwarded_rs1 = rx_stall_data_a_q;
        } else {
            forwarded_rs1 = rf_read_data_a;
        }
        if rx_rs1_q != 5'd0 {
            if cm_valid_q && cm_write_enable_q && !((ENABLE_ZBB || ENABLE_ZBS) && cm_use_bitmanip_q)
                && (cm_rd_q == rx_rs1_q) {
                forwarded_rs1 = cm_forward_data;
            } else if wb_valid_q && wb_write_enable_q && (wb_rd_q == rx_rs1_q) {
                forwarded_rs1 = wb_result_q;
            }
        }

        if rx_stalled_q {
            forwarded_rs2 = rx_stall_data_b_q;
        } else {
            forwarded_rs2 = rf_read_data_b;
        }
        if rx_rs2_q != 5'd0 {
            if cm_valid_q && cm_write_enable_q && !((ENABLE_ZBB || ENABLE_ZBS) && cm_use_bitmanip_q)
                && (cm_rd_q == rx_rs2_q) {
                forwarded_rs2 = cm_forward_data;
            } else if wb_valid_q && wb_write_enable_q && (wb_rd_q == rx_rs2_q) {
                forwarded_rs2 = wb_result_q;
            }
        }

        if rx_use_pc_q {
            rx_operand_a = rx_pc_q;
        } else {
            rx_operand_a = forwarded_rs1;
        }
        if rx_use_immediate_q {
            rx_operand_b = rx_immediate_q;
        } else {
            rx_operand_b = forwarded_rs2;
        }

        ex_bypass_hit_rs1 = rx_valid_q && ex_valid_q && ex_can_bypass_q && (ex_rd_q == rx_rs1_q);
        ex_bypass_hit_rs2 = rx_valid_q && ex_valid_q && ex_can_bypass_q && (ex_rd_q == rx_rs2_q);

        if ex_bypass_q.operand_a {
            alu_operand_a = bypass_data;
        } else {
            alu_operand_a = ex_operand_a_q;
        }
        if ex_bypass_q.operand_b {
            alu_operand_b = bypass_data;
        } else {
            alu_operand_b = ex_operand_b_q;
        }

        execute_bus.alu_op      = ex_alu_op_q;
        execute_bus.zba_control = ex_zba_control_q;
        execute_bus.subtract    = ex_subtract_q;
        execute_bus.link        = ex_link_q;
        execute_bus.word_op     = ex_word_op_q;
        execute_bus.operand_a   = alu_operand_a;
        execute_bus.operand_b   = alu_operand_b;
        lsu_address             = alu_operand_a[31:0] + alu_operand_b[31:0];
        // Loads/stores only add a base and offset. Do not route address
        // permission checks through the ALU's Zba/subtract/word selectors.
        // Four short carry-select slices also keep a dependent address's
        // carry propagation ahead of the region and end-byte comparisons.
        // Every implemented load/store has a signed 12-bit immediate. The
        // redirect-offset register already holds that instruction's immediate;
        // taking it here avoids the general operand-B forwarding selector.
        lsu_offset = {ex_redirect_offset_q[11] repeat 52, ex_redirect_offset_q[11:0]};
        for i in 0..4 {
            lsu_sum_c0[i] = {1'b0, alu_operand_a[i * 16+:16]} + {1'b0, lsu_offset[i * 16+:16]};
            lsu_sum_c1[i] = {1'b0, alu_operand_a[i * 16+:16]} + {1'b0, lsu_offset[i * 16+:16]} + 17'd1;
        }
        lsu_carry[0] = 1'b0;
        lsu_carry[1] = lsu_sum_c0[0][16];
        lsu_carry[2] = lsu_sum_c0[1][16] || (lsu_sum_c1[1][16] && lsu_carry[1]);
        lsu_carry[3] = lsu_sum_c0[2][16] || (lsu_sum_c1[2][16] && lsu_carry[2]);
        if STRICT_MEMORY {
            for i in 0..4 {
                if lsu_carry[i] {
                    lsu_address[i * 16+:16] = lsu_sum_c1[i][15:0];
                } else {
                    lsu_address[i * 16+:16] = lsu_sum_c0[i][15:0];
                }
            }
        }
        rx_access_size      = rx_load_size_q;
        if rx_is_store_q {
            rx_access_size      = rx_store_size_q;
        }
        rx_access_last_byte = 3'd0;
        case rx_access_size {
            2'd1   : rx_access_last_byte = 3'd1;
            2'd2   : rx_access_last_byte = 3'd3;
            2'd3   : rx_access_last_byte = 3'd7;
            default: {}
        }
        rx_access_end_offset = {rx_immediate_q[11], rx_immediate_q[11:0]} + {10'd0, rx_access_last_byte};
        lsu_access_size      = ex_load_size_q;
        if ex_is_store_q {
            lsu_access_size = ex_store_size_q;
        }
        // Classify the possible base pages while the low effective address
        // is added. Request/trap control need not wait for the upper sum.
        // Evaluate each registered forwarding source independently. The late
        // ALU/bypass selectors choose three permission bits instead of driving
        // a 64-bit address mux followed by the entire permission reduction.
        lsu_access_bases[0] = ex_operand_a_q;
        lsu_access_bases[1] = cm_arithmetic_q;
        lsu_access_bases[2] = cm_logic_result_q;
        lsu_access_allowed  = lsu_allowed_candidates[0];
        lsu_boot_boundary   = lsu_boot_candidates[0];
        lsu_ram_boundary    = lsu_ram_candidates[0];
        lsu_boot_region     = lsu_boot_regions[0];
        lsu_timer_region    = lsu_timer_regions[0];
        if ex_bypass_q.operand_a {
            if cm_use_logic_q {
                lsu_access_allowed = lsu_allowed_candidates[2];
                lsu_boot_boundary  = lsu_boot_candidates[2];
                lsu_ram_boundary   = lsu_ram_candidates[2];
                lsu_boot_region    = lsu_boot_regions[2];
                lsu_timer_region   = lsu_timer_regions[2];
            } else {
                lsu_access_allowed = lsu_allowed_candidates[1];
                lsu_boot_boundary  = lsu_boot_candidates[1];
                lsu_ram_boundary   = lsu_ram_candidates[1];
                lsu_boot_region    = lsu_boot_regions[1];
                lsu_timer_region   = lsu_timer_regions[1];
            }
        }
        lsu_access_fault  = STRICT_MEMORY && ex_valid_q && (ex_is_load_q || ex_is_store_q) && !lsu_access_allowed;
        lsu_fault_address = lsu_address;
        if lsu_boot_boundary {
            lsu_fault_address = 64'h0000_0000_0000_1000;
        } else if lsu_ram_boundary {
            lsu_fault_address = 64'h0000_0000_8003_f000;
        }
        if ex_bypass_q.store_data {
            execute_store_data = bypass_data;
        } else {
            execute_store_data = ex_store_data_q;
        }

        csr_bus.index = ex_csr_index_q;
        if ex_csr_use_imm_q {
            csr_source = {59'd0, ex_csr_immediate_q};
        } else {
            csr_source = alu_operand_a;
        }
        ex_exception = ex_valid_q
            && (ex_illegal_q || ex_is_ecall_q || ex_is_ebreak_q || (STRICT_MEMORY && ex_fetch_fault_q));
        if ex_is_ecall_q {
            ex_exception_cause = 64'd11;
        } else if ex_is_ebreak_q {
            ex_exception_cause = 64'd3;
        } else {
            ex_exception_cause = 64'd2;
        }
        if ex_illegal_q {
            ex_exception_value = {32'h0000_0000, ex_raw_instr_q};
        } else {
            ex_exception_value = 64'd0;
        }
        if STRICT_MEMORY && ex_fetch_fault_q {
            ex_exception_cause = 64'd1;
            ex_exception_value = ex_pc_q;
            if ex_fault_boundary_q {
                ex_exception_value = 64'h0000_0000_0000_1000;
                if ex_pc_q[31] {
                    ex_exception_value = 64'h0000_0000_8003_f000;
                }
            }
        }
        // Dynamic prediction keeps its EX direction result. Static prediction
        // finishes the reduction from the same registered compare slices as
        // SLT/SLTU, removing a full-width reduction from the EX bypass path.
        ex_branch_equal      = execute_bus.compare_equal == 4'b1111;
        ex_compare_less_high = execute_bus.compare_less[3]
            || (execute_bus.compare_equal[3] && execute_bus.compare_less[2]);
        ex_compare_less_low  = execute_bus.compare_less[1]
            || (execute_bus.compare_equal[1] && execute_bus.compare_less[0]);
        ex_compare_unsigned  = ex_compare_less_high
            || ((execute_bus.compare_equal[3] && execute_bus.compare_equal[2]) && ex_compare_less_low);
        if (ex_alu_op_q == 4'd9) && (execute_bus.compare_sign_a != execute_bus.compare_sign_b) {
            ex_compare_result = execute_bus.compare_sign_a;
        } else {
            ex_compare_result = ex_compare_unsigned;
        }
        case ex_branch_op_q {
            3'b000 : ex_branch_taken = ex_branch_equal;
            3'b001 : ex_branch_taken = !ex_branch_equal;
            3'b100 : ex_branch_taken = ex_compare_result;
            3'b101 : ex_branch_taken = !ex_compare_result;
            3'b110 : ex_branch_taken = ex_compare_result;
            3'b111 : ex_branch_taken = !ex_compare_result;
            default: ex_branch_taken = 1'b0;
        }
        cm_branch_taken     = cm_branch_taken_q;
        cm_compare_unsigned = cm_compare_less_q[3] || (cm_branch_equal_q[3] && cm_compare_less_q[2])
            || (cm_branch_equal_q[3] && cm_branch_equal_q[2]
                && (cm_compare_less_q[1] || (cm_branch_equal_q[1] && cm_compare_less_q[0])));
        cm_compare_result   = cm_compare_unsigned;
        if cm_compare_signed_q && (cm_compare_sign_a_q != cm_compare_sign_b_q) {
            cm_compare_result = cm_compare_sign_a_q;
        }
        if (BRANCH_PREDICTOR_CONFIG & 12) != 0 {
            case cm_branch_op_q {
                3'b000        : cm_branch_taken = cm_branch_equal_q == 4'b1111;
                3'b001        : cm_branch_taken = cm_branch_equal_q != 4'b1111;
                3'b100, 3'b110: cm_branch_taken = cm_compare_result;
                3'b101, 3'b111: cm_branch_taken = !cm_compare_result;
                default       : cm_branch_taken = 1'b0;
            }
        }

        if (BRANCH_PREDICTOR_CONFIG & 8) != 0 {
            // Legal branch encodings select equality/less-than with bit 2 and
            // invert with bit 0; exceptions mask the reserved encodings.
            cm_branch_taken = (cm_branch_equal_q == 4'b1111) ^ cm_branch_op_q[0];
            if cm_branch_op_q[2] {
                cm_branch_taken = cm_compare_result ^ cm_branch_op_q[0];
            }
        }

        rx_control_fallthrough = rx_immediate_q[31:0] == 32'd4;
        if rx_is_compressed_q {
            rx_control_fallthrough = rx_immediate_q[31:0] == 32'd2;
        }

        // RISC-V uses x1 and x5 as the link-register hints for the return
        // stack.  Keep the classification registered with the instruction so
        // prediction recovery never has to decode the instruction again.
        rx_control_kind = 3'd0;
        if rx_is_branch_q {
            rx_control_kind = 3'd1;
        } else if rx_is_jal_q {
            if (rx_rd_q == 5'd1) || (rx_rd_q == 5'd5) {
                rx_control_kind = 3'd4;
            } else {
                rx_control_kind = 3'd2;
            }
        } else if rx_is_jalr_q {
            if !((rx_rd_q == 5'd1) || (rx_rd_q == 5'd5)) && ((rx_rs1_q == 5'd1) || (rx_rs1_q == 5'd5)) {
                rx_control_kind = 3'd5;
            } else if ((rx_rd_q == 5'd1) || (rx_rd_q == 5'd5)) && ((rx_rs1_q == 5'd1) || (rx_rs1_q == 5'd5))
                && (rx_rd_q != rx_rs1_q) {
                rx_control_kind = 3'd6;
            } else if (rx_rd_q == 5'd1) || (rx_rd_q == 5'd5) {
                rx_control_kind = 3'd4;
            } else {
                rx_control_kind = 3'd3;
            }
        }
        if ex_bypass_q.redirect {
            redirect_addend_a = bypass_data;
        } else {
            redirect_addend_a = ex_redirect_base_q;
        }
        // A dependent JALR is the one redirect path that starts at the prior
        // completion result.  Split its 32-bit sum into two 16-bit slices and
        // precompute both upper carries, matching the RV64 ALU's carry-select
        // organization without adding a cycle to control-flow recovery.
        redirect_low     = {1'b0, redirect_addend_a[15:0]} + {1'b0, ex_redirect_offset_q[15:0]};
        redirect_high_c0 = {1'b0, redirect_addend_a[31:16]} + {1'b0, ex_redirect_offset_q[31:16]};
        redirect_high_c1 = {1'b0, redirect_addend_a[31:16]} + {1'b0, ex_redirect_offset_q[31:16]} + 17'd1;
        if redirect_low[16] {
            redirect_high = redirect_high_c1;
        } else {
            redirect_high = redirect_high_c0;
        }
        redirect_upper_c0 = redirect_addend_a[63:32] + ex_redirect_offset_q[63:32];
        redirect_upper_c1 = redirect_upper_c0 + 32'd1;
        redirect_upper    = redirect_upper_c0;
        if redirect_high[16] {
            redirect_upper = redirect_upper_c1;
        }
        redirect_sum = {redirect_upper, redirect_high[15:0], redirect_low[15:0]};
        if ex_redirect_clear_lsb_q {
            ex_redirect_target = redirect_sum & 64'hffff_ffff_ffff_fffe;
        } else {
            ex_redirect_target = redirect_sum;
        }
        ex_predicted_address = ex_predicted_next_pc_q;
        ex_actual_next_pc    = ex_fallthrough_pc_q;
        if ex_link_q {
            ex_actual_next_pc = ex_redirect_target;
        }
        // Dynamic predictors repair stale type/history even when the PC is
        // right. Static prediction predecodes PC-relative fallthrough targets
        // in RX. JALR always redirects, so its sum need not feed an equality
        // comparator and then the pipeline's redirect-valid fanout.
        ex_prediction_mismatch = ex_valid_q && !ex_is_branch_q && !ex_exception && !ex_is_mret_q && !ex_is_fence_i_q
            && ((((BRANCH_PREDICTOR_CONFIG & 4) == 0) && (ex_predicted_kind_q != ex_control_kind_q))
                || (ex_predicted_next_pc_q != ex_actual_next_pc));
        if (BRANCH_PREDICTOR_CONFIG & 4) != 0 {
            ex_prediction_mismatch = ex_valid_q && ex_static_redirect_q && !ex_exception && !ex_is_mret_q
                && !ex_is_fence_i_q;
        }
        if (BRANCH_PREDICTOR_CONFIG & 8) != 0 {
            // Compare registered targets in CM; the JALR adder must not also
            // traverse the PC comparator and the global redirect enables.
            ex_prediction_mismatch = 1'b0;
        }

        if cm_branch_taken {
            cm_actual_next_pc = cm_redirect_target_q;
        } else {
            cm_actual_next_pc = cm_fallthrough_pc_q;
        }
        if ((BRANCH_PREDICTOR_CONFIG & 8) != 0) && !cm_is_branch_q {
            cm_actual_next_pc = cm_fallthrough_pc_q;
            if cm_control_kind_q != 3'd0 {
                cm_actual_next_pc = cm_redirect_target_q;
            }
        }
        // A faulting branch must enter the trap vector; a future branch-side
        // access/alignment exception must never let prediction repair outrank
        // the older architectural exception.
        cm_prediction_mismatch = cm_valid_q && cm_is_branch_q && !cm_exception_q
            && ((((BRANCH_PREDICTOR_CONFIG & 4) == 0)
                    && ((cm_predicted_kind_q != 3'd1) || (cm_predicted_taken_q != cm_branch_taken)))
                || (cm_predicted_next_pc_q != cm_actual_next_pc));
        if (BRANCH_PREDICTOR_CONFIG & 4) != 0 {
            cm_prediction_mismatch = cm_valid_q && cm_is_branch_q && !cm_exception_q && cm_branch_taken
                && !cm_control_fallthrough_q;
        }
        if (BRANCH_PREDICTOR_CONFIG & 8) != 0 {
            cm_prediction_mismatch = cm_valid_q && !cm_exception_q && !cm_is_mret_q && !cm_is_fence_i_q
                && ((!cm_is_branch_q && !(&cm_linear_match_q))
                    || (cm_is_branch_q && cm_branch_taken && !(&cm_taken_match_q))
                    || (cm_is_branch_q && !cm_branch_taken && !cm_untaken_match_q));
        }
        ex_redirect_valid     = ex_prediction_mismatch;
        branch_redirect_valid = cm_prediction_mismatch;
        redirect_discards_cm  = redirect_pending_q && !redirect_preserve_cm_q;
        // Applying an older redirect takes one extra cycle. Control transfers
        // still present in the younger pipeline during that cycle are
        // wrong-path work and must not enqueue another redirect.
        // A pending older redirect makes the current completion-stage memory
        // operation wrong-path work. It must be flushed immediately instead
        // of stalling the pipeline and thereby dropping the redirect.
        memory_wait  = SYNC_DATA_MEMORY && !redirect_discards_cm && cm_valid_q && (cm_is_load_q || cm_is_store_q)
            && (data_response_sequence != data_request_sequence_q);
        muldiv_wait  = ENABLE_M && cm_valid_q && cm_muldiv_pending_q && !redirect_discards_cm;
        backend_wait = memory_wait || muldiv_wait;

        // Architectural system side effects occur in CM. If the preceding
        // branch redirected, its registered pending bit suppresses this
        // younger instruction without a compare-result-to-CSR timing path.
        // Register the request before distributing the frontend hold. EX and
        // CM retain ownership until their memory/MDU operations finish. At
        // the empty boundary, recheck the live predicate before accepting an
        // interrupt, then retain its cause until trap entry on the next edge.
        // This cuts the pending-level path to fetch/predictor/CSR payloads;
        // a level withdrawn before acceptance cannot cause a stale trap.
        csr_bus.machine_interrupts = machine_interrupts;
        interrupt_drain            = ENABLE_INTERRUPTS && csr_bus.interrupt_pending;
        interrupt_accept           = interrupt_drain_q && interrupt_drain && !ex_valid_q && !cm_valid_q
            && !redirect_pending_q && !interrupt_claimed_q;
        interrupt_event            = ENABLE_INTERRUPTS && interrupt_claimed_q;
        // Changes to the interrupt predicate serialize younger work. Their
        // CM write is followed by a redirect to fallthrough, so the new state
        // is evaluated before a successor can execute, just as after MRET.
        ex_irq_fence       = ENABLE_INTERRUPTS && ex_valid_q && ex_is_csr_q && ex_csr_write_q
            && ((ex_csr_index_q == 5'd1) || (ex_csr_index_q == 5'd16) || (ex_csr_index_q == 5'd17));
        ex_system_barrier  = (ex_valid_q && (ex_is_mret_q || ex_is_fence_i_q)) || ex_irq_fence;
        cm_irq_fence_event = ENABLE_INTERRUPTS && cm_valid_q && cm_is_csr_q && cm_csr_write_q
            && ((cm_csr_index_q == 5'd1) || (cm_csr_index_q == 5'd16) || (cm_csr_index_q == 5'd17)) && !cm_exception_q
            && !backend_wait && !redirect_pending_q;
        cm_trap_event      = cm_valid_q && cm_exception_q && !backend_wait && !redirect_pending_q;
        cm_mret_event      = cm_valid_q && cm_is_mret_q && !backend_wait && !redirect_pending_q;
        cm_fence_i_event   = cm_valid_q && cm_is_fence_i_q && !cm_exception_q && !backend_wait && !redirect_pending_q;
        instruction_flush  = cm_fence_i_event;
        cm_system_redirect = cm_trap_event || cm_mret_event || cm_fence_i_event || cm_irq_fence_event
            || interrupt_event;
        // The registered redirect cancels a wrong-path M request in PREPARE,
        // before it can produce a result. Keep the late CM branch comparison
        // off the MDU state input; architectural ownership remains in CM.
        muldiv_start = ENABLE_M && ex_valid_q && ex_is_muldiv_q && !backend_wait && !redirect_pending_q;

        // This is the architectural retirement boundary: a successful CM
        // instruction transfers to WB here. A pending taken branch explicitly
        // discards its wrong-path CM follower; JAL itself remains retireable.
        cm_retire_event      = cm_valid_q && !cm_exception_q && !backend_wait
            && !(redirect_pending_q && redirect_flush_wb_q);
        csr_bus.write_index  = cm_csr_index_q;
        csr_bus.write_enable = cm_valid_q && cm_is_csr_q && cm_csr_write_q && !cm_exception_q && !backend_wait
            && !redirect_discards_cm;
        // CSR read/modify/write operates on the value captured for this
        // instruction in EX, not on a free-running counter's newer CM value.
        // Present the resulting atomic value to CsrFile as a replace write.
        if cm_csr_op_q == 2'd1 {
            csr_write_value = cm_arithmetic_q | cm_csr_source_q;
        } else if cm_csr_op_q == 2'd2 {
            csr_write_value = cm_arithmetic_q & ~cm_csr_source_q;
        } else {
            csr_write_value = cm_csr_source_q;
        }
        csr_bus.write_op     = 2'd0;
        csr_bus.write_source = csr_write_value;
        csr_bus.trap_enter   = cm_trap_event || interrupt_event;
        csr_bus.trap_pc      = cm_pc_q;
        csr_bus.trap_cause   = cm_exception_cause_q;
        csr_bus.trap_value   = cm_exception_value_q;
        csr_bus.mret         = cm_mret_event;
        if interrupt_event {
            csr_bus.trap_pc    = interrupt_resume_pc_q;
            csr_bus.trap_cause = {1'b1, 59'd0, interrupt_cause_q};
            csr_bus.trap_value = 64'd0;
        }

        redirect_valid = !backend_wait && !redirect_pending_q
            && (ex_redirect_valid || cm_system_redirect || branch_redirect_valid);
        // An EX-owned prediction repair redirects only younger frontend work.
        // Its instruction becomes the next CM owner and must retain memory or
        // CSR side effects while the registered redirect is pending. A branch
        // or system redirect originates from older CM state instead.
        // The source bit also selects between a saved CM redirect target and
        // an EX owner's target that has advanced into the CM register bank.
        redirect_preserve_cm = !branch_redirect_valid && !cm_system_redirect;
        if branch_redirect_valid {
            redirect_target = cm_actual_next_pc;
        } else if cm_trap_event || interrupt_event {
            redirect_target = csr_bus.trap_vector;
        } else if cm_mret_event {
            redirect_target = csr_bus.return_pc;
        } else if cm_fence_i_event {
            redirect_target = cm_fallthrough_pc_q;
        } else {
            redirect_target = cm_fallthrough_pc_q;
        }
        // An EX repair's payload crosses into CM on the same edge as its
        // pending bit. Reuse that register bank instead of extending JALR's
        // adder through the older CM target-priority mux. Memory waits hold
        // this CM owner until the redirect can be applied.
        pending_redirect_target = redirect_target_q;
        if redirect_preserve_cm_q {
            pending_redirect_target = cm_fallthrough_pc_q;
            if cm_control_kind_q != 3'd0 {
                pending_redirect_target = cm_redirect_target_q;
            }
        }
        // Classify the FD consumer against the RX producer one edge before
        // that pair becomes RX/EX.  The registered bit makes the eventual
        // stall decision identical, but removes two register-index compares
        // from predictor request and fetch-cursor control.
        rx_result_can_bypass    = rx_write_enable_q && !rx_is_load_q && !rx_is_muldiv_q
            && !((rx_alu_op_q == 4'd6) || (rx_alu_op_q == 4'd7) || (rx_alu_op_q == 4'd8) || (rx_alu_op_q == 4'd9)
                || (rx_alu_op_q == 4'd11) || (rx_alu_op_q == 6'd16)
                || ((ENABLE_ZBB || ENABLE_ZBS) && rx_alu_op_q[5] && !rx_early_bitmanip)) && (rx_rd_q != 5'd0);
        decode_operand_match_rx = fd_q.valid && rx_valid_q && rx_write_enable_q && (rx_rd_q != 5'd0)
            && ((decode_bus.use_rs1 && (decode_bus.rs1 == rx_rd_q))
                || (decode_bus.use_rs2 && (decode_bus.rs2 == rx_rd_q)));
        decode_execution_hazard = decode_operand_match_rx && !rx_result_can_bypass;
        // A slow Zbb/Zbs producer two instructions ahead will occupy CM when this FD
        // consumer reaches RX. Its result is available from WB one edge later.
        if (ENABLE_ZBB || ENABLE_ZBS) && fd_q.valid && ex_valid_q && ex_alu_op_q[5] && !ex_early_bitmanip
            && ex_write_enable_q && (ex_rd_q != 5'd0)
            && ((decode_bus.use_rs1 && (decode_bus.rs1 == ex_rd_q))
                || (decode_bus.use_rs2 && (decode_bus.rs2 == ex_rd_q))) {
            decode_execution_hazard = 1'b1;
        }
        // CSR instructions are rare, so give each one an empty EX predecessor.
        // The preceding CM side effect is then in the CSR bank before the EX
        // read, preserving program order without a counter incrementer in the
        // CSR read path or an index comparator on global hold control.
        if fd_q.valid && decode_bus.is_csr && rx_valid_q {
            decode_execution_hazard = 1'b1;
        }
        execution_hazard = rx_execution_hazard_q;
        frontend_hold    = execution_hazard || interrupt_drain_q || interrupt_claimed_q;

        predictor_wait = !predictor_ready || (fetch_q.valid && !predictor_response_valid);
        // A redirect/exception detected in this cycle may consume one younger
        // prediction and launch its shadow lookup.  Both are speculative: the
        // registered maintenance event below rolls them back while the
        // frontend is already blocked by redirect_pending_q.  Keeping the raw
        // EX redirect out of this handshake avoids extending forwarding and
        // redirect arithmetic into every predictor state/control endpoint.
        predictor_response_accept   = predictor_response_valid && fetch_q.valid && !backend_wait && !redirect_pending_q
            && !ex_exception && !ex_system_barrier && !frontend_hold;
        predictor_frontend_redirect = predictor_response_accept && predictor_response_taken;
        // Keep the current InstructionBuffer tag hit out of the wide fetch
        // payload mux.  An invalid candidate may refresh masked payload, but
        // only the semantic predictor handshake advances the fetch cursor.
        fetch_candidate_offer   = !backend_wait && !redirect_pending_q && !ex_exception && !ex_system_barrier
            && !frontend_hold
            && (!fetch_q.valid || !fetch_lookahead_q.valid || !fetch_tail_valid_q || predictor_response_accept)
            && !predictor_frontend_redirect;
        fetch_payload_capture   = fetch_candidate_offer && predictor_request_ready;
        fetch_queue_push_valid  = fetch_payload_capture && fetch_packet.valid;
        predictor_request_valid = fetch_packet.valid && fetch_candidate_offer;
        fetch_queue_advance     = !backend_wait && !redirect_pending_q && !ex_exception && !ex_system_barrier
            && !predictor_wait && !frontend_hold && !predictor_frontend_redirect;

        // Keep packet data selection independent from the write enables.  A
        // payload is non-architectural whenever its corresponding valid bit is
        // clear, so every empty bank may refresh from the current input.  A
        // populated bank writes only on the FIFO advance edge.  This exposes a
        // short native-CE predicate while keeping memory waits and predictor
        // decisions out of the payload D muxes.
        fetch_payload_write   = !fetch_valid_q || fetch_queue_advance;
        fetch_lookahead_write = !fetch_lookahead_valid_q || fetch_queue_advance;
        fetch_tail_write      = !fetch_tail_valid_q || fetch_queue_advance;

        // The CM conditional is older than the EX instruction and therefore
        // owns recovery when both detect a mismatch in the same cycle.
        predictor_recover_valid = redirect_valid && !cm_system_redirect;
        // Recovery is applied one cycle after redirect detection.  An EX-owned
        // repair has crossed into CM by then, so its token and control metadata
        // can be read directly from the CM registers.  An older CM branch is
        // overwritten on that edge; retain its payload in the independent bank
        // below and select it with the registered one-bit source tag.  This
        // keeps the late branch comparison off the 39-bit recovery-payload D
        // mux without changing the recovery edge.
        predictor_recover_token       = cm_prediction_token_q;
        predictor_recover_kind        = cm_control_kind_q;
        predictor_recover_taken       = cm_control_kind_q != 3'd0;
        predictor_recover_fallthrough = cm_fallthrough_pc_q;
        if predictor_recover_branch_q {
            predictor_recover_token       = predictor_recover_q.token;
            predictor_recover_kind        = predictor_recover_q.kind;
            predictor_recover_taken       = predictor_recover_q.taken;
            predictor_recover_fallthrough = predictor_recover_q.fallthrough;
        }
        // A data access fault is first registered in CM. It has not performed
        // the earlier EX exception discard, so retire neither its token nor
        // any younger prediction, and reset the speculative queue here.
        predictor_discard_all = interrupt_event || (STRICT_MEMORY && cm_trap_event)
            || (!backend_wait && !redirect_pending_q && !branch_redirect_valid && !cm_system_redirect
                && (ex_exception || ex_system_barrier));

        // Present the four raw cycle predicates independently. CsrFile samples
        // all four at this edge, then applies the controller's memory,
        // redirect, dependency, frontend priority to those registered bits.
        // Doing that selection once, after the event boundary, prevents the
        // late JALR redirect sum from propagating into every counter-event FF.
        // These are control events, not a CPI decomposition: a redirect event
        // can coincide with retirement.
        csr_bus.retire            = cm_retire_event;
        csr_bus.stall_dependency  = execution_hazard || muldiv_wait;
        csr_bus.stall_memory_wait = memory_wait;
        // Count the same generation/application cycles as the raw redirect
        // predicates, but one cycle later from the registered maintenance
        // pulses.  Keeping the delayed pending pulse preserves the second
        // application cycle without routing JALR forwarding/target arithmetic
        // into the event register bank.
        csr_bus.stall_redirect                 = predictor_recover_valid_q || predictor_discard_all_q
            || redirect_pending_q || redirect_event_delay_q;
        csr_bus.stall_frontend_empty           = predictor_wait || !fd_q.valid;
        csr_bus.predictor_conditional_resolved = predictor_conditional_event;
        csr_bus.predictor_direction_wrong      = predictor_direction_wrong_event;
        csr_bus.predictor_btb_miss             = predictor_btb_miss_event;
        csr_bus.predictor_ras_fallback         = predictor_ras_fallback_event;
        // Count only architectural next-PC repair. Predictor-wide slot
        // discard is maintenance, not a branch-prediction miss.
        csr_bus.predictor_repair    = predictor_recover_valid_q;
        csr_bus.counter_freeze      = counter_freeze;
        csr_bus.debug_counter_index = debug_counter_index;
        debug_counter_data          = csr_bus.debug_counter_data;

        pc = fetch_address;
        // A registered held prediction prepares the synchronous lookup while
        // its queue entry waits for the backend. Its accept edge clears the
        // preview as the semantic cursor switches to the same target.
        if EARLY_TAKEN_FETCH && taken_fetch_valid_q {
            pc = taken_fetch_pc_q;
        }
        // The optional board-memory relocation is registered together with
        // the architectural LSU address. It therefore does not put an
        // address-space mux between a pipeline register and every BRAM bank.
        data_addr        = cm_lsu_address_q;
        data_memory_addr = cm_lsu_memory_address_q;
        data_wdata       = cm_lsu_wdata_q;
        data_wmask       = completion_bus.store_mask;
        // Hold the architectural store indication for the complete CM
        // transaction. HardwareMemory performs the physical write only when
        // the request sequence changes, so this cannot duplicate the write.
        data_we               = cm_valid_q && cm_is_store_q && !cm_exception_q && !redirect_discards_cm;
        data_request_sequence = data_request_sequence_q;
        data_load_size        = cm_load_size_q;
        data_load_unsigned    = cm_load_unsigned_q;
        // There is no architectural halt instruction. This output remains for
        // the board debug ABI and will be used by a future debug halt request.
        halted    = 1'b0;
        debug_x31 = debug_x31_q;

    }

    // Hold the frontend through the accepted interrupt even if its external
    // level changes. No EX/CM instruction can enter between acceptance and
    // trap entry, so the saved architectural resume PC below remains stable.
    // CSR writes/MRET already redirect and flush younger work: the registered
    // request is visible before their successor can enter EX.
    always_ff (clk, rst_n) {
        if_reset {
            interrupt_drain_q   = 1'b0;
            interrupt_claimed_q = 1'b0;
            interrupt_cause_q   = 4'd0;
        } else if ENABLE_INTERRUPTS {
            interrupt_drain_q   = interrupt_drain && !csr_bus.trap_enter;
            interrupt_claimed_q = interrupt_accept;
            if interrupt_accept {
                interrupt_cause_q = csr_bus.interrupt_cause;
            }
        }
    }

    // Record the first instruction that has not retired. This remains valid
    // during cache misses, taken branches, and an empty frontend. Interrupts
    // use it only after EX/CM drain, while any older WB write still completes.
    always_ff (clk, rst_n) {
        if_reset {
            interrupt_resume_pc_q = 32'd0;
        } else if ENABLE_INTERRUPTS {
            if cm_trap_event {
                interrupt_resume_pc_q = csr_bus.trap_vector;
            } else if cm_retire_event {
                if cm_mret_event {
                    interrupt_resume_pc_q = csr_bus.return_pc;
                } else if cm_is_branch_q {
                    interrupt_resume_pc_q = cm_actual_next_pc;
                } else if cm_control_kind_q != 3'd0 {
                    interrupt_resume_pc_q = cm_redirect_target_q;
                } else {
                    interrupt_resume_pc_q = cm_fallthrough_pc_q;
                }
            }
        }
    }

    // The valid/source bits are reset while both payload banks refresh from
    // already-registered CM state every cycle.  Retire validity masks its
    // payload; recovery validity and the one-bit source tag select either the
    // current CM payload or the independently captured branch payload below.
    // Retire and recovery remain independent so a retiring older instruction
    // can share a cycle with a younger EX redirect, exactly as in the
    // unregistered interface.
    always_ff (clk, rst_n) {
        if_reset {
            predictor_retire_valid_q   = 1'b0;
            predictor_recover_valid_q  = 1'b0;
            predictor_recover_branch_q = 1'b0;
            predictor_discard_all_q    = 1'b0;
        } else {
            predictor_retire_valid_q   = cm_retire_event;
            predictor_recover_valid_q  = predictor_recover_valid;
            predictor_recover_branch_q = branch_redirect_valid;
            predictor_discard_all_q    = predictor_discard_all;
        }
    }

    // Refresh both payload banks unconditionally from already-registered
    // source fields.  Their reset-bearing valid/source controls make stale
    // payload unobservable without qualifying all 104 payload FF clock-enables
    // with late retirement/redirect decisions.
    always_ff (clk) {
        predictor_retire_q.token       = cm_prediction_token_q;
        predictor_retire_q.pc          = cm_pc_q;
        predictor_retire_q.kind        = cm_control_kind_q;
        predictor_retire_q.taken       = !cm_is_branch_q || cm_branch_taken;
        predictor_retire_q.target      = cm_redirect_target_q;
        predictor_retire_q.fallthrough = cm_fallthrough_pc_q;
        // Capture the current CM branch candidate unconditionally.  Only the
        // adjacent registered source tag makes this bank observable, so no late
        // branch-valid enable or wide selected D path is required.
        predictor_recover_q.token = cm_prediction_token_q;
        predictor_recover_q.kind  = 3'd1;
        predictor_recover_q.taken = cm_branch_taken;
        if (BRANCH_PREDICTOR_CONFIG & 8) != 0 {
            predictor_recover_q.kind  = cm_control_kind_q;
            predictor_recover_q.taken = !cm_is_branch_q || cm_branch_taken;
        }
        predictor_recover_q.fallthrough = cm_fallthrough_pc_q;
    }

    // Preserve the RF response while RX waits, and fold in producers when
    // they reach WB. A CM result is available through live forwarding until
    // its WB transfer, including across a memory wait, so it need not pass
    // through the full completion mux into these snapshot registers.
    // rx_stalled_q masks the unreset payload until its first capture.
    always_ff (clk) {
        if !rx_stalled_q {
            rx_stall_data_a_q = rf_read_data_a;
            rx_stall_data_b_q = rf_read_data_b;
        }
        if wb_valid_q && wb_write_enable_q && (wb_rd_q != 5'd0) {
            if wb_rd_q == rx_rs1_q {
                rx_stall_data_a_q = wb_result_q;
            }
            if wb_rd_q == rx_rs2_q {
                rx_stall_data_b_q = wb_result_q;
            }
        }
    }

    // Only an accepted semantic predictor request advances the instruction
    // cursor.  Invalid payload refreshes therefore cannot skip an address.
    always_ff (clk, rst_n) {
        if_reset {
            fetch_line_q   = 29'd0;
            fetch_parcel_q = 2'd0;
        } else {
            // The semantic handshakes already exclude memory/dependency
            // waits and architectural flushes. Do not repeat those predicates
            // in a priority mux on the late instruction-valid -> PC path.
            if !backend_wait && redirect_pending_q {
                fetch_line_q   = pending_redirect_target[ADDRESS_BITS - 1:3];
                fetch_parcel_q = pending_redirect_target[2:1];
            } else if predictor_frontend_redirect && !predictor_wait {
                fetch_line_q   = predictor_response_next_pc[31:3];
                fetch_parcel_q = predictor_response_next_pc[2:1];
            } else if predictor_request_accept {
                if fetch_cross_line {
                    fetch_line_q = fetch_line_plus_one;
                }
                fetch_parcel_q = fetch_next_parcel;
            }
        }
    }

    // Do not extend recovery/token availability through the instruction-cache
    // address mux. A prediction is held only when the frontend cannot accept
    // another candidate. Acceptance or recovery clears the preview on the
    // same edge that advances or flushes the corresponding queue entry.
    always_ff (clk, rst_n) {
        if_reset {
            taken_fetch_valid_q = 1'b0;
            taken_fetch_pc_q    = 32'd0;
        } else {
            taken_fetch_valid_q = EARLY_TAKEN_FETCH && fetch_q.valid && predictor_response_valid
                && predictor_response_taken && !predictor_response_accept;
            taken_fetch_pc_q    = predictor_response_next_pc;
        }
    }

    // Queue payload is masked by separately reset valid bits.  One clock-only
    // process owns all three packet banks, avoiding packed-struct partial
    // writes across processes.  Each bank has an explicit write enable so
    // synthesis can use the native FF CE instead of putting the stall and
    // predictor-decision predicates on an old-value D mux.  Old-value FF
    // semantics make a simultaneous pop/push shift middle -> head and tail
    // -> middle before appending the incoming packet to the newly opened
    // slot.
    always_ff (clk) {
        if fetch_payload_write {
            if fetch_lookahead_valid_q {
                fetch_payload_q.pc              = fetch_lookahead_payload_q.pc;
                fetch_payload_q.access_fault    = fetch_lookahead_payload_q.access_fault;
                fetch_payload_q.fault_boundary  = fetch_lookahead_payload_q.fault_boundary;
                fetch_payload_q.raw_instruction = fetch_lookahead_payload_q.raw_instruction;
                fetch_payload_q.is_compressed   = fetch_lookahead_payload_q.is_compressed;
            } else {
                fetch_payload_q.pc              = fetch_packet.pc;
                fetch_payload_q.access_fault    = fetch_packet.access_fault;
                fetch_payload_q.fault_boundary  = fetch_packet.fault_boundary;
                fetch_payload_q.raw_instruction = fetch_packet.raw_instruction;
                fetch_payload_q.is_compressed   = fetch_packet.is_compressed;
            }

        }
        if fetch_lookahead_write {
            if fetch_tail_valid_q {
                fetch_lookahead_payload_q.pc              = fetch_tail_payload_q.pc;
                fetch_lookahead_payload_q.access_fault    = fetch_tail_payload_q.access_fault;
                fetch_lookahead_payload_q.fault_boundary  = fetch_tail_payload_q.fault_boundary;
                fetch_lookahead_payload_q.raw_instruction = fetch_tail_payload_q.raw_instruction;
                fetch_lookahead_payload_q.is_compressed   = fetch_tail_payload_q.is_compressed;
            } else {
                fetch_lookahead_payload_q.pc              = fetch_packet.pc;
                fetch_lookahead_payload_q.access_fault    = fetch_packet.access_fault;
                fetch_lookahead_payload_q.fault_boundary  = fetch_packet.fault_boundary;
                fetch_lookahead_payload_q.raw_instruction = fetch_packet.raw_instruction;
                fetch_lookahead_payload_q.is_compressed   = fetch_packet.is_compressed;
            }
        }
        if fetch_tail_write {
            fetch_tail_payload_q.pc              = fetch_packet.pc;
            fetch_tail_payload_q.access_fault    = fetch_packet.access_fault;
            fetch_tail_payload_q.fault_boundary  = fetch_packet.fault_boundary;
            fetch_tail_payload_q.raw_instruction = fetch_packet.raw_instruction;
            fetch_tail_payload_q.is_compressed   = fetch_packet.is_compressed;
        }
    }

    // Occupancy is a prefix: tail implies middle, and middle implies head.
    // Reset/redirect own only these valid bits; the payload bank above remains
    // reset-free.  The normal equations are the complete three-slot FIFO
    // pop/push truth table under that invariant.
    always_ff (clk, rst_n) {
        if_reset {
            fetch_valid_q           = 1'b0;
            fetch_lookahead_valid_q = 1'b0;
            fetch_tail_valid_q      = 1'b0;
        } else if !backend_wait {
            if redirect_pending_q || ex_exception || ex_system_barrier {
                fetch_valid_q           = 1'b0;
                fetch_lookahead_valid_q = 1'b0;
                fetch_tail_valid_q      = 1'b0;
            } else if predictor_wait {
                if fetch_queue_push_valid {
                    if !fetch_lookahead_valid_q {
                        fetch_lookahead_valid_q = 1'b1;
                    } else {
                        fetch_tail_valid_q = 1'b1;
                    }
                }
            } else if frontend_hold {
                // Hold all three occupied slots.
            } else if predictor_frontend_redirect {
                fetch_valid_q           = 1'b0;
                fetch_lookahead_valid_q = 1'b0;
                fetch_tail_valid_q      = 1'b0;
            } else {
                fetch_valid_q           = fetch_lookahead_valid_q || fetch_queue_push_valid;
                fetch_lookahead_valid_q = fetch_tail_valid_q || (fetch_lookahead_valid_q && fetch_queue_push_valid);
                fetch_tail_valid_q      = fetch_tail_valid_q && fetch_queue_push_valid;
            }
        }
    }

    // Pending M results are invisible to consumers while the backend is held.
    // Refresh that payload until done, so only a small result mux crosses this
    // boundary. The completion edge reads the last registered M result.
    always_ff (clk, rst_n) {
        if_reset {
            cm_arithmetic_q = 64'd0;
        } else if ENABLE_M && muldiv_wait {
            cm_arithmetic_q = muldiv_result;
        } else if ENABLE_M || !backend_wait {
            if ex_is_csr_q {
                cm_arithmetic_q = csr_bus.read_data;
            } else {
                cm_arithmetic_q = execute_bus.arithmetic;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            debug_x31_q             = 64'h0000_0000_0000_0000;
            redirect_pending_q      = 1'b0;
            redirect_preserve_cm_q  = 1'b0;
            redirect_event_delay_q  = 1'b0;
            redirect_flush_wb_q     = 1'b0;
            redirect_target_q       = 64'h0000_0000_0000_0000;
            data_request_sequence_q = 1'b0;

            fd_q.pc                = 32'h0000_0000;
            fd_q.instruction       = 32'h0000_0013;
            fd_q.raw_instruction   = 32'h0000_0013;
            fd_q.is_compressed     = 1'b0;
            fd_q.illegal           = 1'b0;
            fd_q.prediction_token  = 3'd0;
            fd_q.predicted_kind    = 3'd0;
            fd_q.predicted_taken   = 1'b0;
            fd_q.predicted_next_pc = 32'h0000_0004;
            fd_q.valid             = 1'b0;
            fd_q.access_fault      = 1'b0;
            fd_q.fault_boundary    = 1'b0;
            rx_fetch_fault_q       = 1'b0;
            rx_fault_boundary_q    = 1'b0;
            ex_fetch_fault_q       = 1'b0;
            ex_fault_boundary_q    = 1'b0;

            rx_valid_q             = 1'b0;
            rx_pc_q                = 64'h0000_0000_0000_0000;
            rx_raw_instr_q         = 32'h0000_0013;
            rx_is_compressed_q     = 1'b0;
            rx_rs1_q               = 5'd0;
            rx_rs2_q               = 5'd0;
            rx_rd_q                = 5'd0;
            rx_immediate_q         = 64'h0000_0000_0000_0000;
            rx_alu_op_q            = 4'd0;
            rx_use_pc_q            = 1'b0;
            rx_use_immediate_q     = 1'b0;
            rx_use_rs1_q           = 1'b0;
            rx_use_rs2_q           = 1'b0;
            rx_write_enable_q      = 1'b0;
            rx_is_load_q           = 1'b0;
            rx_is_muldiv_q         = 1'b0;
            ex_is_muldiv_q         = 1'b0;
            cm_muldiv_pending_q    = 1'b0;
            rx_load_size_q         = 2'b11;
            rx_load_unsigned_q     = 1'b0;
            rx_is_store_q          = 1'b0;
            rx_store_size_q        = 2'b11;
            rx_word_op_q           = 1'b0;
            rx_is_branch_q         = 1'b0;
            rx_branch_op_q         = 3'b000;
            rx_is_jal_q            = 1'b0;
            rx_is_jalr_q           = 1'b0;
            rx_is_csr_q            = 1'b0;
            rx_csr_op_q            = 2'b00;
            rx_csr_use_imm_q       = 1'b0;
            rx_csr_write_q         = 1'b0;
            rx_csr_index_q         = 5'd0;
            rx_is_ecall_q          = 1'b0;
            rx_is_ebreak_q         = 1'b0;
            rx_is_mret_q           = 1'b0;
            rx_is_fence_i_q        = 1'b0;
            rx_illegal_q           = 1'b0;
            rx_prediction_token_q  = 3'd0;
            rx_predicted_kind_q    = 3'd0;
            rx_predicted_taken_q   = 1'b0;
            rx_predicted_next_pc_q = 32'h0000_0004;
            rx_stalled_q           = 1'b0;
            rx_execution_hazard_q  = 1'b0;

            ex_valid_q               = 1'b0;
            ex_pc_q                  = 64'h0000_0000_0000_0000;
            ex_raw_instr_q           = 32'h0000_0013;
            ex_rd_q                  = 5'd0;
            ex_alu_op_q              = 4'd0;
            ex_zba_control_q         = 3'd0;
            ex_subtract_q            = 1'b0;
            ex_write_enable_q        = 1'b0;
            ex_can_bypass_q          = 1'b0;
            ex_is_load_q             = 1'b0;
            ex_load_size_q           = 2'b11;
            ex_load_unsigned_q       = 1'b0;
            ex_is_store_q            = 1'b0;
            ex_store_size_q          = 2'b11;
            ex_access_end_offset_q   = 13'd0;
            ex_word_op_q             = 1'b0;
            ex_is_branch_q           = 1'b0;
            ex_branch_op_q           = 3'b000;
            ex_link_q                = 1'b0;
            ex_static_redirect_q     = 1'b0;
            ex_control_fallthrough_q = 1'b0;
            ex_is_csr_q              = 1'b0;
            ex_csr_op_q              = 2'b00;
            ex_csr_use_imm_q         = 1'b0;
            ex_csr_immediate_q       = 5'd0;
            ex_csr_write_q           = 1'b0;
            ex_csr_index_q           = 5'd0;
            ex_is_ecall_q            = 1'b0;
            ex_is_ebreak_q           = 1'b0;
            ex_is_mret_q             = 1'b0;
            ex_is_fence_i_q          = 1'b0;
            ex_illegal_q             = 1'b0;
            ex_control_kind_q        = 3'd0;
            ex_prediction_token_q    = 3'd0;
            ex_predicted_kind_q      = 3'd0;
            ex_predicted_taken_q     = 1'b0;
            ex_predicted_next_pc_q   = 32'h0000_0004;
            ex_fallthrough_pc_q      = 32'h0000_0004;
            ex_operand_a_q           = 64'h0000_0000_0000_0000;
            ex_operand_b_q           = 64'h0000_0000_0000_0000;
            ex_store_data_q          = 64'h0000_0000_0000_0000;
            ex_redirect_base_q       = 64'h0000_0000_0000_0000;
            ex_redirect_offset_q     = 64'h0000_0000_0000_0000;
            ex_redirect_clear_lsb_q  = 1'b0;
            ex_bypass_q.operand_a    = 1'b0;
            ex_bypass_q.operand_b    = 1'b0;
            ex_bypass_q.store_data   = 1'b0;
            ex_bypass_q.redirect     = 1'b0;

            cm_valid_q               = 1'b0;
            cm_pc_q                  = 64'h0000_0000_0000_0000;
            cm_raw_instr_q           = 32'h0000_0013;
            cm_rd_q                  = 5'd0;
            cm_write_enable_q        = 1'b0;
            cm_is_load_q             = 1'b0;
            cm_load_size_q           = 2'b11;
            cm_load_unsigned_q       = 1'b0;
            cm_is_store_q            = 1'b0;
            cm_store_size_q          = 2'b11;
            cm_is_branch_q           = 1'b0;
            cm_branch_taken_q        = 1'b0;
            cm_linear_match_q        = 1'b0;
            ex_kind_match_q          = 1'b0;
            cm_taken_match_q         = 1'b0;
            cm_untaken_match_q       = 1'b0;
            cm_branch_op_q           = 3'd0;
            cm_control_fallthrough_q = 1'b0;
            cm_branch_equal_q        = 4'b0000;
            cm_redirect_target_q     = 32'h0000_0000;
            cm_shift_low_q           = 64'h0000_0000_0000_0000;
            cm_shift_amount_q        = 3'b000;
            cm_shift_arithmetic_q    = 1'b0;
            cm_logic_result_q        = 64'h0000_0000_0000_0000;
            cm_use_logic_q           = 1'b0;
            cm_use_shift_q           = 1'b0;
            cm_use_bitmanip_q        = 1'b0;
            cm_compare_less_q        = 4'b0000;
            cm_compare_sign_a_q      = 1'b0;
            cm_compare_sign_b_q      = 1'b0;
            cm_compare_signed_q      = 1'b0;
            cm_use_compare_q         = 1'b0;
            cm_shift_left_q          = 1'b0;
            cm_shift_word_q          = 1'b0;
            cm_lsu_address_q         = 64'h0000_0000_0000_0000;
            cm_lsu_memory_address_q  = 64'h0000_0000_0000_0000;
            cm_lsu_wdata_q           = 64'h0000_0000_0000_0000;
            cm_is_csr_q              = 1'b0;
            cm_csr_op_q              = 2'd0;
            cm_csr_write_q           = 1'b0;
            cm_csr_index_q           = 5'd0;
            cm_csr_source_q          = 64'd0;
            cm_exception_q           = 1'b0;
            cm_exception_cause_q     = 64'd0;
            cm_exception_value_q     = 64'd0;
            cm_is_mret_q             = 1'b0;
            cm_is_fence_i_q          = 1'b0;
            cm_control_kind_q        = 3'd0;
            cm_prediction_token_q    = 3'd0;
            cm_predicted_kind_q      = 3'd0;
            cm_predicted_taken_q     = 1'b0;
            cm_predicted_next_pc_q   = 32'h0000_0004;
            cm_fallthrough_pc_q      = 32'h0000_0004;

            wb_valid_q        = 1'b0;
            wb_pc_q           = 64'h0000_0000_0000_0000;
            wb_raw_instr_q    = 32'h0000_0013;
            wb_rd_q           = 5'd0;
            wb_write_enable_q = 1'b0;
            wb_result_q       = 64'h0000_0000_0000_0000;
            wb_mem_we_q       = 1'b0;
            wb_mem_addr_q     = 64'h0000_0000_0000_0000;
            wb_mem_wdata_q    = 64'h0000_0000_0000_0000;
            wb_mem_wmask_q    = 8'h00;

            commit_valid     = 1'b0;
            commit_pc        = 64'h0000_0000_0000_0000;
            commit_instr     = 32'h0000_0013;
            commit_rd        = 5'd0;
            commit_data      = 64'h0000_0000_0000_0000;
            commit_mem_we    = 1'b0;
            commit_mem_addr  = 64'h0000_0000_0000_0000;
            commit_mem_wdata = 64'h0000_0000_0000_0000;
            commit_mem_wmask = 8'h00;
        } else {
            // An EX-owned memory repair keeps its redirect transaction live
            // while the owner waits in CM.  The completion edge below then
            // advances that owner to WB and applies the saved frontend target.
            // Older redirects never enter this hold case.
            if backend_wait && redirect_pending_q && redirect_preserve_cm_q {
                redirect_pending_q     = 1'b1;
                redirect_preserve_cm_q = 1'b1;
            } else {
                redirect_event_delay_q = redirect_pending_q;
                redirect_pending_q     = redirect_valid;
                redirect_preserve_cm_q = redirect_preserve_cm;
                // CM access faults can still have a younger EX follower.
                // That follower must be discarded before it reaches WB.
                redirect_flush_wb_q = branch_redirect_valid || (STRICT_MEMORY && cm_trap_event);
                // Only a CM-owned pending redirect exposes this payload.
                // Refresh it on every advancing cycle to keep the late
                // redirect-valid decision out of a wide old-value mux.
                redirect_target_q = redirect_target;
            }

            commit_valid = wb_valid_q;
            if COMMIT_PAYLOAD {
                commit_pc    = wb_pc_q;
                commit_instr = wb_raw_instr_q;
                commit_rd    = 5'd0;
                commit_data  = 64'h0000_0000_0000_0000;
                if wb_write_enable_q && (wb_rd_q != 5'd0) {
                    commit_rd   = wb_rd_q;
                    commit_data = wb_result_q;
                }
                commit_mem_we    = wb_valid_q && wb_mem_we_q;
                commit_mem_addr  = wb_mem_addr_q;
                commit_mem_wdata = wb_mem_wdata_q;
                commit_mem_wmask = wb_mem_wmask_q;
            } else {
                commit_pc        = 64'd0;
                commit_instr     = 32'd0;
                commit_rd        = 5'd0;
                commit_data      = 64'd0;
                commit_mem_we    = 1'b0;
                commit_mem_addr  = 64'd0;
                commit_mem_wdata = 64'd0;
                commit_mem_wmask = 8'd0;
            }

            if rf_write_enable && (wb_rd_q == 5'd31) {
                debug_x31_q = wb_result_q;
            }

            if backend_wait {
                if muldiv_wait && muldiv_done {
                    cm_muldiv_pending_q = 1'b0;
                }
                // Hold every younger stage and discard the premature WB
                // transfer until the memory-domain response token changes.
                wb_valid_q = 1'b0;
                // RX already owns the register-file response associated with
                // its instruction. Preserve that response while the RF read
                // ports are frozen. The independent snapshot process folds
                // in WB values; CM remains available through live forwarding.
                rx_stalled_q = 1'b1;
            } else {
                // Any frontend/backend hold below inserts an EX bubble, so a
                // dependency against the former EX producer expires here.
                // Zbb/Zbs finishes into the existing WB register. A dependent
                // consumer waits one extra cycle and reads that stable value,
                // keeping the bit-manipulation cone off the common CM bypass.
                rx_execution_hazard_q = (ENABLE_ZBB || ENABLE_ZBS) && execution_hazard && ex_valid_q && ex_alu_op_q[5]
                    && !ex_early_bitmanip;
                wb_valid_q            = cm_valid_q && !cm_exception_q;
                if COMMIT_PAYLOAD {
                    wb_pc_q        = cm_pc_q;
                    wb_raw_instr_q = cm_raw_instr_q;
                    wb_mem_we_q    = cm_is_store_q;
                    wb_mem_addr_q  = cm_lsu_address_q;
                    wb_mem_wdata_q = cm_lsu_wdata_q;
                    wb_mem_wmask_q = completion_bus.store_mask;
                } else {
                    wb_pc_q        = 32'd0;
                    wb_raw_instr_q = 32'd0;
                    wb_mem_we_q    = 1'b0;
                    wb_mem_addr_q  = 32'd0;
                    wb_mem_wdata_q = 64'd0;
                    wb_mem_wmask_q = 8'd0;
                }
                wb_rd_q           = cm_rd_q;
                wb_write_enable_q = cm_write_enable_q;
                wb_result_q       = completion_bus.result;
                if (ENABLE_ZBB || ENABLE_ZBS) && cm_use_bitmanip_q {
                    wb_result_q = bitmanip_result;
                }

                // Exceptions enter CM so trap state and redirect are both
                // registered full-cycle side effects; WB suppresses them.
                // MRET remains a normally retired instruction.
                cm_valid_q          = ex_valid_q;
                cm_muldiv_pending_q = ex_is_muldiv_q;
                cm_pc_q             = ex_pc_q;
                cm_raw_instr_q      = ex_raw_instr_q;
                cm_rd_q             = ex_rd_q;
                cm_write_enable_q   = ex_write_enable_q;
                // Keep operation tags independent of the late address check.
                // Faults issue no request token: after the older CM operation
                // drains, its response already matches the unchanged token,
                // so a faulting memory tag cannot introduce a memory wait.
                // Trap/WB and data_we separately suppress all side effects.
                cm_is_load_q       = ex_is_load_q;
                cm_load_size_q     = ex_load_size_q;
                cm_load_unsigned_q = ex_load_unsigned_q;
                cm_is_store_q      = ex_is_store_q;
                // Only an older CM redirect makes the current EX memory
                // instruction wrong-path.  A prediction-kind repair owned by
                // this same load/store redirects younger fetch but must not
                // suppress the architectural memory operation itself. Keeping
                // ex_redirect_valid out of this CE also avoids routing the
                // unrelated JALR target adder through the request token.
                if ex_valid_q && (ex_is_load_q || ex_is_store_q) && !ex_exception && !lsu_access_fault
                    && !branch_redirect_valid && !cm_system_redirect && !redirect_pending_q {
                    data_request_sequence_q = !data_request_sequence_q;
                }
                cm_store_size_q   = ex_store_size_q;
                cm_is_branch_q    = ex_valid_q && ex_is_branch_q;
                cm_branch_taken_q = 1'b0;
                if (BRANCH_PREDICTOR_CONFIG & 12) == 0 {
                    cm_branch_taken_q = ex_branch_taken;
                }
                cm_branch_op_q           = ex_branch_op_q;
                cm_control_fallthrough_q = ex_control_fallthrough_q;
                cm_branch_equal_q        = execute_bus.compare_equal;
                cm_redirect_target_q     = ex_redirect_target;
                // Keep the late JALR sum local to 16-bit comparisons in EX.
                // CM reduces their registered matches while choosing direction,
                // at the same recovery edge as before.
                cm_taken_match_q   = 1'b0;
                cm_untaken_match_q = 1'b0;
                cm_linear_match_q  = 1'b0;
                if (BRANCH_PREDICTOR_CONFIG & 8) != 0 {
                    for i in 0..TARGET_MATCH_SLICES {
                        cm_taken_match_q[i]  = ex_kind_match_q && ex_predicted_taken_q
                            && (ex_predicted_address[i * 16+:16] == ex_redirect_target[i * 16+:16]);
                        cm_linear_match_q[i] = ex_kind_match_q
                            && ((ex_link_q && (ex_predicted_address[i * 16+:16] == ex_redirect_target[i * 16+:16]))
                                || (!ex_link_q
                                    && (ex_predicted_address[i * 16+:16] == ex_fallthrough_pc_q[i * 16+:16])));
                    }
                    cm_untaken_match_q = ex_kind_match_q && !ex_predicted_taken_q
                        && (ex_predicted_next_pc_q == ex_fallthrough_pc_q);
                }
                cm_shift_low_q = execute_bus.shift_result;
                if ex_word_op_q {
                    cm_shift_amount_q = {1'b0, alu_operand_b[4:3]};
                } else {
                    cm_shift_amount_q = alu_operand_b[5:3];
                }
                cm_shift_arithmetic_q = ex_alu_op_q == 4'd8;
                cm_logic_result_q     = execute_bus.logic_result;
                if ex_early_bitmanip {
                    cm_logic_result_q = early_bitmanip_result;
                }
                cm_use_logic_q          = (execute_bus.result_use_logic || ex_early_bitmanip) && !ex_is_csr_q;
                cm_use_shift_q          = execute_bus.result_use_shift;
                cm_use_bitmanip_q       = (ENABLE_ZBB || ENABLE_ZBS) && ex_alu_op_q[5] && !ex_early_bitmanip;
                cm_compare_less_q       = execute_bus.compare_less;
                cm_compare_sign_a_q     = execute_bus.compare_sign_a;
                cm_compare_sign_b_q     = execute_bus.compare_sign_b;
                cm_compare_signed_q     = ex_alu_op_q == 4'd9;
                cm_use_compare_q        = execute_bus.result_use_compare;
                cm_shift_left_q         = (ex_alu_op_q == 4'd6) || (ex_alu_op_q == 6'd16);
                cm_shift_word_q         = ex_word_op_q;
                cm_lsu_address_q        = lsu_address;
                cm_lsu_memory_address_q = lsu_address;
                if STRICT_MEMORY && RELOCATE_LOW_DATA {
                    // A permitted transfer belongs to exactly one physical
                    // region. Reconstruct its private memory-port prefix from
                    // the early region tags, without waiting for the upper
                    // address carry and a second MMIO/relocation comparison.
                    // Faulting/non-memory instructions issue no token; the
                    // architectural address above remains full width for traps.
                    cm_lsu_memory_address_q = {32'd0, 14'h2000, lsu_address[17:0]};
                    if lsu_boot_region {
                        cm_lsu_memory_address_q = {46'd0, 6'h3f, lsu_address[11:0]};
                    } else if lsu_timer_region {
                        cm_lsu_memory_address_q = {32'd0, 16'h0200, lsu_address[15:0]};
                    }
                } else if RELOCATE_LOW_DATA && !lsu_address[31]
                    && !(ENABLE_INTERRUPTS && (lsu_address[31:16] == 16'h0200)) {
                    cm_lsu_memory_address_q = {14'd0, 6'h3f, lsu_address[11:0]};
                }
                cm_lsu_wdata_q       = execute_store_data;
                cm_is_csr_q          = ex_is_csr_q;
                cm_csr_op_q          = ex_csr_op_q;
                cm_csr_write_q       = ex_csr_write_q;
                cm_csr_index_q       = ex_csr_index_q;
                cm_csr_source_q      = csr_source;
                cm_exception_q       = ex_exception || lsu_access_fault;
                cm_exception_cause_q = ex_exception_cause;
                cm_exception_value_q = ex_exception_value;
                // Check the full effective address before issuing the token.
                // A data fault enters CM directly; it does not put the address
                // adder/permission reduction onto EX's frontend flush fanout.
                // Prepare the data-fault payload for every load/store. Only
                // cm_exception_q makes it observable, so the late permission
                // result need not select all 64 MTVAL bits. Instruction faults
                // keep priority over any load/store bits in the fetched word.
                if STRICT_MEMORY && (ex_is_load_q || ex_is_store_q) && !ex_exception {
                    cm_exception_cause_q = 64'd5;
                    if ex_is_store_q {
                        cm_exception_cause_q = 64'd7;
                    }
                    cm_exception_value_q = lsu_fault_address;
                }
                cm_is_mret_q           = ex_is_mret_q;
                cm_is_fence_i_q        = ex_is_fence_i_q;
                cm_control_kind_q      = ex_control_kind_q;
                cm_prediction_token_q  = ex_prediction_token_q;
                cm_predicted_kind_q    = ex_predicted_kind_q;
                cm_predicted_taken_q   = ex_predicted_taken_q;
                cm_predicted_next_pc_q = ex_predicted_next_pc_q;
                cm_fallthrough_pc_q    = ex_fallthrough_pc_q;

                // Register only the consumer selectors. The producer value enters
                // cm_arithmetic_q/cm_logic_result_q on this same edge and is the
                // bypass source on the next cycle.
                ex_bypass_q.operand_a  = !execution_hazard && ex_bypass_hit_rs1 && rx_use_rs1_q && !rx_is_jalr_q;
                ex_bypass_q.operand_b  = !execution_hazard && ex_bypass_hit_rs2 && rx_use_rs2_q && !rx_use_immediate_q;
                ex_bypass_q.store_data = !execution_hazard && ex_bypass_hit_rs2 && rx_is_store_q;
                ex_bypass_q.redirect   = !execution_hazard && ex_bypass_hit_rs1 && rx_is_jalr_q;

                ex_valid_q     = rx_valid_q;
                ex_pc_q        = rx_pc_q;
                ex_raw_instr_q = rx_raw_instr_q;
                ex_rd_q        = rx_rd_q;
                ex_alu_op_q    = rx_alu_op_q;
                // Decode the Zba input selects before EX's shift-and-add
                // carry chain. The controls stall with their instruction.
                ex_zba_control_q = 3'd0;
                if ENABLE_ZBA && !rx_alu_op_q[5] && rx_alu_op_q[4] {
                    ex_zba_control_q = rx_alu_op_q[2:0];
                }
                // Decode subtraction before EX so the carry-chain input does
                // not start behind a four-bit opcode equality comparator.
                ex_subtract_q            = rx_alu_op_q == 4'd1;
                ex_write_enable_q        = rx_write_enable_q;
                ex_can_bypass_q          = rx_write_enable_q && !rx_is_load_q && !rx_is_muldiv_q
                    && !((rx_alu_op_q == 4'd6) || (rx_alu_op_q == 4'd7) || (rx_alu_op_q == 4'd8)
                        || (rx_alu_op_q == 4'd9) || (rx_alu_op_q == 4'd11) || (rx_alu_op_q == 6'd16)
                        || ((ENABLE_ZBB || ENABLE_ZBS) && rx_alu_op_q[5] && !rx_early_bitmanip)) && (rx_rd_q != 5'd0);
                ex_is_load_q             = rx_is_load_q;
                ex_load_size_q           = rx_load_size_q;
                ex_load_unsigned_q       = rx_load_unsigned_q;
                ex_is_store_q            = rx_is_store_q;
                ex_store_size_q          = rx_store_size_q;
                ex_word_op_q             = rx_word_op_q;
                ex_is_branch_q           = rx_is_branch_q;
                ex_branch_op_q           = rx_branch_op_q;
                ex_link_q                = rx_is_jal_q || rx_is_jalr_q;
                ex_static_redirect_q     = rx_is_jalr_q || (rx_is_jal_q && !rx_control_fallthrough);
                ex_control_fallthrough_q = rx_control_fallthrough;
                ex_is_csr_q              = rx_is_csr_q;
                ex_is_muldiv_q           = rx_is_muldiv_q;
                ex_csr_op_q              = rx_csr_op_q;
                ex_csr_use_imm_q         = rx_csr_use_imm_q;
                ex_csr_immediate_q       = rx_rs1_q;
                ex_csr_write_q           = rx_csr_write_q;
                ex_csr_index_q           = rx_csr_index_q;
                ex_is_ecall_q            = rx_is_ecall_q;
                ex_is_ebreak_q           = rx_is_ebreak_q;
                ex_is_mret_q             = rx_is_mret_q;
                ex_is_fence_i_q          = rx_is_fence_i_q;
                ex_illegal_q             = rx_illegal_q;
                ex_fetch_fault_q         = rx_fetch_fault_q;
                ex_fault_boundary_q      = rx_fault_boundary_q;
                ex_control_kind_q        = rx_control_kind;
                ex_prediction_token_q    = rx_prediction_token_q;
                ex_predicted_kind_q      = rx_predicted_kind_q;
                ex_predicted_taken_q     = rx_predicted_taken_q;
                ex_predicted_next_pc_q   = rx_predicted_next_pc_q;
                ex_kind_match_q          = 1'b0;
                if (BRANCH_PREDICTOR_CONFIG & 8) != 0 {
                    ex_kind_match_q = rx_predicted_kind_q == rx_control_kind;
                }
                if rx_is_compressed_q {
                    ex_fallthrough_pc_q = rx_pc_q + 32'd2;
                } else {
                    ex_fallthrough_pc_q = rx_pc_q + 32'd4;
                }
                if rx_is_jal_q || rx_is_jalr_q {
                    ex_operand_a_q = rx_pc_q;
                    if rx_is_compressed_q {
                        ex_operand_b_q = 64'd2;
                    } else {
                        ex_operand_b_q = 64'd4;
                    }
                } else {
                    ex_operand_a_q = rx_operand_a;
                    ex_operand_b_q = rx_operand_b;
                }
                ex_store_data_q = forwarded_rs2;
                if rx_is_jalr_q {
                    ex_redirect_base_q = forwarded_rs1;
                } else {
                    ex_redirect_base_q = rx_pc_q;
                }
                // Hold the last-byte offset with the same EX descriptor;
                // permission checking adds base to start/end in parallel.
                ex_access_end_offset_q  = rx_access_end_offset;
                ex_redirect_offset_q    = rx_immediate_q;
                ex_redirect_clear_lsb_q = rx_is_jalr_q;

                if redirect_pending_q {
                    fd_q.valid = 1'b0;
                    rx_valid_q = 1'b0;
                    ex_valid_q = 1'b0;
                    cm_valid_q = 1'b0;
                    if redirect_flush_wb_q {
                        wb_valid_q = 1'b0;
                    }
                    rx_stalled_q = 1'b0;
                } else if ex_exception || ex_system_barrier {
                    // Trap state/target is committed from CM on the next
                    // cycle. Kill younger work here so that delaying the CSR
                    // side effect does not let an instruction past the
                    // exception or MRET change architectural state.
                    fd_q.valid   = 1'b0;
                    rx_valid_q   = 1'b0;
                    ex_valid_q   = 1'b0;
                    rx_stalled_q = 1'b0;
                } else if predictor_wait {
                    // The hardware cold-start scrub and a held synchronous
                    // lookup both keep the frontend stationary.  Older work
                    // may drain through CM/WB, while EX receives a bubble so
                    // no instruction is executed twice.
                    ex_valid_q   = 1'b0;
                    rx_stalled_q = rx_valid_q;
                } else if frontend_hold {
                    ex_valid_q   = 1'b0;
                    rx_stalled_q = 1'b1;
                } else {
                    rx_stalled_q           = 1'b0;
                    rx_valid_q             = fd_q.valid;
                    rx_pc_q                = fd_q.pc;
                    rx_raw_instr_q         = fd_q.raw_instruction;
                    rx_is_compressed_q     = fd_q.is_compressed;
                    rx_rs1_q               = decode_bus.rs1;
                    rx_rs2_q               = decode_bus.rs2;
                    rx_rd_q                = decode_bus.rd;
                    rx_immediate_q         = decode_bus.immediate;
                    rx_alu_op_q            = decode_bus.alu_op;
                    rx_use_pc_q            = decode_bus.use_pc;
                    rx_use_immediate_q     = decode_bus.use_immediate;
                    rx_use_rs1_q           = decode_bus.use_rs1;
                    rx_use_rs2_q           = decode_bus.use_rs2;
                    rx_write_enable_q      = decode_bus.write_enable;
                    rx_is_load_q           = decode_bus.is_load;
                    rx_load_size_q         = decode_bus.load_size;
                    rx_load_unsigned_q     = decode_bus.load_unsigned;
                    rx_is_store_q          = decode_bus.is_store;
                    rx_store_size_q        = decode_bus.store_size;
                    rx_word_op_q           = decode_bus.word_op;
                    rx_is_branch_q         = decode_bus.is_branch;
                    rx_branch_op_q         = decode_bus.branch_op;
                    rx_is_jal_q            = decode_bus.is_jal;
                    rx_is_jalr_q           = decode_bus.is_jalr;
                    rx_is_csr_q            = decode_bus.is_csr;
                    rx_is_muldiv_q         = decode_bus.is_muldiv;
                    rx_csr_op_q            = decode_bus.csr_op;
                    rx_csr_use_imm_q       = decode_bus.csr_use_imm;
                    rx_csr_write_q         = decode_bus.csr_write;
                    rx_csr_index_q         = decode_bus.csr_index;
                    rx_is_ecall_q          = decode_bus.is_ecall;
                    rx_is_ebreak_q         = decode_bus.is_ebreak;
                    rx_is_mret_q           = decode_bus.is_mret;
                    rx_is_fence_i_q        = decode_bus.is_fence_i;
                    rx_illegal_q           = decode_bus.illegal || fd_q.illegal;
                    rx_fetch_fault_q       = fd_q.access_fault;
                    rx_fault_boundary_q    = fd_q.fault_boundary;
                    rx_prediction_token_q  = fd_q.prediction_token;
                    rx_predicted_kind_q    = fd_q.predicted_kind;
                    rx_predicted_taken_q   = fd_q.predicted_taken;
                    rx_predicted_next_pc_q = fd_q.predicted_next_pc;
                    rx_execution_hazard_q  = decode_execution_hazard;

                    fd_q = decode_packet;
                }
            }
        }
    }
}
