/// RV64 2-read/1-write register file built from two replicated 1R1W memories.
///
/// Reads are synchronous with one-cycle latency. Register x0 is masked to zero
/// and writes to x0 are suppressed. The replication is intentional: each bank
/// supplies one independent read port while both banks receive every write.
module RegisterFile (
    clk           : input  clock    ,
    write_enable  : input  logic    ,
    write_address : input  logic<5> ,
    write_data    : input  logic<64>,
    read_enable   : input  logic    ,
    read_address_a: input  logic<5> ,
    read_address_b: input  logic<5> ,
    read_data_a   : output logic<64>,
    read_data_b   : output logic<64>,
) {
    var bank_a          : logic<64> [32];
    var bank_b          : logic<64> [32];
    var read_data_a_raw : logic<64>     ;
    var read_data_b_raw : logic<64>     ;
    var read_address_a_q: logic<5>      ;
    var read_address_b_q: logic<5>      ;
    var bypass_a_q      : logic         ;
    var bypass_b_q      : logic         ;
    var bypass_data_a_q : logic<64>     ;
    var bypass_data_b_q : logic<64>     ;

    always_ff (clk) {
        if write_enable && (write_address != 5'd0) {
            bank_a[write_address] = write_data;
        }
        if write_enable && (write_address != 5'd0) {
            bank_b[write_address] = write_data;
        }
    }

    always_ff (clk) {
        if read_enable {
            read_data_a_raw = bank_a[read_address_a];
        }
    }

    always_ff (clk) {
        if read_enable {
            read_address_a_q = read_address_a;
            bypass_a_q       = write_enable && (write_address != 5'd0) && (write_address == read_address_a);
            bypass_data_a_q  = write_data;
        }
    }

    always_ff (clk) {
        if read_enable {
            read_data_b_raw = bank_b[read_address_b];
        }
    }

    always_ff (clk) {
        if read_enable {
            read_address_b_q = read_address_b;
            bypass_b_q       = write_enable && (write_address != 5'd0) && (write_address == read_address_b);
            bypass_data_b_q  = write_data;
        }
    }

    always_comb {
        if read_address_a_q == 5'd0 {
            read_data_a = 64'h0000_0000_0000_0000;
        } else if bypass_a_q {
            read_data_a = bypass_data_a_q;
        } else {
            read_data_a = read_data_a_raw;
        }

        if read_address_b_q == 5'd0 {
            read_data_b = 64'h0000_0000_0000_0000;
        } else if bypass_b_q {
            read_data_b = bypass_data_b_q;
        } else {
            read_data_b = read_data_b_raw;
        }
    }
}
