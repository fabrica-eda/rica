/// RV64 integer execution unit with four 16-bit carry-select slices.
module ExecuteUnit #(
    param ENABLE_ZBA: bit = 0,
) (
    execute: modport ExecuteBus::execute,
) {
    var arithmetic_a: logic<64>;
    var arithmetic_b: logic<64>;
    var zba_source  : logic<64>;
    var zba_shift1  : logic<64>;
    var sum_c0      : logic<17> [4];
    var sum_c1      : logic<17> [4];
    var carry       : logic<4>;
    var arithmetic64: logic<64>;

    inst shift_bus : ShiftBus;
    inst shift_unit: ShiftUnit (
        shift: shift_bus,
    );

    always_comb {
        zba_source = execute.operand_a;
        if ENABLE_ZBA && !execute.alu_op[5] && execute.alu_op[4] && execute.alu_op[2] {
            zba_source = {32'd0, execute.operand_a[31:0]};
        }
        // Two binary selects implement shifts 0..3 without a priority chain.
        zba_shift1 = zba_source;
        if ENABLE_ZBA && !execute.alu_op[5] && execute.alu_op[4] && execute.alu_op[0] {
            zba_shift1 = {zba_source[62:0], 1'd0};
        }
        arithmetic_a = zba_shift1;
        if ENABLE_ZBA && !execute.alu_op[5] && execute.alu_op[4] && execute.alu_op[1] {
            arithmetic_a = {zba_shift1[61:0], 2'd0};
        }
        if execute.subtract {
            arithmetic_b = ~execute.operand_b;
        } else {
            arithmetic_b = execute.operand_b;
        }
        // Each slice computes both carry-in cases; a short carry prefix picks
        // them, so the longest ripple is one 16-bit slice instead of 32 bits.
        // Subtraction's +1 is slice zero's carry-in.
        for i in 0..4 {
            sum_c0[i] = {1'b0, arithmetic_a[i * 16+:16]} + {1'b0, arithmetic_b[i * 16+:16]};
            sum_c1[i] = {1'b0, arithmetic_a[i * 16+:16]} + {1'b0, arithmetic_b[i * 16+:16]} + 17'd1;
        }
        carry[0] = execute.subtract;
        carry[1] = if execute.subtract ? sum_c1[0][16] : sum_c0[0][16];
        carry[2] = sum_c0[1][16] || (sum_c1[1][16] && carry[1]);
        carry[3] = sum_c0[2][16] || (sum_c1[2][16] && carry[2]);
        for i in 0..4 {
            arithmetic64[i * 16+:16] = if carry[i] ? sum_c1[i][15:0] : sum_c0[i][15:0];
        }
        for i in 0..4 {
            execute.compare_equal[i] = execute.operand_a[i * 16+:16] == execute.operand_b[i * 16+:16];
            execute.compare_less[i]  = execute.operand_a[i * 16+:16] <: execute.operand_b[i * 16+:16];
        }
        execute.compare_sign_a = execute.operand_a[63];
        execute.compare_sign_b = execute.operand_b[63];
        if execute.word_op {
            execute.arithmetic = {arithmetic64[31] repeat 32, arithmetic64[31:0]};
        } else {
            execute.arithmetic = arithmetic64;
        }

        case execute.alu_op {
            4'd2       : execute.logic_result = execute.operand_a ^ execute.operand_b;
            4'd3       : execute.logic_result = execute.operand_a | execute.operand_b;
            4'd4       : execute.logic_result = execute.operand_a & execute.operand_b;
            4'd9, 4'd11: execute.logic_result = 64'd0;
            default    : execute.logic_result = execute.operand_b;
        }
        execute.result_use_logic   = !execute.link
            && ((execute.alu_op == 4'd2) || (execute.alu_op == 4'd3) || (execute.alu_op == 4'd4)
                || (execute.alu_op == 4'd5) || (execute.alu_op == 4'd9) || (execute.alu_op == 4'd11));
        execute.result_use_compare = !execute.link && ((execute.alu_op == 4'd9) || (execute.alu_op == 4'd11));
        shift_bus.alu_op           = execute.alu_op[3:0];
        shift_bus.word_op          = execute.word_op;
        shift_bus.operand          = execute.operand_a;
        if ENABLE_ZBA && (execute.alu_op == 6'd16) {
            shift_bus.alu_op  = 4'd6;
            shift_bus.operand = {32'd0, execute.operand_a[31:0]};
        }
        if execute.word_op {
            shift_bus.amount = {1'b0, execute.operand_b[4:0]};
        } else {
            shift_bus.amount = execute.operand_b[5:0];
        }
        execute.shift_result     = shift_bus.result;
        execute.result_use_shift = !execute.link
            && ((execute.alu_op == 4'd6) || (execute.alu_op == 4'd7) || (execute.alu_op == 4'd8)
                || (ENABLE_ZBA && (execute.alu_op == 6'd16)));
    }
}
