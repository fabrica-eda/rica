module LinearAnd16 (
    clk   : input  clock    ,
    data  : input  logic<16>,
    result: output logic    ,
) {
    var data_q  : logic<16>;
    var result_q: logic    ;

    always_comb {
        result = result_q;
    }

    always_ff (clk) {
        data_q = data;
        result_q = data_q[0] && data_q[1] && data_q[2] && data_q[3]
            && data_q[4] && data_q[5] && data_q[6] && data_q[7]
            && data_q[8] && data_q[9] && data_q[10] && data_q[11]
            && data_q[12] && data_q[13] && data_q[14] && data_q[15];
    }
}

module BalancedAnd16 (
    clk   : input  clock    ,
    data  : input  logic<16>,
    result: output logic    ,
) {
    var data_q  : logic<16>;
    var result_q: logic    ;

    always_comb {
        result = result_q;
    }

    always_ff (clk) {
        data_q = data;
        result_q = (((data_q[0] && data_q[1]) && (data_q[2] && data_q[3]))
            && ((data_q[4] && data_q[5]) && (data_q[6] && data_q[7])))
            && (((data_q[8] && data_q[9]) && (data_q[10] && data_q[11]))
            && ((data_q[12] && data_q[13]) && (data_q[14] && data_q[15])));
    }
}

module LinearOr16 (
    clk   : input  clock    ,
    data  : input  logic<16>,
    result: output logic    ,
) {
    var data_q  : logic<16>;
    var result_q: logic    ;

    always_comb {
        result = result_q;
    }

    always_ff (clk) {
        data_q = data;
        result_q = data_q[0] || data_q[1] || data_q[2] || data_q[3]
            || data_q[4] || data_q[5] || data_q[6] || data_q[7]
            || data_q[8] || data_q[9] || data_q[10] || data_q[11]
            || data_q[12] || data_q[13] || data_q[14] || data_q[15];
    }
}

module BalancedOr16 (
    clk   : input  clock    ,
    data  : input  logic<16>,
    result: output logic    ,
) {
    var data_q  : logic<16>;
    var result_q: logic    ;

    always_comb {
        result = result_q;
    }

    always_ff (clk) {
        data_q = data;
        result_q = (((data_q[0] || data_q[1]) || (data_q[2] || data_q[3]))
            || ((data_q[4] || data_q[5]) || (data_q[6] || data_q[7])))
            || (((data_q[8] || data_q[9]) || (data_q[10] || data_q[11]))
            || ((data_q[12] || data_q[13]) || (data_q[14] || data_q[15])));
    }
}
