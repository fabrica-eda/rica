module DefaultMask #(
    param P: bit = 64'd3,
) (
    a: input  logic<64>,
    o: output logic<64>,
) {
    assign o = a & {P repeat 64};
}

module OverrideMask #(
    param P: bit = 0,
) (
    a: input  logic<64>,
    o: output logic<64>,
) {
    assign o = a & {P repeat 64};
}

module SignedMask (
    a: input  logic<64>,
    o: output logic<64>,
) {
    const P    : signed logic<8>  = 64'd255;
    let   value: logic       <64> = P;
    assign o = a & value;
}

#[test(test_default_mask)]
module test_default_mask {
    inst clk: $tb::clock_gen;
    var a: logic<64>;
    var o: logic<64>;
    inst dut: DefaultMask ( a, o );
    initial {
        a = 64'hffff_ffff_ffff_ffff;
        clk.next();
        $display("default: a=%h o=%h", a, o);
        $assert(o == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}

#[test(test_override_mask)]
module test_override_mask {
    inst clk: $tb::clock_gen;
    var a: logic<64>;
    var o: logic<64>;
    inst dut: OverrideMask #( P: 64'd1 ) ( a, o );
    initial {
        a = 64'hffff_ffff_ffff_ffff;
        clk.next();
        $display("override: a=%h o=%h", a, o);
        $assert(o == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}

#[test(test_signed_mask)]
module test_signed_mask {
    inst clk: $tb::clock_gen;
    var a: logic<64>;
    var o: logic<64>;
    inst dut: SignedMask ( a, o );
    initial {
        a = 64'hffff_ffff_ffff_ffff;
        clk.next();
        $display("signed: a=%h o=%h", a, o);
        $assert(o == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}

#[test(test_inline_constant_mask)]
module test_inline_constant_mask {
    inst clk: $tb::clock_gen;
    const P: bit       = 64'd3;
    var   a: logic<64>;
    let   o: logic<64> = a & {P repeat 64};
    initial {
        a = 64'hffff_ffff_ffff_ffff;
        clk.next();
        $display("inline: a=%h o=%h", a, o);
        $assert(o == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}
