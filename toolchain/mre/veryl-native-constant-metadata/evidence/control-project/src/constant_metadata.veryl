module ConstantMask (
    a: input  logic<64>,
    o: output logic<64>,
) {
    const P: bit = 64'd3;
    assign o = a & {P repeat 64};
}

#[test(test_constant_mask)]
module test_constant_mask {
    inst clk: $tb::clock_gen;

    var a: logic<64>;
    var o: logic<64>;
    inst dut: ConstantMask ( a, o );

    initial {
        a = 64'hffff_ffff_ffff_ffff;
        clk.next();
        $display("a=%h o=%h", a, o);
        $assert(o == 64'hffff_ffff_ffff_ffff);
        $finish();
    }
}
